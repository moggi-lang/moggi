module Main where

import System.Filesystem
import System.Filesystem.Path

-- The working directory is the one place that exists on every platform, so the
-- demo file goes there and is removed again at the end.
demoName :: String
demoName = "moggi-system-demo.txt"

firstLine :: [String] -> String
firstLine ls = case ls of
  [] -> ""
  x : _ -> x

countLines :: [String] -> Int
countLines xs = case xs of
  [] -> 0
  _ : rest -> 1 + countLines rest

showReport :: String -> String -> IO ()
showReport path content = do
  putStrLn ("file: " <> takeFileName path)
  putStrLn ("preview: " <> firstLine (lines content))
  putStrLn ("lines: " <> describeLineCount (countLines (lines content)))

describeLineCount :: Int -> String
describeLineCount n = case n of
  0 -> "none"
  1 -> "one"
  2 -> "two"
  3 -> "three"
  4 -> "four"
  5 -> "five"
  6 -> "six"
  _ -> "many"

seedFile :: FilePath -> IO ()
seedFile path = do
  writeTextFile path (unlines ["alpha", "beta", "gamma"])
  appendTextFile path (unlines ["delta"])

main :: IO ()
main = do
  here <- getWorkingDirectory
  let path = here <> "/" <> demoName
  seedFile path
  content <- readTextFile path
  putStrLn "=== file report ==="
  showReport path content
  removeFile path
  putStrLn "done"
