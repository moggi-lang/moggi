module Main where

import Moggi.Internal.Base
import Text.Show

-- A lambda parameter may be a pattern. The compiler desugars `\p -> e` into
-- `\v -> case v of p -> e`, exactly as GHC does, so `\[] -> 0` is accepted and
-- means what it means in Haskell.
nil :: [Int] -> Int
nil = \[] -> 0

cons :: [Int] -> Int
cons = \(x : _) -> x

pair :: (Int, Int) -> Int
pair = \(x, y) -> x + y

nested :: [Maybe Int] -> Int
nested = \(Just x : _) -> x

main :: IO ()
main = do
  print (nil [])
  print (cons [7, 8])
  print (pair (3, 4))
  print (nested [Just 5, Nothing])
