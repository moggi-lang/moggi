program
  data Big
    constructor Big
      field s :: Int -> String
      field n :: Int
  function s :: Big -> Int -> String
    pat_var __record
    case
      variable __record
      alt
        pat_con Big
          pat_var __value
          pat_wild _
        variable __value
  function n :: Big -> Int
    pat_var __record
    case
      variable __record
      alt
        pat_con Big
          pat_wild _
          pat_var __value
        variable __value
  function useBig :: Big
    record_con Big
      s =
        evidence_method Show.show evidence= nullary=0
          instance Int
      n =
        integer 1
  function update :: Big -> Big
    pat_var b
    record_update
      receiver
        variable b
      s =
        evidence_method Show.show evidence= nullary=0
          instance Int
  function applied :: String
    apply
      field_access .s
        variable useBig
      integer 3
