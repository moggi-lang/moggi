-- Standalone deriving for a class with more than one parameter.
--
-- The derived head is the class applied to two arguments, so the deriving
-- framework takes its target data type from the head's first argument (`P`)
-- rather than from the whole `__InstanceHead` head, and the instance still
-- resolves as `Both P Bool` at the use site. Two derived instances of the same
-- class give each `both` an evidence name built from its argument list
-- (`__ev_Both_P_Bool_both` vs `__ev_Both_Q_Int_both`) instead of a hash.

data P = P
data Q = Q

class Both a b where
  both :: a -> b -> String
  both x y = "default"

deriving anyclass instance Both P Bool

deriving anyclass instance Both Q Int

test :: String
test = both P True

other :: String
other = both Q (1 :: Int)
