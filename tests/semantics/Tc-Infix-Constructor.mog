data Chain a = a :> [a]

infixr 5 :>

headNe :: Chain Int -> Int
headNe xs = case xs of
  x :> rest -> x

build :: Chain Int
build = 1 :> [2, 3]

fromOp :: Chain Int
fromOp = (:>) 4 [5]

-- Same fixity as list cons (`infixr 5`), so this is `1 :> (2 : [3])`.
nested :: Chain Int
nested = 1 :> 2 : [3]
