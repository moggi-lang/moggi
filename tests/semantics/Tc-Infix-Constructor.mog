data NonEmpty a = a :| [a]

infixr 5 :|

headNe :: NonEmpty Int -> Int
headNe xs = case xs of
  x :| rest -> x

build :: NonEmpty Int
build = 1 :| [2, 3]

fromOp :: NonEmpty Int
fromOp = (:|) 4 [5]

-- Same fixity as list cons (`infixr 5`), so this is `1 :| (2 : [3])`.
nested :: NonEmpty Int
nested = 1 :| 2 : [3]
