  function isEven :: Int -> Bool
    pat_var n
    case
      infix ==
        variable n
        integer 0
      alt
        pat_con True
        constructor_ref True
      alt
        pat_con False
        apply
          variable isOdd
          infix -
            variable n
            integer 1
  function isOdd :: Int -> Bool
    pat_var n
    case
      infix ==
        variable n
        integer 0
      alt
        pat_con True
        constructor_ref False
      alt
        pat_con False
        apply
          variable isEven
          infix -
            variable n
            integer 1
  function inGroup :: Int
    where
      apply
        apply
          variable outer
          evidence_ref Num Int
        integer 2
      binding
        pat_var outer
        lambda
          pat_var __ev_dict1
          lambda
            pat_var x
            apply
              apply
                evidence_method Num.+ evidence=__ev_dict1 nullary=0
                apply
                  apply
                    variable inner
                    variable __ev_dict1
                  variable x
              apply
                evidence_method Num.fromInteger evidence=__ev_dict1 nullary=0
                intrinsic intToInteger#
                  integer 1
      binding
        pat_var inner
        lambda
          pat_var __ev_dict0
          lambda
            pat_var y
