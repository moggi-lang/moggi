import Data.Eq
import Text.Show
import Data.JSON
import Data.Int
import Moggi.Generics

-- `anyclass` deriving in one module: an empty instance that falls back to the
-- class default, and JSON instances built from the stock Generic representation.

class MyConstraint a where
  myMethod :: a -> String
  myMethod _ = "default"

data Foo = Foo | Bar
  deriving (Eq, Show)
  deriving anyclass (MyConstraint)

data Person = Person { name :: String, age :: Int }
  deriving (Generic)
  deriving anyclass (ToJSON, FromJSON)

x :: Person
x = Person "ada" 36

y :: Value
y = toJSON x

z :: Person
z = case parseJSON y of
  Right p -> p
  Left err -> Person "x" 0
