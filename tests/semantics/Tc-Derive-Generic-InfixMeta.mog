import Moggi.Generics
import Data.Bool

-- Stock Generic MetaCons fixity: operator ctors use
-- 'InfixI '<Associativity> (default infixl 9 ⇒ 'LeftAssociative).
-- FixityI carries no precedence.

data (a :| b) = a :| b deriving (Generic)

infixr 5 :/

data (a :/ b) = a :/ b deriving (Generic)

id :: a -> a
id x = x

type SelInt = S1 (MetaSel Nothing 'NoSourceUnpackedness 'NoSourceStrictness 'DecidedLazy) (Rec0 Int)
type SelBool = S1 (MetaSel Nothing 'NoSourceUnpackedness 'NoSourceStrictness 'DecidedLazy) (Rec0 Bool)
type ProdIB = SelInt :*: SelBool
type ConsLeft = C1 (MetaCons ":|" ('InfixI 'LeftAssociative) 'False) ProdIB
type ConsRight = C1 (MetaCons ":/" ('InfixI 'RightAssociative) 'False) ProdIB
type LeftPipeRep x = D1 (MetaData ":|" "Main" "moggi" 'False) ConsLeft x
type RightPipeRep x = D1 (MetaData ":/" "Main" "moggi" 'False) ConsRight x

checkLeft :: Rep (Int :| Bool) x -> LeftPipeRep x
checkLeft = id

checkRight :: Rep (Int :/ Bool) x -> RightPipeRep x
checkRight = id
