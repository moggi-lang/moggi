-- A wide candidate set that specificity resolves.
--
-- Twelve `fN Unit` instances tie with each other, but `C (Box Unit)` subsumes
-- every one of them and is perfectly applicable, so the use site picks it.
module Main where

import Moggi.Internal.Base

data Box a = Box a

data Unit = Unit

class C a where
  c :: a -> String

class D a

instance C (f1 Unit) where
  c _ = "f1"

instance C (f2 Unit) where
  c _ = "f2"

instance C (f3 Unit) where
  c _ = "f3"

instance C (f4 Unit) where
  c _ = "f4"

instance C (f5 Unit) where
  c _ = "f5"

instance C (f6 Unit) where
  c _ = "f6"

instance C (f7 Unit) where
  c _ = "f7"

instance C (f8 Unit) where
  c _ = "f8"

instance C (f9 Unit) where
  c _ = "f9"

instance C (f10 Unit) where
  c _ = "f10"

instance C (f11 Unit) where
  c _ = "f11"

instance C (f12 Unit) where
  c _ = "f12"

instance C (Box Unit) where
  c _ = "box-unit"

main :: IO ()
main = putStrLn (c (Box Unit))
