program
  function count :: Int
    intrinsic intAdd#
      integer 1
      integer 1
  function asInt :: Int
    variable count
  function unpinned :: Int
    intrinsic intAdd#
      integer 1
      integer 1
  function pinned :: Int
    intrinsic intAdd#
      integer 1
      integer 1
  function pinnedInt :: Int
    variable pinned
  function pinnedAgain :: Int
    variable pinned
  function main :: Int
    intrinsic intAdd#
      intrinsic intAdd#
        variable asInt
        variable pinnedInt
      variable pinnedAgain
