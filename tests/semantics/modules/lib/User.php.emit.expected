<?php declare(strict_types=1);

namespace User;

const __MOGGI_MAP = [[12 => 0, 16 => 1], ['User\\getId' => 0, 'User\\makeUser' => 1], [], [], [[0, 0, 12, 11], [1, 0, 15, 15]], ['User.getId', 'User.makeUser'], ['lib/User.mog']];

function User($id) {
