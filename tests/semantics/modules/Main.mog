-- Module-system fixture: `main` here is a normal function name, not `main :: IO ()`.
-- Exercises imports, qualified names, `hiding`, and modules of the fixture's own
-- `lib/`, which is where a project's modules live.

module Main where

-- `hiding` on the standard library's `Prelude`: `+` still arrives through it
-- (from `instance Num Int` in `Data.Num`, whose `+` is the machine adder), and
-- the explicit import names the module the fixture leans on.
import Prelude hiding (max)
import Data.Int
import Data.Num
import User
import User qualified as U

main :: Int -> User -> Int
main n user = getId user + n

-- `import M qualified as Alias` binds only under Alias (not unqualified).
qualifiedMain :: U.User -> U.UserId
qualifiedMain u = U.getId u
