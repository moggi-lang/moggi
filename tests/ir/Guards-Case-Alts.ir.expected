module
  function positive(n)
      t1 = call __ev_Ord_Int()
      t0 = dict_call t1->>(n, 0)
      ret t0
  function twice(n)
      ret intrinsic intMul#(n, 2)
  function classify(n)
      t2 = match n
        let m = n
        t3 = call twice(m)
        t4 = call positive(t3)
        arm m when t4
            t2 = "positive-double"
        let m__0 = n
        arm m__0 when @otherwise
            t2 = "not-positive-double"
        arm _
            t2 = "unused"
      ret t2
