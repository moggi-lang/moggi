-- System.Filesystem.Path: the filepath 1.5.4.0 API on Posix. The printed
-- values pin the observable results and `check` runs the reference's own
-- documented examples (including the round-trip properties) as assertions.

import System.Filesystem.Path

check :: String -> Bool -> IO ()
check label ok = case ok of
  True -> putStrLn ("ok   " <> label)
  False -> putStrLn ("FAIL " <> label)

-- /directory/file.ext — the example path from the module documentation.
example :: FilePath
example = "/directory/file.ext"

main :: IO ()
main = do
  putStrLn ("isPathSeparator pathSeparator: " <> show (isPathSeparator pathSeparator))
  putStrLn ("isSearchPathSeparator : " <> show (isSearchPathSeparator searchPathSeparator))
  putStrLn ("isExtSeparator .: " <> show (isExtSeparator extSeparator))

  -- Extension functions.
  putStrLn ("splitExtension file.tar.gz: " <> show (splitExtension "file.tar.gz"))
  putStrLn ("takeExtension: " <> takeExtension example)
  putStrLn ("dropExtension: " <> dropExtension example)
  putStrLn ("replaceExtension: " <> replaceExtension "/directory/path.txt" "ext")
  putStrLn ("(-<.>): " <> ("/directory/path.txt" -<.> "ext"))
  putStrLn ("addExtension file.txt bib: " <> addExtension "file.txt" "bib")
  putStrLn ("addExtension file \".\": " <> ("file" <.> "bib"))
  putStrLn ("takeExtensions file.tar.gz: " <> takeExtensions "file.tar.gz")
  putStrLn ("dropExtensions file.tar.gz: " <> dropExtensions "file.tar.gz")
  putStrLn ("splitExtensions file.tar.gz: " <> show (splitExtensions "file.tar.gz"))

  -- Filename / directory functions.
  putStrLn ("splitFileName: " <> show (splitFileName example))
  putStrLn ("splitFileName bob: " <> show (splitFileName "bob"))
  putStrLn ("takeFileName: " <> takeFileName example)
  putStrLn ("takeBaseName: " <> takeBaseName example)
  putStrLn ("dropFileName: " <> dropFileName example)
  putStrLn ("replaceFileName: " <> replaceFileName "/directory/other.txt" "file.ext")
  putStrLn ("replaceBaseName: " <> replaceBaseName "/dave/fred/bob.gz.tar" "new")
  putStrLn ("takeDirectory: " <> takeDirectory example)
  putStrLn ("takeDirectory /foo/bar/baz/: " <> takeDirectory "/foo/bar/baz/")
  putStrLn ("replaceDirectory: " <> replaceDirectory "root/file.ext" "/directory/")
  putStrLn ("combine: " <> combine "/directory" "file.ext")
  putStrLn ("(</>) not combined: " <> ("home" </> "/bob"))
  putStrLn ("splitPath: " <> show (splitPath example))
  putStrLn ("splitDirectories: " <> show (splitDirectories "/test///file"))
  putStrLn ("joinPath: " <> joinPath ["/", "directory/", "file.ext"])

  -- Drive functions (on Posix a drive is a run of path separators).
  putStrLn ("splitDrive /test: " <> show (splitDrive "/test"))
  putStrLn ("splitDrive //test: " <> show (splitDrive "//test"))
  putStrLn ("splitDrive test/file: " <> show (splitDrive "test/file"))
  putStrLn ("takeDrive: " <> takeDrive "//test")
  putStrLn ("dropDrive: " <> dropDrive "//test")
  putStrLn ("joinDrive: " <> joinDrive "/" "foo")

  -- Trailing separators.
  putStrLn ("addTrailingPathSeparator: " <> addTrailingPathSeparator "test/rest")
  putStrLn ("dropTrailingPathSeparator: " <> dropTrailingPathSeparator "file/test/")
  putStrLn ("dropTrailingPathSeparator /: " <> dropTrailingPathSeparator "/")

  -- File name manipulations.
  putStrLn ("normalise /file/./test: " <> normalise "/file/./test")
  putStrLn ("normalise ./bob/fred/: " <> normalise "./bob/fred/")
  putStrLn ("normalise //home: " <> normalise "//home")
  putStrLn ("normalise /a/../c: " <> normalise "/a/../c")
  putStrLn ("normalise .: " <> normalise ".")
  putStrLn ("normalise ./: " <> normalise "./")
  putStrLn ("normalise bob/fred/.: " <> normalise "bob/fred/.")
  putStrLn ("makeRelative: " <> makeRelative "/home/" "/home/bob/foo/bar")
  putStrLn ("makeRelative x x: " <> makeRelative "/home/bob" "/home/bob")
  putStrLn ("makeRelative /fred bob: " <> makeRelative "/fred" "bob")
  putStrLn ("isValid empty: " <> show (isValid ""))
  putStrLn ("isValid /random_ path:*: " <> show (isValid "/random_ path:*"))
  putStrLn ("makeValid empty: " <> makeValid "")

  -- $PATH methods.
  putStrLn ("splitSearchPath: " <> show (splitSearchPath "File1:File2:File3"))
  putStrLn ("splitSearchPath empty item: " <> show (splitSearchPath "File1::File2:File3"))

  -- Reference properties, as assertions.
  check "takeExtension == snd (splitExtension x)" (takeExtension example == snd (splitExtension example))
  check "dropExtension == fst (splitExtension x)" (dropExtension example == fst (splitExtension example))
  check "uncurry (<>) (splitExtension x) == x" (fst (splitExtension example) <> snd (splitExtension example) == example)
  check "splitExtension file == (file, \"\")" (splitExtension "file" == ("file", ""))
  check "splitExtension file/path.txt/ has no extension" (splitExtension "file/path.txt/" == ("file/path.txt/", ""))
  check "splitExtension file/path.txt.bob.fred" (splitExtension "file/path.txt.bob.fred" == ("file/path.txt.bob", ".fred"))
  check "addExtension then takeExtension" (takeExtension (addExtension "/directory/path" "ext") == ".ext")
  check "replaceExtension then takeExtension" (takeExtension (replaceExtension "/directory/path.txt" "ext") == ".ext")
  check "addExtension x \"\" == x" (addExtension example "" == example)
  check "stripExtension hs.o foo.x.hs.o" (stripExtension "hs.o" "foo.x.hs.o" == Just "foo.x")
  check "stripExtension hi.o foo.x.hs.o == Nothing" (stripExtension "hi.o" "foo.x.hs.o" == Nothing)
  check "stripExtension empty is Just x" (stripExtension "" "file.txt" == Just "file.txt")
  check "stripExtension .c.d a.b..c.d" (stripExtension ".c.d" "a.b..c.d" == Just "a.b.")
  check "isExtensionOf png" ("png" `isExtensionOf` "/directory/file.png")
  check "not isExtensionOf ar.gz" (not ("ar.gz" `isExtensionOf` "bar/foo.tar.gz"))
  check "not isExtensionOf csv/table.csv" (not ("csv/table.csv" `isExtensionOf` "/data/csv/table.csv"))
  check "hasExtension" (hasExtension example)
  check "not hasExtension of path" (not (hasExtension "/directory/path"))
  check "takeFileName" (takeFileName example == "file.ext")
  check "joinPath (splitPath x) == x" (joinPath (splitPath example) == example)
  check "uncurry (</>) (splitFileName x) == x" (fst (splitFileName example) </> snd (splitFileName example) == example)
  check "replaceFileName then takeFileName" (takeFileName (replaceFileName example "fred") == "fred")
  check "(x </> fred) takeFileName" (takeFileName (example </> "fred") == "fred")
  check "takeFileName test/ == \"\"" (takeFileName "test/" == "")
  check "takeBaseName addTrailingPathSeparator == \"\"" (takeBaseName (addTrailingPathSeparator example) == "")
  check "replaceBaseName keeps extension" (replaceBaseName "/dave/fred/bob.gz.tar" "new" == "/dave/fred/new.tar")
  check "takeDirectory foo == ." (takeDirectory "foo" == ".")
  check "takeDirectory / == /" (takeDirectory "/" == "/")
  check "takeDirectory /foo == /" (takeDirectory "/foo" == "/")
  check "takeDirectory foo/bar/baz" (takeDirectory "foo/bar/baz" == "foo/bar")
  check "addTrailingPathSeparator idempotent" (addTrailingPathSeparator (addTrailingPathSeparator "test") == "test/")
  check "normalise / == /" (normalise "/" == "/")
  check "normalise /./ == /" (normalise "/./" == "/")
  check "normalise ../bob/fred/ unchanged" (normalise "../bob/fred/" == "../bob/fred/")
  check "normalise does not remove .." (normalise "/test/file/../bob/fred/" == "/test/file/../bob/fred/")
  check "equalFilePath foo foo/" (equalFilePath "foo" "foo/")
  check "not equalFilePath foo /foo" (not (equalFilePath "foo" "/foo"))
  check "not equalFilePath /a/../c /c" (not (equalFilePath "/a/../c" "/c"))
  check "isRelative test/path" (isRelative "test/path")
  check "not isRelative /test" (not (isRelative "/test"))
  check "isAbsolute == not isRelative" (isAbsolute "/test" == not (isRelative "/test"))
  check "makeRelative x x == ." (makeRelative "/a/b" "/a/b" == ".")
  check "makeRelative takeDirectory x" (makeRelative "/directory" example == "file.ext")
  check "makeRelative some/path" (makeRelative "some/path" "some/path/a/b/c" == "a/b/c")
  check "makeRelative different roots" (makeRelative "/Home" "/home/bob" == "/home/bob")
  check "makeRelative /file/test fred/" (makeRelative "/file/test" "/file/test/fred/" == "fred/")
  check "isValid makeValid always holds" (isValid (makeValid "file") && isValid (makeValid ""))
  check "makeValid x == x when valid" (makeValid example == example)
  check "hasDrive //test" (hasDrive "//test")
  check "not hasDrive test" (not (hasDrive "test"))
  check "isDrive /" (isDrive "/")
  check "not isDrive /foo" (not (isDrive "/foo"))
  check "splitDrive uncurry (<>) == x" (fst (splitDrive "//test") <> snd (splitDrive "//test") == "//test")
  check "dropTrailingPathSeparator keeps /" (dropTrailingPathSeparator "/" == "/")
  check "splitDirectories /test/file" (splitDirectories "/test/file" == ["/", "test", "file"])
  check "splitDirectories empty" (splitDirectories "" == [])
  check "splitPath keeps redundant separators" (splitPath "test//item/" == ["test//", "item/"])
  check "joinPath []" (joinPath [] == "")
  check "joinPath splitPath round trip" (joinPath (splitPath "test/item/file") == "test/item/file")
  check "splitSearchPath blank item becomes ." (splitSearchPath "File1::File2:File3" == ["File1", ".", "File2", "File3"])
  check "pathSeparator isPathSeparator" (isPathSeparator pathSeparator)
  check "isSearchPathSeparator" (isSearchPathSeparator searchPathSeparator && not (isSearchPathSeparator pathSeparator))
  check "isExtSeparator" (isExtSeparator extSeparator && not (isExtSeparator pathSeparator))
