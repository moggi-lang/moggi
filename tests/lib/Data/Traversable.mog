-- Data.Traversable: the traversals plus the mapAccum family, which base exports
-- from this module — `import Data.List` only re-exports `mapAccumL`/`mapAccumR`,
-- so importing both must stay clash-free.
import Data.List
import Data.Traversable

main :: IO ()
main = do
  putStrLn (show (mapAccumL (\a b -> (a + b, a)) 0 [1 .. 10]))
  putStrLn (show (mapAccumR (\a b -> (a + b, a)) 0 [1 .. 10]))
  putStrLn (show (mapAccumL (\a b -> (a <> show b, a)) "0" [1 .. 5]))
  putStrLn (show (mapAccumR (\a b -> (a <> show b, a)) "0" [1 .. 5]))
  putStrLn (show (mapAccumL (\a b -> (a + b, a)) 0 (Just 5)))
  putStrLn (show (mapAccumR (\a b -> (a + b, a)) 0 (Just 5)))
  putStrLn (show (mapAccumL (\a b -> (a + b, a)) 0 (Nothing :: Maybe Int)))
  putStrLn (show (mapAccumL (\a b -> (a + b, a)) 0 (Right 5 :: Either String Int)))
  putStrLn (show (mapAccumR (\a b -> (a + b, a)) 0 (Right 5 :: Either String Int)))
  putStrLn (show (traverse (\x -> Just (x + 1)) [1, 2, 3]))
  putStrLn (show (traverse (\x -> Just (x + 1)) (Nothing :: Maybe Int)))
  putStrLn (show (sequenceA [Just 1, Just 2]))
  putStrLn (show (sequenceA [Just 1, Nothing :: Maybe Int]))
  putStrLn (show (mapM (\x -> Just (x * 2)) (Just 3)))
  putStrLn (show (sequence (Just (Just 3))))
  putStrLn (show (for [1, 2] (\x -> Just x)))
  putStrLn (show (forM (Just 2) (\x -> Just (x + 1))))
  putStrLn (show (fmapDefault (+ 1) (Just 1)))
  putStrLn (show (foldMapDefault (\x -> [x]) (Just 1)))
  putStrLn (show (traverse (\x -> Just (x + 1)) (Pair 1 2)))
  putStrLn (show (mapM (\x -> Just (x * 2)) (Pair 1 2)))
  putStrLn (show (sequence (Pair (Just 1) (Just 2))))
  putStrLn (show (forM (Pair 1 2) (\x -> Just (x + 1))))
  putStrLn (show (mapAccumL (\a b -> (a + b, a)) 0 (Pair 1 2)))
  putStrLn (show (mapAccumR (\a b -> (a + b, a)) 0 (Pair 1 2)))

-- Writes only `sequenceA`: the MINIMAL pragma accepts that alternative and the
-- `traverse` / `mapM` / `sequence` defaults are filled in by the class.
data Pair a = Pair a a

instance Functor Pair where
  map f p = case p of
    Pair x y -> Pair (f x) (f y)

instance Foldable Pair where
  foldr f z p = case p of
    Pair x y -> f x (f y z)

instance Traversable Pair where
  sequenceA p = case p of
    Pair fx fy -> pure Pair <*> fx <*> fy

instance Show a => Show (Pair a) where
  show p = case p of
    Pair x y -> "Pair " <> show x <> " " <> show y
