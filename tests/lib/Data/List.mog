-- Data.List: append and its Semigroup, the indexing / 4-to-7-tuple zipping half
-- of base's API, the Foldable re-exports, and the `generic*` family. Strings are
-- not lists in Moggi (`String` is host-native), so `<>` is the string append
-- while `++` covers `[a]`.
import Moggi.Internal.Real
import Data.List

main :: IO ()
main = do
  putStrLn (show ([1, 2] ++ [3]))
  putStrLn (show ([] ++ [] :: [Int]))
  putStrLn (show ([1] ++ ([] :: [Int]) ++ [2]))
  putStrLn (show ([[1]] ++ [[2], [3]]))
  putStrLn ("ab" <> "cd")
  putStrLn (show ([1, 2] <> [3, 4]))
  putStrLn (show (foldl (\acc x -> acc ++ [x]) [] [1, 2, 3]))
  putStrLn (show (zip4 [1, 2] [3] [4, 5] [6, 7]))
  putStrLn (show (zip5 [1] [2] [3] [4] [5]))
  putStrLn (show (zip6 [1] [2] [3] [4] [5] [6]))
  putStrLn (show (zip7 [1] [2] [3] [4] [5] [6] [7]))
  putStrLn (show (zipWith4 (\a b c d -> a + b + c + d) [1] [2] [3] [4]))
  putStrLn (show (zipWith7 (\a b c d e f g -> a + g) [1] [2] [3] [4] [5] [6] [7]))
  putStrLn (show (unzip4 [(1, 2, 3, 4), (5, 6, 7, 8)]))
  putStrLn (show (unzip5 [(1, 2, 3, 4, 5)]))
  putStrLn (show (unzip6 [(1, 2, 3, 4, 5, 6)]))
  putStrLn (show (unzip7 [(1, 2, 3, 4, 5, 6, 7)]))
  putStrLn (show ([1, 2, 3, 4] \\ [2, 4]))
  putStrLn (show ([1, 2] \\ []))
  putStrLn (show ([1, 2, 3] !? 1))
  putStrLn (show ([1, 2, 3] !? 9))
  putStrLn (show ([1, 2, 3] !? (-1)))
  putStrLn (show (compareLength [1, 2] 2, compareLength [1, 2] 1, compareLength [1, 2] 5))
  putStrLn (show (null ([] :: [Int]), null [1]))
  putStrLn (show (length [1, 2, 3]))
  putStrLn (show (map (\x -> x * 2) [1, 2]))
  putStrLn (show (foldl (\a b -> a - b) 0 [1, 2, 3]))
  putStrLn (show (foldr (:) [] [1, 2]))
  putStrLn (show (foldl1 (\a b -> a + b) [1, 2, 3]))
  putStrLn (show (foldr1 (\a b -> a + b) [1, 2, 3]))
  putStrLn (show (concat [[1], [2, 3]]))
  putStrLn (show (concatMap (\x -> [x, x]) [1, 2]))
  putStrLn (show (and [True, False], or [False, True]))
  putStrLn (show (any (\x -> x > 2) [1, 2, 3], all (\x -> x > 0) [1, 2, 3]))
  putStrLn (show (sum [1, 2, 3], product [1, 2, 3]))
  putStrLn (show (maximum [1, 3, 2], minimum [1, 3, 2]))
  putStrLn (show (elem 2 [1, 2, 3], notElem 9 [1, 2, 3]))
  putStrLn (show (maximumBy (\a b -> compare a b) [1, 3, 2], minimumBy (\a b -> compare a b) [1, 3, 2]))
  putStrLn (show (genericLength [1, 2, 3] :: Int))
  putStrLn (show (genericLength [1, 2, 3] :: Integer))
  putStrLn (show (genericTake 2 [1, 2, 3, 4]))
  putStrLn (show (genericTake 0 [1, 2, 3]))
  putStrLn (show (genericTake (-1) [1, 2, 3]))
  putStrLn (show (genericDrop 2 [1, 2, 3, 4]))
  putStrLn (show (genericDrop (-1) [1, 2, 3]))
  putStrLn (show (genericDrop 9 [1, 2]))
  putStrLn (show (genericSplitAt 2 [1, 2, 3, 4]))
  putStrLn (show (genericIndex [10, 20, 30] 1))
  putStrLn (show (genericReplicate 3 (7 :: Int)))
  putStrLn (show (genericReplicate 0 (7 :: Int)))
  putStrLn (show (genericReplicate (3 :: Integer) (7 :: Int)))
  putStrLn (show (genericTake (fromIntegral (2 :: Int) :: Integer) [1, 2, 3, 4]))
  putStrLn (show (genericIndex [10, 20, 30] (fromIntegral (2 :: Int) :: Integer)))
