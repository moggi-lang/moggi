import Data.List (sortBy)
import Data.List.NonEmpty (NonEmpty((:|)), sconcat)
import Data.Maybe
import Data.Monoid (Alt(Alt), getAlt)
import Data.Ord (Down(Down), comparing, getDown)
import Data.Semigroup ((<>))
import Data.Eq
import Text.Show

-- Down reverses only the ordering; Alt is the Alternative monoid; sconcat
-- folds a NonEmpty to the right with (<>).

main :: IO ()
main = do
  putStrLn (show (compare (Down 1) (Down 2)))
  putStrLn (show (compare (Down 2) (Down 1)))
  putStrLn (show (getDown (Down 5)))
  putStrLn (show (map getDown (sortBy (comparing getDown) (map Down ([1, 3, 2] :: [Int])))))
  putStrLn (show (getAlt ((Alt (Just 1)) <> (Alt (Just 2)))))
  putStrLn (show (getAlt ((Alt (Nothing :: Maybe Int)) <> (Alt (Just 2)))))
  putStrLn (show (sconcat (([1, 2] :| [[3], [4, 5]]) :: NonEmpty [Int])))
