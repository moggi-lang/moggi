module
  function add4(a, b, c, d)
      t0 = a intAdd# b
      t1 = t0 intAdd# c
      t2 = t1 intAdd# d
      t3 = t2 intAdd# 1
      ret t3
  function chain(n)
      t3 = call_value partial add4(1, 2, 3)(n)
      ret t3
  function exact()
      t0 = call add4(10, 20, 30, 40)
      ret t0
  function over(n)
      t0 = call_value @add4(1, 2, 3, 4, n)
      ret t0
  function unknown(f, n)
      t0 = call_value f(n)
      ret t0
