-- A literal base and a literal exponent is the shape specialization must
-- terminate on: burning the constants turns the clone's `x * x` into a
-- dictionary call that is not a compile-time constant, so it must not be
-- offered to another clone.

caf :: Int
caf = 2 ^ 10

big :: Integer
big = 2 ^ 100

-- A runtime exponent has nothing to burn and must still work.
run :: Int -> Int -> Int
run x n = x ^ n

main :: IO ()
main = do
  putStrLn (show caf)
  putStrLn (show big)
  putStrLn (show (run 3 12))
