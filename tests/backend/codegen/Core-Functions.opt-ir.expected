module
  function add(x, y)
      ret intrinsic intAdd#(x, y)
  function inc(_p1)
      ret call add(1, _p1)
  function useInc(x)
      ret call add(1, x)
  function sum2()
      ret 3
  function viaLet()
      ret call add(1, 2)
  function id(x)
      ret x
  function ho()
      ret call add(1, 2)
  function apply(f, x)
      ret call_value f(x)
  function useAdd(x)
      ret call apply(partial add(1), x)
  function passPartial(g)
      ret call_value g(5)
  function +(x, y)
      ret intrinsic intAdd#(x, y)
  function plus10(_p1)
      ret call +(10, _p1)
  function triple(a, b, c)
      ret intrinsic intAdd#(intrinsic intAdd#(a, b), c)
  function step1(_p1, _p2)
      ret call triple(1, _p1, _p2)
  function step2(_p1)
      ret call triple(1, 2, _p1)
  function step3()
      ret 6
  function justHi()
      ret call Just("hi")
  function always(x, _p1)
      ret x
  function polyPartial(_p1)
      ret call always(42, _p1)
  function incLambda(x)
      ret partial λ0(x)
  function typedParam()
      ret @λ1
  function twoParams()
      ret @λ2
  function ascribedLambda()
      ret @λ3
  function bodyAsc()
      ret @λ4
  function λ0(y)
      ret intrinsic intAdd#(x, y)
  function λ1(x)
      ret intrinsic intAdd#(x, 1)
  function λ2(x, y)
      ret intrinsic intAdd#(x, y)
  function λ3(x)
      ret intrinsic intAdd#(x, 1)
  function λ4(x)
      ret intrinsic intAdd#(x, 1)
