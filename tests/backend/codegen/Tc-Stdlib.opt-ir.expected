module
  function clampDemo()
      t0 = call __tuple2(0, 10)
      t1 = call clamp(@__ev_Eq_Int, @__ev_Ord_Int, t0, 99)
      ret t1
  function charDemo()
      t2 = call isDigit('\u{37}')
      ret t2
  function altMaybeDemo()
      t3 = call Just(1)
      t4 = call Just(2)
      t6 = call __ev_Alternative_Maybe()
      t5 = dict_call t6-><|>(t3, t4)
      ret t5
  function altListDemo()
      t8 = call __ev_Alternative_List()
      t7 = dict_call t8-><|>([1], [2, 3])
      ret t7
  function pairDemo()
      t9 = call __tuple2(41, @True)
      t10 = call fst(t9)
      ret t10
