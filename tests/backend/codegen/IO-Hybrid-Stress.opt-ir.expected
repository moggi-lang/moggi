module
  function logMsg(msg)
      io_call putStrLn(msg)
      ret ()
  function emitA()
      io_call putStrLn("A")
      ret ()
  function emitB()
      io_call putStrLn("B")
      ret ()
  function equalBranch()
      io_call putStrLn("equal")
      t0 = io_call readTextFile(call packFilePath("input.txt"))
      io_call putStrLn(t0)
      ret ()
  function notEqualBranch(y)
      io_call putStrLn("not equal")
      t2 = io_call readTextFile(call packFilePath(y))
      io_call putStrLn(t2)
      ret ()
  function branchOn(x, y)
      io_match intrinsic stringEq#(x, y)
        arm True
            io_call equalBranch()
            ret ()
        arm False
            io_call notEqualBranch(y)
            ret ()
  function main()
      t4 = io_call readTextFile(call packFilePath("input.txt"))
      t6 = io_call readTextFile(call packFilePath(t4))
      io_call logMsg("start processing")
      io_call branchOn(t4, t6)
      io_call emitA()
      io_call emitB()
      ret ()
