module IO.Hybrid.Stress

import System.IO

logMsg :: String -> IO ()
logMsg msg = putStrLn msg

emitA :: IO ()
emitA = putStrLn "A"

emitB :: IO ()
emitB = putStrLn "B"

equalBranch :: IO ()
equalBranch = do
  putStrLn "equal"
  z <- readFile "input.txt"
  putStrLn z

notEqualBranch :: String -> IO ()
notEqualBranch y = do
  putStrLn "not equal"
  w <- readFile y
  putStrLn w

branchOn :: String -> String -> IO ()
branchOn x y = case x == y of
  True -> equalBranch
  False -> notEqualBranch y

main :: IO ()
main = do
  x <- readFile "input.txt"
  y <- readFile x

  logMsg "start processing"

  branchOn x y

  emitA
  emitB
