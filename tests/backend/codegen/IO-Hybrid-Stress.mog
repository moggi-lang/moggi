module IO.Hybrid.Stress

import System.IO
import System.Filesystem hiding (readFile, writeFile, appendFile)
import System.Filesystem.Path
import System.IO.Base (packFilePath)

logMsg :: String -> IO ()
logMsg msg = putStrLn msg

emitA :: IO ()
emitA = putStrLn "A"

emitB :: IO ()
emitB = putStrLn "B"

equalBranch :: IO ()
equalBranch = do
  putStrLn "equal"
  z <- readTextFile (packFilePath "input.txt")
  putStrLn z

notEqualBranch :: String -> IO ()
notEqualBranch y = do
  putStrLn "not equal"
  w <- readTextFile (packFilePath y)
  putStrLn w

branchOn :: String -> String -> IO ()
branchOn x y = case x == y of
  True -> equalBranch
  False -> notEqualBranch y

main :: IO ()
main = do
  x <- readTextFile (packFilePath "input.txt")
  y <- readTextFile (packFilePath x)

  logMsg "start processing"

  branchOn x y

  emitA
  emitB
