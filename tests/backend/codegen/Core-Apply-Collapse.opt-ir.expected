module
  function add2(a, b)
      ret intrinsic intAdd#(a, b)
  function add3(a, b, c)
      ret intrinsic intAdd#(intrinsic intAdd#(a, b), c)
  function apply2(f, x, y)
      t0 = call_value f(x)
      t1 = call_value t0(y)
      ret t1
  function apply3(f, x, y, z)
      t2 = call_value f(x)
      t3 = call_value t2(y)
      t4 = call_value t3(z)
      ret t4
  function direct2()
      ret 9
  function direct3()
      ret 15
  function loop2(n, acc)
      loop
          match_return n
            arm 0
                ret acc
            arm _
                t10 = call add2(1, n)
                tail_recall(intrinsic intSub#(n, 1), intrinsic intAdd#(acc, t10))
  function loop3(n, acc)
      loop
          match_return n
            arm 0
                ret acc
            arm _
                t14 = call add3(1, 2, n)
                tail_recall(intrinsic intSub#(n, 1), intrinsic intAdd#(acc, t14))
