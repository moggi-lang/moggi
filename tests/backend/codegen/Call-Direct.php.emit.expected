<?php declare(strict_types=1);

namespace StructureCallDirect;

const __MOGGI_MAP = [[21 => ['StructureCallDirect.pairUp', 'tests/backend/codegen/Call-Direct.mog', 10, 12]], ['StructureCallDirect\\addOne' => ['StructureCallDirect.addOne', 'tests/backend/codegen/Call-Direct.mog', 4, 12], 'StructureCallDirect\\twice' => ['StructureCallDirect.twice', 'tests/backend/codegen/Call-Direct.mog', 7, 11], 'StructureCallDirect\\pairUp' => ['StructureCallDirect.pairUp', 'tests/backend/codegen/Call-Direct.mog', 10, 12]]];

function moggi_u64_add(int $a, int $b): int { $ao = $a & 0xffffffff; $ah = ($a >> 32) & 0xffffffff; $bo = $b & 0xffffffff; $bh = ($b >> 32) & 0xffffffff; $lo = $ao + $bo; $c = ($lo >> 32) & 0xffffffff; $hi = ($ah + $bh + $c) & 0xffffffff; return ($hi << 32) | ($lo & 0xffffffff); }
function moggi_u64_sub(int $a, int $b): int { $ao = $a & 0xffffffff; $ah = ($a >> 32) & 0xffffffff; $bo = $b & 0xffffffff; $bh = ($b >> 32) & 0xffffffff; $lo = $ao - $bo; $bw = $lo < 0 ? 1 : 0; $hi = ($ah - $bh - $bw) & 0xffffffff; return ($hi << 32) | ($lo & 0xffffffff); }
function moggi_u64_mul(int $a, int $b): int { $a0 = $a & 0xffff; $a1 = ($a >> 16) & 0xffff; $a2 = ($a >> 32) & 0xffff; $a3 = ($a >> 48) & 0xffff; $b0 = $b & 0xffff; $b1 = ($b >> 16) & 0xffff; $b2 = ($b >> 32) & 0xffff; $b3 = ($b >> 48) & 0xffff; $low = $a0 * $b0; $cy = ($low >> 16) & 0xffff; $m1 = $a0 * $b1 + $a1 * $b0 + $cy; $cy = ($m1 >> 16) & 0xffffffff; $m2 = $a0 * $b2 + $a1 * $b1 + $a2 * $b0 + $cy; $cy = ($m2 >> 16) & 0xffffffff; $hi = $a0 * $b3 + $a1 * $b2 + $a2 * $b1 + $a3 * $b0 + $cy; return (($hi & 0xffff) << 48) | (($m2 & 0xffff) << 32) | (($m1 & 0xffff) << 16) | ($low & 0xffff); }
function moggi_i64_add(int $a, int $b): int { $r = $a + $b; return \is_int($r) ? $r : moggi_u64_add($a, $b); }

function addOne($n) {
    return (\is_int($__m64 = $n + 1) ? $__m64 : moggi_u64_add($n, 1));
}

function twice($n) {
    return moggi_i64_add((\is_int($__m64 = $n + 1) ? $__m64 : moggi_u64_add($n, 1)), 1);
}

function pairUp($n) {
    return [$n, moggi_i64_add((\is_int($__m64 = $n + 1) ? $__m64 : moggi_u64_add($n, 1)), 1)];
}
