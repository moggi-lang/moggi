module
  function positive(n)
      t1 = call __ev_Ord_Int()
      t0 = dict_call t1->>(n, 0)
      ret t0
  function twice(n)
      ret intrinsic intMul#(n, 2)
  function firstSign(_p0)
      match_return _p0
        t4 = call __ev_Ord_Int()
        t3 = dict_call t4-><(x, 0)
        arm x : _ when t3
            ret "neg-first"
        arm x__0 : _ when intrinsic intEq#(x__0, 0)
            ret "zero-first"
        arm _ : _
            ret "other-list"
        arm []
            ret "empty"
  function classify(n)
      match_return n
        let m = n
        t6 = call twice(m)
        t7 = call positive(t6)
        arm m when t7
            ret "positive-double"
        let m__0 = n
        arm m__0 when @otherwise
            ret "not-positive-double"
        arm _
            ret "other"
