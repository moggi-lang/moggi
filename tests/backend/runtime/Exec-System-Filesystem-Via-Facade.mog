import System.Environment (lookupEnv)
import System.Filesystem hiding (readFile, writeFile, appendFile)
import System.Filesystem.Path
import System.IO
import System.IO.Base (packFilePath)

main :: IO ()
main = do
  path <- scratchPath "moggi-fs-facade-test.txt"
  _ <- writeTextFile path "facade-ok"
  content <- readTextFile path
  putStrLn content

scratchPath :: String -> IO FilePath
scratchPath name = do
  tmp <- lookupEnv "TMPDIR"
  win <- lookupEnv "TEMP"
  let dir = case tmp of
        Just d -> d
        Nothing -> case win of
          Just d -> d
          Nothing -> "/tmp"
  pure (packFilePath (dir <> "/" <> name))
