require_once __DIR__ . '/../../../lib/Data/Bool.php';
require_once __DIR__ . '/../../../lib/Moggi/Err.php';
require_once __DIR__ . '/../../../lib/System/IO/PHP.php';

use function Moggi\Err\error;
use function System\IO\PHP\putStrLn;

function emitWhen($b) {
    if ($b === true) {
        putStrLn("y");
        return null;
    }
    elseif ($b === false) {
        putStrLn("n");
        return null;
    }
}

function pick($b) {
    if ($b === true) {
        putStrLn("yes");
        return null;
    }
    elseif ($b === false) {
        putStrLn("no");
        return null;
    }
}

function pickOrError($b) {
    if ($b === true) {
        putStrLn("yes");
        return null;
    }
    elseif ($b === false) {
        error("no");
        return null;
    }
}

function main() {
    putStrLn("linear");
    emitWhen(true);
    putStrLn("deferred");
    putStrLn("before");
    pick(true);
    putStrLn("error-branch");
    pickOrError(true);
    return null;
}
