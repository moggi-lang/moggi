module Tc.IO.WholeFile

import System.IO

bindPath :: FilePath
bindPath = "/tmp/moggi-tc-io-whole-bind.txt"

letPath :: FilePath
letPath = "/tmp/moggi-tc-io-whole-let.txt"

main :: IO ()
main = do
  putStrLn "bind"
  writeFile (bindPath) "bind-linear"
  readFile (bindPath) >>= putStrLn
  putStrLn "let"
  let x = readFile (letPath)
  y <- x
  putStrLn y
