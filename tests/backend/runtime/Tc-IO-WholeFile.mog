module Tc.IO.FilesystemLinear

import System.IO
import System.Filesystem hiding (readFile, writeFile, appendFile)
import System.Filesystem.Path
import System.IO.Base (packFilePath)

bindPath :: FilePath
bindPath = packFilePath "/tmp/moggi-tc-io-fs-linear-bind.txt"

letPath :: FilePath
letPath = packFilePath "/tmp/moggi-tc-io-fs-linear-let.txt"

main :: IO ()
main = do
  putStrLn "bind"
  writeTextFile (bindPath) "bind-linear"
  readTextFile (bindPath) >>= putStrLn
  putStrLn "let"
  let x = readTextFile (letPath)
  y <- x
  putStrLn y
