import Text.Show
import System.IO

-- Standalone deriving of a multi-parameter class, dispatched at run time.
--
-- `Both` has two parameters, so each derived instance head is the class applied
-- to two arguments and the deriving framework reads the target data type from
-- the head's first argument. The default method is what both instances run.

data P = P
data Q = Q

class Both a b where
  both :: a -> b -> String
  both x y = "default"

deriving anyclass instance Both P Bool

deriving anyclass instance Both Q Int

main :: IO ()
main = do
  putStrLn (both P True)
  putStrLn (both Q (1 :: Int))
