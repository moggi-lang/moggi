module
  function runTwice(act)
      t1 = io_assign_action
        result call __w_runTwice(act)
      ret t1
  function __w_runTwice(act)
      io_run act
      io_run act
      ret ()
  function main()
      t6 = io_assign_action
        result call __w_main()
      ret t6
  function __w_main()
