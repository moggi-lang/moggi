import Text.Show
import System.IO

-- Multi-parameter classes: instance selection, superclass expansion and the two
-- standalone deriving forms. Each sub-case needs its own class names (they all
-- spell a two-parameter class `Both` or `Pairish` in isolation), so the module
-- declares one family per sub-case and keeps the outputs in the order the
-- separate cases used to run.

-- ---- Exec-Multi-Param-Instance ----

-- A multi-parameter class, its instance head carried as `__InstanceHead a b`.
--
-- `Pairish` has two parameters and a `Tag a` superclass, and two instances that
-- differ only in the second argument. Resolving `Pairish Int a` before `a` is
-- known would pick whichever instance came first, so the obligation waits until
-- the second argument is concrete. `generic` selects through the instance at a
-- concrete call and forwards the superclass dictionary from it.

class Tag a where
  tag :: a -> String

class Tag a => Pairish a b where
  describe :: a -> b -> String

instance Pairish Int Int where
  describe x y = "ii:" <> tag x

instance Pairish Int Bool where
  describe x y = "ib:" <> tag x

instance Tag Int where
  tag x = "int"

generic :: Pairish a b => a -> b -> String
generic x y = describe x y

runMultiParamInstance :: IO ()
runMultiParamInstance = do
  putStrLn (describe (1 :: Int) (2 :: Int))
  putStrLn (describe (1 :: Int) True)
  putStrLn (generic (1 :: Int) (2 :: Int))
  putStrLn (generic (1 :: Int) True)

-- ---- Exec-Multi-Param-Superclass ----

-- A multi-parameter class whose two superclasses are the same class applied to
-- different arguments (`TagB a` and `TagB b`).
--
-- Expanding `BothB Int Bool` yields `TagB Int`, `TagB Bool`, `BothB Int Bool`.
-- When `both` is projected out of the `BothB Int Bool` dictionary those three
-- form the owning group and must not be passed as arguments, which the old
-- head-equality test could not see once the two `TagB` heads differed. The
-- method body resolves `tagB x`/`tagB y` through the `TagB Int`/`TagB Bool`
-- instances directly.

class TagB a where
  tagB :: a -> String

class (TagB a, TagB b) => BothB a b where
  bothB :: a -> b -> String

instance TagB Int where
  tagB x = "int"

instance TagB Bool where
  tagB x = "bool"

instance BothB Int Bool where
  bothB x y = tagB x <> "+" <> tagB y

runMultiParamSuperclass :: IO ()
runMultiParamSuperclass = putStrLn (bothB (1 :: Int) True)

-- ---- Exec-Derive-Multi-Param ----

-- Standalone deriving of a multi-parameter class, dispatched at run time.
--
-- `BothD` has two parameters, so each derived instance head is the class applied
-- to two arguments and the deriving framework reads the target data type from
-- the head's first argument. The default method is what both instances run.

data DP = DP
data DQ = DQ

class BothD a b where
  bothD :: a -> b -> String
  bothD x y = "default"

deriving anyclass instance BothD DP Bool

deriving anyclass instance BothD DQ Int

runDeriveMultiParam :: IO ()
runDeriveMultiParam = do
  putStrLn (bothD DP True)
  putStrLn (bothD DQ (1 :: Int))

-- ---- Exec-Derive-Multi-Param-Via ----

-- Standalone `deriving via` of a multi-parameter class, dispatched at run time.
--
-- `BothV` has two parameters, so the derived head is the class applied to two
-- arguments. The via type replaces the first argument (`VP` becomes `VW`) and
-- the rest are carried verbatim, giving the context `BothV VW Bool`. Calling
-- `bothV` at `VP Bool` unwraps `VP` into `VW` and runs the `BothV VW Bool`
-- instance.

data VP = VP
newtype VW = VW VP

class BothV a b where
  bothV :: a -> b -> String
  bothV x y = "default"

instance BothV VW Bool where
  bothV (VW VP) True = "wt"
  bothV (VW VP) False = "wf"

deriving via (VW) instance BothV VP Bool

runDeriveMultiParamVia :: IO ()
runDeriveMultiParamVia = do
  putStrLn (bothV VP True)
  putStrLn (bothV VP False)

main :: IO ()
main = do
  runMultiParamInstance
  runMultiParamSuperclass
  runDeriveMultiParam
  runDeriveMultiParamVia
