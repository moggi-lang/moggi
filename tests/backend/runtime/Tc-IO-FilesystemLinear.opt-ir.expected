module
  function bindPath()
      ret call packFilePath("\/tmp\/moggi-tc-io-fs-linear-bind.txt")
  function letPath()
      ret call packFilePath("\/tmp\/moggi-tc-io-fs-linear-let.txt")
  function main()
      io_call putStrLn("bind")
      io_call writeTextFile(@bindPath, "bind-linear")
      t2 = io_call readTextFile(@bindPath)
      io_call putStrLn(t2)
      io_call putStrLn("let")
      t3 = io_call readTextFile(@letPath)
      io_call putStrLn(t3)
      ret ()
