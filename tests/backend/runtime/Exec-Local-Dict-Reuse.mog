import Data.Ord
import Text.Show

-- The runtime half of Tc-Local-Dict-Reuse: the dictionaries the inferred,
-- probed local `cmp` takes are the ones each use site passes, so the compiled
-- program resolves every one of them on every backend.

g :: (Bool, Bool)
g = f

f = (cmp 3, cmp 1)
  where
    cmp x = x > 0

main :: IO ()
main = putStrLn (show g)
