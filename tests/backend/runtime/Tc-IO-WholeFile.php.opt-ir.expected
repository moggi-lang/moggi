module
  function bindPath()
      ret "\/tmp\/moggi-tc-io-whole-bind.txt"
  function letPath()
      ret "\/tmp\/moggi-tc-io-whole-let.txt"
  function main()
      t8 = io_assign_action
        result call __w_main()
      ret t8
  function __w_main()
      t0 = call System.IO.PHP::__w_putStrLn("bind")
      t1 = call System.IO::__w_writeFile(@bindPath, "bind-linear")
      t2 = call System.IO::__w_readFile(@bindPath)
      t3 = call System.IO.PHP::__w_putStrLn(t2)
      t4 = call System.IO.PHP::__w_putStrLn("let")
      t5 = call System.IO::__w_readFile(@letPath)
      t6 = call System.IO.PHP::__w_putStrLn(t5)
      ret ()
