module Main where

import Moggi.Internal.Base

data Expr a where
  Lit :: Int -> Expr Int
  Truth :: Expr Bool
  Pair :: Expr a -> Expr b -> Expr (a, b)

depth :: Expr a -> Int
depth e = go e
  where
    go :: Expr b -> Int
    go (Lit _) = 1
    go Truth = 1
    go (Pair x y) = go x + go y

main :: IO ()
main = do
  putStrLn (show (depth (Lit 1)))
  putStrLn (show (depth (Pair (Lit 1) (Pair Truth Truth))))
