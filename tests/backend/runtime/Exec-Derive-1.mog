import Data.Eq
import Moggi.Internal.Num
import Data.Ord
import Text.Show
import System.IO

-- ---- Exec-Derive-Eq ----

data Color = Red | Blue | Green deriving (Eq)

data Foo a = Bar a Int | Baz deriving (Eq)

runDeriveEq :: IO ()
runDeriveEq = do
  putStrLn (show (Red == Red))
  putStrLn (show (Red == Blue))
  putStrLn (show (Bar 1 2 == Bar 1 2))
  putStrLn (show (Bar 1 2 == Bar 1 3))
  putStrLn (show (Bar True 9 == Bar True 9))
  putStrLn (show (Baz == Baz))
  putStrLn (show (Bar 1 2 == Baz))

-- ---- Exec-Derive-Newtype ----

newtype Age = Age Int
  deriving (Eq, Ord, Show)
  deriving newtype (Num)

runDeriveNewtype :: IO ()
runDeriveNewtype = do
  putStrLn (show (Age 3 == Age 3))
  putStrLn (show (compare (Age 1) (Age 2)))
  putStrLn (show (Age 2 + Age 3))
  putStrLn (show (Age 10 - Age 4))
  putStrLn (show (Age 2 * Age 4))

-- ---- Exec-Derive-Via ----

class MyEq a where
  (===) :: a -> a -> Bool
  (/==) :: a -> a -> Bool

instance MyEq Int where
  (===) x y = x == y
  (/==) x y = x /= y

-- The via type deliberately disagrees with Int's instance, so a `False` result
-- proves the derived instance dispatches through `MyEq MySum`.
newtype MySum = MySum Int

instance MyEq MySum where
  (===) _ _ = False
  (/==) _ _ = True

newtype MyInt = MyInt Int
  deriving via (MySum) MyEq

-- The target wraps another newtype, so `via (Int)` must unwrap both layers.
newtype Inner = Inner Int

newtype Outer = Outer Inner
  deriving via (Int) MyEq

-- A nullary method exercises the via-result coercion back to the target type.
class Default a where
  def :: a

instance Default MySum where
  def = MySum 7

newtype Wrapped = Wrapped Int

deriving via (MySum) instance Default Wrapped

unwrap :: Wrapped -> Int
unwrap (Wrapped n) = n

runDeriveVia :: IO ()
runDeriveVia = do
  putStrLn (show (MyInt 1 === MyInt 1))
  putStrLn (show (MyInt 1 /== MyInt 2))
  putStrLn (show (Outer (Inner 3) === Outer (Inner 3)))
  putStrLn (show (Outer (Inner 3) === Outer (Inner 4)))
  putStrLn (show (unwrap def))

-- ---- combined entry point ----
main :: IO ()
main = do
  runDeriveEq
  runDeriveNewtype
  runDeriveVia
