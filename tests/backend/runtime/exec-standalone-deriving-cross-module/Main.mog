-- Every strategy of standalone deriving, used from the module that imports it: stock with a
-- context over two parameters, newtype, and via. Each instance is written in `Lib`, so each
-- answer here depends on the project instance world carrying it.
module Main where

import Data.Eq
import Text.Show
import System.IO
import Lib

main :: IO ()
main = do
  putStrLn (show (Pair (1 :: Int) True == Pair 1 True))
  putStrLn (show (Pair (1 :: Int) (2 :: Int) == Pair 1 3))
  putStrLn (show (Age 1 == Age 1))
  putStrLn (show (Total 5 == Total 5))
