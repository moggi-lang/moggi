import Control.Exception
import System.IO

-- Uncaught host failure raised by a BCL method across the FFI boundary: the
-- report must name it HostException, keep the native cause, and show the Mogg
-- frame the call came from. `Int64:Parse` is a static method whose CLR
-- signature (string -> int64) is exactly what the Moggi type lowers to.
foreign dotnet function throwHost "System.Int64:Parse" :: String -> Int

main :: IO ()
main = putStrLn (show (throwHost "uncaught-host"))
