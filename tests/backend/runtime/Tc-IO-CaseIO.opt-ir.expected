module
  function emitWhen(b)
      io_match b
        arm True
            io_call putStrLn("y")
            ret ()
        arm False
            io_call putStrLn("n")
            ret ()
  function pick(b)
      io_match b
        arm True
            io_call putStrLn("yes")
            ret ()
        arm False
            io_call putStrLn("no")
            ret ()
  function pickOrError(b)
      io_match b
        arm True
            io_call putStrLn("yes")
            ret ()
        arm False
            io_call error("no")
            ret ()
  function main()
      io_call putStrLn("linear")
      io_call emitWhen(@True)
      io_call putStrLn("deferred")
      io_call putStrLn("before")
      io_call pick(@True)
      io_call putStrLn("error-branch")
      io_call pickOrError(@True)
      ret ()
