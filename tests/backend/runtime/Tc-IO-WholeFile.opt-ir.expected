module
  function bindPath()
      ret "\/tmp\/moggi-tc-io-whole-bind.txt"
  function letPath()
      ret "\/tmp\/moggi-tc-io-whole-let.txt"
  function main()
      io_call putStrLn("bind")
      io_call writeFile(@bindPath, "bind-linear")
      t0 = io_call readFile(@bindPath)
      io_call putStrLn(t0)
      io_call putStrLn("let")
      t1 = io_call readFile(@letPath)
      io_call putStrLn(t1)
      ret ()
