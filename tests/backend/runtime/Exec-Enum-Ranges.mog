import Data.Bool
import Data.Bounded
import Data.Enum
import System.IO
import Text.Show

-- The range methods are class methods with defaults: 'Int' and 'Integer'
-- override all four natively, everything else maps 'toEnum' over an 'Int'
-- range. Open ranges ('enumFrom'/'enumFromThen') diverge under strict
-- evaluation, so only closed ranges appear here.
main :: IO ()
main = do
  putStrLn (show (enumFromTo (6 :: Int) 10))
  putStrLn (show (enumFromTo (42 :: Integer) 1))
  putStrLn (show (enumFromThenTo (4 :: Integer) 2 (-6)))
  putStrLn (show (enumFromThenTo (6 :: Int) 8 2))
  putStrLn (show (enumFromThenTo (1 :: Int) 1 5))
  putStrLn (show (enumerate :: [Bool]))
  putStrLn (show (enumFromTo True False))
  putStrLn (show ([1 .. 5] :: [Int]))
  putStrLn (show ([1, 3 .. 9] :: [Int]))
  putStrLn (show (enumFromTo 'a' 'e'))
  putStrLn (show (enumFromTo (1.0 :: Double) 3.0))
