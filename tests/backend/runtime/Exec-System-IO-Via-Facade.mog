import System.Environment (lookupEnv)
import System.IO

main :: IO ()
main = do
  path <- scratchPath "moggi-io-facade-test.txt"
  _ <- writeFile path "facade-ok"
  content <- readFile path
  putStrLn content

scratchPath :: String -> IO FilePath
scratchPath name = do
  tmp <- lookupEnv "TMPDIR"
  win <- lookupEnv "TEMP"
  let dir = case tmp of
        Just d -> d
        Nothing -> case win of
          Just d -> d
          Nothing -> "/tmp"
  pure (dir <> "/" <> name)
