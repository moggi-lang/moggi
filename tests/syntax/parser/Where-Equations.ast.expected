program
  function fact :: Int -> Int
    pat_var n
    where
      apply
        apply
          variable go
          variable n
        integer 1
      binding
        pat_var go
        lambda
          pat_var _p0
          pat_var acc
          case
            tuple
              variable _p0
              variable acc
            alt
              pat_tuple
                pat_lit 0
                pat_var acc
              variable acc
            alt
              pat_tuple
                pat_var k
                pat_var acc
              apply
                apply
                  variable go
                  infix -
                    variable k
                    integer 1
                infix *
                  variable k
                  variable acc
