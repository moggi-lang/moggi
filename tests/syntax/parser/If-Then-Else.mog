-- `if c then a else b` is syntax, not a function: it desugars to a `case` on
-- the condition, so there is exactly one conditional form in the language.
pick b = if b then 1 else 0
branches n =
  if n < 0
  then "neg"
  else if n == 0 then "zero" else "pos"
nested x = if x then (if x then 1 else 2) else 3
applied x = f (if x then 1 else 2)
