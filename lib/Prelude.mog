{-# LANGUAGE NoImplicitPrelude #-}
-- | The Prelude - the standard module.
-- 
-- The Prelude is imported by default into all Moggi modules unless either there
-- is an explicit import statement for it, or NoImplicitPrelude is enabled.
module Prelude
  ( -- Basic data types
    Bool(False, True)
  , (&&)
  , (||)
  , not
  , otherwise
  , Maybe(Nothing, Just)
  , maybe
  , Either(Left, Right)
  , either
  , Ordering(LT, EQ, GT)
  , Char
  , String
    -- Tuples
  , fst
  , snd
  , curry
  , uncurry
    -- Basic type classes
  , Eq((==), (/=))
  , Ord(compare, (<), (<=), (>), (>=), max, min)
  , Enum(succ, pred, toEnum, fromEnum)
  , enumFromTo
  , enumFromThenTo
  , Bounded(minBound, maxBound)
    -- Numeric types and classes
  , Int
  , Integer
  , Double
  , Word
  , Num(..)
  , Integral(..)
  , fromIntegral
  , Fractional(..)
  , Floating(..)
  , subtract
  , even
  , odd
  , (^)
  , (^^)
  , gcd
  , lcm
    -- Semigroups and monoids
  , Semigroup((<>))
  , Monoid(mempty, mconcat)
    -- Monads, functors and their helpers
  , Functor(map)
  , (<$>)
  , (<$)
  , Applicative(pure, (<*>))
  , (*>)
  , (<*)
  , Monad((>>=))
  , (>>)
  , MonadFail(fail)
  , mapM_
  , sequence_
  , (=<<)
    -- Folds and traversals
  , Foldable(foldr)
  , foldMap
  , foldl
  , foldl1
  , foldr1
  , null
  , length
  , elem
  , notElem
  , any
  , all
  , and
  , or
  , concat
  , concatMap
  , sum
  , product
  , maximum
  , minimum
  , Traversable(traverse, sequenceA, mapM, sequence)
    -- Miscellaneous
  , id
  , const
  , (.)
  , flip
  , ($)
  , until
  , error
  , errorWithoutStackTrace
  , undefined
  , asTypeOf
    -- List operations
  , (:)
  , (++)
  , filter
  , head
  , last
  , tail
  , init
  , (!!)
  , reverse
  , scanl
  , scanl1
  , scanr
  , scanr1
  , take
  , drop
  , takeWhile
  , dropWhile
  , span
  , break
  , splitAt
  , replicate
  , lookup
  , zip
  , zip3
  , zipWith
  , zipWith3
  , unzip
  , unzip3
  , lines
  , words
  , unlines
  , unwords
    -- Converting to and from String
  , ShowS
  , Show(showsPrec, showList, show)
  , shows
  , showChar
  , showString
  , showParen
    -- Basic input and output
  , IO
  , putStr
  , putStrLn
  ) where

import Control.Applicative
import Control.Monad
import Control.Monad.Fail
import Data.Eq
import Data.Foldable
import Data.Functor hiding (unzip)
import Data.Monoid
import Data.Num
import Data.Real
import Data.Semigroup
import Moggi.Internal.Base
import Text.Show
import Data.Ord
import Data.Enum
import Data.Bounded
import Data.Function (id, const, (.), flip, ($), until, asTypeOf)

import Data.Bool
import Data.Char (Char)
import Data.Int
import Data.Integer
import Data.Double
import Data.String (String, lines, pack, words, unlines, unpack, unwords)
import Data.Maybe (Maybe(..), maybe)
import Data.Either
import Data.Traversable
import Data.Tuple (fst, snd, curry, uncurry)
import Data.Word (Word)
import Moggi.Err
import Data.List hiding (
  uncons,
  unsnoc,
  subsequences,
  permutations,
  intercalate,
  transpose,
  intersperse,
  find
)
import System.IO (IO, putStr, putStrLn)
