{-# LANGUAGE NoImplicitPrelude #-}
module System.Environment.DotNet
  ( getArgs
  , getEnv
  , lookupEnv
  , getProgName
  ) where

import Control.Applicative
import Control.Monad
import Data.Bool
import Data.Maybe
import Data.String
import Moggi.Err
import System.IO.Base (IO)
import Moggi.Internal.Prim

foreign dotnet function rawGetenv "System.Environment:GetEnvironmentVariable" :: String -> IO (Maybe String)

getArgs :: IO [String]
getArgs = platformArgv#

lookupEnv :: String -> IO (Maybe String)
lookupEnv k = rawGetenv k

getEnvFromMaybe :: Maybe String -> IO String
getEnvFromMaybe m = case m of
  Just v -> pure v
  Nothing -> error "getEnv: missing environment variable"

getEnv :: String -> IO String
getEnv k = lookupEnv k >>= getEnvFromMaybe

getProgName :: IO String
getProgName = pure "moggi"
