{-# BACKEND
  php = System.Filesystem.PHP
  jvm = System.Filesystem.JVM
  dotnet = System.Filesystem.DotNet
#-}
-- |
-- The filesystem, addressed by path: reading and writing whole files, asking
-- what a path is, and creating, copying and removing files and directories.
--
-- Each read and write comes in two forms. The plain name takes and produces
-- bytes — the same values 'Data.ByteString' holds — and is the one to use when
-- the content is not text or when its encoding matters. The @Text@ name takes
-- and produces a 'String' and applies the host's text encoding at the boundary,
-- which is the convenient choice for a file that is meant to be read.
--
-- The operations that name a directory act on that path only; 'createTree' and
-- 'removeTree' are the two that walk into it. 'copyFile' hands both paths to the
-- host's own copy, which brings the permissions along, while 'copyFileContent'
-- and 'copyPermissions' do one of the two explicitly.
--
-- The implementations are the host's, behind a facade: a program imports this
-- module and never chooses a backend for it.
module System.Filesystem
  ( readFile
  , readTextFile
  , writeFile
  , writeTextFile
  , appendFile
  , appendTextFile
  , isFile
  , getModified
  , getSize
  , copyFile
  , copyFileContent
  , copyPermissions
  , removeFile
  , isDirectory
  , canonicalizePath
  , listDirectory
  , createDirectory
  , createTree
  , removeDirectory
  , removeTree
  , getWorkingDirectory
  , setWorkingDirectory
  , rename
  ) where

import Data.ByteString (ByteString)
import Data.Int
import Data.Time.Clock
import System.Filesystem.Path

readFile :: FilePath -> IO ByteString

readTextFile :: FilePath -> IO String

writeFile :: FilePath -> ByteString -> IO ()

writeTextFile :: FilePath -> String -> IO ()

appendFile :: FilePath -> ByteString -> IO ()

appendTextFile :: FilePath -> String -> IO ()

isFile :: FilePath -> IO Bool

getModified :: FilePath -> IO UTCTime

getSize :: FilePath -> IO Int

copyFile :: FilePath -> FilePath -> IO ()

copyFileContent :: FilePath -> FilePath -> IO ()

copyPermissions :: FilePath -> FilePath -> IO ()

removeFile :: FilePath -> IO ()

isDirectory :: FilePath -> IO Bool

canonicalizePath :: FilePath -> IO FilePath

listDirectory :: FilePath -> IO [FilePath]

createDirectory :: Bool -> FilePath -> IO ()

createTree :: FilePath -> IO ()

removeDirectory :: FilePath -> IO ()

removeTree :: FilePath -> IO ()

getWorkingDirectory :: IO FilePath

setWorkingDirectory :: FilePath -> IO ()

rename :: FilePath -> FilePath -> IO ()
