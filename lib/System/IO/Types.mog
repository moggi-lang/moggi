-- |
-- The types the input/output operations pass around.
--
-- A 'Handle' is an open connection to a file: the operations that read and
-- write take one, and the operations that open and close a file produce and
-- finish one. A handle is opaque — what stands behind it belongs to the backend
-- — so the only things a program can do with one are compare it and show it.
--
-- 'IOMode' says how a file is opened, which decides what the handle that comes
-- back can do and where writing starts.
module System.IO.Types
  ( Handle
  , Resource
  , IOMode(ReadMode, WriteMode, AppendMode, ReadWriteMode)
  ) where

import Data.Bool
import Data.Eq
import Data.Ord
import Text.Show
import Moggi.Internal.Prim

-- | What a 'Handle' stands for, as the backend represents it. It is an
-- implementation detail: a program holds a 'Handle' and passes it back.
data Resource = MkResource

-- | An open connection to a file, and the value the input/output operations
-- read from and write to.
data Handle = MkHandle Resource

-- | How a file is opened: 'ReadMode' reads it, 'WriteMode' replaces its
-- contents, 'AppendMode' keeps them and writes after the end, and
-- 'ReadWriteMode' reads and writes the same open file.
data IOMode = ReadMode | WriteMode | AppendMode | ReadWriteMode

-- Handles are opaque resources: the generated code compares them by identity,
-- which for an unconstructed resource host is never (two handles are only
-- equal to themselves).
instance Eq Handle where
  (==) _ _ = False
  (/=) _ _ = True

instance Show Handle where
  show _ = "<handle>"

instance Eq Resource where
  (==) _ _ = False
  (/=) _ _ = True

instance Show Resource where
  show _ = "<resource>"

ioModeTag :: IOMode -> Int
ioModeTag mode = case mode of
  ReadMode -> 0
  WriteMode -> 1
  AppendMode -> 2
  ReadWriteMode -> 3

instance Eq IOMode where
  (==) a b = intEq# (ioModeTag a) (ioModeTag b)
  (/=) a b = intNe# (ioModeTag a) (ioModeTag b)

instance Ord IOMode where
  compare a b = intCompare# (ioModeTag a) (ioModeTag b)

instance Show IOMode where
  show mode = case mode of
    ReadMode -> "ReadMode"
    WriteMode -> "WriteMode"
    AppendMode -> "AppendMode"
    ReadWriteMode -> "ReadWriteMode"
