{-# LANGUAGE NoImplicitPrelude #-}
-- | The PHP host math for `Data.Double`: the transcendental functions the
-- `Floating` instance is built from. `Double` is PHP's native `float`, so these
-- pass straight through.
module Data.Double.PHP
  ( doubleExp
  , doubleLog
  , doubleSqrt
  , doubleSin
  , doubleCos
  , doubleAsin
  , doubleAcos
  , doubleAtan
  , doubleSinh
  , doubleCosh
  ) where

import Moggi.Internal.Prim

foreign php function rawExp "exp" :: Double -> Double
foreign php function rawLog "log" :: Double -> Double
foreign php function rawSqrt "sqrt" :: Double -> Double
foreign php function rawSin "sin" :: Double -> Double
foreign php function rawCos "cos" :: Double -> Double
foreign php function rawAsin "asin" :: Double -> Double
foreign php function rawAcos "acos" :: Double -> Double
foreign php function rawAtan "atan" :: Double -> Double
foreign php function rawSinh "sinh" :: Double -> Double
foreign php function rawCosh "cosh" :: Double -> Double

doubleExp :: Double -> Double
doubleExp x = rawExp x

doubleLog :: Double -> Double
doubleLog x = rawLog x

doubleSqrt :: Double -> Double
doubleSqrt x = rawSqrt x

doubleSin :: Double -> Double
doubleSin x = rawSin x

doubleCos :: Double -> Double
doubleCos x = rawCos x

doubleAsin :: Double -> Double
doubleAsin x = rawAsin x

doubleAcos :: Double -> Double
doubleAcos x = rawAcos x

doubleAtan :: Double -> Double
doubleAtan x = rawAtan x

doubleSinh :: Double -> Double
doubleSinh x = rawSinh x

doubleCosh :: Double -> Double
doubleCosh x = rawCosh x
