{-# LANGUAGE NoImplicitPrelude #-}
-- | The JVM host math for `Data.Double`. `Double` is the JVM `double`,
-- and the functions come from `java.lang.Math`'s static methods.
--
-- `java.lang.Math` has no `asinh`/`acosh`/`atanh` (only `sinh`/`cosh`/`tanh`),
-- so those three are derived in `Data.Double` from `log` and `sqrt`.
module Data.Double.JVM
  ( doubleExp
  , doubleLog
  , doubleSqrt
  , doubleSin
  , doubleCos
  , doubleAsin
  , doubleAcos
  , doubleAtan
  , doubleSinh
  , doubleCosh
  ) where

import Moggi.Internal.Prim

foreign jvm function rawExp "java.lang.Math:exp" :: Double -> Double
foreign jvm function rawLog "java.lang.Math:log" :: Double -> Double
foreign jvm function rawSqrt "java.lang.Math:sqrt" :: Double -> Double
foreign jvm function rawSin "java.lang.Math:sin" :: Double -> Double
foreign jvm function rawCos "java.lang.Math:cos" :: Double -> Double
foreign jvm function rawAsin "java.lang.Math:asin" :: Double -> Double
foreign jvm function rawAcos "java.lang.Math:acos" :: Double -> Double
foreign jvm function rawAtan "java.lang.Math:atan" :: Double -> Double
foreign jvm function rawSinh "java.lang.Math:sinh" :: Double -> Double
foreign jvm function rawCosh "java.lang.Math:cosh" :: Double -> Double

doubleExp :: Double -> Double
doubleExp x = rawExp x

doubleLog :: Double -> Double
doubleLog x = rawLog x

doubleSqrt :: Double -> Double
doubleSqrt x = rawSqrt x

doubleSin :: Double -> Double
doubleSin x = rawSin x

doubleCos :: Double -> Double
doubleCos x = rawCos x

doubleAsin :: Double -> Double
doubleAsin x = rawAsin x

doubleAcos :: Double -> Double
doubleAcos x = rawAcos x

doubleAtan :: Double -> Double
doubleAtan x = rawAtan x

doubleSinh :: Double -> Double
doubleSinh x = rawSinh x

doubleCosh :: Double -> Double
doubleCosh x = rawCosh x
