{-# LANGUAGE NoImplicitPrelude #-}
-- | The .NET host math for `Data.Double`. `Double` is the CLR `double`,
-- and the functions come from `System.Math`'s static methods.
module Data.Double.DotNet
  ( doubleExp
  , doubleLog
  , doubleSqrt
  , doubleSin
  , doubleCos
  , doubleAsin
  , doubleAcos
  , doubleAtan
  , doubleSinh
  , doubleCosh
  ) where

import Moggi.Internal.Prim

foreign dotnet function rawExp "System.Math:Exp" :: Double -> Double
foreign dotnet function rawLog "System.Math:Log" :: Double -> Double
foreign dotnet function rawSqrt "System.Math:Sqrt" :: Double -> Double
foreign dotnet function rawSin "System.Math:Sin" :: Double -> Double
foreign dotnet function rawCos "System.Math:Cos" :: Double -> Double
foreign dotnet function rawAsin "System.Math:Asin" :: Double -> Double
foreign dotnet function rawAcos "System.Math:Acos" :: Double -> Double
foreign dotnet function rawAtan "System.Math:Atan" :: Double -> Double
foreign dotnet function rawSinh "System.Math:Sinh" :: Double -> Double
foreign dotnet function rawCosh "System.Math:Cosh" :: Double -> Double

doubleExp :: Double -> Double
doubleExp x = rawExp x

doubleLog :: Double -> Double
doubleLog x = rawLog x

doubleSqrt :: Double -> Double
doubleSqrt x = rawSqrt x

doubleSin :: Double -> Double
doubleSin x = rawSin x

doubleCos :: Double -> Double
doubleCos x = rawCos x

doubleAsin :: Double -> Double
doubleAsin x = rawAsin x

doubleAcos :: Double -> Double
doubleAcos x = rawAcos x

doubleAtan :: Double -> Double
doubleAtan x = rawAtan x

doubleSinh :: Double -> Double
doubleSinh x = rawSinh x

doubleCosh :: Double -> Double
doubleCosh x = rawCosh x
