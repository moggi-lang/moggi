{-# LANGUAGE NoImplicitPrelude #-}
module Data.String.JVM
  ( singleton
  , unpack
  , length
  , take
  , drop
  , reverse
  , isPrefixOf
  , isSuffixOf
  , splitOn
  , lines
  , words
  , unlines
  , unwords
  ) where

import Data.Bool
import Data.Char
import Data.Int
import Data.List qualified as L
import Data.Ord
import Moggi.Internal.Prim

-- Ordinary JDK FFI only (no moggi.rt.StringOps).
-- Width-exact signatures: JDK String/Character APIs are int32-based.

-- Character.toString(int) — codepoint overload (Char is a Unicode scalar).
foreign jvm function rawSingleton "java.lang.Character:toString" :: Int32 -> String

singleton c = rawSingleton (int32FromInt# (charToInt# c))

foreign jvm function rawUtf16Length "java.lang.String.length" :: String -> Int32

foreign jvm function rawCodePointCount "java.lang.String.codePointCount" :: String -> Int32 -> Int32 -> Int32

foreign jvm function rawOffsetByCodePoints "java.lang.String.offsetByCodePoints" :: String -> Int32 -> Int32 -> Int32

foreign jvm function rawCodePointAt "java.lang.String.codePointAt" :: String -> Int32 -> Int32

foreign jvm function rawSubstring "java.lang.String.substring" :: String -> Int32 -> Int32 -> String

foreign jvm function rawStartsWith "java.lang.String.startsWith" :: String -> String -> Bool

foreign jvm function rawEndsWith "java.lang.String.endsWith" :: String -> String -> Bool

foreign jvm function lines "java.lang.String.lines" :: String -> [String]

foreign jvm function rawIndexOfFrom "java.lang.String.indexOf" :: String -> String -> Int32 -> Int32

foreign jvm type StringBuilder "java.lang.StringBuilder"

-- StringBuilder.reverse treats a surrogate pair as one character, so an
-- astral scalar survives the reversal.
foreign jvm function newStringBuilder "java.lang.StringBuilder:__con" :: String -> StringBuilder

foreign jvm function sbReverse "java.lang.StringBuilder.reverse" :: StringBuilder -> StringBuilder

foreign jvm function sbToString "java.lang.StringBuilder.toString" :: StringBuilder -> String

utf16Length s = int32ToInt# (rawUtf16Length s)

offsetByCodePoints s a b = int32ToInt# (rawOffsetByCodePoints s (int32FromInt# a) (int32FromInt# b))

substring s a b = rawSubstring s (int32FromInt# a) (int32FromInt# b)

-- Each walk below closes over the string it walks, so its helper takes only the
-- argument the walk itself varies.

unpack :: String -> [Char]
unpack s =
  let codePointAt i = int32ToInt# (rawCodePointAt s (int32FromInt# i))
      unpackAt i end = case intCompare# i end of
        EQ -> []
        _ -> chr (codePointAt i) : unpackAt (offsetByCodePoints s i 1) end
  in unpackAt 0 (utf16Length s)

splitOn :: String -> String -> [String]
splitOn sep s =
  let splitOnAt start =
        let i = int32ToInt# (rawIndexOfFrom s sep (int32FromInt# start))
        in case intCompare# i (0 - 1) of
          EQ -> substring s start (utf16Length s) : []
          _ -> substring s start i : splitOnAt (i + utf16Length sep)
  in case utf16Length sep of
    0 -> s : []
    _ -> splitOnAt 0

length :: String -> Int
length s =
  let codePointCount a b = int32ToInt# (rawCodePointCount s (int32FromInt# a) (int32FromInt# b))
  in codePointCount 0 (utf16Length s)

-- `offsetByCodePoints` reads "n scalars from 0", which is an unchecked index:
-- a count past the end throws, and a negative one walks off the front. Clamp
-- here so only a positive, in-bounds count reaches it.
take :: Int -> String -> String
take n s =
  let takeWithin k =
        let len = length s
        in case intCompare# k len of
          LT -> substring s 0 (offsetByCodePoints s 0 k)
          _ -> s
  in case intCompare# n 0 of
    GT -> takeWithin n
    _ -> ""

drop :: Int -> String -> String
drop n s =
  let dropWithin k =
        let len = length s
        in case intCompare# k len of
          LT -> substring s (offsetByCodePoints s 0 k) (utf16Length s)
          _ -> ""
  in case intCompare# n 0 of
    GT -> dropWithin n
    _ -> s

reverse :: String -> String
reverse s = sbToString (sbReverse (newStringBuilder s))

isPrefixOf :: String -> String -> Bool
isPrefixOf prefix s = rawStartsWith s prefix

isSuffixOf :: String -> String -> Bool
isSuffixOf suffix s = rawEndsWith s suffix

words :: String -> [String]
words s = L.filter (\w -> w /= "") (splitOn " " s)

unlines :: [String] -> String
unlines [] = ""
unlines (line : rest) = line <> "\n" <> unlines rest

unwords :: [String] -> String
unwords [] = ""
unwords [x] = x
unwords (x : rest) = x <> " " <> unwords rest
