{-# LANGUAGE NoImplicitPrelude #-}
module Data.String.PHP
  ( singleton
  , unpack
  , length
  , take
  , drop
  , reverse
  , isPrefixOf
  , isSuffixOf
  , splitOn
  , lines
  , words
  , unlines
  , unwords
  ) where

import Data.Bool
import Data.Char
import Data.Int
import Data.List hiding (singleton, take, drop, isPrefixOf, isSuffixOf)
import Data.List qualified as L
import Data.Ord
import Moggi.Internal.Prim

-- Scalar-aware String ops via PHP mbstring / IntlChar foreigns + Moggi.
-- No custom PHP helpers.

foreign php function mbStrLen "mb_strlen" :: String -> String -> Int

foreign php function mbSubstr "mb_substr" :: String -> Int -> Int -> String -> String

foreign php function mbStrSplit "mb_str_split" :: String -> Int -> String -> [String]

foreign php function intlChr "IntlChar:chr" :: Char -> String

foreign php function intlOrd "IntlChar:ord" :: String -> Int

foreign php function implode "implode" :: String -> [String] -> String

foreign php function rawStartsWith "str_starts_with" :: String -> String -> Bool

foreign php function rawEndsWith "str_ends_with" :: String -> String -> Bool

foreign php function rawExplode "explode" :: String -> String -> [String]

foreign php function rawArrayReverse "array_reverse" :: [String] -> [String]

utf8 = "UTF-8"

singleton c = intlChr c

coerceIntToChar n = intToChar# n

chunkToChar ch = coerceIntToChar (intlOrd ch)

unpack s = L.map chunkToChar (mbStrSplit s 1 utf8)

length s = mbStrLen s utf8

-- A negative length is not "zero chars" to `mb_substr`: it means "all but the
-- last |n|", so the sign has to be rejected before the call.
take :: Int -> String -> String
take n s = case intCompare# n 0 of
  GT -> mbSubstr s 0 n utf8
  _ -> ""

drop :: Int -> String -> String
drop n s = case intCompare# n 0 of
  GT -> dropWithin n s
  _ -> s

dropWithin :: Int -> String -> String
dropWithin n s =
  let len = length s
  in case intCompare# n len of
    LT -> mbSubstr s n (len - n) utf8
    _ -> ""

-- | Reverse by Unicode scalar. `strrev` is byte-wise and would split a
-- multi-byte scalar, so split on codes and reverse the chunks instead: three
-- linear passes over the string rather than the list round-trip through `pack`.
reverse :: String -> String
reverse s = implode "" (rawArrayReverse (mbStrSplit s 1 utf8))

isPrefixOf prefix s = rawStartsWith s prefix

isSuffixOf suffix s = rawEndsWith s suffix

splitOn :: String -> String -> [String]
splitOn sep s = rawExplode sep s

lines "" = ([] :: [String])
lines s = L.reverse (dropWhile (\x -> x == "") (L.reverse (splitOn "\n" s)))

words s = (filter (\w -> w /= "") (splitOn " " s) :: [String])

unlines [] = ""
unlines (line : rest) = line <> "\n" <> unlines rest

unwords [] = ""
unwords [x] = x
unwords (x : rest) = x <> " " <> unwords rest
