import Moggi.Internal.Prim

-- | The unit type.
type Unit = ()

-- | The unit type, also known as Tuple0.
type Tuple0 = Unit

-- | A 1-tuple, also known as Solo.
-- `MkSolo` is the data constructor; `Solo` is the one-field tuple constructor.
data Solo a = MkSolo a

-- | Extract the sole element of a Solo.
getSolo :: Solo a -> a
getSolo (MkSolo a) = a

-- | Tuple1 is a type synonym for Solo.
type Tuple1 = Solo

-- | Extract the first component of a pair.
fst (x, _) = x

-- | Extract the second component of a pair.
snd (_, y) = y

-- | 'curry' converts an uncurried function to a curried function.
curry f x y = f (x, y)

-- | 'uncurry' converts a curried function to a function on pairs.
uncurry f p = f (fst p) (snd p)

-- | Swap the components of a pair.
swap (x, y) = (y, x)

-- ---------------------------------------------------------------------------

-- Shared Show helper: keeps instance methods shallow (O(1) nest) so parse/TC
-- stay near-linear in arity instead of building depth-2N stringAppend trees.
tupleShowParts :: [String] -> String
tupleShowParts [] = ""
tupleShowParts [x] = x
tupleShowParts (x:xs) = stringAppend# x (stringAppend# "," (tupleShowParts xs))

tupleShow :: [String] -> String
tupleShow xs = stringAppend# "(" (stringAppend# (tupleShowParts xs) ")")

-- Avoid recursive `show` binding inside Show instance methods.
showOne :: Show a => a -> String
showOne x = show x

-- Functor, Foldable, Traversable and Show for Solo and Tuple2..Tuple15 -- the
-- arities base itself declares instances for. Each Functorial instance acts on
-- the LAST type parameter; Foldable uses wildcards for leading components.
-- Unit/Tuple0 have kind * and are not Functor. Eq and Ord are declared below, for
-- the same arities.

instance Functor Solo where
  map f (MkSolo a) = MkSolo (f a)

instance Foldable Solo where
  foldr f z (MkSolo a) = f a z

instance Traversable Solo where
  traverse f (MkSolo a) = MkSolo <$> f a

instance Show a => Show (Solo a) where
  showsPrec d (MkSolo a) =
    showParen (d > 10) (\r -> showString "MkSolo " (showsPrec 11 a r))


instance Functor (Tuple2 a1) where
  map f t = case t of
    (x1, x2) -> (x1, f x2)

instance Foldable (Tuple2 a1) where
  foldr f z t = case t of
    (_, x2) -> f x2 z

instance Traversable (Tuple2 a1) where
  traverse f t = case t of
    (x1, x2) -> pure (\y2 -> (x1, y2)) <*> f x2

instance (Show a1, Show a2) => Show (Tuple2 a1 a2) where
  show t = case t of
    (x1, x2) -> tupleShow [showOne x1, showOne x2]

instance Functor (Tuple3 a1 a2) where
  map f t = case t of
    (x1, x2, x3) -> (x1, x2, f x3)

instance Foldable (Tuple3 a1 a2) where
  foldr f z t = case t of
    (_, _, x3) -> f x3 z

instance Traversable (Tuple3 a1 a2) where
  traverse f t = case t of
    (x1, x2, x3) -> pure (\y3 -> (x1, x2, y3)) <*> f x3

instance (Show a1, Show a2, Show a3) => Show (Tuple3 a1 a2 a3) where
  show t = case t of
    (x1, x2, x3) -> tupleShow [showOne x1, showOne x2, showOne x3]

