-- ---------------------------------------------------------------------------
-- Eq and Ord for Unit, Solo and Tuple2..Tuple15.
--
-- A comparison writes the instance's own method, never an operator a backend happens
-- to have for the representation, so a type whose comparison nothing declares is a type
-- error -- arity 16 tuples included, exactly as in base. `(==)` compares components left
-- to right and stops at the first difference, `compare` is lexicographic: the code base's
-- own deriving produces (`x1 == y1 && x2 == y2`, `compare x1 y1 <> compare x2 y2 <> ...`).

instance Eq () where
  (==) _ _ = True

instance Ord () where
  compare _ _ = EQ

instance Eq a => Eq (Solo a) where
  (==) a b = case a of
    MkSolo x -> case b of
      MkSolo y -> x == y

instance Ord a => Ord (Solo a) where
  compare a b = case a of
    MkSolo x -> case b of
      MkSolo y -> compare x y

instance (Eq a1, Eq a2) => Eq (Tuple2 a1 a2) where
  (==) a b = case a of
    (x1, x2) -> case b of
      (y1, y2) -> x1 == y1 && x2 == y2

instance (Ord a1, Ord a2) => Ord (Tuple2 a1 a2) where
  compare a b = case a of
    (x1, x2) -> case b of
      (y1, y2) -> compare x1 y1 <> compare x2 y2

instance (Eq a1, Eq a2, Eq a3) => Eq (Tuple3 a1 a2 a3) where
  (==) a b = case a of
    (x1, x2, x3) -> case b of
      (y1, y2, y3) -> x1 == y1 && x2 == y2 && x3 == y3

instance (Ord a1, Ord a2, Ord a3) => Ord (Tuple3 a1 a2 a3) where
  compare a b = case a of
    (x1, x2, x3) -> case b of
      (y1, y2, y3) -> compare x1 y1 <> compare x2 y2 <> compare x3 y3

instance (Eq a1, Eq a2, Eq a3, Eq a4) => Eq (Tuple4 a1 a2 a3 a4) where
  (==) a b = case a of
    (x1, x2, x3, x4) -> case b of
      (y1, y2, y3, y4) -> x1 == y1 && x2 == y2 && x3 == y3 && x4 == y4

instance (Ord a1, Ord a2, Ord a3, Ord a4) => Ord (Tuple4 a1 a2 a3 a4) where
  compare a b = case a of
    (x1, x2, x3, x4) -> case b of
      (y1, y2, y3, y4) -> compare x1 y1 <> compare x2 y2 <> compare x3 y3 <> compare x4 y4

instance (Eq a1, Eq a2, Eq a3, Eq a4, Eq a5) => Eq (Tuple5 a1 a2 a3 a4 a5) where
  (==) a b = case a of
    (x1, x2, x3, x4, x5) -> case b of
      (y1, y2, y3, y4, y5) -> x1 == y1 && x2 == y2 && x3 == y3 && x4 == y4 && x5 == y5

instance (Ord a1, Ord a2, Ord a3, Ord a4, Ord a5) => Ord (Tuple5 a1 a2 a3 a4 a5) where
  compare a b = case a of
