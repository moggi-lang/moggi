{-# LANGUAGE NoImplicitPrelude #-}
module Data.Num
  ( Num(..)
  , subtract
  ) where

import Data.Bool
import Moggi.Internal.Base
import Moggi.Internal.Prim

-- Integer is a bootstrap primitive synonym; this module does not import the
-- module that defines `Integer`'s operations, so `Data.Integer` can
-- define `instance Num Integer` without an import cycle.
--
--   * Num         -- arithmetic shared by Int, Integer, Double
--   * Integral    -- integer division (Int, Integer)   [Data.Real]
--   * Fractional  -- real division (Double)            [Data.Real]

infixl 6 +, -
infixl 7 *

class Num a where
  (+), (-), (*) :: a -> a -> a
  negate, abs, signum :: a -> a
  fromInteger :: Integer -> a

-- The machine integers' (`Int` and `Word`, both 64-bit) instances live with the
-- class, as they do in
-- base's `GHC.Internal.Num`: `Int` and `Word` are the widths the library's own
-- low-level code is written at -- `Data.Foldable`'s `length`, `Control.Monad`'s
-- `replicateM` -- and those modules sit below `Data.Int` and `Data.Word`, so the
-- instance they need cannot be declared there. The fixed-width types' instances
-- stay with `Data.Int`/`Data.Word`; `Integer`'s and `Natural`'s stay with theirs,
-- whose arithmetic is written in terms of library functions rather than primops.
instance Num Int where
  (+) a b = intAdd# a b
  (-) a b = intSub# a b
  (*) a b = intMul# a b
  negate a = intNegate# a
  abs a = intAbs# a
  signum a = intSignum# a
  fromInteger n = intFromInteger# n

instance Num Word where
  (+) a b = wordFromInt# (intAdd# (wordToInt# a) (wordToInt# b))
  (-) a b = wordFromInt# (intSub# (wordToInt# a) (wordToInt# b))
  (*) a b = wordFromInt# (intMul# (wordToInt# a) (wordToInt# b))
  negate a = wordFromInt# (intNegate# (wordToInt# a))
  abs a = a
  signum a = case wordEq# a (wordFromInt# 0) of
    True -> wordFromInt# 0
    _ -> wordFromInt# 1
  fromInteger n = wordFromInt# (intFromInteger# n)

-- | the same as @'flip' ('-')@.
--
-- Because @-@ is treated specially in the grammar, @(-@ /e/@)@ is not a
-- section, but an application of prefix negation. However, @('subtract'@ /exp/@)@
-- is equivalent to the disallowed section.
subtract :: Num a => a -> a -> a
subtract x y = y - x
