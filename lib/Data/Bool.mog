{-# LANGUAGE NoImplicitPrelude #-}
module Data.Bool
  ( Bool(..)
  , (&&)
  , (||)
  , not
  , otherwise
  , bool
  ) where

import Data.Eq
import Data.Ord
import Text.Show
import Moggi.Internal.Prim

data Bool = False | True

infixr 3 &&
infixr 2 ||

(&&) a b = boolAnd# a b

(||) a b = boolOr# a b

not b = boolNot# b

otherwise = True

bool x y b = case b of
  True -> x
  False -> y

instance Eq Bool where
  (==) a b = boolEq# a b
  (/=) a b = boolNe# a b

instance Ord Bool where
  compare a b = boolCompare# a b

instance Show Bool where
  show b = case b of
    True -> "True"
    False -> "False"
