{-# LANGUAGE NoImplicitPrelude #-}
-- | The Bool type and related functions.
module Data.Bool
  ( Bool(..)
  , (&&)
  , (||)
  , not
  , otherwise
  , bool
  ) where

import Data.Eq
import Data.Ord
import Text.Show
import Moggi.Internal.Prim

-- | The type of truth values: 'False' and 'True'. A @case@ on a 'Bool' is
-- the primitive branch of the language; the operations below are conveniences
-- over it.
data Bool = False | True

infixr 3 &&
infixr 2 ||

-- | Conjunction: 'True' only when both operands are 'True'. The right operand
-- is not evaluated when the left one is 'False'.
(&&) :: Bool -> Bool -> Bool
(&&) a b = boolAnd# a b

-- | Disjunction: 'True' when either operand is 'True'. The right operand is not
-- evaluated when the left one is 'True'.
(||) :: Bool -> Bool -> Bool
(||) a b = boolOr# a b

-- | Negation: 'True' becomes 'False' and 'False' becomes 'True'.
not :: Bool -> Bool
not b = boolNot# b

-- |'otherwise' is defined as the value 'True'.  It helps to make
-- guards more readable.  eg.
--
-- >  f x | x < 0     = ...
-- >      | otherwise = ...
otherwise :: Bool
otherwise = True

-- | Case analysis for the 'Bool' type. @'bool' f t p@ evaluates to @f@
-- when @p@ is 'False', and evaluates to @t@ when @p@ is 'True'.
--
-- This is equivalent to @if p then t else f@; that is, one can
-- think of it as an if-then-else construct with its arguments
-- reordered.
--
-- ==== __Examples__
--
-- Basic usage:
--
-- >>> bool "foo" "bar" True
-- "bar"
-- >>> bool "foo" "bar" False
-- "foo"
--
-- Confirm that @'bool' f t p@ and @if p then t else f@ are
-- equivalent:
--
-- >>> let p = True; f = "bar"; t = "foo"
-- >>> bool f t p == if p then t else f
-- True
-- >>> let p = False
-- >>> bool f t p == if p then t else f
-- True
--
bool :: a -> a -> Bool -> a
bool x y b = case b of
  True -> x
  False -> y

instance Eq Bool where
  (==) a b = boolEq# a b
  (/=) a b = boolNe# a b

instance Ord Bool where
  compare a b = boolCompare# a b

instance Show Bool where
  show b = case b of
    True -> "True"
    False -> "False"
