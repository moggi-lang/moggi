  , isPrefixOf
  , isSuffixOf
  , isInfixOf
  , isSubsequenceOf
  , foldl
  , foldl1
  , foldr
  , foldr1
  , concat
  , concatMap
  , and
  , or
  , any
  , all
  , sum
