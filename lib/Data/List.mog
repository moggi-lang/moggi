{-# LANGUAGE NoImplicitPrelude #-}
-- |
-- Operations on lists.
--
-- Several names are re-exported here but documented at their defining module:
-- the folds, @null@, @length@, @elem@ and friends in @Data.Foldable@, @map@ in
-- @Data.Functor@, and @lines@/@words@/@unlines@/@unwords@ in @Data.String@.
module Data.List
  ( List
  , (:)
  , (++)
  , head
  , last
  , tail
  , init
  , uncons
  , unsnoc
  , singleton
  , null
  , length
  , map
  , reverse
  , intersperse
