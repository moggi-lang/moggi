{-# LANGUAGE NoImplicitPrelude #-}
module Control.Applicative
  ( Applicative(pure, (<*>))
  , Alternative(empty, (<|>))
  , (*>)
  , (<*)
  , (<**>)
  , liftA
  , liftA2
  , liftA3
  , optional
  , some
  , many
  ) where

-- asum is defined in Data.Foldable. Control.Applicative cannot
-- re-export it here: Foldable already imports this module.

import Data.Bool
import Data.Functor
import Data.Maybe

infixl 4 <*>, <*, *>, <**>
infixl 3 <|>

class Functor f => Applicative f where
  pure :: a -> f a
  (<*>) :: f (a -> b) -> f a -> f b

class Applicative f => Alternative f where
  empty :: f a
  (<|>) :: f a -> f a -> f a

(*>) :: Applicative f => f a -> f b -> f b
(*>) fa fb = (\ignored b -> b) <$> fa <*> fb

(<*) :: Applicative f => f a -> f b -> f a
(<*) fa fb = (\a ignored -> a) <$> fa <*> fb

(<**>) :: Applicative f => f a -> f (a -> b) -> f b
(<**>) fa ff = (\a f -> f a) <$> fa <*> ff

liftA :: Applicative f => (a -> b) -> f a -> f b
liftA f fa = pure f <*> fa

liftA2 :: Applicative f => (a -> b -> c) -> f a -> f b -> f c
liftA2 f fa fb = pure f <*> fa <*> fb

liftA3 :: Applicative f => (a -> b -> c -> d) -> f a -> f b -> f c -> f d
liftA3 f fa fb fc = pure f <*> fa <*> fb <*> fc

optional :: Alternative f => f a -> f (Maybe a)
optional v = (Just <$> v) <|> pure Nothing

many :: Alternative f => f a -> f [a]
many v = (liftA2 (\x xs -> x : xs) v (many v)) <|> pure []

some :: Alternative f => f a -> f [a]
some v = liftA2 (\x xs -> x : xs) v (many v)

instance Applicative Maybe where
  pure x = Just x
  (<*>) mf mx = case mf of
    Nothing -> Nothing
    Just f -> case mx of
      Nothing -> Nothing
      Just x -> Just (f x)

instance Alternative Maybe where
  empty = Nothing
  (<|>) mx my = case mx of
    Nothing -> my
    other -> other
