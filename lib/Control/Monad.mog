{-# LANGUAGE NoImplicitPrelude #-}
module Control.Monad
  ( Monad((>>=))
  , MonadPlus(mzero, mplus)
  , (>>)
  , (=<<)
  , (>=>)
  , (<=<)
  , join
  , forever
  , guard
  , when
  , unless
  , liftM
  , liftM2
  , ap
  , foldM
  , foldM_
  , filterM
  , zipWithM
  , zipWithM_
  , replicateM
  , replicateM_
  , msum
  , mfilter
  ) where

import Control.Applicative
import Data.Bool
import Data.Functor
import Data.Maybe
import Data.Ord

-- mapM / sequence / forM live in Data.Traversable (traverse / sequenceA).
-- foldM / filterM / zipWithM / replicateM stay list-Kleisli here to avoid a
-- Control.Monad ↔ Data.Foldable import cycle.

infixl 1 >>=, >>
infixr 1 =<<
infixr 1 >=>, <=<

class Applicative m => Monad m where
  (>>=) :: m a -> (a -> m b) -> m b

class (Alternative m, Monad m) => MonadPlus m where
  -- | The identity of 'mplus'. It should also satisfy the equations
  --
  -- > mzero >>= f  =  mzero
  -- > v >> mzero   =  mzero
  --
  -- The default definition is
  --
  -- @mzero = empty@
  mzero :: m a
  mzero = empty

  -- | An associative operation. The default definition is
  --
  -- @mplus = (<|>)@
  mplus :: m a -> m a -> m a
  mplus = (<|>)

(>>) :: Monad m => m a -> m b -> m b
(>>) m k = m >>= (\ignored -> k)

(=<<) :: Monad m => (a -> m b) -> m a -> m b
(=<<) f m = m >>= f

(>=>) :: Monad m => (a -> m b) -> (b -> m c) -> a -> m c
(>=>) f g x = f x >>= g

(<=<) :: Monad m => (b -> m c) -> (a -> m b) -> a -> m c
(<=<) g f x = f x >>= g

join :: Monad m => m (m a) -> m a
join m = m >>= (\x -> x)

forever :: Applicative f => f a -> f b
forever a = a *> forever a

guard :: Alternative f => Bool -> f ()
guard b = case b of
  True -> pure ()
  False -> empty

when :: Applicative f => Bool -> f () -> f ()
when b act = case b of
  True -> act
  False -> pure ()

unless :: Applicative f => Bool -> f () -> f ()
unless b act = case b of
  True -> pure ()
  False -> act

foldM :: Monad m => (b -> a -> m b) -> b -> [a] -> m b
foldM _ z [] = pure z
foldM f z (x : xs) = f z x >>= (\z2 -> foldM f z2 xs)

foldM_ :: Monad m => (b -> a -> m b) -> b -> [a] -> m ()
foldM_ f z xs = foldM f z xs >> pure ()

filterM :: Applicative m => (a -> m Bool) -> [a] -> m [a]
filterM _ [] = pure []
filterM p (x : xs) = liftA2 (consIf x) (p x) (filterM p xs)

consIf x flg rest = case flg of
  True -> x : rest
  False -> rest

zipWithM :: Applicative m => (a -> b -> m c) -> [a] -> [b] -> m [c]
zipWithM _ [] _ = pure []
zipWithM _ _ [] = pure []
zipWithM f (x : xs) (y : ys) = liftA2 (\z zs -> z : zs) (f x y) (zipWithM f xs ys)

zipWithM_ :: Applicative m => (a -> b -> m c) -> [a] -> [b] -> m ()
zipWithM_ f xs ys = zipWithM f xs ys *> pure ()

replicateM :: Applicative m => Int -> m a -> m [a]
replicateM n ma = case n <= 0 of
  True -> pure []
  False -> liftA2 (\z zs -> z : zs) ma (replicateM (n - 1) ma)

replicateM_ :: Applicative m => Int -> m a -> m ()
replicateM_ n ma = case n <= 0 of
  True -> pure ()
  False -> ma *> replicateM_ (n - 1) ma

msum :: MonadPlus m => [m a] -> m a
msum xs = case xs of
  [] -> mzero
  x : rest -> mplus x (msum rest)

mfilter :: MonadPlus m => (a -> Bool) -> m a -> m a
mfilter p ma = ma >>= (\x -> case p x of
  True -> pure x
  False -> mzero)

liftM :: Monad m => (a1 -> r) -> m a1 -> m r
liftM f ma = ma >>= (\a -> pure (f a))

liftM2 :: Monad m => (a1 -> a2 -> r) -> m a1 -> m a2 -> m r
liftM2 f ma mb = ma >>= (\a -> mb >>= (\b -> pure (f a b)))

ap :: Monad m => m (a -> b) -> m a -> m b
ap mf ma = mf >>= (\f -> ma >>= (\a -> pure (f a)))

instance Monad Maybe where
  (>>=) mx f = case mx of
    Nothing -> Nothing
    Just x -> f x

instance MonadPlus Maybe
