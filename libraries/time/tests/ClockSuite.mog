-- Data.Time.Clock: UTCTime, DiffTime/NominalDiffTime, diffUTCTime/addUTCTime,
-- conversions and the live clock.

module ClockSuite (clockSuite) where

import Data.Time.Calendar
import Data.Time.Clock
import Support (assertTrue, expect)

clockSuite :: IO ()
clockSuite = do
  expect "epoch shows UTC" (show (utcTimeFromUnix 0)) "1970-01-01 00:00:00 UTC"
  expect "next day" (show (utcTimeFromUnix 86400)) "1970-01-02 00:00:00 UTC"
  expect "pre-epoch second" (show (utcTimeFromUnix (-1))) "1969-12-31 23:59:59 UTC"
  expect "leap day noon" (show (utcTime (fromGregorian 2024 2 29) (secondsToDiffTime (12 * 3600)))) "2024-02-29 12:00:00 UTC"
  expect "diff of 90 seconds" (show (nominalDiffTimeToSeconds (diffUTCTime (utcTimeFromUnix 90) (utcTimeFromUnix 0)))) "90"
  expect "diff negative" (show (nominalDiffTimeToSeconds (diffUTCTime (utcTimeFromUnix 0) (utcTimeFromUnix 90)))) "-90"
  expect "add a day" (show (addUTCTime (secondsToNominalDiffTime 86400) (utcTimeFromUnix 0))) "1970-01-02 00:00:00 UTC"
  expect "add negative crosses midnight" (show (addUTCTime (secondsToNominalDiffTime (-1)) (utcTimeFromUnix 0))) "1969-12-31 23:59:59 UTC"
  expect "add normalizes fractions" (show (addUTCTime (picosecondsToNominalDiffTime 1500000000000) (utcTimeFromUnix 0))) "1970-01-01 00:00:01.5 UTC"
  expect "seconds roundtrip" (show (nominalDiffTimeToSeconds (secondsToNominalDiffTime 12345))) "12345"
  expect "picos roundtrip" (show (nominalDiffTimeToPicoseconds (picosecondsToNominalDiffTime 123))) "123"
  expect "diffTime seconds" (show (diffTimeToSeconds (secondsToDiffTime 7))) "7"
  expect "Num adds durations" (show (nominalDiffTimeToSeconds (secondsToNominalDiffTime 40 + secondsToNominalDiffTime 2))) "42"
  expect "utctDay" (show (utctDay (utcTimeFromUnix 0))) "1970-01-01"
  assertTrue "Ord orders" (utcTimeFromUnix 1 > utcTimeFromUnix 0)
  t <- getCurrentTime
  assertTrue "clock runs forward" (toModifiedJulianDay (utctDay t) > 0)
  n <- getMonotonicNanos
  assertTrue "monotonic clock reads" (n >= 0)
