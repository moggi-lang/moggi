module Data.Time.Clock.System.DotNet
  ( systemParts
  ) where

import Control.Applicative
import Control.Monad
import Data.Int
import Data.Num
import Data.Time.Calendar (Day)
import Moggi.Internal.Base
import Moggi.Internal.Prim
import System.IO.Base (IO)

foreign dotnet type DateTimeOffset "System.DateTimeOffset"

foreign dotnet function dtoUtcNow "System.DateTimeOffset:get_UtcNow" :: IO DateTimeOffset
foreign dotnet function dtoToUnixTimeSeconds "System.DateTimeOffset.ToUnixTimeSeconds" :: DateTimeOffset -> Int
foreign dotnet function dtoMillisecond "System.DateTimeOffset.get_Millisecond" :: DateTimeOffset -> Int32

-- Millisecond resolution from a single reading: both parts come from the
-- same value, so they can never straddle a second. 'Millisecond' returns a
-- .NET Int32, so the FFI type is 'Int32' widened with 'fromIntegral'.
systemParts :: IO (Int, Int)
systemParts = do
  now <- dtoUtcNow
  pure (dtoToUnixTimeSeconds now, fromIntegral (dtoMillisecond now) * 1000000)
