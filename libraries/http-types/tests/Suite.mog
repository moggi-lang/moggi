-- The http-types package's test entry point.
--
-- One module covers the package's behaviour, porting the upstream Haskell specs
-- (`HeaderSpec`, `MethodSpec`, `StatusSpec`, `URISpec`, `VersionSpec`) case for
-- case where they are deterministic. QuickCheck properties become fixed
-- samples, and the `Settings`/pattern-synonym matches become constructor
-- matches, since Moggi has no pattern synonyms.
--
-- The module is named `Suite`, not `Main`: the descriptor's `[test-suite]`
-- declares `main = Suite`, and a package may carry more than one executable,
-- so an entry point cannot be identified by being called `Main`.

module Suite (main) where

import Data.Bool (Bool(..), (&&), not)
import Data.Bounded (Bounded(..))
import Data.ByteString (ByteString)
import Data.ByteString.Builder.Internal (toByteString)
import Data.CaseInsensitive qualified as CI
import Data.Either (Either(..))
import Data.Enum (Enum(..))
import Data.Eq ((==))
import Data.Foldable (mapM_)
import Data.List (any, filter, map)
import Data.Maybe (Maybe(..))
import Data.Ord (Ordering(..), compare, (<), (>))
import Data.String (String)
import Data.String.Encoding (encodeUtf8)
import Network.HTTP.Types
import System.Exit (die)

-- The package works on 'ByteString', while a literal in Moggi is a 'String'.
bs :: String -> ByteString
bs = encodeUtf8

assertTrue :: String -> Bool -> IO ()
assertTrue name ok = case ok of
  True -> pure ()
  False -> die ("FAIL: " <> name)

-- ---------------------------------------------------------------------------
-- Helpers mirroring the upstream spec shapes.

checkHeader :: (HeaderName, String) -> IO ()
checkHeader entry = case entry of
  (hdr, name) -> assertTrue ("header " <> name) (hdr == CI.mk (bs name))

allMethods :: [Method]
allMethods = map renderStdMethod (enumFromTo minBound maxBound)

checkStatus :: (Status, Status, Int, String) -> IO ()
checkStatus entry = case entry of
  (st, alias, code, msg) -> do
    assertTrue ("status alias " <> show code) (st == alias)
    assertTrue ("status code " <> show code) (statusCode st == code)
    assertTrue ("status message " <> show code) (statusMessage st == bs msg)

statusOf :: (Status, Status, Int, String) -> Status
statusOf (st, _, _, _) = st

allStatuses :: [Status]
allStatuses = map statusOf statusTable

statusesIn :: Int -> [Status]
statusesIn hundred = filter (\s -> div (statusCode s) 100 == hundred) allStatuses

notInCodes :: [Status] -> Status -> Bool
notInCodes yes s = not (any (\y -> statusCode y == statusCode s) yes)

checkCategory :: String -> (Status -> Bool) -> [Status] -> IO ()
checkCategory name p yes = do
  mapM_ (\s -> assertTrue (name <> " accepts " <> show (statusCode s)) (p s)) yes
  mapM_
    (\s -> assertTrue (name <> " rejects " <> show (statusCode s)) (not (p s)))
    (filter (notInCodes yes) allStatuses)

checkVersion :: (String, HttpVersion, HttpVersion) -> IO ()
checkVersion entry = case entry of
  (rendered, v1, v2) -> do
    assertTrue ("version literal " <> rendered) (v1 == v2)
    assertTrue ("version show " <> rendered) (show v1 == rendered)

-- ---------------------------------------------------------------------------
