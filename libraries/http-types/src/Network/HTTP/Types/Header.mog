-- | An individual byte range. Used in @Range@ request headers.
-- This type and its accompanying functions are /NOT/ compatible with the
-- @Content-Range@ response header.
--
-- Negative indices are not allowed!
data ByteRange
  = ByteRangeFrom Integer
  | ByteRangeFromTo Integer Integer
  | ByteRangeSuffix Integer
  deriving (Show, Eq, Ord)

-- | Turns a byte range into a byte string 'Builder'.
renderByteRangeBuilder :: ByteRange -> Builder
renderByteRangeBuilder range = case range of
  ByteRangeFrom from -> BB.integerDec from <> BB.word8 _hyphen
  ByteRangeFromTo from to -> BB.integerDec from <> BB.word8 _hyphen <> BB.integerDec to
  ByteRangeSuffix suffix -> BB.word8 _hyphen <> BB.integerDec suffix

-- | Renders a byte range into a 'B.ByteString'.
--
-- >>> renderByteRange (ByteRangeFrom 2048)
-- "2048-"
renderByteRange :: ByteRange -> ByteString
renderByteRange br = toByteString (renderByteRangeBuilder br)

-- | A list of byte ranges.
type ByteRanges = [ByteRange]

-- | Turns a list of byte ranges into a byte string 'Builder'.
renderByteRangesBuilder :: ByteRanges -> Builder
renderByteRangesBuilder ranges =
  BB.byteString "bytes="
    <> mconcat (intersperse (BB.word8 _comma) (map renderByteRangeBuilder ranges))

-- | Renders a list of byte ranges into a 'B.ByteString'.
--
-- >>> renderByteRanges [ByteRangeFrom 2048, ByteRangeSuffix 20]
-- "bytes=2048-,-20"
renderByteRanges :: ByteRanges -> ByteString
renderByteRanges brs = toByteString (renderByteRangesBuilder brs)

-- | Parse the value of a Range header into a 'ByteRanges'.
--
-- >>> parseByteRanges "error"
-- Nothing
-- >>> parseByteRanges "bytes=0-499"
-- Just [ByteRangeFromTo 0 499]
-- >>> parseByteRanges "bytes=-500"
-- Just [ByteRangeSuffix 500]
-- >>> parseByteRanges "bytes=9500-"
-- Just [ByteRangeFrom 9500]
-- >>> parseByteRanges "bytes=0-0,-1"
-- Just [ByteRangeFromTo 0 0,ByteRangeSuffix 1]
parseByteRanges :: ByteString -> Maybe ByteRanges
parseByteRanges bs1 =
  let prefix = "bytes=" :: ByteString
      split = B.splitAt (B.length prefix) bs1
  in if fst split == prefix
       then case parseRange (snd split) of
         Nothing -> Nothing
         Just r -> parseRanges (fst r) (snd r)
       else Nothing

parseRange :: ByteString -> Maybe (ByteRange, ByteString)
parseRange bs2 = case B8.readInteger bs2 of
  Nothing -> Nothing
  Just i ->
    if fst i < 0
      then Just (ByteRangeSuffix (negate (fst i)), snd i)
      else case startsWithHyphen bs2 of
        -- A suffix of zero is not satisfiable: "-0" reaches the parser as a
        -- non-negative zero whose input still carries the sign.
        True -> Nothing
        False -> case popByte _hyphen (snd i) of
          Nothing -> Just (ByteRangeFrom (fst i), snd i)
          Just bs4 -> case B8.readInteger bs4 of
            Just j ->
              if fst j >= fst i
                then Just (ByteRangeFromTo (fst i) (fst j), snd j)
                else Just (ByteRangeFrom (fst i), bs4)
            Nothing -> Just (ByteRangeFrom (fst i), bs4)

startsWithHyphen :: ByteString -> Bool
startsWithHyphen bs = case B.uncons bs of
  Nothing -> False
  Just b -> fst b == _hyphen

parseRanges :: ByteRange -> ByteString -> Maybe ByteRanges
parseRanges r bs3 = case B.null bs3 of
  True -> Just [r]
  False -> case popByte _comma bs3 of
    Nothing -> Nothing
    Just bs4 -> case parseRange bs4 of
      Nothing -> Nothing
      Just next -> case parseRanges (fst next) (snd next) of
        Nothing -> Nothing
        Just rest -> Just (r : rest)

popByte :: Word8 -> ByteString -> Maybe ByteString
popByte w8 bs = case B.uncons bs of
  Nothing -> Nothing
  Just b -> if fst b == w8 then Just (snd b) else Nothing

_comma :: Word8
_comma = 44

_hyphen :: Word8
_hyphen = 45
