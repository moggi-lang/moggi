{-# LANGUAGE NoImplicitPrelude #-}
-- | Types and constants to describe HTTP status codes.
--
-- At the bottom are some functions to check if a given 'Status' is from a
-- certain category. (i.e. @1XX@, @2XX@, etc.)
--
-- Porting notes: the upstream low-level @renderStatusCodeToPtr@ and
-- @renderFullStatusToPtr@ are absent -- base has no 'Foreign.Ptr' and no
-- pointer writes. 'renderStatusCode' and 'renderFullStatus' produce the same
-- bytes by packing the digits instead. The @StatusCode@ pattern synonym is
-- not provided either; match on the 'Status' constructor. The 'Data.Data.Data'
-- and 'GHC.Generics.Generic' derivations are absent with those libraries.
module Network.HTTP.Types.Status
  ( -- * HTTP Status
    Status(..)
  , mkStatus

    -- ** Parsing and Rendering
  , parseStatusCode
  , renderStatusCode
  , parseFullStatus
  , renderFullStatus

