-- | Informational class
--
-- Checks if the status is in the 1XX range.
statusIsInformational :: Status -> Bool
statusIsInformational status = case status of
  Status code _ -> code >= 100 && code < 200

-- | Successful class
--
-- Checks if the status is in the 2XX range.
statusIsSuccessful :: Status -> Bool
statusIsSuccessful status = case status of
  Status code _ -> code >= 200 && code < 300

-- | Redirection class
--
-- Checks if the status is in the 3XX range.
statusIsRedirection :: Status -> Bool
statusIsRedirection status = case status of
  Status code _ -> code >= 300 && code < 400

-- | Client Error class
--
-- Checks if the status is in the 4XX range.
statusIsClientError :: Status -> Bool
statusIsClientError status = case status of
  Status code _ -> code >= 400 && code < 500

-- | Server Error class
--
-- Checks if the status is in the 5XX range.
statusIsServerError :: Status -> Bool
statusIsServerError status = case status of
  Status code _ -> code >= 500 && code < 600

-- | Render the 3 digit 'Status' code into a 'ByteString'.
renderStatusCode :: Status -> ByteString
renderStatusCode status = case status of
  Status code _ ->
    if code >= 1000
      then encodeUtf8 (show status)
      else
        B8.pack (digitString code)

digit3 :: Int -> Char
digit3 x = chr (48 + x)

digitString :: Int -> String
digitString code =
  showChar (digit3 (div code 100))
    (showChar (digit3 (div (mod code 100) 10))
      (showChar (digit3 (mod code 10)) ""))

-- | Render the full 'Status' code with status message into a 'ByteString'.
renderFullStatus :: Status -> ByteString
renderFullStatus status = case status of
  Status code msg ->
    if code >= 1000
      then encodeUtf8 (show code) <> encodeUtf8 " " <> msg
      else renderStatusCode status <> encodeUtf8 " " <> msg

-- | Parses the first three characters as digits and converts them to an 'Int'.
--
-- If the first 3 characters are not digits (i.e. @0-9@), or the 'ByteString'
-- is less than 3 bytes long, the result will be 'Nothing'.
--
-- When successful, it will return the parsed status code and the remainder of
-- the 'ByteString'.
--
-- >>> parseStatusCode "307"
-- Just (307,"")
--
-- >>> parseStatusCode "404 Not Found"
-- Just (404," Not Found")
--
-- >>> parseStatusCode "No Digits"
-- Nothing
--
-- >>> parseStatusCode "12 Is Not Enough Digits"
-- Nothing
parseStatusCode :: ByteString -> Maybe (Int, ByteString)
parseStatusCode bs = case B8.uncons bs of
  Nothing -> Nothing
  Just p1 -> case B8.uncons (snd p1) of
    Nothing -> Nothing
    Just p2 -> case B8.uncons (snd p2) of
      Nothing -> Nothing
      Just p3 -> case toNumber (fst p1) of
        Nothing -> Nothing
        Just h -> case toNumber (fst p2) of
          Nothing -> Nothing
          Just t -> case toNumber (fst p3) of
            Nothing -> Nothing
            Just i -> Just (h * 100 + t * 10 + i, B.drop 3 bs)

toNumber :: Char -> Maybe Int
toNumber c =
  if c >= '0' && c <= '9'
    then Just (ord c - 48)
    else Nothing

-- | Assumes the provided 'ByteString' is either:
--
--   * only 3 digits, or
--   * 3 digits, a space, and the rest of the status message
--
-- /N.B. this function does not check for newlines, it puts everything/
-- /after the code and space into the 'statusMessage'./
--
-- >>> parseFullStatus "307"
-- Just (Status {statusCode = 307, statusMessage = ""})
--
-- >>> parseFullStatus "404 Not Found"
-- Just (Status {statusCode = 404, statusMessage = "Not Found"})
--
-- >>> parseFullStatus "1337 Is A Bad Status Code"
-- Nothing
--
-- >>> parseFullStatus "101Still Needs A Space"
-- Nothing
--
-- >>> parseFullStatus "No Digits"
-- Nothing
parseFullStatus :: ByteString -> Maybe Status
parseFullStatus bs = case parseStatusCode bs of
  Nothing -> Nothing
  Just parsed -> case B.uncons (snd parsed) of
    Nothing -> Just (mkStatus (fst parsed) (encodeUtf8 ""))
    Just rest ->
      if fst rest == 32
        then Just (mkStatus (fst parsed) (snd rest))
        else Nothing
