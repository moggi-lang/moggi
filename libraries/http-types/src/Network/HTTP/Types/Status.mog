-- | HTTP Status.
--
-- Only the 'statusCode' is used for comparisons.
--
-- /Please use 'mkStatus' to create status codes from code and message, or the 'Enum' instance or the/
-- /status code constants (like 'ok200'). There might be additional record members in the future./
--
-- Note that the 'Show' instance is only for debugging.
data Status = Status { statusCode :: Int, statusMessage :: ByteString }
  deriving (Show)

-- | A 'Status' is equal to another 'Status' if the status codes are equal.
instance Eq Status where
  (==) a b = statusCode a == statusCode b

-- | 'Status'es are ordered according to their status codes only.
instance Ord Status where
  compare a b = compare (statusCode a) (statusCode b)

-- | Be advised, that when using the @enumFrom*@ family of methods or
-- ranges in lists, it will generate all possible status codes.
--
-- E.g. @[status100 .. status200]@ generates 'Status'es of @100, 101, 102 .. 198, 199, 200@
--
-- The statuses not included in this library will have an empty message.
instance Enum Status where
  fromEnum status = statusCode status
  toEnum code = case code of
    100 -> status100
    101 -> status101
    200 -> status200
    201 -> status201
    202 -> status202
    203 -> status203
    204 -> status204
    205 -> status205
    206 -> status206
    300 -> status300
    301 -> status301
    302 -> status302
    303 -> status303
    304 -> status304
    305 -> status305
    307 -> status307
    308 -> status308
    400 -> status400
    401 -> status401
    402 -> status402
    403 -> status403
    404 -> status404
    405 -> status405
    406 -> status406
    407 -> status407
    408 -> status408
    409 -> status409
    410 -> status410
    411 -> status411
    412 -> status412
    413 -> status413
    414 -> status414
    415 -> status415
    416 -> status416
    417 -> status417
    418 -> status418
    422 -> status422
    426 -> status426
    428 -> status428
    429 -> status429
    431 -> status431
    451 -> status451
    500 -> status500
    501 -> status501
    502 -> status502
    503 -> status503
    504 -> status504
    505 -> status505
    511 -> status511
    c -> mkStatus c B.empty

instance Bounded Status where
  minBound = status100
  maxBound = status511

-- | Create a 'Status' from a status code and message.
mkStatus :: Int -> ByteString -> Status
mkStatus = Status

