module System.FilePath.Units.PHP
  ( unitsLength
  , takeUnits
  , dropUnits
  ) where

import Moggi.Internal.Prim

foreign php function rawStrlen "strlen" :: String -> Int

foreign php function rawSubstr "substr" :: String -> Int -> Int -> String

-- | On PHP a `String` is the host byte string, so units are bytes and every
-- byte sequence — valid UTF-8 or not — keeps its exact bytes.
unitsLength :: String -> Int
unitsLength s = rawStrlen s

takeUnits :: Int -> String -> String
takeUnits n s = case intCompare# n 0 of
  GT -> case intCompare# n (unitsLength s) of
    LT -> rawSubstr s 0 n
    _ -> s
  _ -> ""

dropUnits :: Int -> String -> String
dropUnits n s = case intCompare# n 0 of
  GT -> case intCompare# n (unitsLength s) of
    LT -> rawSubstr s n (intSub# (unitsLength s) n)
    _ -> ""
  _ -> s
