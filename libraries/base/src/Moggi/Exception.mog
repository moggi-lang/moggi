{-# LANGUAGE NoImplicitPrelude #-}

-- | Exceptions and exception-handling functions.
--
-- `Exception` carries `(Typeable e, Show e)` as its superclasses, and
-- `SomeException` is the compiler-provided tagged value, with @base@'s
-- constructor available as the 'SomeException' pattern. `Moggi.Stack` provides
-- `CallStack` and `SrcLoc`; the call stack is a runtime snapshot rather than
-- a compile-time implicit stack.
module Moggi.Exception
  ( Exception(..)
  , SomeException
  , pattern SomeException
  , throw
  , ArithException(..)
  , divZeroException
  , overflowException
  , ratioZeroDenomException
  , underflowException
  , ErrorCall(..)
  , errorCallException
  ) where

import Moggi.Exception.Type
import Moggi.Internal.Base
import Moggi.Internal.Prim

throw :: (HasCallStack, Exception e) => e -> a
throw e = exceptionThrow# (toException e)

errorCallException :: String -> SomeException
errorCallException s = toException (ErrorCall s)
