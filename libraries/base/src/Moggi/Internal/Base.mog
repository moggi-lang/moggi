{-# LANGUAGE NoImplicitPrelude #-}
{-# BACKEND
  php = Moggi.Internal.Base.PHP
  jvm = Moggi.Internal.Base.JVM
  dotnet = Moggi.Internal.Base.DotNet
#-}
-- | The bottom of the library: the readable names of the machine's types.
--
-- 'Moggi.Internal.Prim' owns the MagicHash layer — @Int#@, @String#@, @List#@
-- and the primops over them. This module gives those types the names a
-- signature writes and a program reads: 'Int' (and its widths), 'Word' (and its
-- widths), 'Integer', 'Double', 'Char', 'String' and 'List'.
--
-- They have to be declared here, and not in the module that owns each type's
-- API, because the library's own bottoms and class modules name them while
-- sitting *below* those modules:
--
-- * @Moggi.Err@'s @error :: String -> a@ and @Text.Read@'s @read :: String -> a@
--   are the library's bottom (only 'Moggi.Internal.Prim' is below them), and
--   @Data.String@ needs `Data.Char` and `Data.Int` and so sits above both.
-- * @Data.Num@'s @fromInteger :: Integer -> a@ and its @Num Int@/@Num Word@
--   instances sit below @Data.Integer@, @Data.Int@ and @Data.Word@, because
--   @Data.Foldable@'s @length :: t a -> Int@ and @Control.Monad@'s @replicateM@
--   are written at 'Int' and are below those modules.
-- * @Data.Char@'s machine modules read a numeric value out of a @Char@ as a
--   'Double' (`IntlChar:getNumericValue`), and they sit below @Data.Double@ —
--   which imports @Data.Char@ — so they cannot import the name back.
-- * @Text.Show@'s @showChar :: Char -> ShowS@ sits below @Data.Char@.
-- * every module that writes @[a]@ names 'List', and those modules
--   (@Text.Show@, @Data.Enum@, @Data.Monad@, @Data.Foldable@) sit below
--   @Data.List@.
-- * @Data.Char@ reads a character out of a string literal: that walk needs the
--   scalars of a string and a slice of one, so the backend's 'unpack', 'take'
--   and 'drop' live here too — @Data.Char@ sits below @Data.String@, which is
--   where the public string API is.
--
-- So the names live at the one place no library module is below, and the public
-- modules re-export them: @Data.Int@ and @Data.Word@ keep their instances and
-- operations, @Data.String@ and @Data.List@ their operations, and each of them
-- exports the name from here. This module declares `String`, `Char`, `Int`, `Word`, the list type
-- and the `Integer` synonym over the kernel's own arbitrary-precision integer.
--
-- `Type`, the kind a signature writes in a kind annotation, is not declared:
-- the compiler parses it as a keyword wherever a kind is expected. It is
-- re-exported from here all the same, so `Data.Kind` has something to name.
--
-- The classes the machine's own types are compared with are declared here too
-- ('Eq', 'Ord') along with the two types their methods answer in ('Bool',
-- 'Ordering'): a class has to be visible to the module that derives an instance
-- for a type declared here, and `Data.Eq` sits above every module that compares
-- an 'Int' or a 'String'. The scalar types' instances stay in the public
-- modules; 'NonEmpty' is derived here, next to its declaration.
module Moggi.Internal.Base
  ( Int
  , Int8
  , Int16
  , Int32
  , Int64
  , Word
  , Word8
  , Word16
  , Word32
  , Word64
  , Integer
  , Double
  , Char
  , String
  , List
  , unpack
  , take
  , drop
  , NonEmpty(..)
  , Bool(..)
  , Ordering(..)
  , Eq(..)
  , Ord(..)
  , (&&)
  , (||)
  , not
  , otherwise
  , Type
  ) where

import Moggi.Internal.Prim

-- | A signed 64-bit integer, the same width on every backend: Java and C#
-- take the host's 64-bit `long`, and PHP's own `int` is 64-bit too (a 64-bit
-- PHP build is required — the compiler and every emitted entry module abort
-- when `PHP_INT_SIZE < 8`). It wraps on overflow, so `maxBound + 1` is
-- `minBound` everywhere.
type Int = Int#

-- | 8-bit signed integer type
type Int8 = Int8#

-- | 16-bit signed integer type
type Int16 = Int16#

-- | 32-bit signed integer type
type Int32 = Int32#

-- | 64-bit signed integer type
type Int64 = Int64#

-- | A 'Word' is an unsigned integral type, with the same size as 'Int'.
type Word = Word#

-- | 8-bit unsigned integer type
type Word8 = Word8#

-- | 16-bit unsigned integer type
type Word16 = Word16#

-- | 32-bit unsigned integer type
type Word32 = Word32#

-- | 64-bit unsigned integer type
type Word64 = Word64#

-- Arbitrary-precision integer. Its operations are @Data.Integer@'s.
type Integer = Integer#

-- | IEEE binary64, the same on every backend. Its operations and instances are
-- @Data.Double@'s.
type Double = Double#

-- Char = Unicode scalar value (U+0000..U+10FFFF excluding surrogates).
-- Not a grapheme. Classification/case use the backend Unicode database.
-- Grapheme segmentation and normalization are separate APIs.
type Char = Char#

-- | String is an opaque backend-native representation of a sequence of Char
-- (Unicode scalar values). The sequence model is semantic only: String does
-- not expose list operations or guarantee scalar indexing complexity.
-- Equality is scalar-sequence identity (no implicit normalization).
type String = String#

-- | The list type, whose syntax is `[a]`. Its operations are `Data.List`'s.
type List = List#

-- | The scalars of a string, left to right.
unpack :: String -> [Char]

-- | The prefix of @s@ holding its first @n@ scalars.
--
-- A count past the end gives the whole string; a non-positive count gives
-- @""@.
take :: Int -> String -> String

-- | @s@ without its first @n@ scalars.
--
-- A count at or past the end gives @""@; a non-positive count leaves @s@
-- unchanged.
drop :: Int -> String -> String

infix 4 ==, /=
infix 4 <, <=, >, >=
infixr 5 :|

-- | The type of truth values: 'False' and 'True'. A @case@ on a 'Bool' is
-- the primitive branch of the language.
data Bool = False | True

infixr 3 &&
infixr 2 ||

-- | Conjunction: 'True' only when both operands are 'True'. The right operand
-- is not evaluated when the left one is 'False'.
(&&) :: Bool -> Bool -> Bool
(&&) a b = boolAnd# a b

-- | Disjunction: 'True' when either operand is 'True'. The right operand is not
-- evaluated when the left one is 'True'.
(||) :: Bool -> Bool -> Bool
(||) a b = boolOr# a b

-- | Negation: 'True' becomes 'False' and 'False' becomes 'True'.
not :: Bool -> Bool
not b = boolNot# b

-- |'otherwise' is defined as the value 'True'.  It helps to make
-- guards more readable.  eg.
--
-- >  f x | x < 0     = ...
-- >      | otherwise = ...
otherwise :: Bool
otherwise = True

-- | The result of a comparison: 'LT', 'EQ' or 'GT'.
data Ordering = LT | EQ | GT

-- | The 'Eq' class defines equality ('==') and inequality ('/=').
-- All the basic datatypes are instances of 'Eq', and 'Eq' may be derived for
-- any datatype whose constituents are also instances of 'Eq'.
--
-- Instances are encouraged to follow these properties:
--
-- [__Reflexivity__]: @x == x@ = 'True'
-- [__Symmetry__]: @x == y@ = @y == x@
-- [__Transitivity__]: if @x == y && y == z@ = 'True', then @x == z@ = 'True'
-- [__Extensionality__]: if @x == y@ = 'True' and @f@ is a function
-- whose return type is an instance of 'Eq', then @f x == f y@ = 'True'
-- [__Negation__]: @x /= y@ = @not (x == y)@
class Eq a where
  {-# MINIMAL (==) | (/=) #-}
  (==), (/=) :: a -> a -> Bool

  (/=) x y = boolNot# (x == y)
  (==) x y = boolNot# (x /= y)

-- | The 'Ord' class is used for totally ordered datatypes.
class Eq a => Ord a where
  compare :: a -> a -> Ordering
  (<), (<=), (>), (>=) :: a -> a -> Bool
  max, min :: a -> a -> a

  compare x y = case x == y of
    True -> EQ
    False -> case x <= y of
      True -> LT
      False -> GT

  (<=) x y = case compare x y of
    GT -> False
    _ -> True
  (>=) x y = case compare x y of
    LT -> False
    _ -> True
  (>) x y = case compare x y of
    GT -> True
    _ -> False
  (<) x y = case compare x y of
    LT -> True
    _ -> False

  -- These two default methods use '<=' rather than 'compare'
  -- because the latter is often more expensive
  max x y = case x <= y of
    True -> y
    False -> x
  min x y = case x <= y of
    True -> x
    False -> y
  {-# MINIMAL compare | (<=) #-}

-- | A non-empty list: a head element followed by a possibly empty tail. The
-- `sconcat` method of 'Semigroup' names it, and the module that declares the
-- class cannot import the module that implements the type, so the type is
-- declared here. Its combinators are @Data.List.NonEmpty@'s.
data NonEmpty a = a :| [a]
  deriving (Eq, Ord)
