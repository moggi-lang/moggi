{-# LANGUAGE NoImplicitPrelude #-}
-- | File-descriptor type used by @Control.Concurrent@'s wait operations.
module Moggi.Internal.System.Posix.Types (Fd(..)) where

import Data.Bool (Bool(..))
import Data.Eq (Eq)
import Data.Int (Int)
import Data.Ord (Ord(..), Ordering(..))
import Text.Show

-- | A host file descriptor.
newtype Fd = Fd Int deriving (Eq, Ord, Show)
