{-# LANGUAGE NoImplicitPrelude #-}

module Moggi.Err
  ( error
  , errorWithoutStackTrace
  , undefined
  ) where

import Moggi.Internal.Base
import Moggi.Internal.Prim

error :: HasCallStack => String -> a
error msg = error# msg

-- | A variant of 'error' that reports no call stack.
--
-- The raise carries no throw site, so an uncaught report prints the message
-- without a @CallStack@ section, as in @base@.
errorWithoutStackTrace :: String -> a
errorWithoutStackTrace msg = errorWithoutStackTrace# msg

undefined :: HasCallStack => a
undefined = error "Prelude.undefined"
