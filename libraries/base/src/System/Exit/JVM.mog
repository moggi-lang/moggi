module System.Exit.JVM
  ( exitWithCode
  ) where

import Data.Int
import Moggi.Internal.Base
import Moggi.Internal.Prim

foreign jvm function rawExit "java.lang.System:exit" :: Int32 -> IO ()

exitWithCode :: Int -> IO a
exitWithCode code = do
  _ <- rawExit (int32FromInt# code)
  pure (error "exit")
