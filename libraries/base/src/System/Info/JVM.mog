module System.Info.JVM
  ( os
  , arch
  ) where

import Data.String (isPrefixOf)

foreign jvm function rawGetProperty "java.lang.System:getProperty" :: String -> String

-- | `os.name` in GHC's `System.Info.os` spelling. The property carries
-- versions and vendor spellings (`Windows 11`, `Mac OS X`, `macOS`), so this
-- matches on prefixes; anything unrecognized answers @"unknown"@ rather than
-- guessing.
os :: String
os = normaliseOs (rawGetProperty "os.name")

normaliseOs :: String -> String
normaliseOs n
  | isPrefixOf "Windows" n = "mingw32"
  | isPrefixOf "Darwin" n = "darwin"
  | isPrefixOf "Mac OS X" n = "darwin"
  | isPrefixOf "macOS" n = "darwin"
  | isPrefixOf "Linux" n = "linux"
  | isPrefixOf "FreeBSD" n = "freebsd"
  | isPrefixOf "SunOS" n = "solaris"
  | otherwise = "unknown"

-- | `os.arch` in GHC's `System.Info.arch` spelling. The JVM reports the
-- hardware's own name (`amd64`, `aarch64`, `x86`), which is folded onto the
-- spelling the rest of the table uses.
arch :: String
arch = normaliseArch (rawGetProperty "os.arch")

normaliseArch :: String -> String
normaliseArch a = case a of
  "amd64" -> "x86_64"
  "x86_64" -> "x86_64"
  "aarch64" -> "aarch64"
  "arm64" -> "aarch64"
  "x86" -> "i386"
  "i386" -> "i386"
  "i686" -> "i386"
  "ppc64le" -> "powerpc64le"
  "ppc64" -> "powerpc64"
  "riscv64" -> "riscv64"
  "s390x" -> "s390x"
  _ -> a
