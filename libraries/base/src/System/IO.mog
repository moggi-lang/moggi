{-# LANGUAGE NoImplicitPrelude #-}
{-# BACKEND
  php = System.IO.PHP
  jvm = System.IO.JVM
  dotnet = System.IO.DotNet
#-}
-- |
-- Files, and the three handles every program starts with: 'stdin', 'stdout' and
-- 'stderr'. An 'IO' value is a description of something that happens once it is
-- run, which is why opening a file produces a 'Handle' inside 'IO' and why
-- 'hClose' has to be called rather than being implied.
--
-- A program usually needs neither 'openFile' nor 'hClose' for a whole file: the
-- functions here that take a path read or write it in one go and close it
-- before returning.
--
-- This is the plain stream surface, deliberately: buffering, text encodings,
-- seeking and binary mode are not defined here, and neither is the ability to
-- read or write a file as bytes without a character encoding. A program that
-- needs one of those is better served by 'Data.ByteString.Char8', which owns
-- the byte-level file operations.
module System.IO
  ( IO
  , FilePath
  , Handle
  , IOMode(ReadMode, WriteMode, AppendMode, ReadWriteMode)
  , stdin
  , stdout
  , stderr
  , openFile
  , hClose
  , hPutStr
  , hPutStrLn
  , hPutChar
  , hGetChar
  , hGetLine
  , hFlush
  , hGetContents
  , hIsEOF
  , isEOF
  , hFileSize
  , hSetFileSize
  , readFile
  , readFile'
  , writeFile
  , appendFile
  , putStr
  , putStrLn
  , putChar
  , getChar
  , getLine
  , getContents
  , interact
  , readIO
  , readLn
  , print
  , withFile
  , openTempFile
  , openBinaryTempFile
  ) where

import Control.Applicative hiding (empty)
import Control.Exception (bracket)
import Control.Monad
import Data.Bool
import Data.Eq
import Data.Int
import Data.Integer
import Data.Maybe (Maybe)
import Data.Ord
import Moggi.Internal.Base
import Text.Show
import Text.Read
import System.IO.Base (IO, FilePath)
import Moggi.Internal.Prim
import System.IO.Types

stdin :: Handle

stdout :: Handle

stderr :: Handle

openFile :: FilePath -> IOMode -> IO Handle

hClose :: Handle -> IO ()

hPutStr :: Handle -> String -> IO ()

hPutStrLn :: Handle -> String -> IO ()

hPutChar :: Handle -> Char -> IO ()

hGetChar :: Handle -> IO Char

hGetLine :: Handle -> IO (Maybe String)

hFlush :: Handle -> IO ()

hGetContents :: Handle -> IO String

hIsEOF :: Handle -> IO Bool

hFileSize :: Handle -> IO Integer

hSetFileSize :: Handle -> Integer -> IO ()

putStr :: String -> IO ()

putStrLn :: String -> IO ()

putChar :: Char -> IO ()
putChar c = hPutChar stdout c

getChar :: IO Char
getChar = hGetChar stdin

getLine :: IO String

-- Strict: the whole input is read before anything is written.
getContents :: IO String
getContents = hGetContents stdin

interact :: (String -> String) -> IO ()
interact f = do
  s <- getContents
  putStr (f s)

readIO :: Read a => String -> IO a
readIO s = pure (read s)

readLn :: Read a => IO a
readLn = do
  s <- getLine
  readIO s

print :: Show a => a -> IO ()

isEOF :: IO Bool
isEOF = hIsEOF stdin

-- readFile and readFile' both read the whole file before returning.
readFile :: FilePath -> IO String
readFile p = do
  h <- openFile p ReadMode
  s <- hGetContents h
  hClose h
  pure s

readFile' :: FilePath -> IO String
readFile' p = readFile p

writeFile :: FilePath -> String -> IO ()
writeFile p s = do
  h <- openFile p WriteMode
  hPutStr h s
  hClose h

appendFile :: FilePath -> String -> IO ()
appendFile p s = do
  h <- openFile p AppendMode
  hPutStr h s
  hClose h

withFile :: FilePath -> IOMode -> (Handle -> IO r) -> IO r
withFile p mode use =
  bracket (openFile p mode) hClose use

-- | Create an empty file in a directory and open it for writing, answering
-- with its path and an open handle. The file's name starts with the template
-- and ends with random characters, so callers that create many of them do not
-- collide; remove it with 'System.Filesystem.removeFile' when done.
openTempFile :: FilePath -> String -> IO (FilePath, Handle)

-- | Moggi has no text/binary mode split, so this is 'openTempFile'.
openBinaryTempFile :: FilePath -> String -> IO (FilePath, Handle)
openBinaryTempFile dir template = openTempFile dir template
