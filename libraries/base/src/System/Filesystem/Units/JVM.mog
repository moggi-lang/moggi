module System.Filesystem.Units.JVM
  ( unitsLength
  , takeUnits
  , dropUnits
  ) where

import Data.Int (Int32)
import Moggi.Internal.Prim

foreign jvm function rawUtf16Length "java.lang.String.length" :: String -> Int32

foreign jvm function rawSubstring "java.lang.String.substring" :: String -> Int32 -> Int32 -> String

-- | Units are UTF-16 code units. Callers only cut at ASCII boundaries, so a
-- surrogate pair is never split in an answer (a half seen while scanning a
-- comparison just compares unequal).
unitsLength :: String -> Int
unitsLength s = int32ToInt# (rawUtf16Length s)

takeUnits :: Int -> String -> String
takeUnits n s = case intCompare# n 0 of
  GT -> case intCompare# n (unitsLength s) of
    LT -> rawSubstring s (int32FromInt# 0) (int32FromInt# n)
    _ -> s
  _ -> ""

dropUnits :: Int -> String -> String
dropUnits n s = case intCompare# n 0 of
  GT -> case intCompare# n (unitsLength s) of
    LT -> rawSubstring s (int32FromInt# n) (int32FromInt# (unitsLength s))
    _ -> ""
  _ -> s
