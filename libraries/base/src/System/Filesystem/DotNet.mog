module System.Filesystem.DotNet
  ( readFile
  , readTextFile
  , writeFile
  , writeTextFile
  , appendFile
  , appendTextFile
  , isFile
  , getModified
  , getSize
  , copyFile
  , copyFileContent
  , copyPermissions
  , removeFile
  , isDirectory
  , canonicalizePath
  , listDirectory
  , createDirectory
  , createTree
  , removeDirectory
  , removeTree
  , getWorkingDirectory
  , setWorkingDirectory
  , rename
  ) where

import Control.Applicative
import Control.Monad
import Data.Bool
import Data.ByteString (ByteString)
import Data.ByteString qualified as B
import Data.Char (ord, chr)
import Data.Int
import Data.List hiding (singleton, stripPrefix)
import Data.Num
import Data.Ord
import Data.Semigroup
import Data.String hiding (singleton, pack, unpack, length, take, drop, isPrefixOf, isSuffixOf)
import Data.String qualified as S
import Data.Time.Clock
import Data.Time.Clock.DotNet (DateTimeOffset, dtoToUnixTimeSeconds)
import Moggi.Err
import Moggi.Internal.Base
import System.IO.Base (IO, FilePath, packFilePath, unpackFilePath)
import Moggi.IO.Exception
import System.IO.Error (mkIOError)
import Text.Show
import Data.Maybe
import Moggi.Internal.Prim (word8FromInt#, word8ToInt#)
import Moggi.Internal.Prim

foreign dotnet type FileInfo "System.IO.FileInfo"
foreign dotnet type DateTime "System.DateTime"
foreign dotnet type DirectoryInfo "System.IO.DirectoryInfo"
foreign dotnet type Array "string[]"
foreign dotnet type BoxedObject "System.Object"

foreign dotnet function fileReadAllText "System.IO.File:ReadAllText" :: String -> IO String
foreign dotnet function fileWriteAllText "System.IO.File:WriteAllText" :: String -> String -> IO ()
foreign dotnet function fileAppendAllText "System.IO.File:AppendAllText" :: String -> String -> IO ()
foreign dotnet function fileExists "System.IO.File:Exists" :: String -> Bool
foreign dotnet function fileDelete "System.IO.File:Delete" :: String -> IO ()
foreign dotnet function fileCopy "System.IO.File:Copy" :: String -> String -> Bool -> IO ()
foreign dotnet function fileGetLastWriteTimeUtc "System.IO.File:GetLastWriteTimeUtc" :: String -> DateTime
foreign dotnet function dtoFromDateTime "System.DateTimeOffset:__con" :: DateTime -> DateTimeOffset
foreign dotnet function fileGetLength "System.IO.FileInfo.get_Length" :: FileInfo -> Int
foreign dotnet function newFileInfo "System.IO.FileInfo:__con" :: String -> FileInfo
foreign dotnet function directoryExists "System.IO.Directory:Exists" :: String -> Bool
foreign dotnet function directoryCreateDirectory "System.IO.Directory:CreateDirectory" :: String -> DirectoryInfo
foreign dotnet function directoryDelete "System.IO.Directory:Delete" :: String -> Bool -> IO ()
foreign dotnet function directoryGetFiles "System.IO.Directory:GetFiles" :: String -> IO Array
foreign dotnet function directoryGetDirectories "System.IO.Directory:GetDirectories" :: String -> IO Array
foreign dotnet function directoryGetCurrentDirectory "System.IO.Directory:GetCurrentDirectory" :: IO String
foreign dotnet function directorySetCurrentDirectory "System.IO.Directory:SetCurrentDirectory" :: String -> IO ()
foreign dotnet function directoryMove "System.IO.Directory:Move" :: String -> String -> IO ()
foreign dotnet function fileMove "System.IO.File:Move" :: String -> String -> IO ()
foreign dotnet function pathGetFullPath "System.IO.Path:GetFullPath" :: String -> String
foreign dotnet function pathGetFileName "System.IO.Path:GetFileName" :: String -> String
foreign dotnet function rawArrLength "System.Array.get_Length" :: Array -> Int32
foreign dotnet function rawArrGet "System.Array.GetValue" :: Array -> Int32 -> BoxedObject
foreign dotnet function stringValueOf "System.Convert:ToString" :: BoxedObject -> String

arrLength arr = int32ToInt# (rawArrLength arr)

arrGet arr i = rawArrGet arr (int32FromInt# i)

-- | The host only takes `String`: bytes that are not valid UTF-8 cannot cross,
-- so they fail here with `InvalidArgument` instead of silently opening the
-- wrong file. `fromHostPath` the other way is total: any host string encodes.
-- The `loc` names the entry point for the failure, the way `System.IO.DotNet`
-- names its own crossings.
toHostPath :: String -> FilePath -> IO String
toHostPath loc p = case unpackFilePath p of
  Just s -> pure s
  Nothing -> ioError (mkIOError InvalidArgument loc Nothing (Just (show p)))

fromHostPath :: String -> FilePath
fromHostPath s = packFilePath s

readTextFile :: FilePath -> IO String
readTextFile p = do
  hp <- toHostPath "readTextFile" p
  fileReadAllText hp

writeTextFile :: FilePath -> String -> IO ()
writeTextFile p content = do
  hp <- toHostPath "writeTextFile" p
  fileWriteAllText hp content

appendTextFile :: FilePath -> String -> IO ()
appendTextFile p content = do
  hp <- toHostPath "appendTextFile" p
  fileAppendAllText hp content

readFile :: FilePath -> IO ByteString
readFile p = readTextFile p >>= (\s -> pure (fsFromString s))

writeFile :: FilePath -> ByteString -> IO ()
writeFile p content = writeTextFile p (fsToString content)

appendFile :: FilePath -> ByteString -> IO ()
appendFile p content = appendTextFile p (fsToString content)

fsMap :: (a -> b) -> [a] -> [b]
fsMap f xs = case xs of
  [] -> []
  x : rest -> f x : fsMap f rest

fsFromString :: String -> ByteString
fsFromString s = B.pack (fsMap (\c -> word8FromInt# (ord c)) (S.unpack s))

fsToString :: ByteString -> String
fsToString b = S.pack (fsMap (\w -> chr (word8ToInt# w)) (B.unpack b))

isFile :: FilePath -> IO Bool
isFile p = do
  hp <- toHostPath "isFile" p
  pure (fileExists hp)

isDirectory :: FilePath -> IO Bool
isDirectory p = do
  hp <- toHostPath "isDirectory" p
  pure (directoryExists hp)

getModified :: FilePath -> IO UTCTime
getModified p = do
  hp <- toHostPath "getModified" p
  let dt = dtoFromDateTime (fileGetLastWriteTimeUtc hp)
  pure (utcTimeFromUnix (dtoToUnixTimeSeconds dt))

getSize :: FilePath -> IO Int
getSize p = do
  hp <- toHostPath "getSize" p
  pure (fileGetLength (newFileInfo hp))

copyFile :: FilePath -> FilePath -> IO ()
copyFile src dst = do
  srcHp <- toHostPath "copyFile" src
  dstHp <- toHostPath "copyFile" dst
  fileCopy srcHp dstHp True

copyFileContent :: FilePath -> FilePath -> IO ()
copyFileContent src dst = copyFile src dst

copyPermissions :: FilePath -> FilePath -> IO ()
copyPermissions _ _ = pure ()

removeFile :: FilePath -> IO ()
removeFile p = do
  hp <- toHostPath "removeFile" p
  fileDelete hp

canonicalizePath :: FilePath -> IO FilePath
canonicalizePath p = do
  hp <- toHostPath "canonicalizePath" p
  pure (fromHostPath (pathGetFullPath hp))

arrToPaths :: Array -> [FilePath]
arrToPaths arr = arrToPathsAt arr 0 (arrLength arr)

arrToPathsAt :: Array -> Int -> Int -> [FilePath]
arrToPathsAt arr i n = case intCompare# i n of
  EQ -> []
  _ -> fromHostPath (pathGetFileName (stringValueOf (arrGet arr i))) : arrToPathsAt arr (i + 1) n

listDirectory :: FilePath -> IO [FilePath]
listDirectory p = do
  hp <- toHostPath "listDirectory" p
  files <- directoryGetFiles hp
  dirs <- directoryGetDirectories hp
  pure (arrToPaths files <> arrToPaths dirs)

createDirectory :: Bool -> FilePath -> IO ()
createDirectory _ p = do
  hp <- toHostPath "createDirectory" p
  _ <- pure (directoryCreateDirectory hp)
  pure ()

createTree :: FilePath -> IO ()
createTree p = createDirectory True p

removeDirectory :: FilePath -> IO ()
removeDirectory p = do
  hp <- toHostPath "removeDirectory" p
  case directoryExists hp of
    True -> directoryDelete hp False
    False -> pure ()

removeTree :: FilePath -> IO ()
removeTree p = do
  hp <- toHostPath "removeTree" p
  case directoryExists hp of
    True -> directoryDelete hp True
    False -> case fileExists hp of
      True -> fileDelete hp
      False -> pure ()

getWorkingDirectory :: IO FilePath
getWorkingDirectory = do
  s <- directoryGetCurrentDirectory
  pure (fromHostPath s)

setWorkingDirectory :: FilePath -> IO ()
setWorkingDirectory p = do
  hp <- toHostPath "setWorkingDirectory" p
  directorySetCurrentDirectory hp

rename :: FilePath -> FilePath -> IO ()
rename src dst = do
  dir <- isDirectory src
  renameByKind dir src dst

renameByKind :: Bool -> FilePath -> FilePath -> IO ()
renameByKind dir src dst = do
  srcHp <- toHostPath "rename" src
  dstHp <- toHostPath "rename" dst
  case dir of
    True -> directoryMove srcHp dstHp
    False -> fileMove srcHp dstHp
