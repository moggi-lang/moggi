{-# LANGUAGE NoImplicitPrelude #-}

-- | Simple quantity semaphores.
module Control.Concurrent.QSem
  ( QSem
  , newQSem
  , waitQSem
  , signalQSem
  ) where

import Control.Applicative
import Control.Concurrent.MVar
import Control.Exception (mask_, onException, uninterruptibleMask_)
import Control.Monad
import Data.List (reverse, (:))
import Data.Maybe (Maybe(..))
import Data.Num
import Moggi.Internal.Base
import Moggi.IO.Exception (ioError, userError)
import System.IO (IO)

-- | A quantity semaphore acquired and released in units of one.
--
-- The state is @(available, ready, blocked)@.  @ready@ is the queue of
-- waiters to serve next; @blocked@ is a stack of newer waiters, reversed when
-- it becomes the ready queue.  A waiter is an empty @MVar ()@ that a signal
-- fills.
newtype QSem = QSem (MVar (Int, [MVar ()], [MVar ()]))

-- | Build a semaphore with the given initial quantity, which must be at least
-- zero.
newQSem :: Int -> IO QSem
newQSem initial = case initial < 0 of
  True -> ioError (userError "newQSem: Initial quantity must be non-negative")
  False -> do
    sem <- newMVar (initial, [], [])
    pure (QSem sem)

-- | Wait for a unit, in FIFO order with the other waiters.
--
-- A waiter removes itself if its wait is interrupted, passing the unit to the
-- next waiter rather than losing it.
waitQSem :: QSem -> IO ()
waitQSem (QSem sem) = mask_ (do
  state <- takeMVar sem
  case state of
    (available, ready, blocked) -> case available == 0 of
      True -> do
        waiter <- newEmptyMVar
        putMVar sem (available, ready, waiter : blocked)
        waitQSemWaiter sem waiter
      False -> putMVar sem (available - 1, ready, blocked))

waitQSemWaiter :: MVar (Int, [MVar ()], [MVar ()]) -> MVar () -> IO ()
waitQSemWaiter sem waiter = onException (takeMVar waiter) (uninterruptibleMask_ (do
  state <- takeMVar sem
  alreadyWoken <- tryTakeMVar waiter
  case alreadyWoken of
    Just () -> do
      next <- signalQSemState state
      putMVar sem next
    Nothing -> do
      putMVar waiter ()
      putMVar sem state))

-- | Return a unit, waking the longest waiter if there is one.
signalQSem :: QSem -> IO ()
signalQSem (QSem sem) = uninterruptibleMask_ (do
  state <- takeMVar sem
  next <- signalQSemState state
  putMVar sem next)

signalQSemState :: (Int, [MVar ()], [MVar ()]) -> IO (Int, [MVar ()], [MVar ()])
signalQSemState (available, ready, blocked) = case available == 0 of
  False -> pure (available + 1, ready, blocked)
  True -> signalWaiters ready blocked

signalWaiters :: [MVar ()] -> [MVar ()] -> IO (Int, [MVar ()], [MVar ()])
signalWaiters [] [] = pure (1, [], [])
signalWaiters [] blocked = signalWaiters (reverse blocked) []
signalWaiters (waiter : rest) blocked = do
  woken <- tryPutMVar waiter ()
  case woken of
    True -> pure (0, rest, blocked)
    False -> signalWaiters rest blocked
