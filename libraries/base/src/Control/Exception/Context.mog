{-# LANGUAGE NoImplicitPrelude #-}

-- | Exception context: a list of 'SomeExceptionAnnotation' values attached to
-- an exception. The constructor is public, as in @base@.
module Control.Exception.Context
  ( ExceptionContext(..)
  , emptyExceptionContext
  , addExceptionAnnotation
  , getExceptionAnnotations
  , getAllExceptionAnnotations
  , displayExceptionContext
  ) where

import Data.Dynamic (fromDynamic, toDyn)
import Data.List ((:))
import Data.Semigroup ((<>))
import Data.Maybe
import Data.String (String)
import Moggi.Internal.Base
import Moggi.Internal.Exception.Annotation (SomeExceptionAnnotation(..), ExceptionAnnotation(..))
import Moggi.Internal.Exception.Context (ExceptionContext(..))

-- | An empty context.
emptyExceptionContext :: ExceptionContext
emptyExceptionContext = ExceptionContext []

-- | Add one annotation to a context.
addExceptionAnnotation :: ExceptionAnnotation a => a -> ExceptionContext -> ExceptionContext
addExceptionAnnotation a (ExceptionContext xs) = ExceptionContext (SomeExceptionAnnotation a : xs)

-- | Retrieve the annotations of one type from a context.
getExceptionAnnotations :: forall t. ExceptionAnnotation t => ExceptionContext -> [t]
getExceptionAnnotations (ExceptionContext xs) = getAnnotations xs

getAnnotations :: forall t. ExceptionAnnotation t => [SomeExceptionAnnotation] -> [t]
getAnnotations xs = case xs of
  [] -> []
  SomeExceptionAnnotation a : rest -> case (fromDynamic (toDyn a)) :: Maybe t of
    Just found -> found : getAnnotations rest
    Nothing -> getAnnotations rest

-- | Every annotation in a context, with its type erased.
getAllExceptionAnnotations :: ExceptionContext -> [SomeExceptionAnnotation]
getAllExceptionAnnotations (ExceptionContext xs) = xs

-- | Render a context, one annotation per line.
displayExceptionContext :: ExceptionContext -> String
displayExceptionContext (ExceptionContext xs) = displayAnnotations xs

displayAnnotations :: [SomeExceptionAnnotation] -> String
displayAnnotations xs = case xs of
  [] -> ""
  SomeExceptionAnnotation a : rest -> displayExceptionAnnotation a <> displayRest rest

displayRest :: [SomeExceptionAnnotation] -> String
displayRest xs = case xs of
  [] -> ""
  _ -> "\n" <> displayAnnotations xs
