{-# LANGUAGE NoImplicitPrelude #-}
-- | Core exception combinators.
--
-- bracket/finally restore the handler on every path, which is the whole
-- contract under synchronous-only exceptions: there is no async delivery to
-- interleave between acquisition and release, so masking is the identity.
module Control.Exception.Base
  ( SomeException(..)
  , Exception(..)
  , IOException
  , ArithException(..)
  , ArrayException(..)
  , AssertionFailed(..)
  , SomeAsyncException(..)
  , AsyncException(..)
  , asyncExceptionToException
  , asyncExceptionFromException
  , NonTermination(..)
  , NestedAtomically(..)
  , BlockedIndefinitelyOnMVar(..)
  , BlockedIndefinitelyOnSTM(..)
  , AllocationLimitExceeded(..)
  , CompactionFailed(..)
  , Deadlock(..)
  , FixIOException(..)
  , NoMethodError(..)
  , PatternMatchFail(..)
  , RecConError(..)
  , RecSelError(..)
  , RecUpdError(..)
  , ErrorCall(..)
  , TypeError(..)
  , NoMatchingContinuationPrompt(..)
  , throwIO
  , throw
  , ioError
  , throwTo
  , catch
  , catchJust
  , handle
  , handleJust
  , try
  , tryJust
  , onException
  , evaluate
  , mapException
  , mask
  , mask_
  , uninterruptibleMask
  , uninterruptibleMask_
  , MaskingState(..)
  , getMaskingState
  , assert
  , recSelError
  , recConError
  , impossibleError
  , impossibleConstraintError
  , nonExhaustiveGuardsError
  , patError
  , noMethodBindingError
  , typeError
  , nonTermination
  , nestedAtomically
  , noMatchingContinuationPrompt
  , bracket
  , bracket_
  , bracketOnError
  , finally
  ) where

import Control.Applicative
import Control.Monad
import Data.Bool
import Data.Either
import Data.Function (id)
import Data.Maybe
import Moggi.Exception (throw)
import Moggi.Err (errorWithoutStackTrace)
import Moggi.Exception.Context (WhileHandling(..), annotateIO)
import Moggi.Exception.Type
import Moggi.Internal.Base
import Moggi.Internal.IO
import Moggi.Internal.Prim
import System.IO.Base (IO)
import Moggi.Internal.Thread (ThreadId(..))
import Text.Show
import Moggi.IO.Exception (IOException, ioError)

throwIO :: (HasCallStack, Exception e) => e -> IO a
throwIO e = exceptionThrowIo# (toException e)

-- | Throw an exception in a thread. Only the calling thread is supported:
-- the machine has no way to deliver an exception into another host thread, so
-- a foreign target fails with 'ErrorCall' rather than being silently ignored.
throwTo :: Exception e => ThreadId -> e -> IO ()
throwTo (ThreadId target) e = do
  self <- myThreadId#
  case target == self of
    True -> throwIO e
    False -> throwIO (ErrorCall "throwTo to another thread is not supported by the Moggi runtime")

-- Handler is a named top-level so catch does not rely on IO-returning lambdas.
mkCatchHandler :: Exception e => (e -> IO a) -> SomeException -> IO a
mkCatchHandler handler se =
  maybe (exceptionThrowIo# se) (\e -> annotateIO (WhileHandling se) (handler e)) (fromException se)

catch :: Exception e => IO a -> (e -> IO a) -> IO a
catch action handler =
  exceptionCatch# action (mkCatchHandler handler)

catchJust :: Exception e => (e -> Maybe b) -> IO a -> (b -> IO a) -> IO a
catchJust p action handler =
  catch action (mkCatchJustHandler p handler)

mkCatchJustHandler :: Exception e => (e -> Maybe b) -> (b -> IO a) -> e -> IO a
mkCatchJustHandler p handler e =
  maybe (throwIO e) handler (p e)

handle :: Exception e => (e -> IO a) -> IO a -> IO a
handle handler action = catch action handler

handleJust :: Exception e => (e -> Maybe b) -> (b -> IO a) -> IO a -> IO a
handleJust p handler action = catchJust p action handler

try :: Exception e => IO a -> IO (Either e a)
try action =
  catch (mkTrySuccess action) mkTryFailure

mkTrySuccess :: IO a -> IO (Either e a)
mkTrySuccess action = do
  x <- action
  pure (Right x)

mkTryFailure :: Exception e => e -> IO (Either e a)
mkTryFailure e = pure (Left e)

tryJust :: Exception e => (e -> Maybe b) -> IO a -> IO (Either b a)
tryJust p action =
  catch (mkTrySuccess action) (mkTryJustHandler p)

mkTryJustHandler :: Exception e => (e -> Maybe b) -> e -> IO (Either b a)
mkTryJustHandler p e =
  maybe (throwIO e) (mkLeftPure) (p e)

mkLeftPure :: b -> IO (Either b a)
mkLeftPure b = pure (Left b)

onException :: IO a -> IO b -> IO a
onException action what =
  exceptionCatch# action (mkOnExceptionHandler what)

mkOnExceptionHandler :: IO b -> SomeException -> IO a
mkOnExceptionHandler what se = do
  _ <- what
  exceptionThrowIo# se

finally :: IO a -> IO b -> IO a
finally action cleanup = exceptionFinally# action cleanup

bracket :: IO a -> (a -> IO b) -> (a -> IO c) -> IO c
bracket before after thing = do
  a <- before
  finally (thing a) (after a)

bracket_ :: IO a -> IO b -> IO c -> IO c
bracket_ before after thing =
  bracket before (mkIgnore after) (mkIgnore thing)

mkIgnore :: IO b -> a -> IO b
mkIgnore m _ = m

bracketOnError :: IO a -> (a -> IO b) -> (a -> IO c) -> IO c
bracketOnError before after thing = do
  a <- before
  onException (thing a) (after a)

-- | Evaluate a value to weak head normal form. Moggi is strict, so the
-- argument has already been evaluated when this is called; the action only
-- gives the value an 'IO' context, exactly as @base@'s does.
evaluate :: a -> IO a
evaluate x = pure x

-- Strict evaluation has already evaluated the argument before this call, so
-- there is no deferred computation whose exception could be caught and mapped.
-- Identity is therefore the exact strict-language analogue of @base@'s
-- 'mapException'.
mapException :: (Exception e1, Exception e2) => (e1 -> e2) -> a -> a
mapException _ x = x

-- | Mask asynchronous exceptions for the action. There are no asynchronous
-- exceptions, so the unmask function is 'id'.
mask :: ((forall a. IO a -> IO a) -> IO b) -> IO b
mask f = f id

mask_ :: IO a -> IO a
mask_ action = action

-- | 'mask' without interruptible operations. Every operation is already
-- uninterruptible here, so this is the same identity.
uninterruptibleMask :: ((forall a. IO a -> IO a) -> IO b) -> IO b
uninterruptibleMask f = f id

uninterruptibleMask_ :: IO a -> IO a
uninterruptibleMask_ action = action

-- | The masking state of the calling thread.
data MaskingState
  = Unmasked
  | MaskedInterruptible
  | MaskedUninterruptible
  deriving (Eq, Ord, Show)

-- | There is never a mask, so the state is always 'Unmasked'.
getMaskingState :: IO MaskingState
getMaskingState = pure Unmasked

-- | @'assert' pred x@ returns @x@ when @pred@ holds and fails otherwise.
assert :: Bool -> a -> a
assert pred x = case pred of
  True -> x
  False -> throw (AssertionFailed "Assertion failed")

-- | Report a missing record field. These are the runtime-error entry points
-- @base@ exposes from this module.
recSelError :: String -> a
recSelError message = throw (RecSelError message)

recConError :: String -> a
recConError message = throw (RecConError message)

impossibleError :: String -> a
impossibleError message = errorWithoutStackTrace message

impossibleConstraintError :: String -> a
impossibleConstraintError message = errorWithoutStackTrace message

nonExhaustiveGuardsError :: String -> a
nonExhaustiveGuardsError message = throw (PatternMatchFail message)

patError :: String -> a
patError message = throw (PatternMatchFail message)

noMethodBindingError :: String -> a
noMethodBindingError message = throw (NoMethodError message)

typeError :: String -> a
typeError message = throw (TypeError message)

nonTermination :: SomeException
nonTermination = toException NonTermination

nestedAtomically :: SomeException
nestedAtomically = toException NestedAtomically

noMatchingContinuationPrompt :: SomeException
noMatchingContinuationPrompt = toException NoMatchingContinuationPrompt
