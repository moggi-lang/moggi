{-# LANGUAGE NoImplicitPrelude #-}
-- | 'MonadFail': the 'fail' an action runs when a pattern match does not
-- match, or when the action decides to give up.
module Control.Monad.Fail
  ( MonadFail(fail)
  ) where

import Control.Monad
import Data.List
import Data.Maybe
import Moggi.Err
import Moggi.IO.Exception (ioError, userError)
import Moggi.Internal.Base
import Moggi.Internal.Prim
import System.IO.Base (IO)

-- | Actions with a failure of their own. 'fail' is a method so a monad can
-- answer its own empty value; the default raises, as a monad with no empty
-- value does.
class Monad m => MonadFail m where
  fail :: String -> m a
  fail s = errorWithoutStackTrace s

instance MonadFail Maybe where
  fail _ = Nothing

instance MonadFail List where
  fail _ = []

-- | A failure in 'IO' is a user 'IOError', caught by 'tryIOError' like any
-- other.
instance MonadFail IO where
  fail msg = ioError (userError msg)
