{-# LANGUAGE NoImplicitPrelude #-}
-- | Monadic zipping: 'mzip' pairs the values of two actions, the shape a monad
-- comprehension's zipped generators are written in terms of.
--
-- Instances should satisfy, for an 'mzip' that preserves information,
-- @'munzip' ('mzip' ma mb) = (ma, mb)@.
--
-- There is no 'MonadZip' instance for 'IO': 'munzip' answers a pair of
-- actions, and an 'IO' value may not appear outside an 'IO'-returning
-- function, so the method has no type at 'IO' here. 'mzip' itself is
-- 'Control.Monad.liftM2' with a pair, which needs no instance.
module Control.Monad.Zip
  ( MonadZip(mzip, mzipWith, munzip)
  ) where

import Control.Monad
import Data.List.NonEmpty
import Data.Maybe
import Data.Ord
import Data.Proxy
import Data.Functor.Identity (Identity(..))
import Data.Tuple (Solo(MkSolo), fst, snd)
import Moggi.Internal.Base
import Moggi.Internal.Prim

-- | Monads whose values can be paired pointwise. 'munzip' is a method so an
-- instance can pair the results more efficiently than the default does.
class Monad m => MonadZip m where
  mzip :: m a -> m b -> m (a, b)
  mzip ma mb = mzipWith (\a b -> (a, b)) ma mb

  mzipWith :: (a -> b -> c) -> m a -> m b -> m c
  mzipWith f ma mb = liftM (\ab -> case ab of (a, b) -> f a b) (mzip ma mb)

  munzip :: m (a, b) -> (m a, m b)
  munzip mab = (liftM fst mab, liftM snd mab)

instance MonadZip List where
  mzip xs ys = case xs of
    [] -> []
    x : xrest -> case ys of
      [] -> []
      y : yrest -> (x, y) : mzip xrest yrest
  mzipWith f xs ys = case xs of
    [] -> []
    x : xrest -> case ys of
      [] -> []
      y : yrest -> f x y : mzipWith f xrest yrest
  munzip ps = case ps of
    [] -> ([], [])
    p : rest -> case p of
      (x, y) -> case munzip rest of
        (xs, ys) -> (x : xs, y : ys)

instance MonadZip Maybe where
  mzipWith f ma mb = liftM2 f ma mb

instance MonadZip Down where
  mzipWith f ma mb = liftM2 f ma mb

instance MonadZip Solo where
  mzipWith f ma mb = liftM2 f ma mb
  munzip mp = case mp of
    MkSolo p -> case p of
      (a, b) -> (MkSolo a, MkSolo b)

instance MonadZip Identity where
  mzipWith f ma mb = liftM2 f ma mb
  munzip mp = case mp of
    Identity p -> case p of
      (a, b) -> (Identity a, Identity b)

instance MonadZip Proxy where
  mzipWith _ _ _ = Proxy

instance MonadZip NonEmpty where
  mzipWith f xs ys = case xs of
    x :| xrest -> case ys of
      y :| yrest -> f x y :| neZipWithList f xrest yrest
  munzip ps = case ps of
    p :| prest -> case p of
      (a, b) -> case neUnzipList prest of
        (heads, tails) -> (a :| heads, b :| tails)

neZipWithList :: (a -> b -> c) -> [a] -> [b] -> [c]
neZipWithList f xs ys = case xs of
  [] -> []
  x : xrest -> case ys of
    [] -> []
    y : yrest -> f x y : neZipWithList f xrest yrest

neUnzipList :: [(a, b)] -> ([a], [b])
neUnzipList ps = case ps of
  [] -> ([], [])
  p : rest -> case p of
    (a, b) -> case neUnzipList rest of
      (heads, tails) -> (a : heads, b : tails)
