{-# LANGUAGE NoImplicitPrelude #-}
-- |
-- A 'Monad' is a type of actions that can be chained: @(>>=)@ takes the value an
-- action produced and returns the next action to run, which is what the @do@
-- notation is written in terms of. 'pure', from 'Applicative', is the action
-- that produces a value and does nothing else.
--
-- Everything else here is a combination of those two: run an action for its
-- effect and drop its value, lift a plain function over one or more actions,
-- repeat an action until it fails, or use a condition as an action.
--
-- Some names in this module are older spellings of operations that are defined
-- elsewhere and read better there: 'liftM' is 'map', 'liftM2' is 'liftA2', 'ap'
-- is '(<*>)', and 'msum' is 'asum'. They are kept so that existing code keeps
-- compiling; new code does not need them. The same is true of the class
-- 'MonadPlus' and its two methods, which say what 'Alternative' already says.
module Control.Monad
  ( Monad((>>=), (>>))
  , MonadPlus(mzero, mplus)
  , void
  , (=<<)
  , (>=>)
  , (<=<)
  , join
  , forever
  , guard
  , when
  , unless
  , liftM
  , liftM2
  , liftM3
  , liftM4
  , liftM5
  , mapAndUnzipM
  , ap
  , foldM
  , foldM_
  , filterM
  , zipWithM
  , zipWithM_
  , replicateM
  , replicateM_
  , msum
  , mfilter
  , WrappedMonad(WrapMonad)
  , unwrapMonad
  ) where

-- mapM / sequence / forM live in Data.Traversable (traverse / sequenceA).
-- foldM / filterM / zipWithM / replicateM stay list-Kleisli here to avoid a
-- Control.Monad ↔ Data.Foldable import cycle.

import Control.Applicative
import Data.Bool
import Data.Functor
import Data.Maybe
import Data.Num
import Data.Ord
import Moggi.Internal.Base
import Moggi.Internal.Prim

infixl 1 >>=, >>
infixr 1 =<<
infixr 1 >=>, <=<

class Applicative m => Monad m where
  (>>=) :: m a -> (a -> m b) -> m b

  -- | Run both actions in order and drop the first value: @m >> k@ is the
  -- effect of both, with @k@'s result. A method (rather than a top-level
  -- function) so instances can override it; the default sequences '(>>=)'.
  (>>) :: m a -> m b -> m b
  (>>) m k = m >>= (\_ -> k)

class (Alternative m, Monad m) => MonadPlus m where
  -- | The identity of 'mplus'. It should also satisfy the equations
  --
  -- > mzero >>= f  =  mzero
  -- > v >> mzero   =  mzero
  --
  -- The default definition is
  --
  -- @mzero = empty@
  mzero :: m a
  mzero = empty

  -- | An associative operation. The default definition is
  --
  -- @mplus = (<|>)@
  mplus :: m a -> m a -> m a
  mplus = (<|>)

(=<<) :: Monad m => (a -> m b) -> m a -> m b
(=<<) f m = m >>= f

(>=>) :: Monad m => (a -> m b) -> (b -> m c) -> a -> m c
(>=>) f g x = f x >>= g

(<=<) :: Monad m => (b -> m c) -> (a -> m b) -> a -> m c
(<=<) g f x = f x >>= g

join :: Monad m => m (m a) -> m a
join m = m >>= (\x -> x)

forever :: Applicative f => f a -> f b
forever a = a *> forever a

guard :: Alternative f => Bool -> f ()
guard b = case b of
  True -> pure ()
  False -> empty

when :: Applicative f => Bool -> f () -> f ()
when b act = case b of
  True -> act
  False -> pure ()

unless :: Applicative f => Bool -> f () -> f ()
unless b act = case b of
  True -> pure ()
  False -> act

foldM :: Monad m => (b -> a -> m b) -> b -> [a] -> m b
foldM _ z [] = pure z
foldM f z (x : xs) = f z x >>= (\z2 -> foldM f z2 xs)

foldM_ :: Monad m => (b -> a -> m b) -> b -> [a] -> m ()
foldM_ f z xs = foldM f z xs >> pure ()

filterM :: Applicative m => (a -> m Bool) -> [a] -> m [a]
filterM _ [] = pure []
filterM p (x : xs) = liftA2 (consIf x) (p x) (filterM p xs)

consIf x flg rest = case flg of
  True -> x : rest
  False -> rest

zipWithM :: Applicative m => (a -> b -> m c) -> [a] -> [b] -> m [c]
zipWithM _ [] _ = pure []
zipWithM _ _ [] = pure []
zipWithM f (x : xs) (y : ys) = liftA2 (\z zs -> z : zs) (f x y) (zipWithM f xs ys)

zipWithM_ :: Applicative m => (a -> b -> m c) -> [a] -> [b] -> m ()
zipWithM_ f xs ys = zipWithM f xs ys *> pure ()

replicateM :: Applicative m => Int -> m a -> m [a]
replicateM n ma = case n <= 0 of
  True -> pure []
  False -> liftA2 (\z zs -> z : zs) ma (replicateM (n - 1) ma)

replicateM_ :: Applicative m => Int -> m a -> m ()
replicateM_ n ma = case n <= 0 of
  True -> pure ()
  False -> ma *> replicateM_ (n - 1) ma

msum :: MonadPlus m => [m a] -> m a
msum xs = case xs of
  [] -> mzero
  x : rest -> mplus x (msum rest)

mfilter :: MonadPlus m => (a -> Bool) -> m a -> m a
mfilter p ma = ma >>= (\x -> case p x of
  True -> pure x
  False -> mzero)

liftM :: Monad m => (a1 -> r) -> m a1 -> m r
liftM f ma = ma >>= (\a -> pure (f a))

liftM2 :: Monad m => (a1 -> a2 -> r) -> m a1 -> m a2 -> m r
liftM2 f ma mb = ma >>= (\a -> mb >>= (\b -> pure (f a b)))

liftM3 :: Monad m => (a1 -> a2 -> a3 -> r) -> m a1 -> m a2 -> m a3 -> m r
liftM3 f ma mb mc = ma >>= (\a -> mb >>= (\b -> mc >>= (\c -> pure (f a b c))))

liftM4 :: Monad m => (a1 -> a2 -> a3 -> a4 -> r) -> m a1 -> m a2 -> m a3 -> m a4 -> m r
liftM4 f ma mb mc md = ma >>= (\a -> mb >>= (\b -> mc >>= (\c -> md >>= (\d -> pure (f a b c d)))))

liftM5 :: Monad m => (a1 -> a2 -> a3 -> a4 -> a5 -> r) -> m a1 -> m a2 -> m a3 -> m a4 -> m a5 -> m r
liftM5 f ma mb mc md me = ma >>= (\a -> mb >>= (\b -> mc >>= (\c -> md >>= (\d -> me >>= (\e -> pure (f a b c d e))))))

mapAndUnzipM :: Monad m => (a -> m (b, c)) -> [a] -> m ([b], [c])
mapAndUnzipM _ [] = pure ([], [])
mapAndUnzipM f (x : xs) = f x >>= (\yz -> case yz of
  (y, z) -> mapAndUnzipM f xs >>= (\yzs -> case yzs of
    (ys, zs) -> pure (y : ys, z : zs)))

ap :: Monad m => m (a -> b) -> m a -> m b
ap mf ma = mf >>= (\f -> ma >>= (\a -> pure (f a)))

instance Monad Maybe where
  (>>=) mx f = case mx of
    Nothing -> Nothing
    Just x -> f x

-- | Unwrapping, like the wrapped type: only the 'Ord' is reversed.
instance Monad Down where
  (>>=) (Down a) k = k a

instance MonadPlus Maybe

-- | A 'Monad' seen through its 'Applicative' interface only: 'pure' and
-- '(<*>)' here are the 'Monad' ones, which lets 'Applicative' combinators
-- reuse monadic behaviour (notably 'Alternative' via 'WrappedMonad' + 'Ap').
newtype WrappedMonad m a = WrapMonad (m a)
  deriving (Functor)

unwrapMonad :: WrappedMonad m a -> m a
unwrapMonad m = case m of
  WrapMonad x -> x

instance Applicative m => Applicative (WrappedMonad m) where
  pure x = WrapMonad (pure x)
  (<*>) mf mx = case mf of
    WrapMonad f -> case mx of
      WrapMonad x -> WrapMonad (f <*> x)

instance Monad m => Monad (WrappedMonad m) where
  (>>=) m f = case m of
    WrapMonad x -> WrapMonad (x >>= (\a -> case f a of
      WrapMonad y -> y))
