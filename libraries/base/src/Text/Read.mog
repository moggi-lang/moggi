{-# LANGUAGE NoImplicitPrelude #-}
-- | Converting strings to values: the 'Read' class and the functions around it.
--
-- The class methods are 'readsPrec' and 'readList', and 'reads', 'read',
-- 'readParen' and 'lex' are the functions written over them. 'ReadPrec' is the
-- parser those are written from: it carries the precedence a signature asks
-- for, so a parser can be composed instead of threaded through by hand, and
-- 'readPrec' is the method an instance writes when the parser is the easier
-- form.
module Text.Read
  (
    -- * The 'Read' class
    Read(..)
  , ReadS

    -- * Operations
  , reads
  , read
  , readParen
  , lex

    -- * New parsing functions
  , module Text.ParserCombinators.ReadPrec
  , Lexeme(..)
  , lexP
  , parens
  , readListDefault
  , readListPrecDefault
  , readEither
  , readMaybe
  ) where

import Control.Applicative
import Control.Monad
import Control.Monad.Fail
import Data.Bool
import Data.Char
import Data.Double (Double, rationalToDouble)
import Data.Either (Either(Left, Right))
import Data.Functor.Const (Const(Const))
import Data.List.NonEmpty (NonEmpty((:|)))
import Data.Functor.Identity (Identity(..))
import Data.Int (Int8, Int16, Int32, Int64)
import Data.Integer (Integer, integerAdd, integerFromInt, integerMul)
import Data.Tuple (Solo(MkSolo))
import Data.Word (Word, Word8, Word16, Word32, Word64)
import Data.Eq
import Data.Maybe (Maybe(Nothing, Just))
import Data.Num
import Data.Ord
import Numeric.Natural (Natural)
import Data.Char (lexLitChar, readLitChar)
import Data.String (isPrefixOf, pack, singleton, unpack)
import Text.Show
import Text.ParserCombinators.ReadPrec
import Moggi.Err
import Moggi.Internal.Base hiding (take, drop, unpack)
import Moggi.Internal.Prim


-- | A parse of @a@ from the front of a string: the value and the rest.
type ReadS a = String -> [(a, String)]

-- | The parser at precedence zero, in parentheses when the input has them.
parens :: ReadPrec a -> ReadPrec a
parens p = readS_to_Prec (\_ s -> readParen True (readPrec_to_S (reset p) 0) s)

-- Keep the parses that are followed by the closing parenthesis.
parenthesised :: ReadS a -> ReadS a
parenthesised g s = case lex s of
  ("(", r) : _ -> closeParses (g r)
  _ -> []

mapParses :: (a -> b) -> [(a, String)] -> [(b, String)]
mapParses f pairs = case pairs of
  [] -> []
  (x, rest) : more -> (f x, rest) : mapParses f more

-- | Parsing a value out of the front of a string.
--
-- 'readsPrec' takes a precedence context, as 'showsPrec' does, so a field of a
-- compound value is parsed at the context its rendering was written in. An
-- instance may instead give only 'read', which consumes the whole string; that
-- is what the instances written before 'readsPrec' existed do, and the default
-- below keeps them working.
class Read a where
  {-# MINIMAL readsPrec | readPrec | read #-}

  -- | Parse a value at the given precedence, with the input that follows it.
  readsPrec :: Int -> ReadS a

  -- | Parse a list of values, which is the rendering 'Text.Show.showList'
  -- produces.
  readList :: ReadS [a]

  -- | Parse a value out of a string, failing unless the string is one.
  read :: String -> a

  -- | Parse a value at the given precedence, as a composed parser.
  readPrec :: ReadPrec a

  -- | Parse a list of values, as a composed parser.
  readListPrec :: ReadPrec [a]

  readsPrec _ s = [(read s, "")]

  readList s = readListDefault s

  readPrec = readS_to_Prec readsPrec

  readListPrec = readListPrecDefault

  -- Parsing goes through 'readPrec' rather than 'readsPrec': an instance may
  -- define either one, and the default for the other has to terminate. With
  -- 'readsPrec' here, an instance that defines only 'readPrec' would come back
  -- through this default to 'readsPrec', whose default reads a whole string.
  read s = case readPrec_to_S readPrec 0 s of
    [] -> error "Prelude.read: no parse"
    (x, _) : _ -> x

-- | What 'readListPrec' does by default: the @[a,b]@ form the 'Show' instance
-- for lists renders, with each element read at precedence zero.
readListPrecDefault :: Read a => ReadPrec [a]
readListPrecDefault = readS_to_Prec (\_ -> readListDefault)

-- | A unary constructor: its name, then one field at precedence eleven.
readUnaryWith :: ReadPrec a -> String -> (a -> t) -> ReadPrec t
readUnaryWith rp name cons = readS_to_Prec (\_ s -> unaryNamed rp name cons s)

unaryNamed :: ReadPrec a -> String -> (a -> t) -> String -> [(t, String)]
unaryNamed rp name cons s = case lex s of
  (tok, rest) : _ -> case tok == name of
    True -> mapParses cons (readPrec_to_S (prec 11 rp) 11 rest)
    False -> []
  [] -> []

-- | A binary constructor: its name, then two fields at precedence eleven.
readBinaryWith :: ReadPrec a -> ReadPrec b -> String -> (a -> b -> t) -> ReadPrec t
readBinaryWith rp rq name cons = readS_to_Prec (\_ s -> binaryNamed rp rq name cons s)

binaryNamed :: ReadPrec a -> ReadPrec b -> String -> (a -> b -> t) -> String -> [(t, String)]
binaryNamed rp rq name cons s = case lex s of
  (tok, rest) : _ -> case tok == name of
    True -> readThen (readPrec_to_S (prec 11 rp) 11) (binarySecond rq cons) rest
    False -> []
  [] -> []

binarySecond :: ReadPrec b -> (a -> b -> t) -> a -> String -> [(t, String)]
binarySecond rq cons x t = mapParses (cons x) (readPrec_to_S (prec 11 rq) 11 t)

-- | A number literal, as the lexer reads it: the token walk hands digits
-- over as one token, so this is a decimal integer.
data Number = MkNumber Integer
  deriving (Eq, Show)

-- | A lexeme: a character or string literal, punctuation, an identifier, a
-- symbol, a number, or the end of the input.
data Lexeme
  = Char Char
  | String String
  | Punc String
  | Ident String
  | Symbol String
  | Number Number
  | EOF
  deriving (Eq, Show)

-- | The next lexeme of the input, as a parser.
--
-- It answers the same tokenization 'lex' does, one constructor per kind of
-- token, and 'EOF' at the end, so a parser built on it sees a stream.
lexP :: ReadPrec Lexeme
lexP = readS_to_Prec (\_ -> lexemeParses)

lexemeParses :: ReadS Lexeme
lexemeParses s = case lex s of
  [] -> [(EOF, "")]
  (tok, rest) : _ -> [(lexemeOf tok, rest)]

lexemeOf :: String -> Lexeme
lexemeOf tok = case unpack tok of
  [] -> EOF
  c : _ -> case isIdentifierStart c of
    True -> Ident tok
    False -> case isDigit c of
      True -> numberLexeme tok
      False -> case c == '\'' of
        True -> charLexeme tok
        False -> case c == '"' of
          True -> stringLexeme tok
          False -> case isPunctuationChar c of
            True -> Punc tok
            False -> Symbol tok

numberLexeme :: String -> Lexeme
numberLexeme tok = case digitsToken tok of
  Nothing -> Symbol tok
  Just n -> Number (MkNumber n)

charLexeme :: String -> Lexeme
charLexeme tok = case readLitChar (pack (dropChars 1 (unpack tok))) of
  (c, _) : _ -> Char c
  [] -> Symbol tok

stringLexeme :: String -> Lexeme
stringLexeme tok = case stringBody (pack (dropChars 1 (unpack tok))) of
  Just text -> String text
  Nothing -> Symbol tok

-- | Punctuation: the characters that are lexemes of their own.
isPunctuationChar :: Char -> Bool
isPunctuationChar c =
  c == '(' || c == ')' || c == '[' || c == ']' || c == ',' || c == ';'
  || c == '`' || c == '{' || c == '}'

-- | 'readsPrec' at precedence zero.
reads :: Read a => ReadS a
reads s = readsPrec 0 s

-- | Parse a value surrounded by parentheses when the precedence asks for them,
-- and without them otherwise.
readParen :: Bool -> ReadS a -> ReadS a
readParen b g s = case b of
  True -> readParenMandatory g s
  False -> appendLists (g s) (readParenMandatory g s)

readParenMandatory :: ReadS a -> ReadS a
readParenMandatory g r = case lex r of
  ("(", s) : _ -> closeParses (appendLists (g s) (readParenMandatory g s))
  _ -> []

-- Keep the parses that are followed by the closing parenthesis.
closeParses :: [(a, String)] -> [(a, String)]
closeParses pairs = case pairs of
  [] -> []
  (x, t) : rest -> case lex t of
    (")", u) : _ -> (x, u) : closeParses rest
    _ -> closeParses rest

-- | The lexemes of a string: its leading token and whatever follows. Spaces are
-- skipped; names, numbers and quoted character or string literals come back
-- whole; any other character is a token of its own.
lex :: ReadS String
lex s = lexChars (skipSpaces (unpack s))

lexChars :: [Char] -> [(String, String)]
lexChars cs = case cs of
  [] -> []
  c : _ -> case isIdentifierStart c of
    True -> [(pack (takeWhileChars isIdentifierChar cs), pack (dropWhileChars isIdentifierChar cs))]
    False -> case isDigit c of
      True -> [(pack (takeWhileChars isDigit cs), pack (dropWhileChars isDigit cs))]
      False -> case isSymbolChar c of
        True -> [(pack (takeWhileChars isSymbolChar cs), pack (dropWhileChars isSymbolChar cs))]
        False -> lexCharsQuoted c cs

-- A quoted literal is a single token, quotes included.
lexCharsQuoted :: Char -> [Char] -> [(String, String)]
lexCharsQuoted c cs = case c == '\'' || c == '"' of
  True -> quotedToken c cs
  False -> [(singleton c, pack (dropChars 1 cs))]

quotedToken :: Char -> [Char] -> [(String, String)]
quotedToken q cs = case lexLitCharsUpTo q (pack (dropChars 1 cs)) of
  Nothing -> []
  Just (body, rest) -> [(stringAppend# (singleton q) (stringAppend# body (singleton q)), rest)]

-- The body of a quoted literal: every character literal up to the first
-- unescaped occurrence of the opening quote, which is consumed. The text is
-- kept verbatim so the token still reads back as written.
lexLitCharsUpTo :: Char -> String -> Maybe (String, String)
lexLitCharsUpTo q s = case unpack s of
  [] -> Nothing
  c : rest -> case c == q of
    True -> Just ("", pack rest)
    False -> case lexLitChar s of
      (body, after) : _ -> case lexLitCharsUpTo q after of
        Nothing -> Nothing
        Just (more, rest2) -> Just (stringAppend# body more, rest2)
      [] -> Nothing

-- | What 'readList' does by default: the @[a,b]@ form the 'Show' instance for
-- lists renders.
readListDefault :: Read a => ReadS [a]
readListDefault s = case lex s of
  ("[", r) : _ -> readListElems r
  _ -> []

readListElems :: Read a => String -> [([a], String)]
readListElems r = case reads r of
  [] -> []
  (x, t) : _ -> case lex t of
    (",", u) : _ -> consEach x (readListElems u)
    ("]", u) : _ -> [([x], u)]
    _ -> []

consEach :: a -> [([a], String)] -> [([a], String)]
consEach x pairs = case pairs of
  [] -> []
  (xs, u) : rest -> (x : xs, u) : consEach x rest

-- | The value a string denotes, when the whole of it is that value up to
-- spaces.
readMaybe :: Read a => String -> Maybe a
readMaybe s = case wholeParses (reads s) of
  [] -> Nothing
  x : _ -> Just x

wholeParses :: [(a, String)] -> [a]
wholeParses pairs = case pairs of
  [] -> []
  (x, t) : rest -> case allSpaces (unpack t) of
    True -> x : wholeParses rest
    False -> wholeParses rest

-- | 'readMaybe' with the failure as 'Left'.
readEither :: Read a => String -> Either String a
readEither s = case readMaybe s of
  Just x -> Right x
  Nothing -> Left "Prelude.read: no parse"

appendLists :: [a] -> [a] -> [a]
appendLists xs ys = case xs of
  [] -> ys
  x : rest -> x : appendLists rest ys

skipSpaces :: [Char] -> [Char]
skipSpaces cs = case cs of
  [] -> []
  c : rest -> case isSpace c of
    True -> skipSpaces rest
    False -> cs

allSpaces :: [Char] -> Bool
allSpaces cs = case cs of
  [] -> True
  c : rest -> case isSpace c of
    True -> allSpaces rest
    False -> False

isIdentifierStart :: Char -> Bool
isIdentifierStart c = isAlpha c || c == '_'

isIdentifierChar :: Char -> Bool
isIdentifierChar c = isAlpha c || isDigit c || c == '_' || c == '\''

-- Symbols are one lexeme however many are written together, so an operator
-- constructor comes back whole.
isSymbolChar :: Char -> Bool
isSymbolChar c =
  c == '!' || c == '#' || c == '$' || c == '%' || c == '&' || c == '*'
  || c == '+' || c == '.' || c == '/' || c == '<' || c == '=' || c == '>'
  || c == '?' || c == '@' || c == '^' || c == '|' || c == '~' || c == ':'
  || c == '-' || c == '\\'

takeWhileChars :: (Char -> Bool) -> [Char] -> [Char]
takeWhileChars p cs = case cs of
  [] -> []
  c : rest -> case p c of
    True -> c : takeWhileChars p rest
    False -> []

dropWhileChars :: (Char -> Bool) -> [Char] -> [Char]
dropWhileChars p cs = case cs of
  [] -> []
  c : rest -> case p c of
    True -> dropWhileChars p rest
    False -> cs

dropChars :: Int -> [Char] -> [Char]
dropChars n cs = case n > 0 of
  True -> case cs of
    [] -> []
    _ : rest -> dropChars (n - 1) rest
  False -> cs

-- | Reads a decimal 'Int': an optional minus sign, then digits.
instance Read Int where
  readsPrec _ s = case lex s of
    ("-", r) : _ -> case lex r of
      (tok, rest) : _ -> case digitsOnly tok of
        Nothing -> []
        Just n -> [(negate n, rest)]
      [] -> []
    (tok, rest) : _ -> case digitsOnly tok of
      Nothing -> []
      Just n -> [(n, rest)]
    [] -> []

digitsOnly :: String -> Maybe Int
digitsOnly tok = case unpack tok of
  [] -> Nothing
  ds -> case allDigits ds of
    False -> Nothing
    True -> Just (foldDigits ds 0)

allDigits :: [Char] -> Bool
allDigits cs = case cs of
  [] -> True
  c : rest -> case isDigit c of
    True -> allDigits rest
    False -> False

foldDigits :: [Char] -> Int -> Int
foldDigits cs acc = case cs of
  [] -> acc
  d : rest -> foldDigits rest (acc * 10 + digitToInt d)

-- | Reads a decimal integer of any size, as 'Text.Show.Show' writes it: an
-- optional minus sign, then digits.
instance Read Integer where
  readsPrec _ = readIntegerAs

-- | Reads a decimal natural number. A negative literal underflows through
-- 'fromInteger', which is where the type itself refuses it.
instance Read Natural where
  readsPrec _ = readIntegerAs

-- | Reads a decimal 'Word'. The digits are folded into an 'Integer' and
-- converted with 'fromInteger', so a literal outside the width keeps its low
-- bits exactly as the 'Num' instance does.
instance Read Word where
  readsPrec _ = readIntegerAs

instance Read Word8 where
  readsPrec _ = readIntegerAs

instance Read Word16 where
  readsPrec _ = readIntegerAs

instance Read Word32 where
  readsPrec _ = readIntegerAs

instance Read Word64 where
  readsPrec _ = readIntegerAs

instance Read Int8 where
  readsPrec _ = readIntegerAs

instance Read Int16 where
  readsPrec _ = readIntegerAs

instance Read Int32 where
  readsPrec _ = readIntegerAs

instance Read Int64 where
  readsPrec _ = readIntegerAs

-- | Reads a decimal floating-point literal: an optional minus sign, digits with
-- an optional fraction, and an optional exponent (@1.5e-3@). The written
-- decimal stays exact until the conversion to 'Double', so the result is the
-- nearest representable value.
instance Read Double where
  readsPrec _ s = doubleParses (skipSpaces (unpack s))

-- | Reads what 'Text.Show.Show' writes: @LT@, @EQ@ and @GT@.
instance Read Ordering where
  readsPrec d s = readParen (d > 10) orderingParses s

orderingParses :: ReadS Ordering
orderingParses s = case lex s of
  ("LT", r) : _ -> [(LT, r)]
  ("EQ", r) : _ -> [(EQ, r)]
  ("GT", r) : _ -> [(GT, r)]
  _ -> []

-- | Reads what 'Text.Show.Show' writes: @()@.
instance Read () where
  readsPrec d s = readParen (d > 10) unitParses s

unitParses :: ReadS ()
unitParses s = case lex s of
  ("(", r) : _ -> case lex r of
    (")", rest) : _ -> [((), rest)]
    _ -> []
  _ -> []

-- The digits of a decimal literal are folded into an 'Integer' and handed to
-- 'fromInteger', which is where a narrower type truncates and a natural number
-- refuses a negative one — the same conversion 'base' reads numbers through.
readIntegerAs :: Num a => ReadS a
readIntegerAs s = case signedInteger s of
  Nothing -> []
  Just (n, rest) -> [(fromInteger n, rest)]

signedInteger :: String -> Maybe (Integer, String)
signedInteger s = case lex s of
  ("-", r) : _ -> case lex r of
    (tok, rest) : _ -> case digitsToken tok of
      Nothing -> Nothing
      Just n -> Just (negate n, rest)
    [] -> Nothing
  (tok, rest) : _ -> case digitsToken tok of
    Nothing -> Nothing
    Just n -> Just (n, rest)
  [] -> Nothing

digitsToken :: String -> Maybe Integer
digitsToken tok = case unpack tok of
  [] -> Nothing
  ds -> case allDigits ds of
    True -> Just (foldDigitsInteger ds (integerFromInt 0))
    False -> Nothing

foldDigitsInteger :: [Char] -> Integer -> Integer
foldDigitsInteger cs acc = case cs of
  [] -> acc
  d : rest ->
    foldDigitsInteger rest (integerAdd (integerMul acc (integerFromInt 10)) (integerFromInt (digitToInt d)))

doubleParses :: [Char] -> [(Double, String)]
doubleParses cs = case signOf cs of
  (neg, rest) -> case spanDigits rest of
    ([], _) -> []
    (whole, afterWhole) -> case afterWhole of
      '.' : afterDot -> case spanDigits afterDot of
        (frac, afterFrac) -> scaledDouble neg (appendLists whole frac) (countChars frac) afterFrac
      _ -> scaledDouble neg whole 0 afterWhole

signOf :: [Char] -> (Bool, [Char])
signOf cs = case cs of
  '-' : rest -> (True, rest)
  _ -> (False, cs)

spanDigits :: [Char] -> ([Char], [Char])
spanDigits cs = (takeWhileChars isDigit cs, dropWhileChars isDigit cs)

countChars :: [Char] -> Int
countChars cs = case cs of
  [] -> 0
  _ : rest -> 1 + countChars rest

scaledDouble :: Bool -> [Char] -> Int -> [Char] -> [(Double, String)]
scaledDouble neg digits frac cs = case exponentOf cs of
  Nothing -> []
  Just (e, rest) ->
    [(applySign neg (decimalValue (foldDigitsInteger digits (integerFromInt 0)) frac e), pack rest)]

applySign :: Bool -> Double -> Double
applySign neg x = case neg of
  True -> negate x
  False -> x

-- The written value is @mant * 10^(e - frac)@, built as an exact rational so
-- that a single rounding produces the 'Double'.
decimalValue :: Integer -> Int -> Int -> Double
decimalValue mant frac e = case e >= frac of
  True -> rationalToDouble (integerMul mant (pow10 (e - frac))) (integerFromInt 1)
  False -> rationalToDouble mant (pow10 (frac - e))

pow10 :: Int -> Integer
pow10 n = case n <= 0 of
  True -> integerFromInt 1
  False -> integerMul (integerFromInt 10) (pow10 (n - 1))

exponentOf :: [Char] -> Maybe (Int, [Char])
exponentOf cs = case cs of
  'e' : rest -> signedExponent rest
  'E' : rest -> signedExponent rest
  _ -> Just (0, cs)

signedExponent :: [Char] -> Maybe (Int, [Char])
signedExponent cs = case cs of
  '-' : rest -> negatedExponent rest
  '+' : rest -> positiveExponent rest
  _ -> positiveExponent cs

negatedExponent :: [Char] -> Maybe (Int, [Char])
negatedExponent cs = case positiveExponent cs of
  Nothing -> Nothing
  Just (e, rest) -> Just (negate e, rest)

positiveExponent :: [Char] -> Maybe (Int, [Char])
positiveExponent cs = case spanDigits cs of
  ([], _) -> Nothing
  (ds, rest) -> Just (foldExponent ds 0, rest)

foldExponent :: [Char] -> Int -> Int
foldExponent cs acc = case cs of
  [] -> acc
  d : rest -> foldExponent rest (acc * 10 + digitToInt d)

-- | Reads a list, which is the rendering the 'Show' instance for lists
-- produces: the elements between brackets, separated by commas.
instance Read a => Read [a] where
  readsPrec _ s = readListDefault s
  readList = readListDefault

-- | Reads a character literal, quotes and escapes included.
instance Read Char where
  readsPrec _ s = case lex s of
    (tok, rest) : _ -> case unpack tok of
      q : body -> case q == '\'' of
        True -> charParses (readLitChar (pack body)) rest
        False -> []
      [] -> []
    [] -> []

charParses :: [(Char, String)] -> String -> [(Char, String)]
charParses parses rest = case parses of
  [] -> []
  (c, after) : _ -> case unpack after of
    q : _ -> case q == '\'' of
      True -> [(c, rest)]
      False -> []
    [] -> []

-- | Reads a string literal, quotes and escapes included.
instance Read String where
  readsPrec _ s = case lex s of
    (tok, rest) : _ -> case stringBody (pack (dropChars 1 (unpack tok))) of
      Nothing -> []
      Just text -> [(text, rest)]
    [] -> []

stringBody :: String -> Maybe String
stringBody s = case unpack s of
  [] -> Nothing
  c : rest -> case c == '"' of
    True -> Just ""
    False -> case readLitChar s of
      (ch, after) : _ -> case stringBody after of
        Nothing -> Nothing
        Just text -> Just (stringAppend# (singleton ch) text)
      [] -> Nothing

-- | Reads what 'Show' writes: @"True"@ and @"False"@. Lives here (where
-- 'Read' is defined) rather than in 'Data.Bool', which sits below
-- 'Data.String'.
instance Read Bool where
  readsPrec d s = readParen (d > 10) boolParse s

boolParse :: ReadS Bool
boolParse s = case lex s of
  ("True", r) : _ -> [(True, r)]
  ("False", r) : _ -> [(False, r)]
  _ -> []

-- | Reads what 'Show' writes: @"Down 5"@. Lives here (where 'Read' is
-- defined) rather than in 'Data.Ord', which sits below 'Data.String'.
instance Read a => Read (Down a) where
  readsPrec d s = readParen (d > 10) downParse s

downParse :: Read a => ReadS (Down a)
downParse s = case lex s of
  ("Down", r) : _ -> downEach (readsPrec 11 r)
  _ -> []

downEach :: [(a, String)] -> [(Down a, String)]
downEach pairs = case pairs of
  [] -> []
  (x, t) : rest -> (Down x, t) : downEach rest

-- 'GeneralCategory' is declared in 'Data.Char', which sits below
-- 'Data.String' and so cannot import this module for its own deriving clause;
-- its 'Read' instance lives here instead, where both the class and the type are
-- in scope. It matches what stock deriving would generate ('read "Ctor" =
-- Ctor', error otherwise), written out because standalone deriving is not
-- collected into the cross-module instance index.
instance Read GeneralCategory where
  readsPrec d s = readParen (d > 10) categoryParse s

categoryParse :: ReadS GeneralCategory
categoryParse s = case lex s of
  (tok, rest) : _ -> case categoryNamed tok of
    Just c -> [(c, rest)]
    Nothing -> []
  [] -> []

-- | Read one field, then hand the rest of the input to the continuation.
readThen :: (String -> [(a, String)]) -> (a -> String -> [(t, String)]) -> String -> [(t, String)]
readThen p k s = case p s of
  [] -> []
  (x, t) : _ -> k x t

-- | Read the input after a separating comma.
skipComma :: (String -> [(a, String)]) -> String -> [(a, String)]
skipComma p s = case lex s of
  (",", r) : _ -> p r
  _ -> []

-- | Read the input after an opening parenthesis.
afterOpen :: (String -> [(t, String)]) -> String -> [(t, String)]
afterOpen p s = case lex s of
  ("(", r) : _ -> p r
  _ -> []

-- | A tuple's last field, then the closing parenthesis.
closeParsed :: String -> t -> [(t, String)]
closeParsed s x = case lex s of
  (")", rest) : _ -> [(x, rest)]
  _ -> []

-- | Reads what 'Show' writes for a pair: two values between parentheses,
-- separated by a comma.
instance (Read a, Read b) => Read (a, b) where
  readsPrec _ = afterOpen pairFields

pairFields :: (Read a, Read b) => String -> [((a, b), String)]
pairFields =
  readThen reads (\x t -> readThen (skipComma reads) (\y u -> closeParsed u (x, y)) t)

-- | Reads what 'Show' writes for a triple.
instance (Read a, Read b, Read c) => Read (a, b, c) where
  readsPrec _ = afterOpen tripleFields

tripleFields :: (Read a, Read b, Read c) => String -> [((a, b, c), String)]
tripleFields =
  readThen reads (\x t ->
    readThen (skipComma reads) (\y u ->
      readThen (skipComma reads) (\z v -> closeParsed v (x, y, z)) u) t)

-- | Reads what 'Show' writes for a 4-tuple.
instance (Read a, Read b, Read c, Read d) => Read (a, b, c, d) where
  readsPrec _ = afterOpen quadFields

quadFields :: (Read a, Read b, Read c, Read d) => String -> [((a, b, c, d), String)]
quadFields =
  readThen reads (\x t ->
    readThen (skipComma reads) (\y u ->
      readThen (skipComma reads) (\z v ->
        readThen (skipComma reads) (\w r -> closeParsed r (x, y, z, w)) v) u) t)

-- | Reads what 'Show' writes: @Left x@ or @Right y@.
instance (Read a, Read b) => Read (Either a b) where
  readsPrec d = readParen (d > 10) eitherParses

eitherParses :: (Read a, Read b) => ReadS (Either a b)
eitherParses s = case lex s of
  ("Left", r) : _ -> leftParses (readsPrec 11 r)
  ("Right", r) : _ -> rightParses (readsPrec 11 r)
  _ -> []

leftParses :: [(a, String)] -> [(Either a b, String)]
leftParses pairs = case pairs of
  [] -> []
  (x, t) : rest -> (Left x, t) : leftParses rest

rightParses :: [(b, String)] -> [(Either a b, String)]
rightParses pairs = case pairs of
  [] -> []
  (x, t) : rest -> (Right x, t) : rightParses rest

-- | Reads what 'Show' writes: @Const x@.
instance Read a => Read (Const a b) where
  readsPrec d = readParen (d > 10) constParses

constParses :: Read a => ReadS (Const a b)
constParses s = case lex s of
  ("Const", r) : _ -> constEach (readsPrec 11 r)
  _ -> []

constEach :: [(a, String)] -> [(Const a b, String)]
constEach pairs = case pairs of
  [] -> []
  (x, t) : rest -> (Const x, t) : constEach rest

-- | Reads what 'Show' writes: @Nothing@ or @Just x@.
instance Read a => Read (Maybe a) where
  readsPrec d s = readParen (d > 10) maybeParses s

maybeParses :: Read a => ReadS (Maybe a)
maybeParses s = case lex s of
  ("Nothing", r) : _ -> [(Nothing, r)]
  ("Just", r) : _ -> justEach (readsPrec 11 r)
  _ -> []

justEach :: [(a, String)] -> [(Maybe a, String)]
justEach pairs = case pairs of
  [] -> []
  (x, t) : rest -> (Just x, t) : justEach rest

-- | Reads what 'Show' writes: @1 :| [2,3]@. The tail is a list, so it is read
-- by the list instance rather than one element at a time.
instance Read a => Read (NonEmpty a) where
  readsPrec d = readParen (d > 5) nonEmptyParses

nonEmptyParses :: Read a => ReadS (NonEmpty a)
nonEmptyParses s = case readsPrec 6 s of
  [] -> []
  (x, t) : _ -> case lex t of
    (":|", u) : _ -> nonEmptyTail x (reads u)
    _ -> []

nonEmptyTail :: a -> [([a], String)] -> [(NonEmpty a, String)]
nonEmptyTail x pairs = case pairs of
  [] -> []
  (xs, u) : rest -> (x :| xs, u) : nonEmptyTail x rest

-- | Reads what 'Show' writes: @MkSolo x@.
instance Read a => Read (Solo a) where
  readsPrec d s = readParen (d > 10) soloParses s

soloParses :: Read a => ReadS (Solo a)
soloParses s = case lex s of
  ("MkSolo", r) : _ -> soloEach (readsPrec 11 r)
  _ -> []

soloEach :: [(a, String)] -> [(Solo a, String)]
soloEach pairs = case pairs of
  [] -> []
  (x, t) : rest -> (MkSolo x, t) : soloEach rest

-- | Reads what 'Show' writes: @Identity x@.
instance Read a => Read (Identity a) where
  readsPrec d s = readParen (d > 10) identityParses s

identityParses :: Read a => ReadS (Identity a)
identityParses s = case lex s of
  ("Identity", r) : _ -> identityEach (readsPrec 11 r)
  _ -> []

identityEach :: [(a, String)] -> [(Identity a, String)]
identityEach pairs = case pairs of
  [] -> []
  (x, t) : rest -> (Identity x, t) : identityEach rest

categoryNamed :: String -> Maybe GeneralCategory
categoryNamed tok = case tok of
  "UppercaseLetter" -> Just UppercaseLetter
  "LowercaseLetter" -> Just LowercaseLetter
  "TitlecaseLetter" -> Just TitlecaseLetter
  "ModifierLetter" -> Just ModifierLetter
  "OtherLetter" -> Just OtherLetter
  "NonSpacingMark" -> Just NonSpacingMark
  "SpacingCombiningMark" -> Just SpacingCombiningMark
  "EnclosingMark" -> Just EnclosingMark
  "DecimalNumber" -> Just DecimalNumber
  "LetterNumber" -> Just LetterNumber
  "OtherNumber" -> Just OtherNumber
  "ConnectorPunctuation" -> Just ConnectorPunctuation
  "DashPunctuation" -> Just DashPunctuation
  "OpenPunctuation" -> Just OpenPunctuation
  "ClosePunctuation" -> Just ClosePunctuation
  "InitialQuote" -> Just InitialQuote
  "FinalQuote" -> Just FinalQuote
  "OtherPunctuation" -> Just OtherPunctuation
  "MathSymbol" -> Just MathSymbol
  "CurrencySymbol" -> Just CurrencySymbol
  "ModifierSymbol" -> Just ModifierSymbol
  "OtherSymbol" -> Just OtherSymbol
  "Space" -> Just Space
  "LineSeparator" -> Just LineSeparator
  "ParagraphSeparator" -> Just ParagraphSeparator
  "Control" -> Just Control
  "Format" -> Just Format
  "Surrogate" -> Just Surrogate
  "PrivateUse" -> Just PrivateUse
  "NotAssigned" -> Just NotAssigned
  _ -> Nothing
