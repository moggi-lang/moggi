{-# LANGUAGE NoImplicitPrelude #-}
module Data.String.DotNet
  ( singleton
  , pack
  , length
  , reverse
  , isPrefixOf
  , isSuffixOf
  , splitOn
  , lines
  , words
  , unlines
  , unwords
  ) where

import Data.Bool
import Data.Char
import Data.Eq
import Data.Int
import Data.List qualified as L
import Data.Num
import Data.Ord
import Data.Semigroup
import Moggi.Internal.Base
import Moggi.Internal.Prim

-- Ordinary BCL FFI only (no Moggi.Rt.StringOps).
-- Width-exact signatures: BCL String/Char APIs are int32/UTF-16-char based.

foreign dotnet function rawConvertFromUtf32 "System.Char:ConvertFromUtf32" :: Int32 -> String

foreign dotnet function rawUtf16Length "System.String.get_Length" :: String -> Int32

foreign dotnet function rawCharAt "System.String.get_Chars" :: String -> Int32 -> Char

foreign dotnet function rawIsHighSurrogate "System.Char:IsHighSurrogate" :: Char -> Bool

foreign dotnet function rawIsLowSurrogate "System.Char:IsLowSurrogate" :: Char -> Bool

foreign dotnet function rawSubstringLen "System.String.Substring" :: String -> Int32 -> Int32 -> String

foreign dotnet function rawStartsWith "System.String.StartsWith" :: String -> String -> Bool

foreign dotnet function rawEndsWith "System.String.EndsWith" :: String -> String -> Bool

foreign dotnet function rawIndexOfFrom "System.String.IndexOf" :: String -> String -> Int32 -> Int32

foreign dotnet type StringBuilder "System.Text.StringBuilder"

foreign dotnet function newStringBuilder "System.Text.StringBuilder:__con" :: String -> StringBuilder

foreign dotnet function sbAppend "System.Text.StringBuilder.Append" :: StringBuilder -> String -> StringBuilder

foreign dotnet function sbToString "System.Text.StringBuilder.ToString" :: StringBuilder -> String

singleton c = rawConvertFromUtf32 (int32FromInt# (charToInt# c))

utf16Length s = int32ToInt# (rawUtf16Length s)

substringLen s start len = rawSubstringLen s (int32FromInt# start) (int32FromInt# len)

-- | UTF-16 width of the scalar starting at @i@: 2 for a surrogate pair, else 1.
-- The pair's low half is read through the same walk, so it stays here.
utf16WidthAt :: String -> Int -> Int
utf16WidthAt s i =
  let charAt j = rawCharAt s (int32FromInt# j)
      end = utf16Length s
  in case rawIsHighSurrogate (charAt i) of
    False -> 1
    True -> case intCompare# (i + 1) end of
      LT -> case rawIsLowSurrogate (charAt (i + 1)) of
        True -> 2
        False -> 1
      EQ -> 1
      GT -> 1

-- | Scalars go into one builder left to right, so a long build stays linear
-- and in constant stack.
pack :: [Char] -> String
pack xs = sbToString (packBuilder xs (newStringBuilder ""))

packBuilder :: [Char] -> StringBuilder -> StringBuilder
packBuilder xs sb = case xs of
  [] -> sb
  c : cs -> packBuilder cs (sbAppend sb (singleton c))

reverseOnto :: [a] -> [a] -> [a]
reverseOnto xs acc = case xs of
  [] -> acc
  x : rest -> reverseOnto rest (x : acc)

splitOn :: String -> String -> [String]
splitOn sep s =
  let splitOnAt start =
        let i = int32ToInt# (rawIndexOfFrom s sep (int32FromInt# start))
        in case intCompare# i (0 - 1) of
          EQ -> substringLen s start (intSub# (utf16Length s) start) : []
          LT -> substringLen s start (intSub# (utf16Length s) start) : []
          GT -> substringLen s start (intSub# i start) : splitOnAt (i + utf16Length sep)
  in case utf16Length sep of
    0 -> s : []
    _ -> splitOnAt 0

length :: String -> Int
length s = codePointCountGo s 0 (utf16Length s) 0
-- | A top-level loop rather than a closure: the scalar walk of a long string
-- must run in constant stack, and only an entry's tail call becomes one.
codePointCountGo :: String -> Int -> Int -> Int -> Int
codePointCountGo s i endBound acc = case intCompare# i endBound of
  EQ -> acc
  GT -> acc
  LT -> codePointCountGo s (i + utf16WidthAt s i) endBound (acc + 1)

-- | Reverse by Unicode scalar. The reversed scalars have to be rebuilt one at
-- a time: the BCL reverses a `char[]` in place, and a list cannot be handed to
-- a foreign call, so `System.Array.Reverse` is not reachable from here. Both
-- halves of the round trip are loops, so long strings stay on the heap.
reverse :: String -> String
reverse s = pack (reverseOnto (unpack s) [])

isPrefixOf :: String -> String -> Bool
isPrefixOf prefix s = rawStartsWith s prefix

isSuffixOf :: String -> String -> Bool
isSuffixOf suffix s = rawEndsWith s suffix

lines :: String -> [String]
lines "" = ([] :: [String])
lines s = L.reverse (L.dropWhile (\x -> x == "") (L.reverse (splitOn "\n" s)))

words :: String -> [String]
words s = L.filter (\w -> w /= "") (splitOn " " s)

unlines :: [String] -> String
unlines [] = ""
unlines (line : rest) = line <> "\n" <> unlines rest

unwords :: [String] -> String
unwords [] = ""
unwords [x] = x
unwords (x : rest) = x <> " " <> unwords rest
