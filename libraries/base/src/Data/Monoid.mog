{-# LANGUAGE NoImplicitPrelude #-}
-- | A type @a@ is a 'Monoid' if it provides an associative function ('<>')
-- that lets you combine any two values of type @a@ into one, and a neutral
-- element ('mempty') such that
--
-- > a <> mempty == mempty <> a == a
--
-- The class itself, like every other wrapper ('Dual', 'Endo', 'All', 'Any',
-- 'Sum', 'Product', 'First', 'Last', 'Min', 'Max', 'WrappedMonoid', 'Arg'),
-- lives in @Data.Semigroup@ next to 'Semigroup' and is re-exported here.
-- What this module owns is the 'Maybe' wrappers ('First' and 'Last' that
-- skip 'Nothing' — different from @Data.Semigroup@'s unconditional ones)
-- and the 'Alternative'/'Applicative' wrappers 'Alt' and 'Ap'.
module Data.Monoid
  ( Monoid(mempty, mconcat)
  , (<>)
  , Dual(Dual)
  , getDual
  , Endo(Endo)
  , appEndo
  , All(All)
  , getAll
  , Any(Any)
  , getAny
  , Sum(Sum)
  , getSum
  , Product(Product)
  , getProduct
  , First(First)
  , getFirst
  , Last(Last)
  , getLast
  , Alt(Alt)
  , getAlt
  , Ap(Ap)
  , getAp
  ) where

import Control.Applicative
import Control.Monad
import Data.Bool
import Data.Bounded
import Data.Enum
import Data.Eq
import Data.Functor
import Data.Maybe
import Data.Num
import Data.Ord
import Data.Semigroup
import Moggi.Internal.Base
import Text.Show
import Moggi.Internal.Prim

-- First / Last: Maybe monoids. 'First' returns the leftmost non-'Nothing'
-- value, 'Last' the rightmost one. Different from @Data.Semigroup@'s
-- 'First'/'Last', which keep the first/last value unconditionally.

-- | Maybe monoid returning the leftmost non-'Nothing' value.
data First a = First (Maybe a)
  deriving (Eq, Ord)

getFirst :: First a -> Maybe a
getFirst f = case f of
  First x -> x

instance Semigroup (First a) where
  (<>) a b = case getFirst a of
    Nothing -> b
    Just _ -> a

instance Monoid (First a) where
  mempty = First Nothing

instance Show a => Show (First a) where
  showsPrec d x = showParen (d > 10)
    (\r -> showString "First {getFirst = " (showsPrec 0 (getFirst x) (showString "}" r)))

mapMaybeF :: (a -> b) -> Maybe a -> Maybe b
mapMaybeF f mx = case mx of
  Nothing -> Nothing
  Just x -> Just (f x)

instance Functor First where
  map f x = First (mapMaybeF f (getFirst x))

-- | Maybe monoid returning the rightmost non-'Nothing' value.
data Last a = Last (Maybe a)
  deriving (Eq, Ord)

getLast :: Last a -> Maybe a
getLast x = case x of
  Last m -> m

instance Semigroup (Last a) where
  (<>) a b = case getLast b of
    Nothing -> a
    Just _ -> b

instance Monoid (Last a) where
  mempty = Last Nothing

instance Semigroup a => Monoid (Maybe a) where
  mempty = Nothing

instance Show a => Show (Last a) where
  showsPrec d x = showParen (d > 10)
    (\r -> showString "Last {getLast = " (showsPrec 0 (getLast x) (showString "}" r)))

instance Functor Last where
  map f x = Last (mapMaybeF f (getLast x))

-- Alt

-- | A monoid on an 'Alternative' value under its @('<|>')@, with 'empty' as
-- the neutral element.
data Alt f a = Alt (f a)

getAlt :: Alt f a -> f a
getAlt x = case x of
  Alt fa -> fa

instance Alternative f => Semigroup (Alt f a) where
  (<>) a b = Alt (getAlt a <|> getAlt b)

instance Alternative f => Monoid (Alt f a) where
  mempty = Alt empty

instance Functor f => Functor (Alt f) where
  map f x = Alt (map f (getAlt x))

instance Eq (f a) => Eq (Alt f a) where
  (==) a b = getAlt a == getAlt b
  (/=) a b = getAlt a /= getAlt b

instance Ord (f a) => Ord (Alt f a) where
  compare a b = compare (getAlt a) (getAlt b)

instance Show (f a) => Show (Alt f a) where
  showsPrec d x = showParen (d > 10)
    (\r -> showString "Alt {getAlt = " (showsPrec 0 (getAlt x) (showString "}" r)))

-- Ap

-- | A 'Monoid' from an 'Applicative' action returning a 'Monoid': combine
-- with '(<>)' inside the action, 'mempty' is the action returning 'mempty'.
-- Newtype deriving covers only Functor/Foldable/Traversable for `(* -> *)`
-- classes (plus the `*`-kinded ones below); the rest are by hand.
-- Stock Eq/Ord/Show cannot add the `f a` parameter constraint on a two-parameter
-- newtype, so these three are by hand; Functor newtype-derives fine.
newtype Ap f a = Ap (f a)
  deriving (Functor)

instance Eq (f a) => Eq (Ap f a) where
  (==) a b = case a of
    Ap x -> case b of
      Ap y -> x == y
  (/=) a b = case a of
    Ap x -> case b of
      Ap y -> x /= y

instance Ord (f a) => Ord (Ap f a) where
  compare a b = case a of
    Ap x -> case b of
      Ap y -> compare x y

instance Show (f a) => Show (Ap f a) where
  showsPrec d m = showParen (d > 10)
    (\r -> showString "Ap {getAp = " (showsPrec 0 (getAp m) (showString "}" r)))

instance Enum (f a) => Enum (Ap f a) where
  succ m = case m of
    Ap x -> Ap (succ x)
  pred m = case m of
    Ap x -> Ap (pred x)
  toEnum n = Ap (toEnum n)
  fromEnum m = case m of
    Ap x -> fromEnum x

getAp :: Ap f a -> f a
getAp x = case x of
  Ap fa -> fa

instance Applicative f => Applicative (Ap f) where
  pure x = Ap (pure x)
  (<*>) mf mx = case mf of
    Ap f -> case mx of
      Ap x -> Ap (f <*> x)

instance Alternative f => Alternative (Ap f) where
  empty = Ap empty
  (<|>) a b = case a of
    Ap x -> case b of
      Ap y -> Ap (x <|> y)

instance Monad f => Monad (Ap f) where
  (>>=) m f = case m of
    Ap x -> Ap (x >>= (\a -> case f a of
      Ap y -> y))

instance MonadPlus f => MonadPlus (Ap f)

instance (Applicative f, Semigroup a) => Semigroup (Ap f a) where
  (<>) a b = case a of
    Ap x -> case b of
      Ap y -> Ap (liftA2 (<>) x y)

instance (Applicative f, Monoid a) => Monoid (Ap f a) where
  mempty = Ap (pure mempty)

instance (Applicative f, Bounded a) => Bounded (Ap f a) where
  minBound = Ap (pure minBound)
  maxBound = Ap (pure maxBound)

instance (Applicative f, Num a) => Num (Ap f a) where
  (+) a b = case a of
    Ap x -> case b of
      Ap y -> Ap (liftA2 (+) x y)
  (-) a b = case a of
    Ap x -> case b of
      Ap y -> Ap (liftA2 (-) x y)
  (*) a b = case a of
    Ap x -> case b of
      Ap y -> Ap (liftA2 (*) x y)
  negate a = case a of
    Ap x -> Ap (map negate x)
  abs a = case a of
    Ap x -> Ap (map abs x)
  signum a = case a of
    Ap x -> Ap (map signum x)
  fromInteger n = Ap (pure (fromInteger n))
