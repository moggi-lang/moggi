import Data.Bool
import Data.Char
import Data.Enum
import Data.Eq
import Data.List
import Data.Maybe
import Data.Ord
import Data.String qualified as S
import Data.Tuple
import Data.Word (Word, Word64)
import Data.Num
import Data.Integer
import Data.Real
import Moggi.Err
import Moggi.Internal.Base hiding (take, drop, unpack)
import Text.Show
import Moggi.Internal.Prim
import Data.Functor (Functor(map))

instance Eq Double where
  (==) a b = doubleEq# a b
  (/=) a b = doubleNe# a b

instance Ord Double where
  compare a b = doubleCompare# a b

instance Num Double where
  (+) a b = doubleAdd# a b
  (-) a b = doubleSub# a b
  (*) a b = doubleMul# a b
  negate a = doubleNegate# a
  abs a = doubleAbs# a
  signum a = doubleSignum# a
  fromInteger n = doubleFromInteger# n

instance Enum Double where
  succ x = x + 1.0
  pred x = x - 1.0
  toEnum n = doubleFromInteger# (intToInteger# n)
  fromEnum x = doubleToInt# x

instance Fractional Double where
  (/) a b = doubleDiv# a b
  recip x = doubleDiv# (fromInteger (intToInteger# 1)) x

instance Show Double where
  show x = S.pack (showSignedChars x)

-- The formatter works on @[Char]@; @str@ lifts a 'String' literal into it.
str :: String -> [Char]
str = S.unpack

-- ---------------------------------------------------------------------------
-- IsNaN / isInfinite / isNegativeZero, derived from the IEEE operations.
-- ---------------------------------------------------------------------------

doubleLessThan :: Double -> Double -> Bool
doubleLessThan a b = case doubleCompare# a b of
  LT -> True
  _ -> False

isNaNDouble :: Double -> Bool
isNaNDouble x = doubleNe# x x

isInfiniteDouble :: Double -> Bool
isInfiniteDouble x = case doubleEq# x x of
  False -> False
  True -> case doubleNe# x 0.0 of
    False -> False
    True -> doubleEq# (doubleMul# x 2.0) x

isNegativeZeroDouble :: Double -> Bool
isNegativeZeroDouble x = case doubleEq# x 0.0 of
  False -> False
  True -> case doubleCompare# (doubleDiv# 1.0 x) 0.0 of
    LT -> True
    _ -> False

-- ---------------------------------------------------------------------------
-- Showing
-- ---------------------------------------------------------------------------

-- | Show a signed 'Double' to full precision using standard decimal notation
-- for arguments whose absolute value lies between @0.1@ and @9,999,999@, and
-- scientific notation otherwise.
showSignedChars :: Double -> [Char]
showSignedChars x = case doubleLessThan x 0.0 of
  True -> '-' : formatRealFloatChars FFGeneric Nothing (doubleNegate# x)
  False -> case isNegativeZeroDouble x of
    True -> '-' : formatRealFloatChars FFGeneric Nothing (doubleNegate# x)
    False -> formatRealFloatChars FFGeneric Nothing x

-- | The notation 'formatRealFloatChars' prints in: exponent, fixed point, or
-- whichever of the two is shorter.
data FFFormat = FFExponent | FFFixed | FFGeneric

formatRealFloatChars :: FFFormat -> Maybe Int -> Double -> [Char]
formatRealFloatChars fmt decs x = case isNaNDouble x of
  True -> str "NaN"
  False -> case isInfiniteDouble x of
    True -> case doubleLessThan x 0.0 of
      True -> str "-Infinity"
      False -> str "Infinity"
    False -> case doubleLessThan x 0.0 of
      True -> '-' : doFmt decs fmt (floatToDigitsDouble (doubleNegate# x))
      False -> case isNegativeZeroDouble x of
        True -> '-' : doFmt decs fmt (floatToDigitsDouble (doubleNegate# x))
        False -> doFmt decs fmt (floatToDigitsDouble x)

doFmt :: Maybe Int -> FFFormat -> ([Int], Int) -> [Char]
doFmt decs format digits =
  let is = fst digits
      e = snd digits
      ds = map intToDigit is
  in case format of
    FFGeneric -> doFmt decs (case e < 0 || e > 7 of True -> FFExponent; False -> FFFixed) digits
    FFExponent -> case decs of
      Nothing -> case ds of
        ['0'] -> str "0.0e0"
        [d] -> d : str ".0e" ++ str (show (e - 1))
        (d:ds') -> d : '.' : ds' ++ str "e" ++ str (show (e - 1))
        [] -> error "formatRealFloat/doFmt/FFExponent: []"
      Just d -> case d <= 0 of
        True -> case is of
          [0] -> str "0e0"
          _ ->
            let rounded = roundTo 10 1 is
                ei = fst rounded
                is' = snd rounded
                ns = map intToDigit (case ei > 0 of True -> init is'; False -> is')
            in head ns : 'e' : str (show (e - 1 + ei))
        False ->
          let dec' = max d 1
          in case is of
            [0] -> '0' : '.' : replicate dec' '0' ++ str "e0"
            _ ->
              let rounded = roundTo 10 (dec' + 1) is
                  ei = fst rounded
                  is' = snd rounded
                  ns = map intToDigit (case ei > 0 of True -> init is'; False -> is')
              in head ns : '.' : tail ns ++ ('e' : str (show (e - 1 + ei)))
    FFFixed -> case decs of
      Nothing -> case e <= 0 of
        True -> str "0." ++ replicate (negate e) '0' ++ ds
        False -> fixedDigits e [] ds
      Just d ->
        let dec' = max d 0
        in case e >= 0 of
          True ->
            let rounded = roundTo 10 (dec' + e) is
                ei = fst rounded
                is' = snd rounded
                all' = map intToDigit is'
                ls = take (e + ei) all'
                rs = drop (e + ei) all'
            in mk0 ls ++ (case null rs of True -> []; False -> '.' : rs)
          False ->
            let rounded = roundTo 10 dec' (replicate (negate e) 0 ++ is)
                ei = fst rounded
                is' = snd rounded
                ns = map intToDigit (case ei > 0 of True -> is'; False -> 0 : is')
            in head ns : (case null (tail ns) of True -> []; False -> '.' : tail ns)

mk0 :: [Char] -> [Char]
mk0 [] = ['0']
mk0 ls = ls

fixedDigits :: Int -> [Char] -> [Char] -> [Char]
fixedDigits 0 s rs = mk0 (reverse s) ++ '.' : mk0 rs
fixedDigits n s [] = fixedDigits (n - 1) ('0' : s) []
fixedDigits n s (r:rs) = fixedDigits (n - 1) (r : s) rs

roundTo :: Int -> Int -> [Int] -> (Int, [Int])
roundTo base d is =
  let b2 = base `quot` 2
      r = roundToGo b2 d True is
  in case r of
    (0, _) -> r
    (1, xs) -> (1, 1 : xs)
    _ -> error "roundTo: bad Value"

roundToGo :: Int -> Int -> Bool -> [Int] -> (Int, [Int])
roundToGo b2 n _ [] = (0, replicate n 0)
roundToGo b2 0 e (x:xs) = case x == b2 && e && all (== 0) xs of
  True -> (0, [])
  False -> ((case x >= b2 of True -> 1; False -> 0), [])
roundToGo b2 n _ (i:xs) =
  let inner = roundToGo b2 (n - 1) (even i) xs
      c = fst inner
      ds = snd inner
      i' = c + i
  in case i' == b2 * 2 of
    True -> (1, 0 : ds)
    False -> (0, i' : ds)

-- ---------------------------------------------------------------------------
-- floatToDigits: ([d1..dn], e) with x = 0.d1..dn * 10^e.
--
-- Based on "Printing Floating-Point Numbers Quickly and Accurately" by
-- R.G. Burger and R.K. Dybvig, PLDI 96, over 'Integer'.
-- ---------------------------------------------------------------------------

floatToDigitsDouble :: Double -> ([Int], Int)
floatToDigitsDouble x = case doubleEq# x 0.0 of
  True -> ([0], 0)
  False -> floatToDigitsNonZero x

floatToDigitsNonZero :: Double -> ([Int], Int)
floatToDigitsNonZero x =
  let decoded = decodeDouble x
      f0 = fst decoded
      e0 = snd decoded
      b = integerFromInt 2
      base = integerFromInt 10
      p = 53
      minExp = -1074
      n = minExp - e0
      adjusted = case n > 0 of
        True -> (integerQuot f0 (b ^ n), e0 + n)
        False -> (f0, e0)
      f = fst adjusted
      e = snd adjusted
      factors = floatToDigitsFactors b p minExp f e
      r = fst (fst factors)
      s = snd (fst factors)
      mUp = fst (snd factors)
      mDn = snd (snd factors)
      k = floatToDigitsK p e0 base r s mUp mDn
      rds = case k >= 0 of
        True -> floatToDigitsGen base r (s * base ^ k) mUp mDn []
        False ->
          let bk = base ^ intNegate# k
          in floatToDigitsGen base (r * bk) s (mUp * bk) (mDn * bk) []
  in (map integerToInt (reverse rds), k)

floatToDigitsFactors :: Integer -> Int -> Int -> Integer -> Int -> ((Integer, Integer), (Integer, Integer))
floatToDigitsFactors b p minExp f e = case e >= 0 of
  True ->
    let be = b ^ e
    in case f == b ^ (p - 1) of
      True -> ((f * be * b * 2, 2 * b), (be * b, be))
      False -> ((f * be * 2, 2), (be, be))
  False -> case e > minExp && f == b ^ (p - 1) of
    True -> ((f * b * 2, b ^ (intNegate# e + 1) * 2), (b, 1))
    False -> ((f * 2, b ^ intNegate# e * 2), (1, 1))

floatToDigitsK :: Int -> Int -> Integer -> Integer -> Integer -> Integer -> Integer -> Int
floatToDigitsK p e0 base r s mUp mDn =
  let lx = p - 1 + e0
      k1 = (lx * 8651) `quot` 28738
      k0 = case lx >= 0 of
        True -> k1 + 1
        False -> k1
  in floatToDigitsFixup base r s mUp mDn k0

floatToDigitsFixup :: Integer -> Integer -> Integer -> Integer -> Integer -> Int -> Int
floatToDigitsFixup base r s mUp mDn n = case n >= 0 of
  True -> case r + mUp <= base ^ n * s of
    True -> n
    False -> floatToDigitsFixup base r s mUp mDn (n + 1)
  False -> case base ^ intNegate# n * (r + mUp) <= s of
    True -> n
    False -> floatToDigitsFixup base r s mUp mDn (n + 1)

floatToDigitsGen :: Integer -> Integer -> Integer -> Integer -> Integer -> [Integer] -> [Integer]
floatToDigitsGen base rn sN mUpN mDnN ds =
  let qr = (rn * base) `quotRem` sN
      dn = fst qr
      rn' = snd qr
      mUpN' = mUpN * base
      mDnN' = mDnN * base
  in case (rn' < mDnN', rn' + mUpN' > sN) of
    (True, False) -> dn : ds
    (False, True) -> (dn + 1) : ds
    (True, True) -> case rn' * 2 < sN of
      True -> dn : ds
      False -> (dn + 1) : ds
    (False, False) -> floatToDigitsGen base rn' sN mUpN' mDnN' (dn : ds)

-- ---------------------------------------------------------------------------
-- decodeFloat: (m, e) with x = m * 2^e and m a 53-bit integer for normal
-- values. The magnitude is brought into [2^52, 2^53) by exact scaling with
-- powers of two, so no bit-level primitive is needed.
-- ---------------------------------------------------------------------------

decodeDouble :: Double -> (Integer, Int)
decodeDouble x = case doubleLessThan x 0.0 of
  True -> let decoded = decodeMagnitude (doubleNegate# x) in (negate (fst decoded), snd decoded)
  False -> decodeMagnitude x

decodeMagnitude :: Double -> (Integer, Int)
decodeMagnitude x = decodeScaleDown x 0

decodeScaleDown :: Double -> Int -> (Integer, Int)
decodeScaleDown x e = case doubleCompare# x 9007199254740992.0 of
  LT -> decodeScaleUp x e
  _ -> decodeScaleDown (doubleMul# x 0.5) (e + 1)

decodeScaleUp :: Double -> Int -> (Integer, Int)
decodeScaleUp x e = case doubleCompare# x 4503599627370496.0 of
  LT -> decodeScaleUp (doubleMul# x 2.0) (e - 1)
  _ -> (integerFromInt (doubleToInt# x), e)

-- ---------------------------------------------------------------------------
-- Floating Double: the semantic transcendental API on `Double`.
--
-- `Floating` itself lives in `Data.Real`; the host math comes from the
-- compiler's `double*#` intrinsics (via `Moggi.Internal.Prim`), the same way
-- `Double`'s arithmetic does. `java.lang.Math` has no `asinh`/`acosh`/`atanh`,
-- so those three are derived from `log` and `sqrt` on every backend.
-- ---------------------------------------------------------------------------

instance Floating Double where
  pi = 3.141592653589793
  exp x = doubleExp# x
  log x = doubleLog# x
  sqrt x = doubleSqrt# x
  sin x = doubleSin# x
  cos x = doubleCos# x
  asin x = doubleAsin# x
  acos x = doubleAcos# x
  atan x = doubleAtan# x
  sinh x = doubleSinh# x
  cosh x = doubleCosh# x
  asinh x = case doubleLessThan (doubleAbs# x) 1.0e-8 of
    True -> x
    False -> case doubleLessThan (doubleAbs# x) 1.0e150 of
      True -> log (x + sqrt (x * x + 1.0))
      False -> case doubleLessThan x 0.0 of
        True -> negate (log (doubleNegate# x) + 0.6931471805599453)
        False -> log x + 0.6931471805599453
  acosh x = case doubleLessThan x 1.0e150 of
    True -> log (x + sqrt (x * x - 1.0))
    False -> log x + 0.6931471805599453
  atanh x = case doubleLessThan (doubleAbs# x) 1.0e-8 of
    True -> x
    False -> 0.5 * log ((1.0 + x) / (1.0 - x))
  log1p x = case doubleLessThan (doubleAbs# x) 1.0e-8 of
    True -> x
    False -> doubleLog# (doubleAdd# 1.0 x)
  expm1 x = case doubleLessThan (doubleAbs# x) 1.0e-8 of
    True -> x
    False -> doubleSub# (doubleExp# x) 1.0
  tanh x = case doubleLessThan 20.0 (doubleAbs# x) of
    True -> case doubleLessThan x 0.0 of
      True -> -1.0
      False -> 1.0
    False -> doubleDiv# (doubleSinh# x) (doubleCosh# x)

-- | The 'Double' nearest to @num \/ den@: the quotient of the two integers as
-- a floating-point value. The quotient is formed at full width and then scaled
-- by a power of two, so neither very large denominators nor subnormal results
-- overflow on the way.
rationalToDouble :: Integer -> Integer -> Double
rationalToDouble num den = case den == integerFromInt 0 of
  True -> case num == integerFromInt 0 of
    True -> doubleDiv# 0.0 0.0
    False -> case num > integerFromInt 0 of
      True -> doubleDiv# 1.0 0.0
      False -> doubleDiv# (-1.0) 0.0
  False -> case num == integerFromInt 0 of
    True -> 0.0
    False -> case sameSign num den of
      True -> ratioMagnitude (absInteger num) (absInteger den)
      False -> negate (ratioMagnitude (absInteger num) (absInteger den))

sameSign :: Integer -> Integer -> Bool
sameSign a b = case a > integerFromInt 0 of
  True -> b > integerFromInt 0
  False -> b < integerFromInt 0

absInteger :: Integer -> Integer
absInteger n = case n > integerFromInt 0 of
  True -> n
  False -> negate n

ratioMagnitude :: Integer -> Integer -> Double
ratioMagnitude a b = scaleByPowerOfTwo (doubleFromInteger# q) (negate k)
  where
    k = 53 + bitLength b - bitLength a
    scaled = case k >= 0 of
      True -> a * (integerFromInt 2 ^ k)
      False -> a
    divisor = case k >= 0 of
      True -> b
      False -> b * (integerFromInt 2 ^ (negate k))
    q = roundQuotient scaled divisor

bitLength :: Integer -> Int
bitLength n = case n > integerFromInt 0 of
  True -> bitLengthGo n 0
  False -> 0

bitLengthGo :: Integer -> Int -> Int
bitLengthGo n acc = case n == integerFromInt 0 of
  True -> acc
  False -> bitLengthGo (quot n 2) (acc + 1)

scaleByPowerOfTwo :: Double -> Int -> Double
scaleByPowerOfTwo x e = case e >= 0 of
  True -> scaleUp x e
  False -> scaleDown x (negate e)

scaleUp :: Double -> Int -> Double
scaleUp x e = case e == 0 of
  True -> x
  False -> scaleUp (doubleMul# x 2.0) (e - 1)

scaleDown :: Double -> Int -> Double
scaleDown x e = case e == 0 of
  True -> x
  False -> scaleDown (doubleDiv# x 2.0) (e - 1)

castWord64ToDouble :: Word64 -> Double
castWord64ToDouble w = castWord64ToDouble# w

castDoubleToWord64 :: Double -> Word64
castDoubleToWord64 x = castDoubleToWord64# x

isDoubleNaN :: Double -> Bool
isDoubleNaN x = isNaNDouble x

isDoubleInfinite :: Double -> Bool
isDoubleInfinite x = isInfiniteDouble x

isDoubleNegativeZero :: Double -> Bool
isDoubleNegativeZero x = isNegativeZeroDouble x

-- ---------------------------------------------------------------------------
-- Conversions
-- ---------------------------------------------------------------------------

double2Int :: Double -> Int
double2Int x = doubleToInt# x

int2Double :: Int -> Double
int2Double n = doubleFromInteger# (intToInteger# n)

word2Double :: Word -> Double
word2Double w = doubleFromInteger# (toInteger w)

-- ---------------------------------------------------------------------------
-- Rounding to integral values
-- ---------------------------------------------------------------------------

truncateToInteger :: Double -> Integer
truncateToInteger x = case isNaNDouble x of
  True -> error "truncate: NaN"
  False -> case isInfiniteDouble x of
    True -> error "truncate: Infinity"
    False -> case doubleLessThan x 0.0 of
      True -> negate (magnitudeWhole (doubleNegate# x))
      False -> magnitudeWhole x

magnitudeWhole :: Double -> Integer
magnitudeWhole x = case doubleEq# x 0.0 of
  True -> integerFromInt 0
  False -> wholeOfDecoded (decodeDouble x)

wholeOfDecoded :: (Integer, Int) -> Integer
wholeOfDecoded decoded = case snd decoded >= 0 of
  True -> fst decoded * (integerFromInt 2 ^ snd decoded)
  False -> integerQuot (fst decoded) (integerFromInt 2 ^ intNegate# (snd decoded))

truncateDouble :: Integral a => Double -> a
truncateDouble x = fromInteger (truncateToInteger x)

floorDouble :: Integral a => Double -> a
floorDouble x = case doubleLessThan x (doubleFromInteger# w) of
  True -> fromInteger (w - 1)
  False -> fromInteger w
  where
    w = truncateToInteger x

ceilingDouble :: Integral a => Double -> a
ceilingDouble x = case doubleLessThan (doubleFromInteger# w) x of
  True -> fromInteger (w + 1)
  False -> fromInteger w
  where
    w = truncateToInteger x

roundDouble :: Integral a => Double -> a
roundDouble x = case doubleLessThan x 0.0 of
  True -> fromInteger (negate (roundMagnitude (doubleNegate# x)))
  False -> fromInteger (roundMagnitude x)

roundMagnitude :: Double -> Integer
roundMagnitude x = case doubleLessThan frac 0.5 of
  True -> w
  False -> case doubleLessThan 0.5 frac of
    True -> w + 1
    False -> case evenInteger w of
      True -> w
      False -> w + 1
  where
    w = magnitudeWhole x
    frac = x - doubleFromInteger# w

evenInteger :: Integer -> Bool
evenInteger n = rem n (integerFromInt 2) == integerFromInt 0

properFractionDouble :: Integral a => Double -> (a, Double)
properFractionDouble x = (fromInteger w, x - doubleFromInteger# w)
  where
    w = truncateToInteger x

-- ---------------------------------------------------------------------------
-- Predicates
-- ---------------------------------------------------------------------------

isDoubleFinite :: Double -> Bool
isDoubleFinite x = case isNaNDouble x of
  True -> False
  False -> case isInfiniteDouble x of
    True -> False
    False -> True

isDoubleDenormalized :: Double -> Bool
isDoubleDenormalized x = case doubleEq# x 0.0 of
  True -> False
  False -> doubleLessThan (doubleAbs# x) 2.2250738585072014e-308

-- ---------------------------------------------------------------------------
-- Comparison
-- ---------------------------------------------------------------------------

gtDouble :: Double -> Double -> Bool
gtDouble a b = case doubleCompare# a b of
  GT -> True
  _ -> False

geDouble :: Double -> Double -> Bool
geDouble a b = case doubleCompare# a b of
  GT -> True
  EQ -> True
  _ -> False

leDouble :: Double -> Double -> Bool
leDouble a b = case doubleCompare# a b of
  LT -> True
  EQ -> True
  _ -> False

ltDouble :: Double -> Double -> Bool
ltDouble a b = case doubleCompare# a b of
  LT -> True
  _ -> False

-- ---------------------------------------------------------------------------
-- Arithmetic
-- ---------------------------------------------------------------------------

plusDouble :: Double -> Double -> Double
plusDouble a b = doubleAdd# a b

minusDouble :: Double -> Double -> Double
minusDouble a b = doubleSub# a b

timesDouble :: Double -> Double -> Double
timesDouble a b = doubleMul# a b

divideDouble :: Double -> Double -> Double
divideDouble a b = doubleDiv# a b

negateDouble :: Double -> Double
negateDouble x = doubleNegate# x

expDouble :: Double -> Double
expDouble x = doubleExp# x

expm1Double :: Double -> Double
expm1Double x = doubleSub# (doubleExp# x) 1.0

logDouble :: Double -> Double
logDouble x = doubleLog# x

log1pDouble :: Double -> Double
log1pDouble x = doubleLog# (doubleAdd# x 1.0)

sqrtDouble :: Double -> Double
sqrtDouble x = doubleSqrt# x

fabsDouble :: Double -> Double
fabsDouble x = doubleAbs# x

sinDouble :: Double -> Double
sinDouble x = doubleSin# x

cosDouble :: Double -> Double
cosDouble x = doubleCos# x

tanDouble :: Double -> Double
tanDouble x = doubleDiv# (doubleSin# x) (doubleCos# x)

asinDouble :: Double -> Double
asinDouble x = doubleAsin# x

acosDouble :: Double -> Double
acosDouble x = doubleAcos# x

atanDouble :: Double -> Double
atanDouble x = doubleAtan# x

sinhDouble :: Double -> Double
sinhDouble x = doubleSinh# x

coshDouble :: Double -> Double
coshDouble x = doubleCosh# x

tanhDouble :: Double -> Double
tanhDouble x = doubleDiv# (doubleSinh# x) (doubleCosh# x)

asinhDouble :: Double -> Double
asinhDouble x = doubleLog# (doubleAdd# x (doubleSqrt# (doubleAdd# (doubleMul# x x) 1.0)))

acoshDouble :: Double -> Double
acoshDouble x = doubleLog# (doubleAdd# x (doubleSqrt# (doubleSub# (doubleMul# x x) 1.0)))

atanhDouble :: Double -> Double
atanhDouble x = doubleMul# 0.5 (doubleLog# (doubleDiv# (doubleAdd# 1.0 x) (doubleSub# 1.0 x)))

-- ---------------------------------------------------------------------------
-- Formatting
-- ---------------------------------------------------------------------------

formatRealFloat :: FFFormat -> Maybe Int -> Double -> String
formatRealFloat fmt decs x = S.pack (formatRealFloatChars fmt decs x)

formatRealFloatAlt :: FFFormat -> Maybe Int -> Bool -> Double -> String
formatRealFloatAlt fmt decs alt x = case alt of
  True -> S.pack (ensurePoint (formatRealFloatChars fmt decs x))
  False -> S.pack (formatRealFloatChars fmt decs x)

ensurePoint :: [Char] -> [Char]
ensurePoint s = case break pointOrExponent s of
  (_, '.' : _) -> s
  (pre, 'e' : rest) -> pre ++ '.' : 'e' : rest
  (pre, 'E' : rest) -> pre ++ '.' : 'E' : rest
  _ -> s ++ ['.']
  where
    pointOrExponent c = case c of
      '.' -> True
      'e' -> True
      'E' -> True
      _ -> False

showSignedFloat :: (Double -> ShowS) -> Int -> Double -> ShowS
showSignedFloat showPos p x = case doubleLessThan x 0.0 of
  True -> showParen (p > 6) (\s -> showPos (doubleNegate# x) (showChar '-' s))
  False -> showPos x

-- ---------------------------------------------------------------------------
-- Powers of two and the numeric-literal helpers
-- ---------------------------------------------------------------------------

powerDouble :: Double -> Int -> Double
powerDouble x n = x ^ n

powerOfTwo :: Int -> Double
powerOfTwo e = scaleByPowerOfTwo 1.0 e

log1mexpOrd :: Double -> Int
log1mexpOrd x = case doubleCompare# x (-0.6931471805599453) of
  LT -> -1
  EQ -> 0
  GT -> 1

clamp :: Int -> Int -> Int -> Int
clamp lo hi x = max lo (min hi x)

expt :: Integer -> Int -> Integer
expt b e = b ^ e

expts10 :: Integer -> Int -> Integer
expts10 m e = m * (integerFromInt 10 ^ e)

expts :: Int -> [(Integer, Int)]
expts b = exptsUp b 0

exptsUp :: Int -> Int -> [(Integer, Int)]
exptsUp b e = case e > maxExpt of
  True -> []
  False -> (integerFromInt b ^ e, e) : exptsUp b (e + 1)

maxExpt :: Int
maxExpt = 1024

maxExpt10 :: Int
maxExpt10 = 324

minExpt :: Int
minExpt = 0 - 1074

-- | @n \/ d@ rounded to the nearest integer, halves to even. The invariant is
-- @d > 0@.
roundQuotient :: Integer -> Integer -> Integer
roundQuotient n d = case 2 * r > d of
  True -> q + 1
  False -> case 2 * r == d of
    True -> case rem q (integerFromInt 2) == integerFromInt 0 of
      True -> q
      False -> q + 1
    False -> q
  where
    q = quot n d
    r = rem n d

integerToBinaryFloat' :: Integer -> (Integer, Int)
integerToBinaryFloat' n = shrinkInteger n 0

shrinkInteger :: Integer -> Int -> (Integer, Int)
shrinkInteger m e = case m >= big of
  True -> shrinkInteger (quot m 2) (e + 1)
  False -> case m <= negate big of
    True -> shrinkInteger (quot m 2) (e + 1)
    False -> (m, e)
  where
    big = integerFromInt 2 ^ 53

eqDouble :: Double -> Double -> Bool
eqDouble a b = doubleEq# a b

floatToDigits :: Integer -> Double -> ([Int], Int)
floatToDigits base x = case base == integerFromInt 10 of
  True -> floatToDigitsDouble x
  False -> binaryFloatDigits x

binaryFloatDigits :: Double -> ([Int], Int)
binaryFloatDigits x = case doubleEq# x 0.0 of
  True -> ([0], 0)
  False -> (integerBits (fst decoded), 53 + snd decoded)
  where
    decoded = decodeDouble x

integerBits :: Integer -> [Int]
integerBits n = case n == integerFromInt 0 of
  True -> []
  False -> integerBits (quot n 2) ++ [integerToInt (rem n 2)]

-- ---------------------------------------------------------------------------
-- RealFloat
-- ---------------------------------------------------------------------------

class Floating a => RealFloat a where
  floatRadix :: a -> Integer
  floatDigits :: a -> Int
  floatRange :: a -> (Int, Int)
  decodeFloat :: a -> (Integer, Int)
  encodeFloat :: Integer -> Int -> a
  exponent :: a -> Int
  significand :: a -> a
  scaleFloat :: Int -> a -> a
  isNaN :: a -> Bool
  isInfinite :: a -> Bool
  isDenormalized :: a -> Bool
  isNegativeZero :: a -> Bool
  isIEEE :: a -> Bool

instance RealFloat Double where
  floatRadix _ = integerFromInt 2
  floatDigits _ = 53
  floatRange _ = (0 - 1021, 1024)
  decodeFloat x = decodeDouble x
  encodeFloat m e = doubleMul# (doubleFromInteger# m) (powerOfTwo e)
  exponent x = 52 + snd (decodeDouble x)
  significand x = doubleMul# x (powerOfTwo (negate (52 + snd (decodeDouble x))))
  scaleFloat e x = doubleMul# x (powerOfTwo e)
  isNaN x = isNaNDouble x
  isInfinite x = isInfiniteDouble x
  isDenormalized x = isDoubleDenormalized x
  isNegativeZero x = isNegativeZeroDouble x
  isIEEE _ = True
