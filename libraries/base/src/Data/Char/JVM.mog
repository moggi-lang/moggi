{-# LANGUAGE NoImplicitPrelude #-}
module Data.Char.JVM
  ( isControl
  , isSpace
  , isLower
  , isUpper
  , isLowerCase
  , isUpperCase
  , generalCategoryCode
  , isAlpha
  , isLetter
  , isAlphaNum
  , isPrint
  , isDigit
  , isNumber
  , isPunctuation
  , isSymbol
  , isSeparator
  , isMark
  , toUpper
  , toLower
  , toTitle
  , digitToInt
  ) where

import Data.Bool
import Moggi.Err
import Data.Eq
import Data.Int
import Data.Num
import Data.Ord
import Moggi.Internal.Base
import Moggi.Internal.Prim

foreign jvm function isControl "java.lang.Character:isISOControl" :: Char -> Bool

foreign jvm function isSpace "java.lang.Character:isWhitespace" :: Char -> Bool

-- Lower/upper follow the general category (like base's 'isLower'/'isUpper');
-- the Unicode Lowercase/Uppercase properties are 'isLowerCase'/'isUpperCase'.
-- Codes are the shared category-code table (the 'GeneralCategory' 'Enum'
-- order): 1 is lowercase, 0 and 2 are uppercase/titlecase.
isLower c = intEq (generalCategoryCode c) 1

isUpper c = intEq (generalCategoryCode c) 0 || intEq (generalCategoryCode c) 2

foreign jvm function isLowerCase "java.lang.Character:isLowerCase" :: Char -> Bool

foreign jvm function isUpperCase "java.lang.Character:isUpperCase" :: Char -> Bool

foreign jvm function isAlpha "java.lang.Character:isLetter" :: Char -> Bool

foreign jvm function isAlphaNum "java.lang.Character:isLetterOrDigit" :: Char -> Bool

foreign jvm function isDigit "java.lang.Character:isDigit" :: Char -> Bool

foreign jvm function toUpper "java.lang.Character:toUpperCase" :: Char -> Char

foreign jvm function toLower "java.lang.Character:toLowerCase" :: Char -> Char

foreign jvm function toTitle "java.lang.Character:toTitleCase" :: Char -> Char

foreign jvm function rawGetType "java.lang.Character:getType" :: Char -> Int32

foreign jvm function rawGetNumericValue "java.lang.Character:getNumericValue" :: Char -> Int32

getType c = int32ToInt# (rawGetType c)

getNumericValue c = int32ToInt# (rawGetNumericValue c)

-- java.lang.Character category bytes: letters 1-5, marks 6-8, numbers 9-11,
-- separators 12-14, control 15, format 16, private-use 18, surrogate 19,
-- punctuation 20-24/29-30, symbols 25-28; 0 (unassigned) is code 29.
-- Codes are the shared category-code table (the 'GeneralCategory' 'Enum' order).
generalCategoryCode :: Char -> Int
generalCategoryCode c = catFromType (getType c)

catFromType t = case intEq t 1 of
  True -> 0
  False -> case intEq t 2 of
    True -> 1
    False -> case intEq t 3 of
      True -> 2
      False -> case intEq t 4 of
        True -> 3
        False -> case intEq t 5 of
          True -> 4
          False -> catMarkOrNumber t

catMarkOrNumber t = case intEq t 6 of
  True -> 5
  False -> case intEq t 7 of
    True -> 7
    False -> case intEq t 8 of
      True -> 6
      False -> case intEq t 9 of
        True -> 8
        False -> case intEq t 10 of
          True -> 9
          False -> case intEq t 11 of
            True -> 10
            False -> catPunctOrSymbol t

catPunctOrSymbol t = case intEq t 23 of
  True -> 11
  False -> case intEq t 20 of
    True -> 12
    False -> case intEq t 21 of
      True -> 13
      False -> case intEq t 22 of
        True -> 14
        False -> case intEq t 29 of
          True -> 15
          False -> case intEq t 30 of
            True -> 16
            False -> case intEq t 24 of
              True -> 17
              False -> catSymbolOrSep t

catSymbolOrSep t = case intEq t 25 of
  True -> 18
  False -> case intEq t 26 of
    True -> 19
    False -> case intEq t 27 of
      True -> 20
      False -> case intEq t 28 of
        True -> 21
        False -> case intEq t 12 of
          True -> 22
          False -> case intEq t 13 of
            True -> 23
            False -> case intEq t 14 of
              True -> 24
              False -> catOther t

catOther t = case intEq t 15 of
  True -> 25
  False -> case intEq t 16 of
    True -> 26
    False -> case intEq t 18 of
      True -> 28
      False -> case intEq t 19 of
        True -> 27
        False -> 29

isLetter = isAlpha

isPrint c = not (isControl c)

intEq a b = a == b

lteInt a b = case intCompare# a b of
  GT -> False
  _ -> True

gteInt a b = case intCompare# a b of
  LT -> False
  _ -> True

inRange lo hi n = gteInt n lo && lteInt n hi

isNumber c =
  let t = getType c
  in intEq t 9 || intEq t 10 || intEq t 11

isSymbol c =
  let t = getType c
  in intEq t 25 || intEq t 26 || intEq t 27 || intEq t 28

isSeparator c =
  let t = getType c
  in intEq t 12 || intEq t 13 || intEq t 14

-- java.lang.Character category bytes: NON_SPACING_MARK = 6,
-- ENCLOSING_MARK = 7, COMBINING_SPACING_MARK = 8.
isMark c =
  let t = getType c
  in intEq t 6 || intEq t 7 || intEq t 8

isPunctuation c =
  let t = getType c
  in intEq t 20 || intEq t 21 || intEq t 22 || intEq t 23 || intEq t 24 || intEq t 29 || intEq t 30

digitToIntUnicode c = getNumericValue c

digitToIntHexUpper n c =
  case inRange 65 70 n of
    True -> n - 55
    False -> digitToIntUnicode c

digitToIntHexLower n c =
  case inRange 97 102 n of
    True -> n - 87
    False -> digitToIntHexUpper n c

digitToIntFromOrd n c =
  case inRange 48 57 n of
    True -> n - 48
    False -> digitToIntHexLower n c

digitToInt c = digitToIntFromOrd (charToInt# c) c
