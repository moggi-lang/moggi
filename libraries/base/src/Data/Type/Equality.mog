{-# LANGUAGE NoImplicitPrelude #-}
-- |
-- Module      :  Data.Type.Equality
-- License     :  BSD-style (see the file LICENSE)
--
-- Stability   :  stable
-- Portability :  not portable
--
-- Definition of propositional equality @(':~:')@. Pattern-matching on a variable
-- of type @(a ':~:' b)@ produces a proof that @a '~' b@.
module Data.Type.Equality
  (
    -- * The equality types
    type (~)
  , type (~~)
  , (:~:)(..)
  , (:~~:)(..)

    -- * Working with equality
  , sym
  , trans
  , castWith
  , gcastWith
  , apply
  , inner
  , outer

    -- * Inferring equality from other types
  , TestEquality(..)

    -- * Boolean type-level equality
  , type (==)
  ) where

import Data.Bool (Bool(..))
import Data.Bounded (Bounded(..))
import Moggi.Internal.Type.Equality ((:~:)(..), (:~~:)(..), TestEquality(..))
import Data.Enum (Enum(..))
import Data.Type.Bool
import Data.Eq (Eq(..))
import Moggi.Err (error)
import Data.Maybe (Maybe(..))
import Data.Ord (Ord(..), Ordering(..))
import Text.Read (Read(..), lex, readParen)
import Text.Show (Show(..))

-- with credit to Conal Elliott for 'ty', Erik Hesselink & Martijn van
-- Steenbergen for 'type-equality', Edward Kmett for 'eq', and Gabor Greif
-- for 'type-eq'

-- | Symmetry of equality
sym :: (a :~: b) -> (b :~: a)
sym Refl = Refl

-- | Transitivity of equality
trans :: (a :~: b) -> (b :~: c) -> (a :~: c)
trans Refl Refl = Refl

-- | Type-safe cast, using propositional equality
castWith :: (a :~: b) -> a -> b
castWith Refl x = x

-- | Generalized form of type-safe cast using propositional equality
gcastWith :: (a :~: b) -> ((a ~ b) => r) -> r
gcastWith Refl x = x

-- | Apply one equality to another, jointly
apply :: (f :~: g) -> (a :~: b) -> (f a :~: g b)
apply Refl Refl = Refl

-- | Extract a witness of equality of two types
inner :: (f a :~: g b) -> a :~: b
inner Refl = Refl

-- | Extract a witness of equality of two type constructors
outer :: (f a :~: g b) -> f :~: g
outer Refl = Refl

instance Eq (a :~: b) where
  (==) Refl Refl = True

instance Show (a :~: b) where
  show Refl = "Refl"

instance Ord (a :~: b) where
  compare Refl Refl = EQ

deriving instance a ~ b => Read (a :~: b)

instance a ~ b => Enum (a :~: b) where
  toEnum 0 = Refl
  toEnum _ = error "Data.Type.Equality.toEnum: bad argument"
  fromEnum Refl = 0

deriving instance a ~ b => Bounded (a :~: b)

instance Eq (a :~~: b) where
  (==) HRefl HRefl = True

instance Show (a :~~: b) where
  show HRefl = "HRefl"

instance Ord (a :~~: b) where
  compare HRefl HRefl = EQ

-- | A type family to compute Boolean equality.
type family (a :: k) == (b :: k) :: Bool where
  f a == g b = (f == g) && (a == b)
  a == a = 'True
  _ == _ = 'False
