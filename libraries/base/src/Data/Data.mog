ratioConstr :: Constr
ratioConstr = mkConstrTag ratioDataType ":%" 1 [] Infix

ratioDataType :: DataType
ratioDataType = mkAlgDataType "GHC.Real.Ratio" (\_ -> [ratioConstr])

-- The instance uses the (%) smart constructor instead of the internal (:%)
-- constructor to preserve the invariant that a Ratio is in normal form.
instance (Data a, Integral a) => Data (Ratio a) where
  gfoldl k z r = z (\x y -> x % y) `k` numerator r `k` denominator r
  toConstr _ = ratioConstr
  gunfold k z c = case constrIndex c of
    1 -> k (k (z (\x y -> x % y)))
    _ -> errorWithoutStackTrace "Data.Data.gunfold(Ratio)"
  dataTypeOf _ = ratioDataType
  dataCast1 f = gcast1 f

------------------------------------------------------------------------------

nilConstr :: Constr
nilConstr = mkConstrTag listDataType "[]" 1 [] Prefix

consConstr :: Constr
consConstr = mkConstrTag listDataType "(:)" 2 [] Infix

listDataType :: DataType
listDataType = mkAlgDataType "Prelude.[]" (\_ -> [nilConstr, consConstr])

-- For historical reasons, the constructor name used for (:) is "(:)". In a
-- derived instance it would be ":".
instance Data a => Data [a] where
  gfoldl k z xs = case xs of
    [] -> z []
    x : tl -> z (:) `k` x `k` tl
  toConstr xs = case xs of
    [] -> nilConstr
    _ : _ -> consConstr
  gunfold k z c = case constrIndex c of
    1 -> z []
    2 -> k (k (z (:)))
    _ -> errorWithoutStackTrace "Data.Data.gunfold(List)"
  dataTypeOf _ = listDataType
  dataCast1 f = gcast1 f

  -- The gmaps are given as an illustration: for lists they differ from map.
  gmapT f xs = case xs of
    [] -> []
    x : tl -> f x : f tl
  gmapQ f xs = case xs of
    [] -> []
    x : tl -> [f x, f tl]
  gmapM f xs = case xs of
    [] -> pure []
    x : tl -> f x >>= \x' -> f tl >>= \tl' -> pure (x' : tl')

------------------------------------------------------------------------------

-- | 'String' is a primitive type here rather than a synonym for @[Char]@, so it
-- carries the list representation itself: generic programming sees the same
-- structure a @Data [Char]@ instance would give it.
instance Data String where
  gfoldl k z s = case unpack s of
    [] -> z (pack [])
    c : tl -> z (\x xs -> pack (x : unpack xs)) `k` c `k` (pack tl)
  toConstr s = case unpack s of
    [] -> nilConstr
    _ : _ -> consConstr
  gunfold k z c = case constrIndex c of
    1 -> z (pack [])
    2 -> k (k (z (\x xs -> pack (x : unpack xs))))
    _ -> errorWithoutStackTrace "Data.Data.gunfold(String)"
  dataTypeOf _ = listDataType

------------------------------------------------------------------------------

