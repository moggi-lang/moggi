module Data.Data
  ( -- * Module Data.Typeable re-exported for convenience
    module Data.Typeable

    -- * The Data class for processing constructor applications
  , Data(gfoldl, gunfold, toConstr, dataTypeOf
        , dataCast1, dataCast2
        , gmapT, gmapQ, gmapQl, gmapQr, gmapQi, gmapM, gmapMp, gmapMo)

    -- * Datatype representations
  , DataType
  , mkDataType, mkIntType, mkFloatType, mkCharType, mkNoRepType
    -- ** Delayed constructor tables
  , mkAlgDataType
  , dataTypeName, DataRep(..), dataTypeRep
  , repConstr, isAlgType, dataTypeConstrs, indexConstr, maxConstrIndex, isNorepType

    -- * Data constructor representations
  , Constr, ConIndex, Fixity(..)
  , mkConstr, mkConstrTag, mkIntegralConstr, mkRealConstr, mkCharConstr
  , constrType, ConstrRep(..), constrRep, constrFields, constrFixity
  , constrIndex, showConstr, readConstr

    -- * Convenience functions: take type constructors apart
  , tyconUQname, tyconModule

    -- * Generic operations defined in terms of 'gunfold'
  , fromConstr, fromConstrB, fromConstrM
  ) where

import Control.Applicative (Applicative(..))
import Control.Monad (Monad((>>=), (>>)), MonadPlus(mzero, mplus))
import Data.Bool (not)
import Data.Either (Either(Left, Right))
import Data.Eq
import Data.Functor.Const (Const(Const), getConst)
import Data.Function ((.))
import Data.Functor.Identity (Identity(..))
import Data.Functor.Product (Product(Pair))
import Data.Functor.Sum (Sum(InL, InR))
import Data.List ((!!), break, dropWhile, filter, findIndex, length)
import Data.Maybe (Maybe(Nothing, Just), fromJust)
import Data.Monoid (First(..), Last(..))
import Data.Num
import Data.Ord
import Data.Proxy (Proxy(..))
import Data.Ratio (Ratio, Rational, numerator, denominator, (%))
import Data.Real (Integral(..), Real(..), fromIntegral, realToFrac, toRational)
import Data.Semigroup ((<>), All(..), Any(..), Dual(..))
import Data.String (pack, unpack)
import Data.Tuple
  ( Solo(..), Tuple2(..), Tuple3(..), Tuple4(..)
  , Tuple5(..), Tuple6(..), Tuple7(..) )
import Data.Typeable
import Data.Version (Version(..))
import Data.Void (Void)
import Moggi.Err (errorWithoutStackTrace)
import Moggi.Internal.Base
  ( Int, Integer, Double, Char, String, List, Bool(..), NonEmpty(..) )
import Moggi.Internal.Prim
import Text.Read (Read, reads)
import Text.Show

------------------------------------------------------------------------------
--
--      The Data class
--
------------------------------------------------------------------------------

{- |
The 'Data' class comprehends a fundamental primitive 'gfoldl' for
folding over constructor applications, say terms. This primitive can
be instantiated in several ways to map over the immediate subterms
of a term; see the @gmap@ combinators later in this class.  Indeed, a
generic programmer does not necessarily need to use the ingenious gfoldl
primitive but rather the intuitive @gmap@ combinators. The 'gfoldl'
primitive is completed by means to query top-level constructors, to
turn constructor representations into proper terms, and to list all
possible datatype constructors.  This completion allows us to serve
generic programming scenarios like read, show, equality, term generation.

The combinators 'gmapT', 'gmapQ', 'gmapM', etc are all provided with
default definitions in terms of 'gfoldl', leaving open the opportunity
to provide datatype-specific definitions.
(The inclusion of the @gmap@ combinators as members of class 'Data'
allows the programmer or the compiler to derive specialised, and maybe
more efficient code per datatype.  /Note/: 'gfoldl' is more higher-order
than the @gmap@ combinators.  This is subject to ongoing benchmarking
experiments.  It might turn out that the @gmap@ combinators will be
moved out of the class 'Data'.)

Conceptually, the definition of the @gmap@ combinators in terms of the
primitive 'gfoldl' requires the identification of the 'gfoldl' function
arguments.  Technically, we also need to identify the type constructor
@c@ for the construction of the result type from the folded term type.

In the definition of @gmapQ@/x/ combinators, we use phantom type
constructors for the @c@ in the type of 'gfoldl' because the result type
of a query does not involve the (polymorphic) type of the term argument.
In the definition of 'gmapQl' we simply use the plain constant type
constructor because 'gfoldl' is left-associative anyway and so it is
readily suited to fold a left-associative binary operation over the
immediate subterms.  In the definition of gmapQr, extra effort is
needed. We use a higher-order accumulation trick to mediate between
left-associative constructor application vs. right-associative binary
operation (e.g., @(:)@).  When the query is meant to compute a value
of type @r@, then the result type within generic folding is @r -> r@.
So the result of folding is a function to which we finally pass the
right unit.

With the @-XDeriveDataTypeable@ option, GHC can generate instances of the
'Data' class automatically.  For example, given the declaration

> data T a b = C1 a b | C2 deriving (Typeable, Data)

GHC will generate an instance that is equivalent to

> instance (Data a, Data b) => Data (T a b) where
>     gfoldl k z (C1 a b) = z C1 `k` a `k` b
>     gfoldl k z C2       = z C2
>
>     gunfold k z c = case constrIndex c of
>                         1 -> k (k (z C1))
>                         2 -> z C2
>
>     toConstr (C1 _ _) = con_C1
>     toConstr C2       = con_C2
>     dataTypeOf _ = ty_T
>
> con_C1 = mkConstr ty_T "C1" [] Prefix
> con_C2 = mkConstr ty_T "C2" [] Prefix
> ty_T   = mkDataType "Module.T" [con_C1, con_C2]

This is suitable for datatypes that are exported transparently.

-}
class Typeable a => Data a where

  -- | Left-associative fold operation for constructor applications.
  --
  -- The type of 'gfoldl' is a headache, but operationally it is a simple
  -- generalisation of a list fold.
  --
  -- The default definition for 'gfoldl' is @'const' 'id'@, which is
  -- suitable for abstract datatypes with no substructures.
  gfoldl :: (forall d b. Data d => c (d -> b) -> d -> c b)
         -- ^ defines how nonempty constructor applications are folded.
         -- It takes the folded tail of the constructor application and its
         -- head, i.e., an immediate subterm, and combines them in some way.
         -> (forall g. g -> c g)
         -- ^ defines how the empty constructor application is folded, like
         -- the neutral \/ start element for list folding.
         -> a
         -- ^ structure to be folded.
         -> c a
         -- ^ result, with a type defined in terms of @a@, but variability
         -- is achieved by means of type constructor @c@ for the construction
         -- of the actual result type.

  -- See the 'Data' instances in this file for an illustration of 'gfoldl'.

  gfoldl _ z = z

  -- | Unfolding constructor applications
  gunfold :: (forall b r. Data b => c (b -> r) -> c r)
          -> (forall r. r -> c r)
          -> Constr
          -> c a

  -- | Obtaining the constructor from a given datum.
  -- For proper terms, this is meant to be the top-level constructor.
  -- Primitive datatypes are here viewed as potentially infinite sets of
  -- values (i.e., constructors).
  toConstr :: a -> Constr

  -- | The outer type constructor of the type
  dataTypeOf :: a -> DataType

  -- | Mediate types and unary type constructors.
  --
  -- In 'Data' instances of the form
  --
  -- @
  --     instance (Data a, ...) => Data (T a)
  -- @
  --
  -- 'dataCast1' should be defined as 'gcast1'.
  --
  -- The default definition is @'const' 'Nothing'@, which is appropriate
  -- for instances of other forms.
  dataCast1 :: Typeable t
            => (forall d. Data d => c (t d))
            -> Maybe (c a)
  dataCast1 _ = Nothing

  -- | Mediate types and binary type constructors.
  --
  -- In 'Data' instances of the form
  --
  -- @
  --     instance (Data a, Data b, ...) => Data (T a b)
  -- @
  --
  -- 'dataCast2' should be defined as 'gcast2'.
  --
  -- The default definition is @'const' 'Nothing'@, which is appropriate
  -- for instances of other forms.
  dataCast2 :: Typeable t
            => (forall d e. (Data d, Data e) => c (t d e))
            -> Maybe (c a)
  dataCast2 _ = Nothing

  -- | A generic transformation that maps over the immediate subterms
  --
  -- The default definition instantiates the type constructor @c@ in the
  -- type of 'gfoldl' to an identity datatype constructor, using the
  -- isomorphism pair as injection and projection.
  gmapT :: (forall b. Data b => b -> b) -> a -> a
  gmapT f x0 = runIdentity (gfoldl (\c x -> Identity ((runIdentity c) (f x))) Identity x0)

  -- | A generic query with a left-associative binary operator.
  gmapQl :: (r -> r' -> r) -> r -> (forall d. Data d => d -> r') -> a -> r
  gmapQl o r f x = getConst (gfoldl (\c y -> Const (o (getConst c) (f y))) (\_ -> Const r) x)

  -- | A generic query with a right-associative binary operator.
  gmapQr :: (r' -> r -> r) -> r -> (forall d. Data d => d -> r') -> a -> r
  gmapQr o r0 f x0 = unQr (gfoldl (\c y -> Qr (\r -> unQr c (o (f y) r))) (\_ -> Qr (\r -> r)) x0) r0

  -- | A generic query that processes the immediate subterms and returns a list
  -- of results, in the order of the constructor declaration.
  gmapQ :: (forall d. Data d => d -> u) -> a -> [u]
  gmapQ f x = gmapQr (:) [] f x

  -- | A generic query that processes one child by index (zero-based).
  gmapQi :: Int -> (forall d. Data d => d -> u) -> a -> u
  gmapQi i f x =
    case gfoldl (\c y -> case c of
                  Qi j q -> Qi (j + 1) (if i == j then Just (f y) else q))
                (\_ -> Qi 0 Nothing) x of
      Qi _ q -> fromJust q

  -- | A generic monadic transformation that maps over the immediate subterms.
  gmapM :: Monad m => (forall d. Data d => d -> m d) -> a -> m a
  gmapM f x = gfoldl (\c y -> c >>= \c' -> f y >>= \y' -> pure (c' y')) pure x

  -- | Transformation of at least one immediate subterm does not fail.
  gmapMp :: MonadPlus m => (forall d. Data d => d -> m d) -> a -> m a
  gmapMp f x =
    unMp (gfoldl (\c y -> case c of Mp cm ->
                    Mp (cm >>= \p -> case p of (h, b) ->
                      (f y >>= \y' -> pure (h y', True))
                          `mplus` pure (h y, b)))
                 (\g -> Mp (pure (g, False))) x)
      >>= \p -> case p of (x2, b) -> if b then pure x2 else mzero

  -- | Transformation of one immediate subterm with success.
  gmapMo :: MonadPlus m => (forall d. Data d => d -> m d) -> a -> m a
  gmapMo f x =
    unMp (gfoldl (\c y -> case c of Mp cm ->
                    Mp (cm >>= \p -> case p of (h, b) ->
                      if b
                        then pure (h y, b)
                        else (f y >>= \y' -> pure (h y', True))
                               `mplus` pure (h y, b)))
                 (\g -> Mp (pure (g, False))) x)
      >>= \p -> case p of (x2, b) -> if b then pure x2 else mzero

-- | Type constructor for adding counters to queries
data Qi q a = Qi Int (Maybe q)

-- | The type constructor used in definition of gmapQr
newtype Qr r a = Qr { unQr :: r -> r }

-- | The type constructor used in definition of gmapMp
newtype Mp m x = Mp { unMp :: m (x, Bool) }

------------------------------------------------------------------------------
--
--      Generic unfolding
--
------------------------------------------------------------------------------

-- | Build a term skeleton.
fromConstr :: Data a => Constr -> a
fromConstr c = fromConstrB (\_ -> errorWithoutStackTrace "Data.Data.fromConstr") c

-- | Build a term and use a generic function for subterms.
fromConstrB :: Data a
            => (forall d. Data d => d)
            -> Constr
            -> a
fromConstrB f c = runIdentity (gunfold (\x -> Identity (runIdentity x f)) Identity c)

-- | Monadic variation on 'fromConstrB'.
fromConstrM :: forall m a. (Monad m, Data a)
            => (forall d. Data d => m d)
            -> Constr
            -> m a
fromConstrM f c = gunfold (\x -> x >>= \x' -> f >>= \y -> pure (x' y)) pure c

------------------------------------------------------------------------------
--
--      Datatype and constructor representations
--
------------------------------------------------------------------------------

-- | Representation of datatypes.
-- A package of constructor representations with names of type and module.
data DataType = DataType String (() -> DataRep)

-- | Representation of constructors. Note that equality on constructors
-- with different types may not work -- i.e. the constructors for 'False' and
-- 'Nothing' may compare equal.
data Constr = Constr ConstrRep String [String] Fixity DataType

-- | Public representation of datatypes.
data DataRep = AlgRep [Constr]
             | IntRep
             | FloatRep
             | CharRep
             | NoRep
             deriving (Eq, Show)

-- | Public representation of constructors.
data ConstrRep = AlgConstr    ConIndex
               | IntConstr    Integer
               | FloatConstr  Rational
               | CharConstr   Char
               deriving (Eq, Show)

-- | Unique index for datatype constructors,
-- counting from 1 in the order they are given in the program text.
type ConIndex = Int

-- | Fixity of constructors.
data Fixity = Prefix
            | Infix
            deriving (Eq, Show)

instance Show DataType where
  show dt = "DataType {tycon = " <> show (dataTypeName dt)
                <> ", datarep = " <> show (dataTypeRep dt) <> "}"

-- | Equality of constructors.
instance Eq Constr where
  (==) c c' = constrRep c == constrRep c'

instance Show Constr where
  show c = showConstr c

------------------------------------------------------------------------------
--
--      Observers for datatype representations
--
------------------------------------------------------------------------------

-- | Gets the type constructor including the module.
dataTypeName :: DataType -> String
dataTypeName dt = case dt of DataType n _ -> n

-- | Gets the public presentation of a datatype.
dataTypeRep :: DataType -> DataRep
dataTypeRep dt = case dt of DataType _ r -> r ()

-- | Gets the datatype of a constructor.
constrType :: Constr -> DataType
constrType c = case c of Constr _ _ _ _ dt -> dt

-- | Gets the public presentation of constructors.
constrRep :: Constr -> ConstrRep
constrRep c = case c of Constr r _ _ _ _ -> r

-- | Look up a constructor by its representation.
repConstr :: DataType -> ConstrRep -> Constr
repConstr dt cr =
  case (dataTypeRep dt, cr) of
    (AlgRep cs, AlgConstr i)  -> cs !! (i - 1)
    (IntRep, IntConstr i)     -> mkIntegralConstr dt i
    (FloatRep, FloatConstr f) -> mkRealConstr dt f
    (CharRep, CharConstr c)   -> mkCharConstr dt c
    _ -> errorWithoutStackTrace "Data.Data.repConstr: The given ConstrRep does not fit to the given DataType."

------------------------------------------------------------------------------
--
--      Representations of algebraic data types
--
------------------------------------------------------------------------------

-- | Constructs an algebraic datatype.
--
-- A declaration whose constructor list names its datatype and whose
-- constructors name the datatype in turn is the usual shape of a table
-- (@boolType = mkDataType "Prelude.Bool" [falseConstr, trueConstr]@,
-- @trueConstr = mkConstr boolType "True" …@). The list is an argument, so it
-- is built before this is called; when that knot cannot be tied that way, use
-- 'mkAlgDataType', which holds the list in a function.
mkDataType :: String -> [Constr] -> DataType
mkDataType str cs = DataType str (\_ -> AlgRep cs)

-- | A datatype whose constructor list is built on demand.
--
-- This is the form the tables in this module are written in: a datatype and
-- its constructors usually name each other, and a compiler that evaluates an
-- argument before passing it builds the list while it is still being defined.
-- 'mkDataType' has that shape in 'Data.Data', where a value is only built when
-- something asks for it; here the delay has to be in the program, and this is
-- it -- hold the list in a function:
--
-- > wType = mkAlgDataType "Main.W" (\_ -> [wConstr])
-- > wConstr = mkConstr wType "W" ["field"] Prefix
--
-- 'mkConstr' leaves the index to 'constrIndex', which reads it from the table,
-- so the constructor does not have to look itself up while the table is built.
--
-- The representations are mutually recursive in the source
-- (@boolType = mkAlgDataType "Prelude.Bool" (\_ -> [falseConstr, …])@,
-- @falseConstr = mkConstrTag boolType "False" …@), which only terminates if the
-- list is not demanded while the datatype is being built. Holding it in a
-- function is that delay, and the constructor itself stores the datatype it was
-- built from, so nothing has to be looked up again.
mkAlgDataType :: String -> (() -> [Constr]) -> DataType
mkAlgDataType str cs = DataType str (\_ -> AlgRep (cs ()))

-- | Constructs a constructor.
mkConstrTag :: DataType -> String -> Int -> [String] -> Fixity -> Constr
mkConstrTag dt str idx fields fix =
  Constr (AlgConstr idx) str fields fix dt

-- | Constructs a constructor.
--
-- A constructor's index is its position in its datatype's constructor list, and
-- the two are usually written in terms of each other:
--
-- > boolType = mkDataType "Prelude.Bool" [falseConstr, trueConstr]
-- > falseConstr = mkConstr boolType "False" [] Prefix
--
-- A compiler that builds a value only when something asks for it leaves the
-- position to be worked out at that moment, which is how that knot is tied
-- there. Here a value is built as soon as it is passed, so the table would be
-- asked about the constructor that is still being built: 'mkConstr' therefore
-- records the placeholder 'ConIndex' @0@ and 'constrIndex' reads the position
-- from the datatype when it is asked -- the same answer, in the same way, one
-- step later.
mkConstr :: DataType -> String -> [String] -> Fixity -> Constr
mkConstr dt str fields fix = mkConstrTag dt str 0 fields fix

-- | Gets the constructors of an algebraic datatype.
dataTypeConstrs :: DataType -> [Constr]
dataTypeConstrs dt = case dataTypeRep dt of
  AlgRep cons -> cons
  _ -> errorWithoutStackTrace ("Data.Data.dataTypeConstrs is not supported for "
                <> dataTypeName dt <> ", as it is not an algebraic data type.")

-- | Gets the field labels of a constructor.
constrFields :: Constr -> [String]
constrFields c = case c of Constr _ _ fs _ _ -> fs

-- | Gets the fixity of a constructor.
constrFixity :: Constr -> Fixity
constrFixity c = case c of Constr _ _ _ f _ -> f

------------------------------------------------------------------------------
--
--      From strings to constr's and vice versa: all data types
--
------------------------------------------------------------------------------

-- | Gets the string for a constructor.
showConstr :: Constr -> String
showConstr c = case c of Constr _ str _ _ _ -> str

-- | Lookup a constructor via a string.
readConstr :: DataType -> String -> Maybe Constr
readConstr dt str = case dataTypeRep dt of
  AlgRep cons -> idx cons
  IntRep      -> mkReadCon (\i -> mkPrimCon dt str (IntConstr i))
  FloatRep    -> mkReadCon ffloat
  CharRep     -> mkReadCon (\c -> mkPrimCon dt str (CharConstr c))
  NoRep       -> Nothing
 where

  -- Read a value and build a constructor
  mkReadCon :: Read t => (t -> Constr) -> Maybe Constr
  mkReadCon f = case reads str of
    [(t, "")] -> Just (f t)
    _         -> Nothing

  -- Traverse list of algebraic datatype constructors
  idx :: [Constr] -> Maybe Constr
  idx cons = case filter (\c -> showConstr c == str) cons of
    []     -> Nothing
    hd : _ -> Just hd

  ffloat :: Double -> Constr
  ffloat = mkPrimCon dt str . FloatConstr . toRational

------------------------------------------------------------------------------
--
--      Convenience functions: algebraic data types
--
------------------------------------------------------------------------------

-- | Test for an algebraic type.
isAlgType :: DataType -> Bool
isAlgType dt = case dataTypeRep dt of
  AlgRep _ -> True
  _        -> False

-- | Gets the constructor for an index (algebraic datatypes only).
indexConstr :: DataType -> ConIndex -> Constr
indexConstr dt idx = case dataTypeRep dt of
  AlgRep cs -> cs !! (idx - 1)
  _ -> errorWithoutStackTrace ("Data.Data.indexConstr is not supported for "
                <> dataTypeName dt <> ", as it is not an algebraic data type.")

-- | Gets the index of a constructor (algebraic datatypes only).
constrIndex :: Constr -> ConIndex
constrIndex con = case constrRep con of
  AlgConstr 0 -> constrPosition con
  AlgConstr idx -> idx
  _ -> errorWithoutStackTrace ("Data.Data.constrIndex is not supported for "
                <> dataTypeName (constrType con)
                <> ", as it is not an algebraic data type.")

-- | Where a constructor built by 'mkConstr' sits in its datatype.
constrPosition :: Constr -> ConIndex
constrPosition con =
  case findIndex (\c -> showConstr c == showConstr con) (dataTypeConstrs (constrType con)) of
    Just i  -> i + 1 -- ConTag starts at 1
    Nothing -> errorWithoutStackTrace ("Data.Data.constrIndex: " <> showConstr con
                  <> " is not a constructor of " <> dataTypeName (constrType con))

-- | Gets the maximum constructor index of an algebraic datatype.
maxConstrIndex :: DataType -> ConIndex
maxConstrIndex dt = case dataTypeRep dt of
  AlgRep cs -> length cs
  _ -> errorWithoutStackTrace ("Data.Data.maxConstrIndex is not supported for "
                <> dataTypeName dt <> ", as it is not an algebraic data type.")

------------------------------------------------------------------------------
--
--      Representation of primitive types
--
------------------------------------------------------------------------------

-- | Constructs the 'Int' type.
mkIntType :: String -> DataType
mkIntType = mkPrimType IntRep

-- | Constructs the 'Float' type.
mkFloatType :: String -> DataType
mkFloatType = mkPrimType FloatRep

-- | Constructs the 'Char' type.
mkCharType :: String -> DataType
mkCharType = mkPrimType CharRep

mkPrimType :: DataRep -> String -> DataType
mkPrimType dr str = DataType str (\_ -> dr)

-- Makes a constructor for primitive types. GHC leaves the fields and fixity as
-- bottom; a strict value cannot carry them, so an unavailable field is empty.
mkPrimCon :: DataType -> String -> ConstrRep -> Constr
mkPrimCon dt str cr = Constr cr str [] Prefix dt

mkIntegralConstr :: (Integral a, Show a) => DataType -> a -> Constr
mkIntegralConstr dt i = case dataTypeRep dt of
  IntRep -> mkPrimCon dt (show i) (IntConstr (toInteger i))
  _ -> errorWithoutStackTrace ("Data.Data.mkIntegralConstr is not supported for "
                <> dataTypeName dt <> ", as it is not an Integral data type.")

mkRealConstr :: (Real a, Show a) => DataType -> a -> Constr
mkRealConstr dt f = case dataTypeRep dt of
  FloatRep -> mkPrimCon dt (show f) (FloatConstr (toRational f))
  _ -> errorWithoutStackTrace ("Data.Data.mkRealConstr is not supported for "
                <> dataTypeName dt <> ", as it is not a Real data type.")

-- | Makes a constructor for 'Char'.
mkCharConstr :: DataType -> Char -> Constr
mkCharConstr dt c = case dataTypeRep dt of
  CharRep -> mkPrimCon dt (show c) (CharConstr c)
  _ -> errorWithoutStackTrace ("Data.Data.mkCharConstr is not supported for "
                <> dataTypeName dt <> ", as it is not an Char data type.")

------------------------------------------------------------------------------
--
--      Non-representations for non-representable types
--
------------------------------------------------------------------------------

-- | Constructs a non-representation for a non-representable type.
mkNoRepType :: String -> DataType
mkNoRepType str = DataType str (\_ -> NoRep)

-- | Test for a non-representable type.
isNorepType :: DataType -> Bool
isNorepType dt = case dataTypeRep dt of
  NoRep -> True
  _     -> False

------------------------------------------------------------------------------
--
--      Convenience for qualified type constructors
--
------------------------------------------------------------------------------

-- | Gets the unqualified type constructor:
-- drop *.*.*... before name
--
tyconUQname :: String -> String
tyconUQname x = pack (unqualified (unpack x))
 where
  unqualified cs = case dropWhile (\c -> not (c == '.')) cs of
    []     -> cs
    _ : tl -> unqualified tl

-- | Gets the module of a type constructor:
-- take *.*.*... before name
--
tyconModule :: String -> String
tyconModule x = pack (moduleOf (unpack x))
 where
  moduleOf cs = case break (\c -> c == '.') cs of
    (_, [])     -> []
    (a, _ : tl) -> a <> moduleTail tl

  moduleTail cs = case moduleOf cs of
    [] -> []
    m  -> '.' : m

------------------------------------------------------------------------------
------------------------------------------------------------------------------
--
--      Instances of the Data class for Prelude-like types.
--
------------------------------------------------------------------------------

------------------------------------------------------------------------------

boolType :: DataType
boolType = mkAlgDataType "Prelude.Bool" (\_ -> [falseConstr, trueConstr])

falseConstr :: Constr
falseConstr = mkConstrTag boolType "False" 1 [] Prefix

trueConstr :: Constr
trueConstr = mkConstrTag boolType "True" 2 [] Prefix

instance Data Bool where
  gfoldl _ z x = z x
  toConstr x = case x of
    False -> falseConstr
    True  -> trueConstr
  gunfold _ z c = case constrIndex c of
    1 -> z False
    2 -> z True
    _ -> errorWithoutStackTrace "Data.Data.gunfold(Bool)"
  dataTypeOf _ = boolType

------------------------------------------------------------------------------

charType :: DataType
charType = mkCharType "Prelude.Char"

instance Data Char where
  toConstr x = mkCharConstr charType x
  gunfold _ z c = case constrRep c of
    CharConstr x -> z x
    _ -> errorWithoutStackTrace ("Data.Data.gunfold: Constructor " <> show c
                  <> " is not of type Char.")
  dataTypeOf _ = charType

------------------------------------------------------------------------------

doubleType :: DataType
doubleType = mkFloatType "Prelude.Double"

instance Data Double where
  toConstr x = mkRealConstr doubleType x
  gunfold _ z c = case constrRep c of
    FloatConstr x -> z (realToFrac x)
    _ -> errorWithoutStackTrace ("Data.Data.gunfold: Constructor " <> show c
                  <> " is not of type Double.")
  dataTypeOf _ = doubleType

