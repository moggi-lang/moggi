productType = mkAlgDataType "Data.Functor.Product.Product" (\_ -> [pairConstr])

pairConstr :: Constr
pairConstr = mkConstrTag productType "Pair" 1 [] Prefix

instance (Typeable a, Typeable f, Typeable g, Data (f a), Data (g a)) => Data (Product f g a) where
  gfoldl k z p = case p of Pair x y -> z Pair `k` x `k` y
  toConstr _ = pairConstr
  gunfold k z c = case constrIndex c of
    1 -> k (k (z Pair))
    _ -> errorWithoutStackTrace "Data.Data.gunfold(Product)"
  dataTypeOf _ = productType

