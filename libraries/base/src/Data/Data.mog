instance (Data a, Data b) => Data (Either a b) where
  gfoldl k z e = case e of
    Left a  -> z Left `k` a
    Right b -> z Right `k` b
  toConstr e = case e of
    Left _  -> leftConstr
    Right _ -> rightConstr
  gunfold k z c = case constrIndex c of
    1 -> k (z Left)
    2 -> k (z Right)
    _ -> errorWithoutStackTrace "Data.Data.gunfold(Either)"
  dataTypeOf _ = eitherType
  dataCast2 f = gcast2 f

