eqConstr :: Constr
eqConstr = mkConstrTag orderingType "EQ" 2 [] Prefix

gtConstr :: Constr
gtConstr = mkConstrTag orderingType "GT" 3 [] Prefix

instance Data Ordering where
  gfoldl _ z x = z x
  toConstr x = case x of
    LT -> ltConstr
    EQ -> eqConstr
    GT -> gtConstr
  gunfold _ z c = case constrIndex c of
    1 -> z LT
    2 -> z EQ
    3 -> z GT
    _ -> errorWithoutStackTrace "Data.Data.gunfold(Ordering)"
  dataTypeOf _ = orderingType

