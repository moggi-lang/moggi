-- | The @Sum@ and @Product@ instances carry their functor parameters' own
-- 'Typeable' evidence, the way @base@'s standalone derivation writes them: the
-- superclass 'Typeable' of @Data (Sum f g a)@ has to build a representation of
-- @Sum f g a@, which embeds one for @f@ and one for @g@. A 'Data' context such as
-- @Data (f a)@ only supplies @Typeable (f a)@, and a representation of an
-- application cannot be taken apart again for a functor that may be a type
-- family, so the two constraints are written out rather than left to the solver.

sumType :: DataType
sumType = mkAlgDataType "Data.Functor.Sum.Sum" (\_ -> [inLConstr, inRConstr])

inLConstr :: Constr
inLConstr = mkConstrTag sumType "InL" 1 [] Prefix

inRConstr :: Constr
inRConstr = mkConstrTag sumType "InR" 2 [] Prefix

instance (Typeable a, Typeable f, Typeable g, Data (f a), Data (g a)) => Data (Sum f g a) where
  gfoldl k z s = case s of
    InL x -> z InL `k` x
    InR y -> z InR `k` y
  toConstr s = case s of
    InL _ -> inLConstr
    InR _ -> inRConstr
  gunfold k z c = case constrIndex c of
    1 -> k (z InL)
    2 -> k (z InR)
    _ -> errorWithoutStackTrace "Data.Data.gunfold(Sum)"
  dataTypeOf _ = sumType

------------------------------------------------------------------------------

