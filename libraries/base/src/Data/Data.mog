nothingConstr :: Constr
nothingConstr = mkConstrTag maybeType "Nothing" 1 [] Prefix

justConstr :: Constr
justConstr = mkConstrTag maybeType "Just" 2 [] Prefix

instance Data a => Data (Maybe a) where
  gfoldl k z m = case m of
    Nothing -> z Nothing
    Just a  -> z Just `k` a
  toConstr m = case m of
    Nothing -> nothingConstr
    Just _  -> justConstr
  gunfold k z c = case constrIndex c of
    1 -> z Nothing
    2 -> k (z Just)
    _ -> errorWithoutStackTrace "Data.Data.gunfold(Maybe)"
  dataTypeOf _ = maybeType
  dataCast1 f = gcast1 f

