nonEmptyConstr :: Constr
nonEmptyConstr = mkConstrTag nonEmptyType ":|" 1 [] Infix

instance Data a => Data (NonEmpty a) where
  gfoldl k z n = case n of
    a :| as -> z (\x xs -> x :| xs) `k` a `k` as
  toConstr _ = nonEmptyConstr
  gunfold k z c = case constrIndex c of
    1 -> k (k (z (\x xs -> x :| xs)))
    _ -> errorWithoutStackTrace "Data.Data.gunfold(NonEmpty)"
  dataTypeOf _ = nonEmptyType
  dataCast1 f = gcast1 f

