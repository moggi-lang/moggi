{-# LANGUAGE NoImplicitPrelude #-}
{-# BACKEND
  php = Data.Char.PHP
  jvm = Data.Char.JVM
  dotnet = Data.Char.DotNet
#-}
-- | The 'Char' type and associated operations.
--
-- Unicode characters are divided into letters, numbers, marks, punctuation,
-- symbols, separators (including spaces) and others (including control
-- characters), which is what the classifiers below ask about.
--
-- 'lexLitChar' and 'readLitChar' read a character out of a 'String': they walk
-- the scalars of the literal and slice it, so they live here, next to the
-- classification they read through.
module Data.Char
  (
    Char

  -- * Character classification
  , isControl, isSpace
  , isLower, isLowerCase, isUpper, isUpperCase, isAlpha, isAlphaNum, isPrint
  , isDigit, isOctDigit, isHexDigit
  , isLetter, isMark, isNumber, isPunctuation, isSymbol, isSeparator

  -- ** Subranges
  , isAscii, isLatin1
  , isAsciiUpper, isAsciiLower

  -- ** Unicode general categories
  , GeneralCategory(..), generalCategory

  -- * Case conversion
  , toUpper, toLower, toTitle

  -- * Single digit characters
  , digitToInt
  , intToDigit

  -- * Numeric representations
  , ord
  , chr

  -- * String representations
  , showLitChar
  , lexLitChar, readLitChar
  ) where

import Data.Bool
import Data.Bounded
import Data.Enum
import Data.Eq
import Moggi.Err
import Data.Int
import Data.Maybe (Maybe(..))
import Data.Num
import Data.Ord
import Text.Show
import Moggi.Internal.Base
import Moggi.Internal.Prim

-- Zero-cost representation coercions (Char and Int are both backend ints).
ord :: Char -> Int
ord c = charToInt# c

-- Partial: traps on non-scalars (including surrogates).
coerceChar n = intToChar# n

chr :: Int -> Char
chr n = case isUnicodeScalar n of
  True -> coerceChar n
  False -> error "Data.Char.chr: not a Unicode scalar value"

-- | The Unicode general category of a character: letter, mark, number,
-- punctuation, symbol, separator, or other. The constructors are in the
-- Unicode order, so the 'Enum' instance maps 'toEnum' onto the standard
-- category numbers.
data GeneralCategory
  = UppercaseLetter
  | LowercaseLetter
  | TitlecaseLetter
  | ModifierLetter
  | OtherLetter
  | NonSpacingMark
  | SpacingCombiningMark
  | EnclosingMark
  | DecimalNumber
  | LetterNumber
  | OtherNumber
  | ConnectorPunctuation
  | DashPunctuation
  | OpenPunctuation
  | ClosePunctuation
  | InitialQuote
  | FinalQuote
  | OtherPunctuation
  | MathSymbol
  | CurrencySymbol
  | ModifierSymbol
  | OtherSymbol
  | Space
  | LineSeparator
  | ParagraphSeparator
  | Control
  | Format
  | Surrogate
  | PrivateUse
  | NotAssigned
  deriving (Eq, Ord, Enum, Bounded, Show)

isControl :: Char -> Bool

isSpace :: Char -> Bool

isLower :: Char -> Bool

isUpper :: Char -> Bool

-- | Whether the character has the Unicode Lowercase property (letter-like
-- characters such as @'ⓐ'@ count, unlike 'isLower', which only selects
-- 'LowercaseLetter').
isLowerCase :: Char -> Bool

-- | Whether the character has the Unicode Uppercase property (letter-like
-- characters such as @'Ⓐ'@ count, unlike 'isUpper', which only selects
-- 'UppercaseLetter' and 'TitlecaseLetter').
isUpperCase :: Char -> Bool

-- | The general category of a character, from the host's Unicode tables.
-- Backends implement 'generalCategoryCode' (the constructor's 'Enum' index);
-- the mapping to constructors lives here so it is written once.
generalCategory :: Char -> GeneralCategory
generalCategory c = toEnum (generalCategoryCode c)

-- | 'generalCategory' as an 'Enum' index (backend-defined; not exported).
generalCategoryCode :: Char -> Int

isAlpha :: Char -> Bool

isLetter :: Char -> Bool

isAlphaNum :: Char -> Bool

isPrint :: Char -> Bool

isDigit :: Char -> Bool

isNumber :: Char -> Bool

isPunctuation :: Char -> Bool

isSymbol :: Char -> Bool

isSeparator :: Char -> Bool

isMark :: Char -> Bool

toUpper :: Char -> Char

toLower :: Char -> Char

toTitle :: Char -> Char

digitToInt :: Char -> Int

-- Code-range predicates: pure Moggi on ord.

intLt a b = case intCompare# a b of
  LT -> True
  EQ -> False
  GT -> False

intGt a b = case intCompare# a b of
  LT -> False
  EQ -> False
  GT -> True

intGte a b = case intCompare# a b of
  LT -> False
  EQ -> True
  GT -> True

intLte a b = case intCompare# a b of
  LT -> True
  EQ -> True
  GT -> False

inRange lo hi n = intGte n lo && intLte n hi

charEqInt a b = case intCompare# a b of
  EQ -> True
  _ -> False

-- Surrogates U+D800..U+DFFF are code points but not Unicode scalar values.
isUnicodeScalar n =
  intGte n 0
  && intLte n 1114111
  && (intLt n 55296 || intGt n 57343)

isAscii :: Char -> Bool
isAscii c = intLt (ord c) 128

isLatin1 :: Char -> Bool
isLatin1 c = intLt (ord c) 256

isAsciiUpper :: Char -> Bool
isAsciiUpper c = inRange 65 90 (ord c)

isAsciiLower :: Char -> Bool
isAsciiLower c = inRange 97 122 (ord c)

isOctDigit :: Char -> Bool
isOctDigit c = inRange 48 55 (ord c)

isHexDigit :: Char -> Bool
isHexDigit c =
  let n = ord c
  in isDigit c || inRange 65 70 n || inRange 97 102 n

intToDigit :: Int -> Char
intToDigit n = case inRange 0 9 n of
  True -> chr (n + 48)
  False -> intToDigitHex n

intToDigitHex n = case inRange 10 15 n of
  True -> chr (n + 87)
  False -> error "Data.Char.intToDigit: not a digit"

charSuccN n = case charEqInt n 55295 of
  True -> 57344
  False -> case charEqInt n 1114111 of
    True -> error "Data.Char.succ: maxBound"
    False -> n + 1

charPredN n = case charEqInt n 57344 of
  True -> 55295
  False -> case charEqInt n 0 of
    True -> error "Data.Char.pred: minBound"
    False -> n - 1

instance Eq Char where
  (==) a b = charEq# a b
  (/=) a b = charNe# a b

instance Ord Char where
  compare a b = charCompare# a b

instance Bounded Char where
  minBound = chr 0
  maxBound = chr 1114111

instance Enum Char where
  succ c = chr (charSuccN (ord c))
  pred c = chr (charPredN (ord c))
  toEnum = chr
  fromEnum = ord

-- | Show a character the way it is written in a source literal: a printable
-- character stands for itself and everything else uses an escape (the named
-- control escapes, @\\DEL@, the ASCII control names from @NUL@ to @US@, or the
-- decimal code of a character above @DEL@).
showLitChar :: Char -> ShowS
showLitChar c s = case ord c of
  n -> case n > 127 of
    True -> showChar '\\' (showString (show n) s)
    False -> case n == 127 of
      True -> showString "\\DEL" s
      False -> case n == 92 of
        True -> showString "\\\\" s
        False -> case n >= 32 of
          True -> showChar c s
          False -> showControlName n s

-- The ASCII control names, indexed by code point.
showControlName :: Int -> ShowS
showControlName n s = case n of
  7 -> showString "\\a" s
  8 -> showString "\\b" s
  9 -> showString "\\t" s
  10 -> showString "\\n" s
  11 -> showString "\\v" s
  12 -> showString "\\f" s
  13 -> showString "\\r" s
  14 -> showString "\\SO" s
  _ -> showString (stringCons# '\\' (asciiName n)) s

asciiName :: Int -> String
asciiName n = case n of
  0 -> "NUL"
  1 -> "SOH"
  2 -> "STX"
  3 -> "ETX"
  4 -> "EOT"
  5 -> "ENQ"
  6 -> "ACK"
  7 -> "BEL"
  8 -> "BS"
  9 -> "HT"
  10 -> "LF"
  11 -> "VT"
  12 -> "FF"
  13 -> "CR"
  14 -> "SO"
  15 -> "SI"
  16 -> "DLE"
  17 -> "DC1"
  18 -> "DC2"
  19 -> "DC3"
  20 -> "DC4"
  21 -> "NAK"
  22 -> "SYN"
  23 -> "ETB"
  24 -> "CAN"
  25 -> "EM"
  26 -> "SUB"
  27 -> "ESC"
  28 -> "FS"
  29 -> "GS"
  30 -> "RS"
  _ -> "US"

instance Show Char where
  show c = case c == '\'' of
    True -> "'\\''"
    False -> stringAppend# "'" (stringAppend# (showLitChar c "") "'")

-- | Read one character literal body (no surrounding quotes): an escape
-- starting with @\@ or a single plain character. No parse when the input
-- is empty or the escape is unknown.
readLitChar :: String -> [(Char, String)]
readLitChar s = case litCharOne (unpack s) of
  Nothing -> []
  Just (c, n) -> [(c, drop n s)]

-- | The source text of one character literal body: what 'readLitChar' would
-- consume, returned verbatim.
lexLitChar :: String -> [(String, String)]
lexLitChar s = case litCharOne (unpack s) of
  Nothing -> []
  Just (_, n) -> [(take n s, drop n s)]

-- One literal body: the character and how many scalars it takes.
litCharOne :: [Char] -> Maybe (Char, Int)
litCharOne cs = case cs of
  [] -> Nothing
  c : rest -> case ord c == 92 of
    True -> litEscape rest
    False -> Just (c, 1)

litEscape :: [Char] -> Maybe (Char, Int)
litEscape cs = case cs of
  [] -> Nothing
  c : rest -> case ord c of
    97 -> Just (chr 7, 2)
    98 -> Just (chr 8, 2)
    102 -> Just (chr 12, 2)
    110 -> Just (chr 10, 2)
    114 -> Just (chr 13, 2)
    116 -> Just (chr 9, 2)
    118 -> Just (chr 11, 2)
    92 -> Just (chr 92, 2)
    39 -> Just (chr 39, 2)
    34 -> Just (chr 34, 2)
    38 -> Nothing
    94 -> litControl rest
    120 -> litBased 16 isHexDigit rest
    111 -> litBased 8 isOctDigit rest
    _ -> litNameOrDecimal cs

-- @\^X@: codes 64-95 name control codes 0-31.
litControl :: [Char] -> Maybe (Char, Int)
litControl cs = case cs of
  [] -> Nothing
  d : _ -> case ord d >= 64 && ord d <= 95 of
    True -> Just (chr (ord d - 64), 3)
    False -> Nothing

-- @\x../\o..@: at least one digit, and a scalar at the end.
litBased :: Int -> (Char -> Bool) -> [Char] -> Maybe (Char, Int)
litBased base isDig cs = case readDigits isDig base cs of
  (v, n) -> case n == 0 of
    True -> Nothing
    False -> case validScalar v of
      True -> Just (chr v, 2 + n)
      False -> Nothing

-- Plain decimal, or an ASCII control name (@NUL@..@US@, @DEL@, @SO@).
litNameOrDecimal :: [Char] -> Maybe (Char, Int)
litNameOrDecimal cs = case readDigits isDigit 10 cs of
  (v, n) -> case n == 0 of
    True -> tryLitNames litNames cs
    False -> case validScalar v of
      True -> Just (chr v, 1 + n)
      False -> Nothing

readDigits :: (Char -> Bool) -> Int -> [Char] -> (Int, Int)
readDigits isDig base cs = readDigitsGo cs 0 0
  where
    readDigitsGo ds acc n = case ds of
      [] -> (acc, n)
      d : rest -> case isDig d of
        True -> readDigitsGo rest (acc * base + digitToInt d) (n + 1)
        False -> (acc, n)

validScalar :: Int -> Bool
validScalar v = v >= 0 && v <= 1114111 && (v < 55296 || v > 57343)

tryLitNames :: [(String, Int)] -> [Char] -> Maybe (Char, Int)
tryLitNames ns cs = case ns of
  [] -> Nothing
  (name, code) : rest -> case charsPrefix (unpack name) cs of
    True -> Just (chr code, 1 + strLength name)
    False -> tryLitNames rest cs

charsPrefix :: [Char] -> [Char] -> Bool
charsPrefix p s = case p of
  [] -> True
  x : xs -> case s of
    [] -> False
    y : ys -> case x == y of
      True -> charsPrefix xs ys
      False -> False

litNames :: [(String, Int)]
litNames =
  [ ("NUL", 0), ("SOH", 1), ("STX", 2), ("ETX", 3)
  , ("EOT", 4), ("ENQ", 5), ("ACK", 6), ("BEL", 7)
  , ("BS", 8), ("HT", 9), ("LF", 10), ("VT", 11)
  , ("FF", 12), ("CR", 13), ("SO", 14), ("SI", 15)
  , ("DLE", 16), ("DC1", 17), ("DC2", 18), ("DC3", 19)
  , ("DC4", 20), ("NAK", 21), ("SYN", 22), ("ETB", 23)
  , ("CAN", 24), ("EM", 25), ("SUB", 26), ("ESC", 27)
  , ("FS", 28), ("GS", 29), ("RS", 30), ("US", 31)
  , ("DEL", 127)
  ]

-- | The number of scalars in a string, for the literal names above.
strLength :: String -> Int
strLength s = strLengthOf (unpack s) 0

strLengthOf :: [Char] -> Int -> Int
strLengthOf cs n = case cs of
  [] -> n
  _ : rest -> strLengthOf rest (n + 1)
