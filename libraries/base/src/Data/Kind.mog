-- | Kinds that describe other types.
module Data.Kind
  ( Type
  , Constraint
  , FUN
  ) where

-- | A run-time representation: how a value of a type is stored.
data RuntimeRep

-- | The representation of lifted types, the ordinary types with values.
data LiftedRep

-- | The kind of types stored at a given run-time representation.
data TYPE (r :: k)

-- | The kind of constraints over types stored at a given representation.
data CONSTRAINT (r :: k)

-- | The kind of ordinary types with values.
type Type = TYPE LiftedRep

-- | The kind of constraints.
type Constraint = CONSTRAINT LiftedRep

-- | The kind of function types.
data FUN
