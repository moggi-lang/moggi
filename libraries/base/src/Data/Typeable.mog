{-# LANGUAGE NoImplicitPrelude #-}
-----------------------------------------------------------------------------
--
-- Module      :  Data.Typeable
-- Copyright   :  (c) The University of Glasgow, CWI 2001--2004
-- License     :  BSD-style (see the file libraries/base/LICENSE)
--
-- Maintainer  :  libraries@haskell.org
-- Stability   :  stable
-- Portability :  portable
--
-- The 'Typeable' class reifies types to some extent by associating type
-- representations to types. These type representations can be compared,
-- and one can in turn define a type-safe cast operation. To this end,
-- an unsafe cast is guarded by a test for type (representation)
-- equivalence. The module "Data.Dynamic" uses Typeable for an
-- implementation of dynamics. The module "Data.Data" uses Typeable
-- and type-safe cast (but not dynamics) to support the \"Scrap your
-- boilerplate\" style of generic programming.
--
-- == Compatibility Notes
--
-- Since GHC 8.2, GHC has supported type-indexed type representations.
-- "Data.Typeable" provides type representations which are qualified over this
-- index, providing an interface very similar to the "Typeable" notion seen in
-- previous releases. For the type-indexed interface, see "Type.Reflection".
--
-- Since GHC 7.10, all types automatically have 'Typeable' instances derived.
-- This is in contrast to previous releases where 'Typeable' had to be
-- explicitly derived using the @DeriveDataTypeable@ language extension.
--
-- Since GHC 7.8, 'Typeable' is poly-kinded. The changes required for this might
-- break some old programs involving 'Typeable'. More details on this, including
-- how to fix your code, can be found on the
-- <https://gitlab.haskell.org/ghc/ghc/wikis/ghc-kinds/poly-typeable PolyTypeable wiki page>
--
-----------------------------------------------------------------------------

module Data.Typeable
    ( -- * The Typeable class
      Typeable
    , typeOf
    , typeRep

      -- * Propositional equality
    , (:~:)(Refl)
    , (:~~:)(HRefl)

      -- * Type-safe cast
    , cast
    , eqT
    , heqT
    , decT
    , hdecT
    , gcast                -- a generalisation of cast

      -- * Generalized casts for higher-order kinds
    , gcast1               -- :: ... => c (t a) -> Maybe (c (t' a))
    , gcast2               -- :: ... => c (t a b) -> Maybe (c (t' a b))

      -- * A canonical proxy type
    , Proxy (..)

      -- * Type representations
    , TypeRep
    , rnfTypeRep
    , showsTypeRep
    , mkFunTy

      -- * Observing type representations
    , funResultTy
    , splitTyConApp
    , typeRepArgs
    , typeRepTyCon
    , typeRepFingerprint

      -- * Type constructors
    , TyCon          -- abstract, instance of: Eq, Show, Typeable
                     -- For now don't export Module to avoid name clashes
    , tyConPackage
    , tyConModule
    , tyConName
    , rnfTyCon
    , tyConFingerprint

      -- * For backwards compatibility
    , typeOf1, typeOf2, typeOf3, typeOf4, typeOf5, typeOf6, typeOf7
      -- Jank
    , trLiftedRep
    ) where

import Type.Reflection qualified as I
import Type.Reflection
  ( Typeable, Fingerprint, SomeTypeRep(..)
  , TyCon, tyConPackage, tyConModule, tyConName, rnfTyCon, tyConFingerprint
  , trLiftedRep
  )
import Data.Type.Equality

import Data.Either
import Data.Maybe
import Data.Proxy
import Data.Void (Void)
import Moggi.Internal.Base
import Text.Show (ShowS, shows)

-- | A quantified type representation.
type TypeRep = SomeTypeRep


-- | Observe a type representation for the type of a value.
typeOf :: forall a. Typeable a => a -> TypeRep
typeOf _ = I.someTypeRep (I.typeRepProxy (Proxy :: Proxy a))

-- | Takes a value of type @a@ and returns a concrete representation
-- of that type.
--
-- @since base-4.7.0.0
typeRep :: forall proxy a. Typeable a => proxy a -> TypeRep
typeRep _ = I.someTypeRep (I.typeRepProxy (Proxy :: Proxy a))

-- | Show a type representation
showsTypeRep :: TypeRep -> ShowS
showsTypeRep t = shows t

-- | The type-safe cast operation
cast :: forall a b. (Typeable a, Typeable b) => a -> Maybe b
cast x = case ta `I.eqTypeRep` tb of
  Just HRefl -> Just x
  Nothing    -> Nothing
 where
  ta = I.typeRepProxy (Proxy :: Proxy a)
  tb = I.typeRepProxy (Proxy :: Proxy b)

-- | Extract a witness of equality of two types
--
-- @since base-4.7.0.0
eqT :: forall a b. (Typeable a, Typeable b) => Maybe (a :~: b)
eqT = case heqT :: Maybe (a :~~: b) of
  Just HRefl -> Just Refl
  Nothing    -> Nothing

-- | Decide an equality of two types
--
-- @since base-4.19.0.0
decT :: forall a b. (Typeable a, Typeable b) => Either (a :~: b -> Void) (a :~: b)
decT = case hdecT :: Either (a :~~: b -> Void) (a :~~: b) of
  Right HRefl -> Right Refl
  Left p      -> Left (refuteHomogeneous p)

-- The refutation of @a :~~: b@ is a refutation of @a :~: b@: a homogeneous
-- witness is the heterogeneous one. This is the lambda @\Refl -> p HRefl@;
-- a lambda parameter here must be a variable, so it is a named function.
refuteHomogeneous :: forall a b. (a :~~: b -> Void) -> a :~: b -> Void
refuteHomogeneous p Refl = p HRefl

-- | Extract a witness of heterogeneous equality of two types
--
-- @since base-4.18.0.0
heqT :: forall a b. (Typeable a, Typeable b) => Maybe (a :~~: b)
heqT = ta `I.eqTypeRep` tb
 where
  ta = I.typeRepProxy (Proxy :: Proxy a)
  tb = I.typeRepProxy (Proxy :: Proxy b)

-- | Decide heterogeneous equality of two types.
--
-- @since base-4.19.0.0
hdecT :: forall a b. (Typeable a, Typeable b) => Either (a :~~: b -> Void) (a :~~: b)
hdecT = ta `I.decTypeRep` tb
 where
  ta = I.typeRepProxy (Proxy :: Proxy a)
  tb = I.typeRepProxy (Proxy :: Proxy b)

-- | A flexible variation parameterised in a type constructor
gcast :: forall a b c. (Typeable a, Typeable b) => c a -> Maybe (c b)
gcast x = case eqT :: Maybe (a :~: b) of
  Just Refl -> Just x
  Nothing   -> Nothing

-- | Cast over @k1 -> k2@
gcast1 :: forall c t t' a. (Typeable t, Typeable t')
       => c (t a) -> Maybe (c (t' a))
gcast1 x = case eqT :: Maybe (t :~: t') of
  Just Refl -> Just x
  Nothing   -> Nothing

-- | Cast over @k1 -> k2 -> k3@
gcast2 :: forall c t t' a b. (Typeable t, Typeable t')
       => c (t a b) -> Maybe (c (t' a b))
gcast2 x = case eqT :: Maybe (t :~: t') of
  Just Refl -> Just x
  Nothing   -> Nothing

-- | Applies a type to a function type. Returns: @Just u@ if the first argument
-- represents a function of type @t -> u@ and the second argument represents a
-- function of type @t@. Otherwise, returns @Nothing@.
funResultTy :: TypeRep -> TypeRep -> Maybe TypeRep
funResultTy a b = I.funResultTy a b

-- | Build a function type.
mkFunTy :: TypeRep -> TypeRep -> TypeRep
mkFunTy (SomeTypeRep arg) (SomeTypeRep res) = I.someTypeRep (I.mkFunTy arg res)

-- | Splits a type constructor application. Note that if the type constructor is
-- polymorphic, this will not return the kinds that were used.
splitTyConApp :: TypeRep -> (TyCon, [TypeRep])
splitTyConApp t = case t of
  SomeTypeRep x -> I.splitApps x

-- | Observe the argument types of a type representation
typeRepArgs :: TypeRep -> [TypeRep]
typeRepArgs ty = case splitTyConApp ty of (_, args) -> args

-- | Observe the type constructor of a quantified type representation.
typeRepTyCon :: TypeRep -> TyCon
typeRepTyCon = I.someTypeRepTyCon

-- | Takes a value of type @a@ and returns a concrete representation
-- of that type.
--
-- @since base-4.7.0.0
typeRepFingerprint :: TypeRep -> Fingerprint
typeRepFingerprint t = case t of
  SomeTypeRep x -> I.typeRepFingerprint x

-- | Force a 'TypeRep' to normal form.
rnfTypeRep :: TypeRep -> ()
rnfTypeRep = I.rnfSomeTypeRep


-- Keeping backwards-compatibility
typeOf1 :: forall t a. Typeable t => t a -> TypeRep
typeOf1 _ = I.someTypeRep (I.typeRepProxy (Proxy :: Proxy t))

typeOf2 :: forall t a b. Typeable t => t a b -> TypeRep
typeOf2 _ = I.someTypeRep (I.typeRepProxy (Proxy :: Proxy t))

typeOf3 :: forall t a b c. Typeable t => t a b c -> TypeRep
typeOf3 _ = I.someTypeRep (I.typeRepProxy (Proxy :: Proxy t))

typeOf4 :: forall t a b c d. Typeable t => t a b c d -> TypeRep
typeOf4 _ = I.someTypeRep (I.typeRepProxy (Proxy :: Proxy t))

typeOf5 :: forall t a b c d e. Typeable t => t a b c d e -> TypeRep
typeOf5 _ = I.someTypeRep (I.typeRepProxy (Proxy :: Proxy t))

typeOf6 :: forall t a b c d e f. Typeable t => t a b c d e f -> TypeRep
typeOf6 _ = I.someTypeRep (I.typeRepProxy (Proxy :: Proxy t))

typeOf7 :: forall t a b c d e f g. Typeable t => t a b c d e f g -> TypeRep
typeOf7 _ = I.someTypeRep (I.typeRepProxy (Proxy :: Proxy t))
