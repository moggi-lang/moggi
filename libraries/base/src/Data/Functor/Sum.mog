{-# LANGUAGE NoImplicitPrelude #-}
-- | Sums, lifted to functors: a value is one functor's value or the other's,
-- and a mapped function runs on whichever side is present.
--
-- >>> map (+1) (InL (Just 1)) :: Sum Maybe [Int]
-- InL (Just 2)
--
-- >>> map (+1) (InR [1, 2, 3]) :: Sum Maybe [Int]
-- InR [2,3,4]
module Data.Functor.Sum (
    Sum(..),
  ) where

import Control.Applicative ((<|>), Alternative(empty))
import Data.Bool
import Data.Foldable (Foldable(foldMap, foldr))
import Data.Functor (Functor(map))
import Data.Functor.Classes
import Data.List ((++))
import Data.Ord (Ordering(EQ, GT, LT))
import Data.Traversable (Traversable(traverse))
import Moggi.Internal.Base
import Text.Read (Read, ReadS, lex, readParen)
import Text.Show

-- | Lifted sum of functors.
data Sum f g a = InL (f a) | InR (g a)
  deriving (Eq, Ord, Read, Show)

instance (Eq1 f, Eq1 g) => Eq1 (Sum f g) where
  liftEq eq (InL x1) (InL x2) = liftEq eq x1 x2
  liftEq _ (InL _) (InR _) = False
  liftEq _ (InR _) (InL _) = False
  liftEq eq (InR y1) (InR y2) = liftEq eq y1 y2

instance (Ord1 f, Ord1 g) => Ord1 (Sum f g) where
  liftCompare cmp (InL x1) (InL x2) = liftCompare cmp x1 x2
  liftCompare _ (InL _) (InR _) = LT
  liftCompare _ (InR _) (InL _) = GT
  liftCompare cmp (InR y1) (InR y2) = liftCompare cmp y1 y2

instance (Read1 f, Read1 g) => Read1 (Sum f g) where
  liftReadsPrec rp rl d = readsData (readsSumWith (liftReadsPrec rp rl) (liftReadsPrec rp rl)) d

readsSumWith :: (Int -> ReadS (f a)) -> (Int -> ReadS (g a)) -> String -> ReadS (Sum f g a)
readsSumWith rpF rpG kw = \s -> case readsUnaryWith rpF "InL" InL kw s of
  [] -> readsUnaryWith rpG "InR" InR kw s
  found -> found

instance (Show1 f, Show1 g) => Show1 (Sum f g) where
  liftShowsPrec sp sl d (InL x) = showsUnaryWith (liftShowsPrec sp sl) "InL" d x
  liftShowsPrec sp sl d (InR y) = showsUnaryWith (liftShowsPrec sp sl) "InR" d y

instance (Functor f, Functor g) => Functor (Sum f g) where
  map f (InL x) = InL (map f x)
  map f (InR y) = InR (map f y)

instance (Foldable f, Foldable g) => Foldable (Sum f g) where
  foldMap f (InL x) = foldMap f x
  foldMap f (InR y) = foldMap f y
  foldr f z (InL x) = foldr f z x
  foldr f z (InR y) = foldr f z y

instance (Traversable f, Traversable g) => Traversable (Sum f g) where
  traverse f (InL x) = map InL (traverse f x)
  traverse f (InR y) = map InR (traverse f y)
