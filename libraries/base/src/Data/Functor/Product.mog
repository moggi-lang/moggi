{-# LANGUAGE NoImplicitPrelude #-}
-- | Products, lifted to functors: @'Pair' x y@ holds one value of each functor,
-- and a function mapped over the pair runs in both halves.
--
-- >>> map (+1) (Pair [1, 2, 3] (Just 0))
-- Pair [2,3,4] (Just 1)
--
-- >>> Pair "Hello, " (Left 'x') <> Pair "World" (Right 'y')
-- Pair "Hello, World" (Right 'y')
module Data.Functor.Product (
    Product(..),
  ) where

import Control.Applicative
import Control.Monad (Monad, MonadPlus(mplus, mzero), (>>=))
import Control.Monad.Zip (MonadZip(mzipWith))
import Data.Bool
import Data.Foldable (Foldable(foldl, foldMap, foldr))
import Data.Functor (Functor(map))
import Data.Functor.Classes
import Data.List ((++))
import Data.Monoid (Monoid(mempty))
import Data.Ord (Ordering(EQ, GT, LT))
import Data.Semigroup (Semigroup((<>)))
import Data.Traversable (Traversable(traverse))
import Data.Tuple (fst, snd)
import Moggi.Internal.Base
import Text.Read (Read, ReadS, lex, readParen)
import Text.Show

-- | Lifted product of functors.
data Product f g a = Pair (f a) (g a)
  deriving (Eq, Ord, Read, Show)

instance (Eq1 f, Eq1 g) => Eq1 (Product f g) where
  liftEq eq (Pair x1 y1) (Pair x2 y2) = liftEq eq x1 x2 && liftEq eq y1 y2

instance (Ord1 f, Ord1 g) => Ord1 (Product f g) where
  liftCompare cmp (Pair x1 y1) (Pair x2 y2) = case liftCompare cmp x1 x2 of
    EQ -> liftCompare cmp y1 y2
    other -> other

instance (Read1 f, Read1 g) => Read1 (Product f g) where
  liftReadsPrec rp rl d =
    readsData (\kw -> readsBinaryWith (liftReadsPrec rp rl) (liftReadsPrec rp rl) "Pair" Pair kw) d

instance (Show1 f, Show1 g) => Show1 (Product f g) where
  liftShowsPrec sp sl d (Pair x y) =
    showsBinaryWith (liftShowsPrec sp sl) (liftShowsPrec sp sl) "Pair" d x y

instance (Functor f, Functor g) => Functor (Product f g) where
  map f (Pair x y) = Pair (map f x) (map f y)

instance (Foldable f, Foldable g) => Foldable (Product f g) where
  foldMap f (Pair x y) = foldMap f x <> foldMap f y
  foldr f z (Pair x y) = foldr f (foldr f z y) x
  foldl f z (Pair x y) = foldl f (foldl f z x) y

instance (Traversable f, Traversable g) => Traversable (Product f g) where
  traverse f (Pair x y) = liftA2 Pair (traverse f x) (traverse f y)

instance (Applicative f, Applicative g) => Applicative (Product f g) where
  pure x = Pair (pure x) (pure x)
  (<*>) pf px = case pf of
    Pair f g -> case px of
      Pair x y -> Pair (f <*> x) (g <*> y)
  liftA2 f pa pb = case pa of
    Pair a b -> case pb of
      Pair x y -> Pair (liftA2 f a x) (liftA2 f b y)

instance (Alternative f, Alternative g) => Alternative (Product f g) where
  empty = Pair empty empty
  (<|>) pa pb = case pa of
    Pair x1 y1 -> case pb of
      Pair x2 y2 -> Pair (x1 <|> x2) (y1 <|> y2)

instance (Monad f, Monad g) => Monad (Product f g) where
  (>>=) pa k = case pa of
    Pair m n -> Pair (m >>= (\v -> productFst (k v))) (n >>= (\v -> productSnd (k v)))

instance (MonadPlus f, MonadPlus g) => MonadPlus (Product f g) where
  mzero = Pair mzero mzero
  mplus pa pb = case pa of
    Pair x1 y1 -> case pb of
      Pair x2 y2 -> Pair (mplus x1 x2) (mplus y1 y2)

instance (MonadZip f, MonadZip g) => MonadZip (Product f g) where
  mzipWith f pa pb = case pa of
    Pair x1 y1 -> case pb of
      Pair x2 y2 -> Pair (mzipWith f x1 x2) (mzipWith f y1 y2)

instance (Semigroup (f a), Semigroup (g a)) => Semigroup (Product f g a) where
  (<>) pa pb = case pa of
    Pair x1 y1 -> case pb of
      Pair x2 y2 -> Pair (x1 <> x2) (y1 <> y2)

instance (Monoid (f a), Monoid (g a)) => Monoid (Product f g a) where
  mempty = Pair mempty mempty

productFst :: Product f g a -> f a
productFst (Pair x _) = x

productSnd :: Product f g a -> g a
productSnd (Pair _ y) = y
