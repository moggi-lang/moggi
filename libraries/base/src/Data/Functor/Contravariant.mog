{-# LANGUAGE NoImplicitPrelude #-}
-- | 'Contravariant' functors: a functor that consumes its values instead of
-- producing them, so 'contramap' precomposes the function on the way in. A
-- predicate @a -> Bool@ is the canonical example: given a predicate on
-- integers, 'contramap' turns it into a predicate on anything that yields an
-- integer.
--
-- >>> getPredicate (contramap length (Predicate (> 3))) "abcde"
-- True
module Data.Functor.Contravariant (
  -- * Contravariant Functors
    Contravariant(..)
  , phantom
  -- * Operators
  , (>$<), (>$$<), ($<)
  -- * Predicates
  , Predicate(..)
  -- * Comparisons
  , Comparison(..)
  , defaultComparison
  -- * Equivalence Relations
  , Equivalence(..)
  , defaultEquivalence
  , comparisonEquivalence
  -- * Dual arrows
  , Op(..)
  ) where

import Control.Applicative
import Data.Bool
import Data.Eq
import Data.Function (const, flip)
import Data.Functor (Functor(map), (<$))
import Data.Functor.Compose (Compose(Compose))
import Data.Functor.Const (Const(Const))
import Data.Functor.Product (Product(Pair))
import Data.Functor.Sum (Sum(InL, InR))
import Data.Monoid (Monoid(mempty))
import Data.Ord (Ordering(EQ), compare)
import Data.Proxy (Proxy(Proxy))
import Data.Real (Floating(..), Fractional(..))
import Data.Semigroup (Semigroup((<>)))
import Moggi.Internal.Base

infixl 4 >$, $<, >$<, >$$<

-- | The class of contravariant functors. 'contramap' maps a function over the
-- /input/ of a structure, so the function runs first and the structure sees its
-- result.
class Contravariant f where
  contramap :: (a -> b) -> f b -> f a

  -- | Replace every location in the input with the same value.
  (>$) :: b -> f b -> f a
  (>$) b f = contramap (const b) f

-- | The only value a type that is both 'Functor' and 'Contravariant' can hold.
phantom :: (Functor f, Contravariant f) => f a -> f b
phantom x = () <$ x $< ()

-- | '>$' with its arguments flipped.
($<) :: Contravariant f => f b -> b -> f a
($<) = flip (>$)

-- | Infix 'contramap'.
(>$<) :: Contravariant f => (a -> b) -> f b -> f a
(>$<) = contramap

-- | 'contramap' with its arguments flipped.
(>$$<) :: Contravariant f => f b -> (a -> b) -> f a
(>$$<) = flip contramap

instance (Contravariant f, Contravariant g) => Contravariant (Sum f g) where
  contramap f x = case x of
    InL a -> InL (contramap f a)
    InR b -> InR (contramap f b)

instance (Contravariant f, Contravariant g) => Contravariant (Product f g) where
  contramap f x = case x of
    Pair a b -> Pair (contramap f a) (contramap f b)

instance Contravariant (Const a) where
  contramap _ x = case x of
    Const a -> Const a

instance (Functor f, Contravariant g) => Contravariant (Compose f g) where
  contramap f x = case x of
    Compose fga -> Compose (map (contramap f) fga)

instance Contravariant Proxy where
  contramap _ _ = Proxy

-- | A predicate on @a@: a value that classifies its input.
newtype Predicate a = Predicate { getPredicate :: a -> Bool }

-- | Combining two predicates keeps the input only when both accept it.
instance Semigroup (Predicate a) where
  (<>) p q = Predicate (\a -> getPredicate p a && getPredicate q a)

-- | The predicate that accepts every input.
instance Monoid (Predicate a) where
  mempty = Predicate (\_ -> True)

instance Contravariant Predicate where
  contramap f p = Predicate (\a -> getPredicate p (f a))

-- | A total ordering on @a@, as 'compare' would give it.
newtype Comparison a = Comparison { getComparison :: a -> a -> Ordering }

instance Semigroup (Comparison a) where
  (<>) p q = Comparison (\a b -> getComparison p a b <> getComparison q a b)

instance Monoid (Comparison a) where
  mempty = Comparison (\_ _ -> EQ)

instance Contravariant Comparison where
  contramap f p = Comparison (\a b -> getComparison p (f a) (f b))

-- | Order using 'compare'.
defaultComparison :: Ord a => Comparison a
defaultComparison = Comparison compare

-- | An equivalence relation on @a@.
newtype Equivalence a = Equivalence { getEquivalence :: a -> a -> Bool }

instance Semigroup (Equivalence a) where
  (<>) p q = Equivalence (\a b -> getEquivalence p a b && getEquivalence q a b)

instance Monoid (Equivalence a) where
  mempty = Equivalence (\_ _ -> True)

instance Contravariant Equivalence where
  contramap f p = Equivalence (\a b -> getEquivalence p (f a) (f b))

-- | Equivalence by '=='.
defaultEquivalence :: Eq a => Equivalence a
defaultEquivalence = Equivalence (==)

-- | The equivalence a 'Comparison' induces: two values are equivalent when it
-- calls them equal.
comparisonEquivalence :: Comparison a -> Equivalence a
comparisonEquivalence c = case c of
  Comparison p -> Equivalence (\a b -> p a b == EQ)

-- | Dual function arrows: an @Op a b@ consumes a @b@.
newtype Op a b = Op { getOp :: b -> a }

instance Semigroup a => Semigroup (Op a b) where
  (<>) f g = Op (\a -> getOp f a <> getOp g a)

instance Monoid a => Monoid (Op a b) where
  mempty = Op (\_ -> mempty)

instance Contravariant (Op a) where
  contramap f g = Op (\b -> getOp g (f b))

instance Num a => Num (Op a b) where
  (+) f g = Op (\a -> getOp f a + getOp g a)
  (-) f g = Op (\a -> getOp f a - getOp g a)
  (*) f g = Op (\a -> getOp f a * getOp g a)
  negate f = Op (\a -> negate (getOp f a))
  abs f = Op (\a -> abs (getOp f a))
  signum f = Op (\a -> signum (getOp f a))
  fromInteger n = Op (\_ -> fromInteger n)

instance Fractional a => Fractional (Op a b) where
  (/) f g = Op (\a -> getOp f a / getOp g a)
  recip f = Op (\a -> recip (getOp f a))
  fromRational r = Op (\_ -> fromRational r)

instance Floating a => Floating (Op a b) where
  pi = Op (\_ -> pi)
  exp f = Op (\a -> exp (getOp f a))
  sqrt f = Op (\a -> sqrt (getOp f a))
  log f = Op (\a -> log (getOp f a))
  sin f = Op (\a -> sin (getOp f a))
  tan f = Op (\a -> tan (getOp f a))
  cos f = Op (\a -> cos (getOp f a))
  asin f = Op (\a -> asin (getOp f a))
  atan f = Op (\a -> atan (getOp f a))
  acos f = Op (\a -> acos (getOp f a))
  sinh f = Op (\a -> sinh (getOp f a))
  tanh f = Op (\a -> tanh (getOp f a))
  cosh f = Op (\a -> cosh (getOp f a))
  asinh f = Op (\a -> asinh (getOp f a))
  atanh f = Op (\a -> atanh (getOp f a))
  acosh f = Op (\a -> acosh (getOp f a))
  (**) f g = Op (\a -> getOp f a ** getOp g a)
  logBase f g = Op (\a -> logBase (getOp f a) (getOp g a))
