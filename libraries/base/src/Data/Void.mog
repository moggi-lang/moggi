-- | A logically uninhabited data type, used to indicate that a given term should not exist.
module Data.Void
  ( Void
  , absurd
  , vacuous
  ) where

import Data.Bool
import Data.Eq
import Data.Functor
import Data.Ord
import Moggi.Err
import Moggi.Internal.Base
import Text.Show

-- | Uninhabited data type: it has no constructors, so (modulo non-termination)
-- no value of this type exists. There are no `Enum`/`Bounded` instances: both
-- would have to produce a `Void` (`toEnum`, `minBound`), which is impossible.
data Void
  deriving (Eq, Ord, Show)

-- | Since 'Void' values logically don't exist, this witnesses the
-- logical reasoning tool of \"ex falso quodlibet\".
--
-- >>> let x :: Either Void Int; x = Right 5
-- >>> :{
-- case x of
--     Right r -> r
--     Left l  -> absurd l
-- :}
-- 5
absurd :: Void -> a
absurd _ = error "Data.Void.absurd"

-- | If 'Void' is uninhabited then any 'Functor' that holds only
-- values of type 'Void' is holding no values.
-- It is implemented in terms of @map absurd@.
vacuous :: Functor f => f Void -> f a
vacuous x = map absurd x
