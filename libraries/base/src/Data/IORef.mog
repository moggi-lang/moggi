{-# LANGUAGE NoImplicitPrelude #-}
-- | Mutable references in 'IO': an 'IORef' holds a single value that an
-- 'IO' action can replace.
--
-- A reference is IO state, so the compiler confines it exactly like a
-- mutable array: it cannot appear in a pure signature or in a data field, a
-- state thread cannot take one, and a type synonym cannot hide it under
-- another name. Reads and writes sequence in bind order with the allocations
-- around them.
--
-- There are no atomic variants: the machine exposes no atomic
-- read-modify-write over a cell.
module Data.IORef
  ( IORef
  , newIORef
  , readIORef
  , writeIORef
  , modifyIORef
  , modifyIORef'
  ) where

import Control.Applicative
import Control.Monad
import Data.Functor
import Moggi.Internal.Base
import Moggi.Internal.IO
import System.IO (IO)

-- | A mutable reference in 'IO' holding a value of type @a@.
type IORef a = IORef# a

-- | Build a new reference holding the given value.
newIORef :: a -> IO (IORef a)
newIORef x = newIORef# x

-- | Read the current value of the reference.
readIORef :: IORef a -> IO a
readIORef r = readIORef# r

-- | Replace the reference's value.
writeIORef :: IORef a -> a -> IO ()
writeIORef r x = writeIORef# r x

-- | Apply a function to the reference's value. Evaluation is strict
-- throughout Moggi, so this sequences the read, the application and the
-- write with no thunk pile-up; 'modifyIORef'' is the same function under
-- its stricter name.
modifyIORef :: IORef a -> (a -> a) -> IO ()
modifyIORef r f = do
  x <- readIORef r
  writeIORef r (f x)

-- | Strict 'modifyIORef'. Identical to 'modifyIORef' because Moggi
-- evaluates strictly; kept so code written against both spellings
-- compiles.
modifyIORef' :: IORef a -> (a -> a) -> IO ()
modifyIORef' r f = modifyIORef r f
