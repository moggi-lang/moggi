{-# LANGUAGE NoImplicitPrelude #-}
-- | Enumerations: the 'Enum' class ('succ', 'pred', 'toEnum', 'fromEnum' and
-- the 'enumFrom' family, which is what @[x ..]@ desugars to) and 'enumerate'.
module Data.Enum
  ( Enum(succ, pred, toEnum, fromEnum, enumFrom, enumFromThen, enumFromTo, enumFromThenTo)
  , enumerate
  ) where

import Data.Bool
import Data.Bounded
import Data.Eq
import Data.Ord
import Moggi.Err
import Moggi.Internal.Base
import Moggi.Internal.Prim

-- | Class 'Enum' defines operations on sequentially ordered types.
--
-- Instances of 'Enum' may be derived for any enumeration type (types whose
-- constructors have no fields). The nullary constructors are assumed to be
-- numbered left-to-right by 'fromEnum' from @0@ through @n-1@.
--
-- For any type that is an instance of class 'Bounded' as well as 'Enum', the
-- following should hold:
--
-- * The calls @'succ' 'maxBound'@ and @'pred' 'minBound'@ should result in a
-- runtime error.
--
-- * 'fromEnum' and 'toEnum' should give a runtime error if the result value is
-- not representable in the result type. For example, @'toEnum' 7 :: 'Bool'@ is
-- an error.
class Enum a where
  -- | Successor of a value. For numeric types, 'succ' adds 1.
  succ :: a -> a
  -- | Predecessor of a value. For numeric types, 'pred' subtracts 1.
  pred :: a -> a
  -- | Convert from an 'Int'.
  toEnum :: Int -> a
  -- | Convert to an 'Int'.
  -- It is implementation-dependent what 'fromEnum' returns when applied to a
  -- value that is too large to fit in an 'Int'.
  fromEnum :: a -> Int

  -- | Used in the translation of @[x ..]@: the infinite list from @x@.
  -- The default maps 'toEnum' over the 'Int' range, so only 'Int' itself
  -- (and types that cannot go through 'fromEnum', like 'Integer') override it.
  enumFrom :: a -> [a]
  enumFrom x = enumMapToEnum toEnum (enumFrom (fromEnum x))

  -- | Used in the translation of @[x, y ..]@: @x@, @y@, then stepping by
  -- their distance.
  enumFromThen :: a -> a -> [a]
  enumFromThen x y = enumMapToEnum toEnum (enumFromThen (fromEnum x) (fromEnum y))

  -- | Used in the translation of @[lo .. hi]@ with @[lo .. hi] = enumFromTo lo
  -- hi@.
  --
  -- >>> enumFromTo 6 10 :: [Int]
  -- [6,7,8,9,10]
  -- >>> enumFromTo 42 1 :: [Integer]
  -- []
  enumFromTo :: a -> a -> [a]
  enumFromTo lo hi = enumMapToEnum toEnum (enumFromTo (fromEnum lo) (fromEnum hi))

  -- | Used in the translation of @[lo, nxt .. hi]@ with
  -- @[lo, nxt .. hi] = enumFromThenTo lo nxt hi@.
  --
  -- >>> enumFromThenTo 4 2 (-6) :: [Integer]
  -- [4,2,0,-2,-4,-6]
  -- >>> enumFromThenTo 6 8 2 :: [Int]
  -- []
  enumFromThenTo :: a -> a -> a -> [a]
  enumFromThenTo lo nxt hi =
    enumMapToEnum toEnum (enumFromThenTo (fromEnum lo) (fromEnum nxt) (fromEnum hi))

-- | Map a function over a list. Local (rather than 'map') so the class
-- defaults above never carry a `Functor` dictionary.
enumMapToEnum :: (a -> b) -> [a] -> [b]
enumMapToEnum f xs = case xs of
  [] -> []
  x : rest -> (f x) : (enumMapToEnum f rest)

-- | Every value of a bounded enumeration, from 'minBound' to 'maxBound'.
--
-- >>> enumerate :: [Bool]
-- [False,True]
enumerate :: (Enum a, Bounded a) => [a]
enumerate = enumFromTo minBound maxBound

instance Bounded Bool where
  minBound = False
  maxBound = True

instance Enum Bool where
  succ b = case b of
    False -> True
    True -> error "Prelude.Enum.Bool.succ: bad argument"
  pred b = case b of
    True -> False
    False -> error "Prelude.Enum.Bool.pred: bad argument"
  toEnum n = case n of
    0 -> False
    1 -> True
    _ -> error "Prelude.Enum.Bool.toEnum: bad argument"
  fromEnum b = case b of
    True -> 1
    False -> 0

instance Bounded Ordering where
  minBound = LT
  maxBound = GT

instance Enum Ordering where
  succ o = case o of
    LT -> EQ
    EQ -> GT
    GT -> error "Prelude.Enum.Ordering.succ: bad argument"
  pred o = case o of
    GT -> EQ
    EQ -> LT
    LT -> error "Prelude.Enum.Ordering.pred: bad argument"
  toEnum n = case n of
    0 -> LT
    1 -> EQ
    2 -> GT
    _ -> error "Prelude.Enum.Ordering.toEnum: bad argument"
  fromEnum o = case o of
    LT -> 0
    EQ -> 1
    GT -> 2

-- | The enumeration runs backwards: 'succ' steps the wrapped value down and
-- 'fromEnum' mirrors the codes, so @enumerate :: [Down Bool]@ is
-- @[Down True, Down False]@.
--
-- The mirror is bitwise complement on the 'Int' codes, written with primops
-- (rather than 'Num' methods) so this module stays below 'Data.Num':
-- @complement i = -i - 1@ swaps 'minBound' and 'maxBound' exactly.
instance (Enum a, Bounded a, Eq a) => Enum (Down a) where
  succ (Down x) = Down (pred x)
  pred (Down x) = Down (succ x)
  fromEnum (Down x) = complementInt (fromEnum x)
  toEnum n = Down (toEnum (complementInt n))
  enumFrom (Down x) = case x == minBound of
    True -> [Down x]
    False -> wrapDown (enumFromThen x (pred x))
  enumFromThen (Down x) (Down y) = wrapDown (enumFromThen x y)

complementInt :: Int -> Int
complementInt n = intSub# (intNegate# n) 1

wrapDown :: [a] -> [Down a]
wrapDown xs = case xs of
  [] -> []
  y : rest -> Down y : wrapDown rest
