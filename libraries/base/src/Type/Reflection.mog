{-# LANGUAGE NoImplicitPrelude #-}
-- |
-- Module      :  Type.Reflection
-- Stability   :  stable
-- Portability :  non-portable (requires GADTs and compiler support)
--
-- The public, @base@-compatible reflection API. The implementation lives in
-- "Moggi.Internal.Type.Reflection"; only the names @base@ exposes are
-- re-exported here.
module Type.Reflection
  ( -- * The Typeable class
    Typeable
  , typeRep
  , withTypeable
  , typeOf

    -- * Propositional equality
  , (:~:)(Refl)
  , (:~~:)(HRefl)

    -- * Type representations
  ,    TypeRep
  , pattern TypeRep
  , typeRepTyCon
  , rnfTypeRep
  , eqTypeRep
  , decTypeRep
  , typeRepKind
  , splitApps

    -- ** Quantified
  , SomeTypeRep(..)
  , someTypeRep
  , someTypeRepTyCon
  , rnfSomeTypeRep

    -- * Pattern synonyms
  , pattern App
  , pattern Con
  , pattern Con'
  , pattern Fun

    -- * Type constructors
  , TyCon
  , tyConPackage
  , tyConModule
  , tyConName
  , rnfTyCon

    -- * Module names
  , Module
  , moduleName
  , modulePackage
  , rnfModule
  ) where

import Moggi.Internal.Type.Reflection
  ( Typeable, typeRep, withTypeable, typeOf
  , (:~:)(Refl), (:~~:)(HRefl)
  , TypeRep, pattern TypeRep, typeRepTyCon, rnfTypeRep, eqTypeRep, decTypeRep
  , typeRepKind, splitApps
  , SomeTypeRep(..), someTypeRep, someTypeRepTyCon, rnfSomeTypeRep
  , pattern App, pattern Con, pattern Con', pattern Fun
  , TyCon, tyConPackage, tyConModule, tyConName, rnfTyCon
  , Module, moduleName, modulePackage, rnfModule
  )
