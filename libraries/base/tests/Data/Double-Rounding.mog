import System.IO
import Data.Int (Int)
import Data.Integer (Integer)
import Data.Double

main :: IO ()
main = do
  putStrLn (show (floorDouble 2.5 :: Int))
  putStrLn (show (ceilingDouble 2.5 :: Int))
  putStrLn (show (truncateDouble 2.5 :: Int))
  putStrLn (show (roundDouble 2.5 :: Int))
  putStrLn (show (floorDouble (-2.5) :: Int))
  putStrLn (show (ceilingDouble (-2.5) :: Int))
  putStrLn (show (truncateDouble (-2.5) :: Int))
  putStrLn (show (roundDouble (-2.5) :: Int))
  putStrLn (show (roundDouble 3.5 :: Int))
  putStrLn (show (roundDouble (-3.5) :: Int))
  putStrLn (show (floorDouble (negate 0.0) :: Int))
  putStrLn (show (ceilingDouble (negate 0.0) :: Int))
  putStrLn (show (floorDouble 5.0e-324 :: Int))
  putStrLn (show (ceilingDouble 5.0e-324 :: Int))
  putStrLn (show (properFractionDouble 2.5 :: (Int, Double)))
  putStrLn (show (properFractionDouble (-2.5) :: (Int, Double)))
  putStrLn (show (properFractionDouble 5.0e-324 :: (Int, Double)))
  putStrLn (show (floorDouble 1180591620717411303424.0 :: Integer))
  putStrLn (show (ceilingDouble 1180591620717411303424.0 :: Integer))
  putStrLn (show (truncateDouble 1180591620717411303424.0 :: Integer))
  putStrLn (show (roundDouble 1180591620717411303424.0 :: Integer))
  putStrLn (show (properFractionDouble 1180591620717411303424.0 :: (Integer, Double)))
  putStrLn (show (floorDouble 1.0e300 :: Integer))
  putStrLn (show (roundDouble 1.0e300 :: Integer))
  putStrLn (show (properFractionDouble 1.0e300 :: (Integer, Double)))
  putStrLn (show (floorDouble (negate 1.0e300) :: Integer))
  putStrLn (show (truncateDouble (negate 1.0e300) :: Integer))
