-- Data.Char: general categories, case/property predicates, case conversion,
-- digit conversion, and the GeneralCategory instances. Values stay in ASCII
-- (plus chr-built code points) so all backends agree.

import Data.Char
import Text.Read

main :: IO ()
main = do
  putStrLn (show (generalCategory 'A'))
  putStrLn (show (generalCategory 'a'))
  putStrLn (show (generalCategory '5'))
  putStrLn (show (generalCategory ','))
  putStrLn (show (generalCategory ' '))
  putStrLn (show (generalCategory (chr 7)))
  putStrLn (show (generalCategory (chr 453)))
  putStrLn (show (fromEnum (generalCategory 'A')))
  putStrLn (show (fromEnum (generalCategory 'a')))
  putStrLn (show (fromEnum (generalCategory '5')))
  putStrLn (show (toEnum 2 :: GeneralCategory))
  putStrLn (show (minBound :: GeneralCategory))
  putStrLn (show (maxBound :: GeneralCategory))
  putStrLn (show (read "DecimalNumber" :: GeneralCategory))
  putStrLn (show (isLower 'a'))
  putStrLn (show (isUpper 'a'))
  putStrLn (show (isLower 'A'))
  putStrLn (show (isUpper 'A'))
  putStrLn (show (isUpper '5'))
  putStrLn (show (isUpper (chr 453)))
  putStrLn (show (isLowerCase 'a'))
  putStrLn (show (isUpperCase 'A'))
  putStrLn (show (isAlpha 'a'))
  putStrLn (show (isAlpha '5'))
  putStrLn (show (isAlphaNum '5'))
  putStrLn (show (isDigit '5'))
  putStrLn (show (isNumber '5'))
  putStrLn (show (isSpace ' '))
  putStrLn (show (isSpace 'a'))
  putStrLn (show (isControl (chr 7)))
  putStrLn (show (isPrint 'a'))
  putStrLn (show (isAscii 'a'))
  putStrLn (show (isLatin1 (chr 200)))
  putStrLn (show (isOctDigit '7'))
  putStrLn (show (isHexDigit 'f'))
  putStrLn (show (isHexDigit 'g'))
  putStrLn (show (toUpper 'a'))
  putStrLn (show (toLower 'A'))
  putStrLn (show (digitToInt '5'))
  putStrLn (show (digitToInt 'f'))
  putStrLn (show (intToDigit 15))
