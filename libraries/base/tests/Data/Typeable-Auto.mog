module Main where

import Data.Int (Int8)
import Data.Proxy
import Data.Typeable (showsTypeRep)
import Data.Word (Word64)
import Type.Reflection

data Colour = Red | Green

data Box a = Box a

showIndexed :: TypeRep a -> String
showIndexed t = showsTypeRep (SomeTypeRep t) ""

main :: IO ()
main = do
  putStrLn (showIndexed (typeOf Red))
  putStrLn (showIndexed (typeOf (Box Red)))
  putStrLn (showIndexed (typeRep :: TypeRep (Box (Box Colour))))
  putStrLn (showIndexed (typeRep :: TypeRep [Box Int]))
  putStrLn (showIndexed (typeRep :: TypeRep (Colour -> Bool)))
  putStrLn (showIndexed (typeOf (Proxy :: Proxy Colour)))
  putStrLn (showIndexed (typeRep :: TypeRep (Int, Bool)))
  putStrLn (showIndexed (typeRep :: TypeRep (IO ())))
  putStrLn (showIndexed (typeOf LT))
  putStrLn (showIndexed (typeRep :: TypeRep Int8))
  putStrLn (showIndexed (typeRep :: TypeRep Word64))
  putStrLn (showIndexed (typeRep :: TypeRep Integer))
  putStrLn (showIndexed (typeRep :: TypeRep (Maybe Int)))
  putStrLn (showIndexed (typeRep :: TypeRep (Either Int Bool)))
  putStrLn (showIndexed (typeRep :: TypeRep (Int, Bool, Char, Int, Bool, Char, Int)))
