module Main where

import Data.Int (Int8)
import Data.Proxy
import Data.Word (Word64)
import Type.Reflection

data Colour = Red | Green

data Box a = Box a

main :: IO ()
main = do
  putStrLn (showsTypeRep (typeOf Red) "")
  putStrLn (showsTypeRep (typeOf (Box Red)) "")
  putStrLn (showsTypeRep (typeRep :: TypeRep (Box (Box Colour))) "")
  putStrLn (showsTypeRep (typeRep :: TypeRep [Box Int]) "")
  putStrLn (showsTypeRep (typeRep :: TypeRep (Colour -> Bool)) "")
  putStrLn (showsTypeRep (typeOf (Proxy :: Proxy Colour)) "")
  putStrLn (showsTypeRep (typeRep :: TypeRep (Int, Bool)) "")
  putStrLn (showsTypeRep (typeRep :: TypeRep (IO ())) "")
  putStrLn (showsTypeRep (typeOf LT) "")
  putStrLn (showsTypeRep (typeRep :: TypeRep Int8) "")
  putStrLn (showsTypeRep (typeRep :: TypeRep Word64) "")
  putStrLn (showsTypeRep (typeRep :: TypeRep Integer) "")
  putStrLn (showsTypeRep (typeRep :: TypeRep (Maybe Int)) "")
  putStrLn (showsTypeRep (typeRep :: TypeRep (Either Int Bool)) "")
  putStrLn (showsTypeRep (typeRep :: TypeRep (Int, Bool, Char, Int, Bool, Char, Int)) "")
