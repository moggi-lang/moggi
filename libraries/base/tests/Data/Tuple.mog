-- Data.Tuple: Eq and Ord for tuples answer through the element's own instances,
-- so a type with a custom Eq/Ord (`Tag` compares case-insensitively) behaves the
-- same inside a pair or triple, and a derived record holding tuple fields
-- follows those instances too.

import Data.Char qualified as C
import Data.List qualified as L
import Data.String (String)
import Data.String qualified as S
import Data.Tuple (Tuple2, Tuple3, Tuple4)

data Tag = Tag String deriving (Show)

tagKey :: Tag -> String
tagKey (Tag s) = S.pack (L.map C.toLower (S.unpack s))

instance Eq Tag where
  (==) a b = tagKey a == tagKey b
  (/=) a b = case tagKey a == tagKey b of
    True -> False
    False -> True

instance Ord Tag where
  compare a b = compare (tagKey a) (tagKey b)

data Rec = Rec { recPair :: (Tag, Tag), recTriple :: (Tag, Tag, Tag) } deriving (Eq, Ord, Show)

main :: IO ()
main = do
  putStrLn (show ((Tag "a", Tag "b") == (Tag "A", Tag "B")))
  putStrLn (show ((Tag "a", Tag "b") == (Tag "A", Tag "C")))
  putStrLn (show ((Tag "a", Tag "b") /= (Tag "a", Tag "B")))
  putStrLn (show (compare (Tag "a", Tag "b") (Tag "A", Tag "b")))
  putStrLn (show (compare (Tag "a", Tag "b") (Tag "a", Tag "A")))
  putStrLn (show ((Tag "a", Tag "b", Tag "c") == (Tag "A", Tag "B", Tag "C")))
  putStrLn (show ((Tag "a", Tag "b", Tag "c") == (Tag "a", Tag "b", Tag "C")))
  putStrLn (show (compare (Tag "a", Tag "b", Tag "c") (Tag "a", Tag "b", Tag "A")))
  putStrLn (show ((Tag "a", Tag "b", Tag "c", Tag "d") == (Tag "A", Tag "B", Tag "C", Tag "D")))
  putStrLn (show (Rec (Tag "a", Tag "b") (Tag "x", Tag "y", Tag "z") == Rec (Tag "A", Tag "B") (Tag "X", Tag "Y", Tag "Z")))
  putStrLn (show (compare (Rec (Tag "a", Tag "b") (Tag "x", Tag "y", Tag "z")) (Rec (Tag "a", Tag "A") (Tag "x", Tag "y", Tag "z"))))
