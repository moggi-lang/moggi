-- Data.Bifoldable: folds over Either, pairs, 3-tuples, Const, Arg and K1,
-- plus every combinator built on the class.
import Data.Bifoldable
import Data.Functor.Const (Const(Const))
import Data.Semigroup (Arg(Arg))
import Moggi.Generics (K1(K1))

main :: IO ()
main = do
  putStrLn (show (bifold (Right [1, 2] :: Either [Int] [Int])))
  putStrLn (show (bifold (Left [3] :: Either [Int] [Int])))
  putStrLn (show (bifold ([1, 2], [3])))
  putStrLn (show (bifoldMap (\x -> [x]) (\x -> [x + 10]) (Right 5 :: Either Int Int)))
  putStrLn (show (bifoldr (+) (*) 1 (3, 4)))
  putStrLn (show (bifoldl (+) (*) 1 (3, 4)))
  putStrLn (show (bifoldr1 (+) (1, 2)))
  putStrLn (show (bifoldl1 (+) (1, 2)))
  putStrLn (show (bifoldrM (\x acc -> Just (x + acc)) (\x acc -> Just (x * acc)) 1 (2, 3)))
  putStrLn (show (bifoldlM (\acc x -> Just (acc * 10 + x)) (\acc x -> Just (acc * 10 + x)) 0 (2, 3)))
  putStrLn (show (biList (1, 2)))
  putStrLn (show (biList (Left 5 :: Either Int Int)))
  putStrLn (show (binull (1, 2)))
  putStrLn (show (bilength (1, 2)))
  putStrLn (show (bilength (Right 1 :: Either Int Int)))
  putStrLn (show (bielem 2 (1, 2)))
  putStrLn (show (binotElem 3 (1, 2)))
  putStrLn (show (bimaximum (3, 7)))
  putStrLn (show (biminimum (3, 7)))
  putStrLn (show (bisum (3, 4)))
  putStrLn (show (biproduct (3, 4)))
  putStrLn (show (biconcat ([1], [2])))
  putStrLn (show (biconcatMap (\x -> [x]) (\x -> [x * 2]) (3, 4)))
  putStrLn (show (biand (True, True)))
  putStrLn (show (bior (False, True)))
  putStrLn (show (biany (\x -> x == 2) (\x -> x == 3) (1, 3)))
  putStrLn (show (biall (\x -> x < 10) (\x -> x < 10) (1, 3)))
  putStrLn (show (bimaximumBy compare (3, 7)))
  putStrLn (show (biminimumBy compare (3, 7)))
  putStrLn (show (bifind (\x -> x > 1) (1, 2)))
  putStrLn (show (bitraverse_ (\x -> Just x) (\x -> Just x) (1, 2) :: Maybe ()))
  putStrLn (show (bifor_ (1, 2) (\x -> Just x) (\x -> Just x) :: Maybe ()))
  putStrLn (show (bimapM_ (\x -> Just x) (\x -> Just x) (1, 2) :: Maybe ()))
  putStrLn (show (biforM_ (1, 2) (\x -> Just x) (\x -> Just x) :: Maybe ()))
  putStrLn (show (bisequence_ (Just 1, Just 2) :: Maybe ()))
  putStrLn (show (bisequenceA_ (Just 1, Nothing :: Maybe Int) :: Maybe ()))
  putStrLn (show (biasum (Right (Just 5) :: Either (Maybe Int) (Maybe Int))))
  putStrLn (show (biasum (Left Nothing :: Either (Maybe Int) (Maybe Int))))
  putStrLn (show (bimsum (Just 6, Just 7) :: Maybe Int))
  putStrLn (show (bifold (Const [1, 2] :: Const [Int] [Int])))
  putStrLn (show (bifold (Arg [1] [2, 3] :: Arg [Int] [Int])))
  putStrLn (show (bifold (([1], [2], [3]) :: ([Int], [Int], [Int]))))
  putStrLn (show (bifoldr (+) (+) 0 (1, 2, 3)))
  putStrLn (show (bifold (K1 [4] :: K1 Int [Int] [Int])))
