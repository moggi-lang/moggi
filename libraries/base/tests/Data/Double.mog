import Data.Eq
import Data.Ord
import Data.Double (castWord64ToDouble, castDoubleToWord64, rationalToDouble)
import Text.Show

-- IEEE 754 semantics and `Show`: NaN, infinities, negative zero, and the
-- shortest round-trip decimal form, all identical on every backend. The
-- `Floating` surface continues below, on the same values.

-- IEEE 754 semantics and `Show`: NaN, infinities, negative zero, and the
-- shortest round-trip decimal form, all identical on every backend.

half :: Double -> Double
half x = x / (1.0 + 1.0)

zero :: Double
zero = half 0.0

one :: Double
one = half 2.0

nan :: Double
nan = zero / zero

inf :: Double
inf = one / zero

negInf :: Double
negInf = negate one / zero

report :: String -> Bool -> IO ()
report label b = putStrLn (label <> ": " <> show b)


near :: Double -> Double -> Bool
near a b = abs (a - b) < 1.0e-9
main :: IO ()
main = do
  report "nan==nan" (nan == nan)
  report "nan/=nan" (nan /= nan)
  report "0.0==-0.0" (zero == negate zero)
  report "cmp nan 1" (compare nan one == GT)
  report "cmp nan nan" (compare nan nan == GT)
  report "cmp -0.0 0.0" (compare (negate zero) zero == EQ)
  report "nan<1" (nan < one)
  report "nan>1" (nan > one)
  report "nan<=nan" (nan <= nan)
  report "inf==1/0" (inf == one / zero)
  report "inf+1==inf" (inf + one == inf)
  report "inf-inf is nan" (inf - inf /= inf - inf)
  report "recip 0 == inf" (recip zero == inf)
  report "signum -0.0 neg" (one / signum (negate zero) == negInf)
  report "signum 0.0 pos" (one / signum zero == inf)
  report "rationalToDouble 1 2" (rationalToDouble 1 2 == 0.5)
  report "rationalToDouble 1 0" (rationalToDouble 1 0 == inf)
  report "rationalToDouble 0 0 is nan" (rationalToDouble 0 0 /= rationalToDouble 0 0)
  report "cast round trip 1.5" (castWord64ToDouble (castDoubleToWord64 1.5) == 1.5)
  report "cast keeps sign bit" (castDoubleToWord64 (negate zero) /= castDoubleToWord64 zero)
  report "rationalToDouble 1 3" (rationalToDouble 1 3 == 1.0 / 3.0)
  report "rationalToDouble 2^2000 over 1" (rationalToDouble (2 ^ 2000) 1 == inf)
  report "rationalToDouble 1 over 2^2000" (rationalToDouble 1 (2 ^ 2000) == 0.0)
  report "rationalToDouble 1 over 2^1074" (rationalToDouble 1 (2 ^ 1074) == rationalToDouble 2 (2 ^ 1075))
  report "rationalToDouble tie at 2^-1075" (rationalToDouble 1 (2 ^ 1075) == 0.0)
  report "rationalToDouble just above tie" (rationalToDouble 3 (2 ^ 1076) == rationalToDouble 1 (2 ^ 1074))
  report "rationalToDouble smallest is positive" (rationalToDouble 1 (2 ^ 1074) > 0.0)
  report "min subnormal literal" (5.0e-324 == rationalToDouble 1 (2 ^ 1074))
  report "tiny literal" (1.0e-320 > 0.0)
  report "rationalToDouble max finite" (rationalToDouble ((2 ^ 1024) - (2 ^ 971)) 1 == 1.7976931348623157e308)
  report "rationalToDouble over max" (rationalToDouble (2 ^ 1024) 1 == inf)
  putStrLn (show (8.0 :: Double))
  putStrLn (show (0.1 :: Double))
  putStrLn (show (1.0e10 :: Double))
  putStrLn (show (100.0 :: Double))
  putStrLn (show (0.0001 :: Double))
  putStrLn (show (123456789.0 :: Double))
  putStrLn (show (1.0e-10 :: Double))
  putStrLn (show (0.0 :: Double))
  putStrLn (show inf)
  putStrLn (show nan)
  putStrLn (show (negate zero))
  putStrLn (show (0.1 + 0.2 :: Double))
  putStrLn (show (3.141592653589793 :: Double))
  putStrLn (show (negate 1.0e10 :: Double))
  report "sqrt 4 == 2" (sqrt 4.0 == 2.0)
  report "exp 0 == 1" (exp 0.0 == 1.0)
  report "log 1 == 0" (log 1.0 == 0.0)
  report "log (exp 1) ~ 1" (near (log (exp 1.0)) 1.0)
  report "sin 0 == 0" (sin 0.0 == 0.0)
  report "cos 0 == 1" (cos 0.0 == 1.0)
  report "asin 0 == 0" (asin 0.0 == 0.0)
  report "acos 1 == 0" (acos 1.0 == 0.0)
  report "atan 0 == 0" (atan 0.0 == 0.0)
  report "2 ** 10 ~ 1024" (near (2.0 ** 10.0) 1024.0)
  report "logBase 2 8 ~ 3" (near (logBase 2.0 8.0) 3.0)
  report "sinh 0 == 0" (sinh 0.0 == 0.0)
  report "cosh 0 == 1" (cosh 0.0 == 1.0)
  report "asinh 0 == 0" (asinh 0.0 == 0.0)
  report "acosh 1 == 0" (acosh 1.0 == 0.0)
  report "atanh 0 == 0" (atanh 0.0 == 0.0)
  report "tan (pi/4) ~ 1" (near (tan (pi / 4.0)) 1.0)
  report "tanh 0 == 0" (tanh 0.0 == 0.0)
  report "pi ~ 3.141592653589793" (near pi 3.141592653589793)
  putStrLn (show (sqrt 4.0))
  putStrLn (show (pi :: Double))
  report "expm1 1e-20 == 1e-20" (expm1 1.0e-20 == 1.0e-20)
  report "log1p 1e-20 == 1e-20" (log1p 1.0e-20 == 1.0e-20)
  report "atanh 1e-20 == 1e-20" (atanh 1.0e-20 == 1.0e-20)
  report "tanh 1000 == 1" (tanh 1000.0 == 1.0)
  report "tanh -1000 == -1" (tanh (negate 1000.0) == negate 1.0)
  report "asinh 1e-300 == 1e-300" (asinh 1.0e-300 == 1.0e-300)
  report "asinh 1e300 ~ 691.4686750787736" (near (asinh 1.0e300) 691.4686750787736)
  report "acosh 1e300 ~ 691.4686750787736" (near (acosh 1.0e300) 691.4686750787736)
  report "expm1 1e-3 ~ 0.0010005001667083417" (near (expm1 1.0e-3) 0.0010005001667083417)
  report "(**) negative base, integral exponent" ((-2.0) ** 3.0 == -8.0)
  report "(**) 2 ** 0.5 ~ sqrt 2" (near (2.0 ** 0.5) 1.4142135623730951)
  report "logBase 10 1000 ~ 3" (near (logBase 10.0 1000.0) 3.0)
  report "log1pexp 1000 == 1000" (log1pexp 1000.0 == 1000.0)
  report "log1pexp -1000 ~ 0" (near (log1pexp (negate 1000.0)) 0.0)
  report "log1pexp 50 == 50 + exp -50" (log1pexp 50.0 == 50.0 + exp (negate 50.0))
  report "log1mexp -0.1 ~ -2.3521684610440907" (near (log1mexp (negate 0.1)) (-2.3521684610440907))
  report "log1mexp -1000 ~ 0" (near (log1mexp (negate 1000.0)) 0.0)
