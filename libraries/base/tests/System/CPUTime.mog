-- System.CPUTime: the unit a reading is counted in, and the two properties a
-- CPU clock has to have -- it never runs backwards and it accounts for work the
-- process actually did.
import Data.Ord
import System.CPUTime

-- A strict accumulator loop: the result is observable, so the work is real
-- rather than something an optimizer can drop.
burn :: Int -> Int -> Int
burn n acc = case n of
  0 -> acc
  _ -> burn (n - 1) (acc + n)

-- Burn CPU in bounded rounds until the reading moves, returning the reading
-- and the total of the last round (so the work cannot be dropped). Hosts that
-- report processor time in whole scheduler ticks -- .NET on Linux reads
-- /proc, whose times advance a tick at a time -- can absorb one short burst
-- inside a single tick, so a fixed burst would be testing the host's clock
-- resolution rather than whether the work was accounted for.
busier :: Integer -> Int -> IO (Integer, Int)
busier start rounds = case rounds of
  0 -> do
    now <- getCPUTime
    pure (now, 0)
  _ -> case burn 200000 0 of
    worked -> do
      now <- getCPUTime
      case now > start of
        True -> pure (now, worked)
        False -> busier start (rounds - 1)

main :: IO ()
main = do
  putStrLn (show cpuTimePrecision)
  start <- getCPUTime
  putStrLn (show (start >= 0))
  putStrLn (show (burn 200000 0))
  mid <- getCPUTime
  putStrLn (show (mid >= start))
  later <- busier start 100
  putStrLn (show (case later of (t, _) -> t > start))
  putStrLn (show (case later of (_, w) -> w))
  end <- getCPUTime
  putStrLn (show (end >= mid))
