-- System.Filesystem.Path: the filepath 1.5.4.0 API on Posix. The printed
-- values pin the observable results and `check` runs the reference's own
-- documented examples (including the round-trip properties) as assertions.
--
-- Paths are host-native `String`s (`type FilePath = String`); `fp`/`txt`
-- spell out the conversion, which is the identity in both directions.

import System.Filesystem.Path
import System.IO.Base (FilePath, packFilePath, unpackFilePath)

check :: String -> Bool -> IO ()
check label ok = case ok of
  True -> putStrLn ("ok   " <> label)
  False -> putStrLn ("FAIL " <> label)

fp :: String -> FilePath
fp = packFilePath

txt :: FilePath -> String
txt p = case unpackFilePath p of
  Just s -> s
  Nothing -> "<?>"

-- /directory/file.ext — the example path from the module documentation.
example :: FilePath
example = fp "/directory/file.ext"

main :: IO ()
main = do
  putStrLn ("isPathSeparator pathSeparator: " <> show (isPathSeparator pathSeparator))
  putStrLn ("isSearchPathSeparator : " <> show (isSearchPathSeparator searchPathSeparator))
  putStrLn ("isExtSeparator .: " <> show (isExtSeparator extSeparator))

  -- Extension functions.
  putStrLn ("splitExtension file.tar.gz: " <> show (splitExtension (fp "file.tar.gz")))
  putStrLn ("takeExtension: " <> txt (takeExtension example))
  putStrLn ("dropExtension: " <> txt (dropExtension example))
  putStrLn ("replaceExtension: " <> txt (replaceExtension (fp "/directory/path.txt") (fp "ext")))
  putStrLn ("(-<.>): " <> txt ((fp "/directory/path.txt" -<.> fp "ext")))
  putStrLn ("addExtension file.txt bib: " <> txt (addExtension (fp "file.txt") (fp "bib")))
  putStrLn ("addExtension file \".\": " <> txt ((fp "file" <.> fp "bib")))
  putStrLn ("takeExtensions file.tar.gz: " <> txt (takeExtensions (fp "file.tar.gz")))
  putStrLn ("dropExtensions file.tar.gz: " <> txt (dropExtensions (fp "file.tar.gz")))
  putStrLn ("splitExtensions file.tar.gz: " <> show (splitExtensions (fp "file.tar.gz")))

  -- Filename / directory functions.
  putStrLn ("splitFileName: " <> show (splitFileName example))
  putStrLn ("splitFileName bob: " <> show (splitFileName (fp "bob")))
  putStrLn ("takeFileName: " <> txt (takeFileName example))
  putStrLn ("takeBaseName: " <> txt (takeBaseName example))
  putStrLn ("dropFileName: " <> txt (dropFileName example))
  putStrLn ("replaceFileName: " <> txt (replaceFileName (fp "/directory/other.txt") (fp "file.ext")))
  putStrLn ("replaceBaseName: " <> txt (replaceBaseName (fp "/dave/fred/bob.gz.tar") (fp "new")))
  putStrLn ("takeDirectory: " <> txt (takeDirectory example))
  putStrLn ("takeDirectory /foo/bar/baz/: " <> txt (takeDirectory (fp "/foo/bar/baz/")))
  putStrLn ("replaceDirectory: " <> txt (replaceDirectory (fp "root/file.ext") (fp "/directory/")))
  putStrLn ("combine: " <> txt (combine (fp "/directory") (fp "file.ext")))
  putStrLn ("(</>) not combined: " <> txt ((fp "home" </> fp "/bob")))
  putStrLn ("splitPath: " <> show (splitPath example))
  putStrLn ("splitDirectories: " <> show (splitDirectories (fp "/test///file")))
  putStrLn ("joinPath: " <> txt (joinPath [fp "/", fp "directory/", fp "file.ext"]))

  -- Drive functions (on Posix a drive is a run of path separators).
  putStrLn ("splitDrive /test: " <> show (splitDrive (fp "/test")))
  putStrLn ("splitDrive //test: " <> show (splitDrive (fp "//test")))
  putStrLn ("splitDrive test/file: " <> show (splitDrive (fp "test/file")))
  putStrLn ("takeDrive: " <> txt (takeDrive (fp "//test")))
  putStrLn ("dropDrive: " <> txt (dropDrive (fp "//test")))
  putStrLn ("joinDrive: " <> txt (joinDrive (fp "/") (fp "foo")))

  -- Trailing separators.
  putStrLn ("addTrailingPathSeparator: " <> txt (addTrailingPathSeparator (fp "test/rest")))
  putStrLn ("dropTrailingPathSeparator: " <> txt (dropTrailingPathSeparator (fp "file/test/")))
  putStrLn ("dropTrailingPathSeparator /: " <> txt (dropTrailingPathSeparator (fp "/")))

  -- File name manipulations.
  putStrLn ("normalise /file/./test: " <> txt (normalise (fp "/file/./test")))
  putStrLn ("normalise ./bob/fred/: " <> txt (normalise (fp "./bob/fred/")))
  putStrLn ("normalise //home: " <> txt (normalise (fp "//home")))
  putStrLn ("normalise /a/../c: " <> txt (normalise (fp "/a/../c")))
  putStrLn ("normalise .: " <> txt (normalise (fp ".")))
  putStrLn ("normalise ./: " <> txt (normalise (fp "./")))
  putStrLn ("normalise bob/fred/.: " <> txt (normalise (fp "bob/fred/.")))
  putStrLn ("makeRelative: " <> txt (makeRelative (fp "/home/") (fp "/home/bob/foo/bar")))
  putStrLn ("makeRelative x x: " <> txt (makeRelative (fp "/home/bob") (fp "/home/bob")))
  putStrLn ("makeRelative /fred bob: " <> txt (makeRelative (fp "/fred") (fp "bob")))
  putStrLn ("isValid empty: " <> show (isValid (fp "")))
  putStrLn ("isValid /random_ path:*: " <> show (isValid (fp "/random_ path:*")))
  putStrLn ("makeValid empty: " <> txt (makeValid (fp "")))

  -- $PATH methods.
  putStrLn ("splitSearchPath: " <> show (splitSearchPath "File1:File2:File3"))
  putStrLn ("splitSearchPath empty item: " <> show (splitSearchPath "File1::File2:File3"))

  -- Reference properties, as assertions.
  check "takeExtension == snd (splitExtension x)" (takeExtension example == snd (splitExtension example))
  check "dropExtension == fst (splitExtension x)" (dropExtension example == fst (splitExtension example))
  check "uncurry (<>) (splitExtension x) == x" (fst (splitExtension example) <> snd (splitExtension example) == example)
  check "splitExtension file == (file, \"\")" (splitExtension (fp "file") == (fp "file", fp ""))
  check "splitExtension file/path.txt/ has no extension" (splitExtension (fp "file/path.txt/") == (fp "file/path.txt/", fp ""))
  check "splitExtension file/path.txt.bob.fred" (splitExtension (fp "file/path.txt.bob.fred") == (fp "file/path.txt.bob", fp ".fred"))
  check "addExtension then takeExtension" (takeExtension (addExtension (fp "/directory/path") (fp "ext")) == fp ".ext")
  check "replaceExtension then takeExtension" (takeExtension (replaceExtension (fp "/directory/path.txt") (fp "ext")) == fp ".ext")
  check "addExtension x \"\" == x" (addExtension example (fp "") == example)
  check "stripExtension hs.o foo.x.hs.o" (stripExtension (fp "hs.o") (fp "foo.x.hs.o") == Just (fp "foo.x"))
  check "stripExtension hi.o foo.x.hs.o == Nothing" (stripExtension (fp "hi.o") (fp "foo.x.hs.o") == Nothing)
  check "stripExtension empty is Just x" (stripExtension (fp "") (fp "file.txt") == Just (fp "file.txt"))
  check "stripExtension .c.d a.b..c.d" (stripExtension (fp ".c.d") (fp "a.b..c.d") == Just (fp "a.b."))
  check "isExtensionOf png" ((fp "png") `isExtensionOf` (fp "/directory/file.png"))
  check "not isExtensionOf ar.gz" (not ((fp "ar.gz") `isExtensionOf` (fp "bar/foo.tar.gz")))
  check "not isExtensionOf csv/table.csv" (not ((fp "csv/table.csv") `isExtensionOf` (fp "/data/csv/table.csv")))
  check "hasExtension" (hasExtension example)
  check "not hasExtension of path" (not (hasExtension (fp "/directory/path")))
  check "takeFileName" (takeFileName example == fp "file.ext")
  check "joinPath (splitPath x) == x" (joinPath (splitPath example) == example)
  check "uncurry (</>) (splitFileName x) == x" (fst (splitFileName example) </> snd (splitFileName example) == example)
  check "replaceFileName then takeFileName" (takeFileName (replaceFileName example (fp "fred")) == fp "fred")
  check "(x </> fred) takeFileName" (takeFileName (example </> fp "fred") == fp "fred")
  check "takeFileName test/ == \"\"" (takeFileName (fp "test/") == fp "")
  check "takeBaseName addTrailingPathSeparator == \"\"" (takeBaseName (addTrailingPathSeparator example) == fp "")
  check "replaceBaseName keeps extension" (replaceBaseName (fp "/dave/fred/bob.gz.tar") (fp "new") == fp "/dave/fred/new.tar")
  check "takeDirectory foo == ." (takeDirectory (fp "foo") == fp ".")
  check "takeDirectory / == /" (takeDirectory (fp "/") == fp "/")
  check "takeDirectory /foo == /" (takeDirectory (fp "/foo") == fp "/")
  check "takeDirectory foo/bar/baz" (takeDirectory (fp "foo/bar/baz") == fp "foo/bar")
  check "addTrailingPathSeparator idempotent" (addTrailingPathSeparator (addTrailingPathSeparator (fp "test")) == fp "test/")
  check "normalise / == /" (normalise (fp "/") == fp "/")
  check "normalise /./ == /" (normalise (fp "/./") == fp "/")
  check "normalise ../bob/fred/ unchanged" (normalise (fp "../bob/fred/") == fp "../bob/fred/")
  check "normalise does not remove .." (normalise (fp "/test/file/../bob/fred/") == fp "/test/file/../bob/fred/")
  check "equalFilePath foo foo/" (equalFilePath (fp "foo") (fp "foo/"))
  check "not equalFilePath foo /foo" (not (equalFilePath (fp "foo") (fp "/foo")))
  check "not equalFilePath /a/../c /c" (not (equalFilePath (fp "/a/../c") (fp "/c")))
  check "isRelative test/path" (isRelative (fp "test/path"))
  check "not isRelative /test" (not (isRelative (fp "/test")))
  check "isAbsolute == not isRelative" (isAbsolute (fp "/test") == not (isRelative (fp "/test")))
  check "makeRelative x x == ." (makeRelative (fp "/a/b") (fp "/a/b") == fp ".")
  check "makeRelative takeDirectory x" (makeRelative (fp "/directory") example == fp "file.ext")
  check "makeRelative some/path" (makeRelative (fp "some/path") (fp "some/path/a/b/c") == fp "a/b/c")
  check "makeRelative different roots" (makeRelative (fp "/Home") (fp "/home/bob") == fp "/home/bob")
  check "makeRelative /file/test fred/" (makeRelative (fp "/file/test") (fp "/file/test/fred/") == fp "fred/")
  check "isValid makeValid always holds" (isValid (makeValid (fp "file")) && isValid (makeValid (fp "")))
  check "makeValid x == x when valid" (makeValid example == example)
  check "hasDrive //test" (hasDrive (fp "//test"))
  check "not hasDrive test" (not (hasDrive (fp "test")))
  check "isDrive /" (isDrive (fp "/"))
  check "not isDrive /foo" (not (isDrive (fp "/foo")))
  check "splitDrive uncurry (<>) == x" (fst (splitDrive (fp "//test")) <> snd (splitDrive (fp "//test")) == fp "//test")
  check "dropTrailingPathSeparator keeps /" (dropTrailingPathSeparator (fp "/") == fp "/")
  check "splitDirectories /test/file" (splitDirectories (fp "/test/file") == [fp "/", fp "test", fp "file"])
  check "splitDirectories empty" (splitDirectories (fp "") == [])
  check "splitPath keeps redundant separators" (splitPath (fp "test//item/") == [fp "test//", fp "item/"])
  check "joinPath []" (joinPath [] == fp "")
  check "joinPath splitPath round trip" (joinPath (splitPath (fp "test/item/file")) == fp "test/item/file")
  check "splitSearchPath blank item becomes ." (splitSearchPath "File1::File2:File3" == [fp "File1", fp ".", fp "File2", fp "File3"])
  check "pathSeparator isPathSeparator" (isPathSeparator pathSeparator)
  check "isSearchPathSeparator" (isSearchPathSeparator searchPathSeparator && not (isSearchPathSeparator pathSeparator))
  check "isExtSeparator" (isExtSeparator extSeparator && not (isExtSeparator pathSeparator))
