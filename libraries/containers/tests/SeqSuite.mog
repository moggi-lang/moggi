-- Data.Sequence: construction, views, indexing, subsequences, sorting,
-- zipping, indexed traversals, and the Eq, Show, Semigroup, Monoid, Functor,
-- Foldable, Traversable, Applicative, Monad and Alternative instances.

module SeqSuite (seqSuite) where

import Control.Applicative ((<|>))
import Data.Sequence qualified as Q
import Data.Sequence ((<|), (><))
import Data.Traversable (Identity (MkIdentity), runIdentity)
import Support (assertTrue, expect)

seqSuite :: IO ()
seqSuite = do
  expect "cons builds left to right" (show (Q.toList (1 <| 2 <| Q.singleton 3))) "[1,2,3]"
  expect "snoc appends on the right" (show (Q.toList (Q.snoc (Q.fromList [1, 2]) 3))) "[1,2,3]"
  expect "append concatenates" (show (Q.toList ((Q.fromList [1, 2]) >< (Q.fromList [3])))) "[1,2,3]"
  expect "replicate repeats" (show (Q.toList (Q.replicate 3 7))) "[7,7,7]"
  expect "iterateN unfolds" (show (Q.toList (Q.iterateN 4 (* 2) 1))) "[1,2,4,8]"
  expect "cycleN cycles" (show (Q.toList (Q.cycleN 2 (Q.fromList [1, 2])))) "[1,2,1,2]"
  expect "tails" (show (Q.toList (Q.tails (Q.fromList [1, 2])))) "[MkSeq [1,2],MkSeq [2],MkSeq []]"
  expect "inits" (show (Q.toList (Q.inits (Q.fromList [1, 2])))) "[MkSeq [],MkSeq [1],MkSeq [1,2]]"
  expect "chunksOf splits" (show (Q.toList (Q.chunksOf 2 (Q.fromList [1, 2, 3])))) "[MkSeq [1,2],MkSeq [3]]"
  expect "viewl EmptyL" (show (Q.viewl (Q.empty :: Q.Seq Int))) "EmptyL"
  expect "viewl splits head" (show (Q.viewl (Q.fromList [1, 2]))) "(:<) 1 (MkSeq [2])"
  expect "viewr EmptyR" (show (Q.viewr (Q.empty :: Q.Seq Int))) "EmptyR"
  expect "viewr splits last" (show (Q.viewr (Q.fromList [1, 2]))) "(:>) (MkSeq [1]) 2"
  expect "lookup hits" (show (Q.lookup 1 (Q.fromList [10, 20, 30]))) "Just 20"
  expect "lookup misses" (show (Q.lookup 5 (Q.fromList [10, 20]))) "Nothing"
  expect "lookup negative misses" (show (Q.lookup (-1) (Q.fromList [10]))) "Nothing"
  expect "index" (show (Q.index (Q.fromList [10, 20]) 1)) "20"
  expect "adjust updates" (show (Q.toList (Q.adjust (* 10) 0 (Q.fromList [1, 2])))) "[10,2]"
  expect "adjust out of range is identity" (show (Q.toList (Q.adjust (* 10) 5 (Q.fromList [1])))) "[1]"
  expect "update replaces" (show (Q.toList (Q.update 1 9 (Q.fromList [1, 2])))) "[1,9]"
  expect "deleteAt removes" (show (Q.toList (Q.deleteAt 0 (Q.fromList [1, 2, 3])))) "[2,3]"
  expect "insertAt inserts" (show (Q.toList (Q.insertAt 1 9 (Q.fromList [1, 2])))) "[1,9,2]"
  expect "take keeps a prefix" (show (Q.toList (Q.take 2 (Q.fromList [1, 2, 3])))) "[1,2]"
  expect "drop removes a prefix" (show (Q.toList (Q.drop 2 (Q.fromList [1, 2, 3])))) "[3]"
  expect "splitAt splits" (show (Q.splitAt 1 (Q.fromList [1, 2]))) "(MkSeq [1],MkSeq [2])"
  expect "length" (show (Q.length (Q.fromList [1, 2, 3]))) "3"
  expect "null empty" (show (Q.null (Q.empty :: Q.Seq Int))) "True"
  expect "null non-empty" (show (Q.null (Q.singleton 1))) "False"
  expect "reverse" (show (Q.toList (Q.reverse (Q.fromList [1, 2, 3])))) "[3,2,1]"
  expect "sort orders" (show (Q.toList (Q.sort (Q.fromList [3, 1, 2])))) "[1,2,3]"
  expect "sortBy orders" (show (Q.toList (Q.sortBy (\x y -> compare y x) (Q.fromList [1, 3, 2])))) "[3,2,1]"
  expect "sortOn orders by key" (show (Q.toList (Q.sortOn (\x -> x `mod` 2) (Q.fromList [1, 2, 3])))) "[2,1,3]"
  expect "sort is stable" (show (Q.toList (Q.sortOn fst (Q.fromList [(1, 'x'), (1, 'y'), (0, 'z')])))) "[(0,'z'),(1,'x'),(1,'y')]"
  expect "unstableSort orders" (show (Q.toList (Q.unstableSort (Q.fromList [2, 1])))) "[1,2]"
  expect "filter keeps matches" (show (Q.toList (Q.filter (\x -> x > 1) (Q.fromList [1, 2, 3])))) "[2,3]"
  expect "partition splits" (show (Q.partition (\x -> x > 1) (Q.fromList [1, 2, 3]))) "(MkSeq [2,3],MkSeq [1])"
  expect "spanl splits at first miss" (show (Q.spanl (\x -> x < 3) (Q.fromList [1, 2, 3, 1]))) "(MkSeq [1,2],MkSeq [3,1])"
  expect "breakl splits at first hit" (show (Q.breakl (\x -> x > 1) (Q.fromList [1, 2, 1]))) "(MkSeq [1],MkSeq [2,1])"
  expect "spanr splits at last miss" (show (Q.spanr (\x -> x > 1) (Q.fromList [1, 2, 3]))) "(MkSeq [1],MkSeq [2,3])"
  expect "breakr splits at last hit" (show (Q.breakr (\x -> x > 1) (Q.fromList [1, 2, 1]))) "(MkSeq [1,2],MkSeq [1])"
  expect "takeWhileL" (show (Q.toList (Q.takeWhileL (\x -> x < 3) (Q.fromList [1, 2, 3])))) "[1,2]"
  expect "dropWhileR" (show (Q.toList (Q.dropWhileR (\x -> x > 1) (Q.fromList [1, 2, 3])))) "[1]"
  expect "zip pairs" (show (Q.toList (Q.zip (Q.fromList [1, 2]) (Q.fromList ['a', 'b'])))) "[(1,'a'),(2,'b')]"
  expect "zip stops at shorter" (show (Q.toList (Q.zip (Q.fromList [1, 2, 3]) (Q.fromList [9])))) "[(1,9)]"
  expect "zipWith combines" (show (Q.toList (Q.zipWith (+) (Q.fromList [1, 2]) (Q.fromList [10, 20])))) "[11,22]"
  expect "unzip splits" (show (Q.unzip (Q.fromList [(1, 'a'), (2, 'b')]))) "(MkSeq [1,2],MkSeq ['a','b'])"
  expect "mapWithIndex sees positions" (show (Q.toList (Q.mapWithIndex (\i x -> i * 10 + x) (Q.fromList [1, 2])))) "[1,12]"
  expect "foldlWithIndex folds left" (show (Q.foldlWithIndex (\b i x -> b + i + x) 0 (Q.fromList [10, 20]))) "31"
  expect "foldrWithIndex folds right" (show (Q.foldrWithIndex (\i x acc -> acc + i + x) 0 (Q.fromList [7, 8]))) "16"
  expect "foldMapWithIndex collects" (show (Q.foldMapWithIndex (\i x -> [i + x]) (Q.fromList [10, 20]))) "[10,21]"
  expect "traverseWithIndex visits" (show (Q.toList (runIdentity (Q.traverseWithIndex (\i x -> MkIdentity (i * 100 + x)) (Q.fromList [1, 2]))))) "[1,102]"
  expect "scanl prefixes" (show (Q.toList (Q.scanl (+) 0 (Q.fromList [1, 2, 3])))) "[0,1,3,6]"
  expect "scanr suffixes" (show (Q.toList (Q.scanr (+) 0 (Q.fromList [1, 2, 3])))) "[6,5,3,0]"
  expect "intersperse separates" (show (Q.toList (Q.intersperse 0 (Q.fromList [1, 2, 3])))) "[1,0,2,0,3]"
  expect "Show" (show (Q.fromList [1, 2])) "MkSeq [1,2]"
  assertTrue "Eq" (Q.fromList [1, 2] == Q.fromList [1, 2])
  expect "Semigroup" (show (Q.toList (Q.fromList [1] <> Q.fromList [2]))) "[1,2]"
  expect "Monoid mempty" (show (Q.toList (mempty :: Q.Seq Int))) "[]"
  expect "Functor" (show (Q.toList ((* 2) <$> Q.fromList [1, 2]))) "[2,4]"
  expect "Foldable" (show (foldr (+) 0 (Q.fromList [1, 2, 3]))) "6"
  expect "Traversable" (show (Q.toList (runIdentity (traverse (\x -> MkIdentity (x + 1)) (Q.fromList [1, 2]))))) "[2,3]"
  expect "Applicative" (show (Q.toList (pure 5 :: Q.Seq Int))) "[5]"
  expect "Monad" (show (Q.toList (Q.fromList [1, 2] >>= (\x -> Q.fromList [x, x * 10])))) "[1,10,2,20]"
  expect "Alternative" (show (Q.toList (Q.fromList [1] <|> Q.fromList [2]))) "[1,2]"
