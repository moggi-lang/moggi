-- Data.Tree: rose trees, forests, folds, traversals and the ASCII drawing.

module TreeSuite (treeSuite) where

import Data.Tree
import Support (assertTrue, expect)

sample :: Tree Int
sample = Node 1 [Node 2 [], Node 3 [Node 4 []]]

treeSuite :: IO ()
treeSuite = do
  expect "rootLabel" (show (case sample of Node x _ -> x)) "1"
  expect "flatten is pre-order" (show (flatten sample)) "[1,2,3,4]"
  expect "levels" (show (levels sample)) "[[1],[2,3],[4]]"
  expect "leaves" (show (leaves sample)) "[2,4]"
  expect "edges" (show (edges sample)) "[(1,2),(1,3),(3,4)]"
  expect "Functor" (show (flatten ((* 10) <$> sample))) "[10,20,30,40]"
  expect "Foldable" (show (foldr (+) 0 sample)) "10"
  expect "foldTree sums" (show (foldTree (\x xs -> x + sumList xs) sample)) "10"
  expect "unfoldTree" (show (flatten (unfoldTree (\n -> case n <= 0 of True -> (n, []); False -> (n, [n - 1])) 2))) "[2,1,0]"
  expect "unfoldForest" (show (flatten (Node 0 (unfoldForest (\n -> (n, [])) [1, 2])))) "[0,1,2]"
  expect "drawTree" (show (drawTree (Node "a" [Node "b" []]))) "\"a\\n|\\n`- b\\n\""
  expect "drawForest" (show (drawForest [Node "a" [], Node "b" []])) "\"a\\nb\\n\""
  expect "pathsToRoot" (show (flatten (pathsToRoot sample))) "[1 :| [],2 :| [1],3 :| [1],4 :| [3,1]]"
  expect "pathsFromRoot" (show (flatten (pathsFromRoot sample))) "[1 :| [],1 :| [2],1 :| [3],1 :| [3,4]]"
  expect "PostOrder fold" (show (foldr (:) [] (PostOrder sample))) "[2,4,3,1]"
  assertTrue "Eq" (sample == sample)

sumList :: [Int] -> Int
sumList [] = 0
sumList (x : xs) = x + sumList xs
