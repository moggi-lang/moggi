-- Data.IntSet: Int sets — construction, queries, the set algebra, and the
-- Eq, Ord, Show, Semigroup and Monoid instances.

module IntSetSuite (intSetSuite) where

import Data.IntSet qualified as S
import Support (assertTrue, expect)

intSetSuite :: IO ()
intSetSuite = do
  expect "fromList sorts and dedups" (show (S.toList (S.fromList [3, 1, 2, 1]))) "[1,2,3]"
  expect "size counts distinct elements" (show (S.size (S.fromList [3, 1, 2, 1]))) "3"
  expect "member hits" (show (S.member 2 (S.fromList [3, 1, 2]))) "True"
  expect "notMember misses" (show (S.notMember 5 (S.fromList [3, 1, 2]))) "True"
  expect "insert keeps order" (show (S.toList (S.insert 0 (S.fromList [3, 1, 2])))) "[0,1,2,3]"
  expect "delete removes" (show (S.toList (S.delete 1 (S.fromList [3, 1, 2])))) "[2,3]"
  expect "singleton" (show (S.toList (S.singleton 7))) "[7]"
  expect "union" (show (S.toList (S.union (S.fromList [1, 2]) (S.fromList [2, 3])))) "[1,2,3]"
  expect "unions" (show (S.toList (S.unions [S.fromList [1], S.fromList [2, 3]]))) "[1,2,3]"
  expect "intersection" (show (S.toList (S.intersection (S.fromList [1, 2]) (S.fromList [2, 3])))) "[2]"
  expect "difference" (show (S.toList (S.difference (S.fromList [1, 2]) (S.fromList [2, 3])))) "[1]"
  expect "isSubsetOf yes" (show (S.isSubsetOf (S.fromList [1, 2]) (S.fromList [1, 2, 3]))) "True"
  expect "map" (show (S.toList (S.map (* 2) (S.fromList [3, 1, 2])))) "[2,4,6]"
  expect "filter" (show (S.toList (S.filter (\x -> x > 1) (S.fromList [3, 1, 2])))) "[2,3]"
  expect "null empty" (show (S.null S.empty)) "True"
  expect "Semigroup" (show (S.toList (S.fromList [1] <> S.fromList [2]))) "[1,2]"
  expect "Monoid mempty" (show (S.toList (mempty :: S.IntSet))) "[]"
  assertTrue "Eq" (S.fromList [1, 2] == S.fromList [2, 1])
  expect "Ord compares" (show (compare (S.fromList [1]) (S.fromList [1, 2]))) "LT"
  expect "Show" (show (S.fromList [1, 2])) "MkIntSet (MkSet [1,2])"
