-- src/Util/GenerateHtmlCombinators.hs:250
--
-- | Combinator for the @abbr@ attribute.
--
-- Example:
--
-- > div ! abbr "bar" $ "Hello."
--
-- Result:
--
-- > <div abbr="bar">Hello.</div>
--
abbr :: AttributeValue -> Attribute
abbr = attribute "abbr" " abbr=\""

