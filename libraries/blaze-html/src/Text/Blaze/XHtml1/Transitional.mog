{-# LANGUAGE NoImplicitPrelude #-}
-- | The combinators for this flavour of HTML, generated from the same
-- specification the Haskell library generates them from.
module Text.Blaze.XHtml1.Transitional
  ( Markup
  , Tag
  , Attribute
  , AttributeValue
  , dataAttribute
  , customAttribute
  , ToMarkup (..)
  , text
  , preEscapedText
  , string
  , preEscapedString
  , unsafeByteString
  , textComment
  , stringComment
  , unsafeByteStringComment
  , textTag
  , stringTag
  , ToValue (..)
  , textValue
  , preEscapedTextValue
  , stringValue
  , preEscapedStringValue
  , unsafeByteStringValue
  , (!)
  , (!?)
  , contents
  , Html
  , toHtml
  , preEscapedToHtml
  , docType
  , docTypeHtml
  , a
  , abbr
  , acronym
  , address
  , applet
  , area
  , b
  , basefont
  , bdo
  , big
  , blockquote
  , body
  , br
  , button
  , caption
  , center
  , cite
  , code
  , col
  , colgroup
  , dd
  , del
  , dfn
  , dir
  , div
  , dl
  , dt
  , em
  , fieldset
  , font
  , form
  , h1
  , h2
  , h3
  , h4
  , h5
  , h6
  , head
  , hr
  , html
  , i
  , iframe
  , img
  , input
  , ins
  , isindex
  , kbd
  , label
  , legend
  , li
  , link
  , map
  , menu
  , meta
  , noframes
  , noscript
  , object
  , ol
  , optgroup
  , option
  , p
  , param
