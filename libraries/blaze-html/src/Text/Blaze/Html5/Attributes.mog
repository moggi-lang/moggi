{-# LANGUAGE NoImplicitPrelude #-}
-- | The combinators for this flavour of HTML, generated from the same
-- specification the Haskell library generates them from.
-- Note: upstream's @pattern@ attribute is spelled @pattern_@ here, because
-- @pattern@ is a keyword in moggi and cannot name a function.
module Text.Blaze.Html5.Attributes
  ( accept
  , acceptCharset
  , accesskey
  , action
