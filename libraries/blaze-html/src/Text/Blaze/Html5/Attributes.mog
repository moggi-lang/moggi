-- src/Util/GenerateHtmlCombinators.hs:250
--
-- | Combinator for the @accept@ attribute.
--
-- Example:
--
-- > div ! accept "bar" $ "Hello."
--
-- Result:
--
-- > <div accept="bar">Hello.</div>
--
accept :: AttributeValue -> Attribute
accept = attribute "accept" " accept=\""

