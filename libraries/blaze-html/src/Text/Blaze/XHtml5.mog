-- src/Util/GenerateHtmlCombinators.hs:227
--
-- | Combinator for the @\<area />@ element.
--
-- Example:
--
-- > area
--
-- Result:
--
-- > <area />
--
area :: Html
area = Leaf "area" "<area" " />" ()

