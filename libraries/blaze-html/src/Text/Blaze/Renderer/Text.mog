{-# LANGUAGE NoImplicitPrelude #-}
-- | A renderer that produces text. Moggi's text type is 'String', so this is
-- the string renderer with the decoder made explicit: 'renderMarkupWith' takes
-- what to do with a byte string in the markup.
module Text.Blaze.Renderer.Text
  ( renderMarkupBuilder
  , renderMarkupBuilderWith
  , renderMarkup
  , renderMarkupWith
  , renderHtmlBuilder
  , renderHtmlBuilderWith
  , renderHtml
  , renderHtmlWith
  ) where

import Data.Bool (Bool (..), (&&))
import Data.ByteString (ByteString)
import Data.ByteString qualified as BS
import Data.Char (Char)
import Data.Eq
import Data.List ((:))
import Data.Semigroup ((<>))
import Data.String (String)
import Data.String qualified as S
import Data.String.Encoding (decodeUtf8)
import Data.Word (Word8)
import Text.Blaze.Internal (ChoiceString (..), Markup, MarkupM (..), getText)

-- | Escape the five XML entities of a string, then append the second string.
escapeMarkupEntities :: String -> String -> String
escapeMarkupEntities s k = escapeChars (S.unpack s) k

escapeChars :: [Char] -> String -> String
escapeChars cs k = case cs of
  [] -> k
  c : rest -> escapeChar c (escapeChars rest k)

-- | One character as the text it contributes, followed by the rest.
escapeChar :: Char -> String -> String
escapeChar c k = case c of
  '<' -> "&lt;" <> k
  '>' -> "&gt;" <> k
  '&' -> "&amp;" <> k
  '"' -> "&quot;" <> k
  '\'' -> "&#39;" <> k
  other -> consChar other k

consChar :: Char -> String -> String
consChar c k = S.pack (c : S.unpack k)

containsClose :: ByteString -> Bool
containsClose bs = scanClose (BS.unpack bs)

scanClose :: [Word8] -> Bool
scanClose ws = case ws of
  [] -> False
  a : rest -> case rest of
    b : more -> if a == 60 && b == 47 then True else scanClose rest
    [] -> False

containsCloseString :: String -> Bool
containsCloseString s = scanChars (S.unpack s)

scanChars :: [Char] -> Bool
scanChars cs = case cs of
  [] -> False
  a : rest -> case rest of
    b : more -> if a == '<' && b == '/' then True else scanChars rest
    [] -> False

-- | Render a 'ChoiceString' with the given decoder, then append the string.
fromChoiceString :: (ByteString -> String) -> ChoiceString -> String -> String
fromChoiceString d cs k = case cs of
  Static s -> getText s <> k
  String s -> escapeMarkupEntities s k
  Text s -> escapeMarkupEntities s k
  ByteString bs -> d bs <> k
  PreEscaped x -> case x of
    String s -> s <> k
    Text s -> s <> k
    other -> fromChoiceString d other k
  External x -> case x of
    String s -> if containsCloseString s then k else s <> k
    Text s -> if containsCloseString s then k else s <> k
    ByteString bs -> if containsClose bs then k else d bs <> k
    other -> fromChoiceString d other k
  AppendChoiceString x y -> fromChoiceString d x (fromChoiceString d y k)
  EmptyChoiceString -> k

-- | Render markup, with the attributes collected so far as a prefix.
go :: (ByteString -> String) -> String -> MarkupM a -> String -> String
go d attrs m k = case m of
  Parent _ open close content ->
    getText open <> attrs <> consChar '>' (go d "" content (getText close <> k))
  CustomParent tag content ->
    consChar '<' (fromChoiceString d tag
      (attrs <> consChar '>' (go d "" content
        ("</" <> fromChoiceString d tag (consChar '>' k)))))
  Leaf _ begin end _ -> getText begin <> attrs <> getText end <> k
  CustomLeaf tag close _ ->
    consChar '<' (fromChoiceString d tag
      (attrs <> (if close then " />" <> k else consChar '>' k)))
  AddAttribute _ key value h ->
    go d (getText key <> fromChoiceString d value (consChar '"' attrs)) h k
  AddCustomAttribute key value h ->
    go d (consChar ' ' (fromChoiceString d key
      ("=\"" <> fromChoiceString d value (consChar '"' attrs)))) h k
  Content content _ -> fromChoiceString d content k
  Comment comment _ -> "<!-- " <> fromChoiceString d comment (" -->" <> k)
  Append h1 h2 -> go d attrs h1 (go d attrs h2 k)
  Empty _ -> k

-- | Render markup to text, decoding byte strings as UTF-8.
renderMarkupBuilder :: Markup -> String
renderMarkupBuilder markup = renderMarkupBuilderWith decodeUtf8 markup

-- | Render markup to text with the given decoder for byte strings.
renderMarkupBuilderWith :: (ByteString -> String) -> Markup -> String
renderMarkupBuilderWith d markup = go d "" markup ""

renderMarkup :: Markup -> String
renderMarkup = renderMarkupBuilder

renderMarkupWith :: (ByteString -> String) -> Markup -> String
renderMarkupWith = renderMarkupBuilderWith

renderHtmlBuilder :: Markup -> String
renderHtmlBuilder = renderMarkupBuilder

renderHtmlBuilderWith :: (ByteString -> String) -> Markup -> String
renderHtmlBuilderWith = renderMarkupBuilderWith

renderHtml :: Markup -> String
renderHtml = renderMarkup

renderHtmlWith :: (ByteString -> String) -> Markup -> String
renderHtmlWith = renderMarkupWith
