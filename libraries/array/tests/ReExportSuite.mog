-- Re-export surface (Haskell parity): @Data.Array@ re-exports @Data.Ix@,
-- and @Data.Array.ST@\/@Data.Array.IO@ re-export @Data.Array.MArray@.
-- This module imports only the re-exporting modules, so a dropped
-- re-export fails to compile here.

module ReExportSuite (reExportSuite) where

import Control.Monad.ST (ST, runST)
import Data.Array
import Data.Array.IO
import Data.Array.ST
import Support (assertTrue)

-- 'newListArray'\/'getElems' resolve through the @MArray@ re-export.
newSTIs :: (Int, Int) -> [Int] -> ST s (STArray s Int Int)
newSTIs = newListArray

-- Same, through @Data.Array.IO@.
newIOIs :: (Int, Int) -> [Int] -> IO (IOArray Int Int)
newIOIs = newListArray

reExportSuite :: IO ()
reExportSuite = do
  assertTrue "Ix range through Data.Array" (range (0, 2) == [0, 1, 2])
  assertTrue "Ix inRange through Data.Array" (inRange (0, 2) 1)
  let n = runST (do marr <- newSTIs (0, 2) [1, 2, 3]; getElems marr) :: [Int]
  assertTrue "MArray through Data.Array.ST" (n == [1, 2, 3])
  marr <- newIOIs (0, 1) [7, 8]
  es <- getElems marr
  assertTrue "MArray through Data.Array.IO" (es == [7, 8])
  let arr = array (0, 1) [(0, 7), (1, 8)] :: Array Int Int
  assertTrue "array through Data.Array" (elems arr == [7, 8])
