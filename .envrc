export NIX_CONFIG="experimental-features = nix-command flakes"

if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
  . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
fi

watch_file flake.nix
watch_file flake.lock
watch_file nix/shell.nix
watch_file nix/devshell.nix

if ! has nix; then
  echo "nix is not installed or not on PATH" >&2
  return 1
fi

profile="$(direnv_layout_dir)/flake-profile"
mkdir -p "$(direnv_layout_dir)"
# `--file nix/shell.nix` (impure, read in place) instead of the repo flake
# (`path:.` or `git+file://…`): a flake reference archives the whole working
# tree into the store on every evaluation, so each compiler edit stashed
# another copy and re-resolved the environment — and `git+file` only skips
# ignored files, not tracked edits. This file reads just `flake.lock` (for the
# pinned nixpkgs) and `nix/devshell.nix`, so day-to-day source edits never
# touch the store; direnv reloads only when one of the watched files changes.
eval "$(nix print-dev-env --impure --profile "$profile" --file "nix/shell.nix")"
nix profile wipe-history --profile "$profile"
