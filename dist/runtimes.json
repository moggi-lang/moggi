{
  "linuxGlibcFloor": "2.35",

  "targets": {
    "linux-x86_64":    {"os": "linux",   "arch": "x86_64",  "phpPlatform": "unix",    "dotnetRid": "linux-x64",   "jvmOs": "linux",   "jvmArch": "x64",       "graalvmAsset": "linux-x64",     "spcAsset": "linux-x86_64",   "zigAsset": "x86_64-linux",  "archiveExt": "tar.gz"},
    "linux-aarch64":   {"os": "linux",   "arch": "aarch64", "phpPlatform": "unix",    "dotnetRid": "linux-arm64", "jvmOs": "linux",   "jvmArch": "aarch64",   "graalvmAsset": "linux-aarch64", "spcAsset": "linux-aarch64",  "zigAsset": "aarch64-linux", "archiveExt": "tar.gz"},
    "macos-x86_64":    {"os": "macos",   "arch": "x86_64",  "phpPlatform": "unix",    "dotnetRid": "osx-x64",     "jvmOs": "mac",     "jvmArch": "x64",       "graalvmAsset": "macos-x64",     "spcAsset": "macos-x86_64",   "zigAsset": null,            "archiveExt": "tar.gz"},
    "macos-aarch64":   {"os": "macos",   "arch": "aarch64", "phpPlatform": "unix",    "dotnetRid": "osx-arm64",   "jvmOs": "mac",     "jvmArch": "aarch64",   "graalvmAsset": "macos-aarch64", "spcAsset": "macos-aarch64",  "zigAsset": null,            "archiveExt": "tar.gz"},
    "windows-x86_64":  {"os": "windows", "arch": "x86_64",  "phpPlatform": "windows", "dotnetRid": "win-x64",     "jvmOs": "windows", "jvmArch": "x64",       "graalvmAsset": "windows-x64",   "spcAsset": "windows-x64",    "zigAsset": null,            "archiveExt": "zip"}
  },

  "runtimes": {
    "php": {
      "version": "8.5.7",
      "upstream": "php.net",
      "license": {
        "name": "PHP License 3.01",
        "file": "LICENSE",
        "url": "https://www.php.net/license/3_01.txt",
        "acknowledgement": "This product includes PHP software, freely available from <https://www.php.net/software/>."
      },
      "checksumsUrl": "https://www.php.net/releases/index.php?json&version={version}",
      "extensions": ["bcmath", "intl", "mbstring"],
      "configureFlags": [
        "--disable-all",
        "--disable-cgi",
        "--enable-cli",
        "--enable-bcmath",
        "--enable-mbstring",
        "--enable-intl",
        "--without-pear"
      ],
      "unix": {
        "format": "tar.gz",
        "url": "https://www.php.net/distributions/php-{version}.tar.gz",
        "stripComponents": 0,
        "build": true,
        "binary": "sapi/cli/php"
      },
      "windows-x86_64": {
        "format": "zip",
        "url": "https://downloads.php.net/~windows/releases/archives/php-{version}-nts-Win32-vs17-x64.zip",
        "stripComponents": 0,
        "binary": "php.exe"
      },
      "unsupported": {
        "windows-aarch64": "php.net publishes no Windows ARM64 build (the Windows release page offers x64 and x86 only)"
      }
    },

    "dotnet": {
      "version": "8.0.425",
      "upstream": "dotnet.microsoft.com",
      "license": {
        "name": "MIT (Linux and macOS); .NET Library License (Windows)",
        "file": "LICENSE.txt"
      },
      "asset": {
        "format": "tar.gz",
        "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/{version}/dotnet-sdk-{version}-{dotnetRid}.tar.gz",
        "stripComponents": 0,
        "binary": "dotnet"
      },
      "assetZip": {
        "format": "zip",
        "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/{version}/dotnet-sdk-{version}-{dotnetRid}.zip",
        "stripComponents": 0,
        "binary": "dotnet.exe"
      },
      "checksumsUrl": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/8.0/releases.json"
    },

    "jvm": {
      "version": "21",
      "upstream": "Eclipse Temurin (Adoptium)",
      "license": {
        "name": "GPLv2 with Classpath Exception",
        "file": "NOTICE"
      },
      "asset": {
        "format": "tar.gz",
        "url": "https://api.adoptium.net/v3/binary/latest/{version}/ga/{jvmOs}/{jvmArch}/jdk/hotspot/normal/eclipse",
        "stripComponents": 1,
        "binary": "bin/java"
      },
      "assetZip": {
        "format": "zip",
        "url": "https://api.adoptium.net/v3/binary/latest/{version}/ga/{jvmOs}/{jvmArch}/jdk/hotspot/normal/eclipse",
        "stripComponents": 1,
        "binary": "bin/java.exe"
      },
      "checksumsUrl": "https://api.adoptium.net/v3/assets/latest/{version}/hotspot?architecture={jvmArch}&image_type=jdk&os={jvmOs}&vendor=eclipse"
    },

    "graalvm": {
      "version": "21.0.2",
      "upstream": "graalvm-community-jdk (github.com/graalvm/graalvm-ce-builds)",
      "license": {
        "name": "GPLv2 with Classpath Exception (Community Edition)",
        "file": "LICENSE_NATIVEIMAGE.txt"
      },
      "asset": {
        "format": "tar.gz",
        "url": "https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-{version}/graalvm-community-jdk-{version}_{graalvmAsset}_bin.tar.gz",
        "sha256Url": "https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-{version}/graalvm-community-jdk-{version}_{graalvmAsset}_bin.tar.gz.sha256",
        "stripComponents": 1,
        "binary": "bin/native-image"
      },
      "assetZip": {
        "format": "zip",
        "url": "https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-{version}/graalvm-community-jdk-{version}_{graalvmAsset}_bin.zip",
        "sha256Url": "https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-{version}/graalvm-community-jdk-{version}_{graalvmAsset}_bin.zip.sha256",
        "stripComponents": 1,
        "binary": "bin/native-image.cmd"
      },
      "unsupported": {
        "windows-aarch64": "GraalVM publishes no Windows ARM64 build (linux-x64, linux-aarch64, macos-x64, macos-aarch64, windows-x64 only)"
      }
    },

    "composer": {
      "version": "2.10.1",
      "upstream": "getcomposer.org",
      "license": {
        "name": "MIT",
        "file": "LICENSE",
        "url": "https://raw.githubusercontent.com/composer/composer/{version}/LICENSE"
      },
      "asset": {
        "format": "plain",
        "url": "https://getcomposer.org/download/{version}/composer.phar",
        "sha256Url": "https://getcomposer.org/download/{version}/composer.phar.sha256sum",
        "stripComponents": 0,
        "binary": "composer.phar"
      }
    },

    "maven": {
      "version": "3.9.12",
      "upstream": "Apache Maven (archive.apache.org)",
      "license": {
        "name": "Apache License 2.0",
        "file": "LICENSE"
      },
      "asset": {
        "format": "tar.gz",
        "url": "https://archive.apache.org/dist/maven/maven-3/{version}/binaries/apache-maven-{version}-bin.tar.gz",
        "sha512Url": "https://archive.apache.org/dist/maven/maven-3/{version}/binaries/apache-maven-{version}-bin.tar.gz.sha512",
        "stripComponents": 1,
        "binary": "bin/mvn"
      },
      "assetZip": {
        "format": "zip",
        "url": "https://archive.apache.org/dist/maven/maven-3/{version}/binaries/apache-maven-{version}-bin.zip",
        "sha512Url": "https://archive.apache.org/dist/maven/maven-3/{version}/binaries/apache-maven-{version}-bin.zip.sha512",
        "stripComponents": 1,
        "binary": "bin/mvn.cmd"
      }
    },

    "php-native": {
      "version": "8.5",
      "static": true,
      "upstream": "static-php-cli's micro SAPI, compiled for this target by spc 2.8.5",
      "license": {
        "name": "PHP License 3.01, plus the licences of everything the runtime statically links (ICU and friends)",
        "file": "LICENSE",
        "url": "https://www.php.net/license/3_01.txt",
        "acknowledgement": "This product includes PHP software, freely available from <https://www.php.net/software/>.",
        "dump": true
      },
      "build": {
        "tool": "spc",
        "php": "8.5",
        "sapi": "micro"
      }
    },

    "spc": {
      "version": "2.8.5",
      "upstream": "github.com/crazywhalecc/static-php-cli",
      "checksumsUrl": "https://api.github.com/repos/crazywhalecc/static-php-cli/releases/tags/{version}",
      "unix": {
        "format": "tar.gz",
        "url": "https://github.com/crazywhalecc/static-php-cli/releases/download/{version}/spc-{spcAsset}.tar.gz",
        "stripComponents": 0,
        "binary": "spc"
      },
      "windows": {
        "format": "raw",
        "url": "https://github.com/crazywhalecc/static-php-cli/releases/download/{version}/spc-{spcAsset}.exe",
        "stripComponents": 0,
        "binary": "spc.exe"
      },
      "unsupported": {
        "windows-aarch64": "static-php-cli publishes no Windows ARM64 build (linux x86_64/aarch64, macOS x86_64/aarch64 and Windows x64 only)"
      }
    },

    "zig": {
      "version": "0.15.2",
      "upstream": "ziglang.org",
      "checksumsUrl": "https://ziglang.org/download/index.json",
      "unix": {
        "format": "tar.xz",
        "url": "https://ziglang.org/download/{version}/zig-{zigAsset}-{version}.tar.xz",
        "stripComponents": 1,
        "binary": "zig"
      },
      "unsupported": {
        "macos-x86_64": "only the Linux toolchain compiles with Zig; macOS uses Clang",
        "macos-aarch64": "only the Linux toolchain compiles with Zig; macOS uses Clang",
        "windows-x86_64": "only the Linux toolchain compiles with Zig; Windows uses MSVC",
        "windows-aarch64": "only the Linux toolchain compiles with Zig; Windows uses MSVC"
      }
    }
  },

  "variants": {
    "moggi":         {"runtimes": ["php", "php-native", "dotnet", "jvm", "graalvm", "composer", "maven"]},
    "moggi-php":     {"runtimes": ["php", "php-native", "composer"]},
    "moggi-dotnet":  {"runtimes": ["dotnet"]},
    "moggi-jvm":     {"runtimes": ["jvm", "graalvm", "maven"]},
    "moggi-minimal": {"runtimes": []}
  }
}
